import RobustBinaryRepair

namespace Orthemology.Tranche3

def rationalReport (l u e : ℚ) : ℚ := 1/2+(l+u)/2*e-(u-l)/2*e^2
def rationalValue (l u e : ℚ) : ℚ :=
  (rationalReport l u e)^2-(l*(1/2+e)^2+(1-l)*(1/2)^2)

def RationalValid (l u e : ℚ) : Prop :=
  0 ≤ l ∧ l ≤ u ∧ u ≤ 1 ∧ 0 ≤ e ∧ e ≤ 1/4
instance (l u e : ℚ) : Decidable (RationalValid l u e) :=
  inferInstanceAs (Decidable (0 ≤ l ∧ l ≤ u ∧ u ≤ 1 ∧ 0 ≤ e ∧ e ≤ 1/4))

/-- Executable exact-rational certificate. It does not read a hidden standard. -/
def rationalCertificate (l u e eta : ℚ) : Option ℚ :=
  if RationalValid l u e ∧ rationalValue l u e < eta
  then some (rationalReport l u e) else none

lemma rationalReport_cast (l u e : ℚ) :
    (rationalReport l u e : ℝ) = robustReport l u e := by
  simp only [rationalReport, robustReport]
  push_cast
  ring

lemma rationalValue_cast (l u e : ℚ) :
    (rationalValue l u e : ℝ) = robustValue l u e := by
  simp only [rationalValue, robustValue, excessZero]
  push_cast
  rw [rationalReport_cast]

lemma rationalValid_cast (l u e : ℚ) (h : RationalValid l u e) :
    0 ≤ (l:ℝ) ∧ (l:ℝ) ≤ u ∧ (u:ℝ) ≤ 1 ∧ 0 ≤ (e:ℝ) ∧ (e:ℝ) ≤ 1/4 := by
  rcases h with ⟨h0,h1,h2,h3,h4⟩
  refine ⟨by exact_mod_cast h0, by exact_mod_cast h1, by exact_mod_cast h2,
    by exact_mod_cast h3, ?_⟩
  have hx : (e:ℝ) ≤ ((1/4:ℚ):ℝ) := by exact_mod_cast h4
  norm_num at hx ⊢
  exact hx

/-- Every emitted rational report is sound for the full real interval,
not just for standards on a tested rational grid. -/
theorem rationalCertificate_sound (l u e eta q : ℚ)
    (h : rationalCertificate l u e eta = some q) : RobustGood l u e eta q := by
  unfold rationalCertificate at h
  split_ifs at h with hc
  · have hq : rationalReport l u e = q := Option.some.inj h
    have hv := rationalValid_cast l u e hc.1
    have hb : robustValue l u e ≤ (eta:ℝ) := by
      rw [← rationalValue_cast]
      exact_mod_cast hc.2
    rw [← hq, rationalReport_cast]
    apply (robustGood_iff_endpoints _ _ _ _ _ hv.2.1 hv.2.2.2.1 (by linarith [hv.2.2.2.2])).mpr
    have hm := robustReport_mem _ _ _ hv.1 hv.2.1 hv.2.2.1 hv.2.2.2.1 hv.2.2.2.2
    exact ⟨hm.1.le,hm.2.le,hb,by rw [robust_crossing]; exact hb⟩

/-- Under valid input bounds, rejection exactly means that no coherent real
report can meet the supplied tolerance for every possible real standard. -/
theorem rationalCertificate_reject_iff (l u e eta : ℚ) (hv : RationalValid l u e) :
    rationalCertificate l u e eta = none ↔ ¬ ∃ q : ℝ, RobustGood l u e eta q := by
  have h := rationalValid_cast l u e hv
  rw [robust_repair_exists_iff _ _ _ _ h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2]
  rw [← rationalValue_cast]
  unfold rationalCertificate
  simp only [hv, true_and]
  split_ifs with hc
  · simp only [reduceCtorEq, false_iff, not_not]
    exact_mod_cast hc
  · simp only [true_iff]
    exact_mod_cast hc

end Orthemology.Tranche3

#print axioms Orthemology.Tranche3.rationalCertificate_sound
#print axioms Orthemology.Tranche3.rationalCertificate_reject_iff
#eval Orthemology.Tranche3.rationalCertificate (49/100) (51/100) (1/10) 0
#eval Orthemology.Tranche3.rationalCertificate 0 1 (1/10) 0
/- Independent audit controls: zero/full/nonreduced weights; repeated syntax is
   independently sampled within a run, whereas relational comparison needs a
   correlated coupling. These controls do not modify the successor. -/
import P01CouplingWitness
namespace SuccessorIndependentAudit
open OrthemologyV2 OrthemologyV3 P01D P01R P01Probability
open scoped BigOperators

def ctx : P01F.Context := fun _ => .var 0
def vals : P01D.Env := fun n => if n = 0 then .i else skk
def rawEnv : REnv := diagEnv (fun _ => rawPER)
def varied : EExpr := .mix fairWeight (.pure (.var 0)) (.pure (.var 1))

theorem varied_typed : EHas ctx varied (.var 0) :=
  .mix (.pureCurry (.var ctx 0)) (.pureCurry (.var ctx 1)) fairWeight

theorem actual_related_valuations : ValRelated ctx rawEnv vals vals := by
  intro n
  exact Conv.refl _

theorem half_i : outputMass varied vals .i = 1/2 := by
  rw [varied,output_mass_mixture,output_mass_pure,output_mass_pure]
  norm_num [fairWeight, vals,eval,skk] <;> decide

theorem half_skk : outputMass varied vals skk = 1/2 := by
  rw [varied,output_mass_mixture,output_mass_pure,output_mass_pure]
  norm_num [fairWeight, vals,eval,skk] <;> decide

theorem raw_relation_separates : ¬ (P01R.interpret (.var 0)).rel rawEnv .i skk :=
  P01Source.I_SKK_not_convertible

theorem independent_product_has_forbidden_mass :
    outputMass varied vals .i * outputMass varied vals skk = 1/4 := by
  rw [half_i,half_skk]
  norm_num

theorem common_coupling_removes_forbidden_mass :
    outputCoupling varied vals vals .i skk = 0 := by
  apply Finset.sum_eq_zero
  intro s hs
  apply if_neg
  intro h
  have he : (Term.i : Term) = skk := h.1.symm.trans h.2
  exact (by decide : (Term.i : Term) ≠ skk) he

theorem independent_product_not_relationally_supported :
    ¬ (∀ t u, 0 < outputMass varied vals t * outputMass varied vals u →
      (P01R.interpret (.var 0)).rel rawEnv t u) := by
  intro h
  apply raw_relation_separates
  apply h .i skk
  rw [independent_product_has_forbidden_mass]
  norm_num

def zeroW : Weight := ⟨0,7,by decide,by decide⟩
def fullW : Weight := ⟨7,7,by decide,by decide⟩
def repeatedHalf : Weight := ⟨2,4,by decide,by decide⟩

theorem zero_weight_branch_exact (l r : EExpr) (θ : P01D.Env) (t : Term) :
    outputMass (.mix zeroW l r) θ t = outputMass r θ t := by
  rw [output_mass_mixture]
  norm_num [zeroW]

theorem full_weight_branch_exact (l r : EExpr) (θ : P01D.Env) (t : Term) :
    outputMass (.mix fullW l r) θ t = outputMass l θ t := by
  rw [output_mass_mixture]
  norm_num [fullW]

theorem nonreduced_weight_law_exact (l r : EExpr) (θ : P01D.Env) (t : Term) :
    outputMass (.mix repeatedHalf l r) θ t = outputMass (.mix fairWeight l r) θ t := by
  rw [output_mass_mixture,output_mass_mixture]
  norm_num [repeatedHalf,fairWeight]

theorem branch_collision_mass_is_summed (p : Weight) (θ : P01D.Env) (t : Term) :
    outputMass (.mix p (.pure (.atom t)) (.pure (.atom t))) θ t = 1 := by
  rw [output_mass_mixture,output_mass_pure,output_mass_pure]
  simp only [eval,ite_true,mul_one]
  rw [← add_div, ← Nat.cast_add, Nat.add_sub_of_le p.bounded]
  exact div_self (ne_of_gt (Nat.cast_pos.mpr p.positiveDen))

theorem duplicated_expression_samples_independently :
    outputMass (.app varied varied) vals (.app .i skk) = 1/4 := by
  unfold outputMass pushMass
  change (∑s : (Fin 2 × Unit × Unit) × (Fin 2 × Unit × Unit), _) = _
  simp only [Fintype.sum_prod_type]
  norm_num [Fin.sum_univ_two,Fintype.sum_unique,run,varied,fairWeight,vals,eval,skk,
    seedWeight,Seed] <;> decide

#print axioms independent_product_not_relationally_supported
#print axioms duplicated_expression_samples_independently
#print axioms branch_collision_mass_is_summed
end SuccessorIndependentAudit
import GlobalParitySufficiency
noncomputable section
namespace IndependentSingletonOracle
open HiddenParity HiddenParity.Necessity
