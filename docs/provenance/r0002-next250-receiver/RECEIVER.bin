open P01AC.EffectiveCompleteness (NBody)
open StructuredContextUniformity StructuredContextUniformity.Controls
-- The allExt body must use the actual type-weakened context.
example : FormE (twkTel [parameterSensitive]) NBody :=
  formBody (ctx_inclusion parameterSensitive_original)
import Counterexample
open FiniteMomentRecovery.FourPoint
-- This intentionally false control must fail to type-check.
example : moment wPlus 3 - moment wMinus 3 = (1 : ℝ) / 53 := by
  exact third_moment_difference
import Lean
import UniformSection
open Lean Elab Command
partial def initialityAncestors (env : Environment) (n : Name) : StateM NameSet Unit := do
  if (← get).contains n then return
  modify (·.insert n)
  if let some ci := env.find? n then
    for k in ci.getUsedConstantsAsSet.toList do initialityAncestors env k
run_cmd do
  let env ← getEnv
  for root in [`RigidityInitiality.dependent_section_from_rigidity,
      `RigidityInitiality.dependent_section_explicit,
      `RigidityInitiality.dependent_section_curried,
      `RigidityInitiality.section_has, `RigidityInitiality.rigidity_implies_section] do
    let (_, names) := (initialityAncestors env root).run {}
    logInfo m!"ANCESTORS {root}: {names.toList}"
    let bad := names.toList.filter fun n =>
      n.toString.startsWith "FullPER." ||
      n.toString.startsWith "HomogeneousOriginal" ||
      n.toString.startsWith "GenericFoldTransport." ||
      n.toString.startsWith "RigidityDiscriminator." ||
      n.toString == "SourceFoldContract.SourceNaturality" ||
      n.toString.startsWith "SourceRigidity.q_"
    unless bad.isEmpty do throwError m!"Forbidden source theorem ancestry: {bad}"
    logInfo m!"PASS source-only ancestry for {root}"
import IndependentScopeControl
namespace FullEIndependentReview
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open RigidityInitiality SourceRigidity
open HasEDependentSubstitutionControls (proofId)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- The ambient context itself requires actual E, independently of the R assumption. -/
theorem nonoriginal_context : CtxE [proofId] := .ext .nil (RigidityInitiality.FullE.has_form seed)
theorem context_not_original : ¬ Ctx [proofId] := by
  intro h
  cases h with
  | ext _ hD => exact HasETypeSubstitutionControls.beyond_original_image_not_formed hD

def ambientId : Ty := .identity proofId (.var 0) (.var 0)
def contextFamily : Ty := wk ambientId

theorem context_variable : HasE [proofId] (.var 0) proofId := by
  have hD := RigidityInitiality.FullE.has_form seed
  have h := HasE.var (RigidityInitiality.FullE.form_wk hD .nil hD) (Lookup.zero (A := proofId) (Γ := []))
  simpa only [wk, proofId_subst] using h

theorem ambientId_formed : FormE [proofId] ambientId := by
  have hD := RigidityInitiality.FullE.has_form context_variable
  exact .identity hD context_variable context_variable

theorem ambientId_seed : HasE [proofId] ident ambientId :=
  .identityIntro ambientId_formed context_variable context_variable (.refl _)

theorem contextFamily_formed : FormE [N, proofId] contextFamily :=
  RigidityInitiality.FullE.form_wk ambientId_formed nonoriginal_context
    (RigidityInitiality.FullE.N_form nonoriginal_context)

theorem contextFamily_at (n : Poly) : inst contextFamily n = ambientId := inst_wk ambientId n

theorem contextFamily_successor : successorFamily contextFamily = contextFamily := by
  simp only [successorFamily, contextFamily, wk, subst_comp]
  congr 1

theorem context_step : HasE [proofId] (abstract ident) (dependentStepType contextFamily) := by
  have h := HasE.piIntro
    (FormE.pi (RigidityInitiality.FullE.N_form nonoriginal_context)
      (RigidityInitiality.FullE.form_arr contextFamily_formed contextFamily_formed))
    (HasE.i contextFamily_formed (RigidityInitiality.FullE.form_arr contextFamily_formed contextFamily_formed))
    (scoped_abstract (show Scoped 2 ident from trivial))
  simpa only [dependentStepType, contextFamily_successor] using h

/-- Tests binding R then n while preserving the old ambient proof variable. -/
theorem ambient_uniform_section :
    HasE [proofId] (abstract (sectionPoly (pren Nat.succ ident) (pren Nat.succ (abstract ident))))
      (arr Rigidity (.pi N contextFamily)) :=
  RigidityInitiality.FullE.rigidity_implies_section nonoriginal_context contextFamily_formed
    ((contextFamily_at zero).symm ▸ ambientId_seed) context_step

theorem binder_indices : shiftedFamily contextFamily =
    .identity proofId (.var 2) (.var 2) := by
  simp only [shiftedFamily, contextFamily, ambientId, wk, subst, proofId_subst, psub, pup, pren]

theorem unshifted_capture_is_wrong : shiftedFamily contextFamily ≠
    .identity proofId (.var 1) (.var 1) := by
  rw [binder_indices]
  intro h
  cases h

/-- A separate genuinely dependent motive for J over the E-only carrier. -/
def jFamily : Ty := .identity (wk proofId) (.var 0) (.var 0)

theorem jFamily_formed : FormE [proofId, proofId] jFamily := by
  have hD := RigidityInitiality.FullE.has_form context_variable
  have hv : HasE [proofId, proofId] (.var 0) (wk proofId) :=
    .var (RigidityInitiality.FullE.form_wk hD nonoriginal_context hD) .zero
  exact .identity (RigidityInitiality.FullE.form_wk hD nonoriginal_context hD) hv hv

theorem jFamily_at (x : Poly) : inst jFamily x = .identity proofId x x := by
  simp only [jFamily, inst, subst, subst_wk_cancel, subst_id, psub, cons]

/-- Uses the port's actual two-binder J transport, in a context excluded from Ctx. -/
theorem j_transport_control : HasE [proofId] (jPoly ident (.var 0) ident) ambientId := by
  have hj := RigidityInitiality.FullE.transport_source nonoriginal_context
    (RigidityInitiality.FullE.has_form context_variable) jFamily_formed
    context_variable context_variable ambientId_seed
    (show HasE [proofId] ident (inst jFamily (.var 0)) from by
      simpa only [jFamily_at, ambientId] using ambientId_seed)
  simpa only [jFamily_at, ambientId] using hj

/-- J erasure is conversion in the unchanged calculus, not reflected equality. -/
theorem erased_j_control : HasE [proofId] ident ambientId := by
  have hj := RigidityInitiality.FullE.transport_has_erased nonoriginal_context
    (RigidityInitiality.FullE.has_form context_variable) jFamily_formed
    context_variable context_variable ambientId_seed
    (show HasE [proofId] ident (inst jFamily (.var 0)) from by
      simpa only [jFamily_at, ambientId] using ambientId_seed)
  simpa only [jFamily_at, ambientId] using hj

#print axioms ambient_uniform_section
#print axioms context_not_original
#print axioms binder_indices
#print axioms j_transport_control
#print axioms erased_j_control
end FullEIndependentReview
import GenericAuditControls
open MeasureTheory
example : ∀ b : Bool, (Measure.dirac false : Measure Bool) {b} ≠ 0 := by
  intro b
  cases b <;> norm_num
import ExplicitWinningRecord

noncomputable section
open MeasureTheory
open Orthemology.Tranche2.PolicyEmbedding
namespace HiddenParity.IndependentExplicit
open HiddenParity.Sufficiency HiddenParity.Stochastic HiddenParity.Necessity
universe u w
variable {S A : Type u} {M : Type w}
variable [Fintype S] [Fintype A] [DecidableEq S] [DecidableEq A] [Inhabited S] [DecidableEq M]
variable [MeasurableSpace S] [MeasurableSingletonClass S] [MeasurableSpace A] [MeasurableSingletonClass A]
variable (P : RationalKernel M (S × A) S) (menu : Finset M → S → Finset A)
variable (priority : M → (S × A) → Nat) (B : Finset M) (hB : B.Nonempty)
variable (s : S) (hs : s ∈ winningRegion P menu priority B) (d : S × A)
set_option linter.unusedSectionVars false

/-- This independent rfl probe expands all the way to the literal generator. -/
theorem literal_generator_field :
    (ExplicitController.winningRecord P menu priority B hB s hs d).policy =
      generatedPhasePolicy P menu priority B s (Classical.choose hB) d.2
        (empiricalReject P (ExplicitController.tolerance P B)) := rfl

theorem literal_dirac_field :
    (ExplicitController.winningRecord P menu priority B hB s hs d).seedLaw = Measure.dirac () := rfl

include hs in
theorem literal_generator_measurable :
    Measurable (fun z : Unit × History A S =>
      ExplicitController.policy P menu priority B hB s d z.1 z.2) :=
  (ExplicitController.winningRecord P menu priority B hB s hs d).measurable

include hs in
/-- The actual history law uses the literal generator and exact Dirac law. -/
theorem literal_generator_common_success :
    ∀ θ ∈ B, ∀ᵐ H ∂markovHistoryLaw P θ s
      (ExplicitController.policy P menu priority B hB s d) (Measure.dirac ()),
      ParitySuccess (priority θ) (historyAction d H) :=
  (ExplicitController.winningRecord P menu priority B hB s hs d).parity

include hs in
theorem literal_generator_lawful :
    Lawful P menu B s (ExplicitController.policy P menu priority B hB s d) (Measure.dirac ()) :=
  (ExplicitController.winningRecord P menu priority B hB s hs d).lawful

theorem tolerance_positive : 0 < ExplicitController.tolerance P B :=
  (Classical.choose_spec (finite_row_separation P B)).1

theorem policy_ignores_dummy_source (d' : S × A) (h : d.2 = d'.2) :
    ExplicitController.policy P menu priority B hB s d =
      ExplicitController.policy P menu priority B hB s d' := by
  unfold ExplicitController.policy
  rw [h]

end HiddenParity.IndependentExplicit
import RoundRobinSchedule
import HistoryStageSafety

noncomputable section
open MeasureTheory Filter
open Orthemology.Tranche2.PolicyEmbedding Orthemology.Tranche2.RecurrentSupport

namespace HiddenParity.Sufficiency
open HiddenParity.Stochastic HiddenParity.Adaptive HiddenParity.Necessity
universe u v
variable {State Action : Type u} {R : Type v}
variable [Fintype State] [Fintype Action] [DecidableEq State] [DecidableEq Action] [Inhabited State]
variable [MeasurableSpace R] [MeasurableSpace State] [MeasurableSingletonClass State]
variable [MeasurableSpace Action] [MeasurableSingletonClass Action]

/-- Current state read exclusively from actual observed receipts. -/
def observedState (s₀ : State) : History Action State → State
  | [] => s₀
  | (_,y) :: _ => y

/-- Prior departure count reconstructed from the complete observed history. -/
def historyVisits (s₀ s : State) : History Action State → ℕ
  | [] => 0
  | (_,_) :: h => historyVisits s₀ s h + if observedState s₀ h = s then 1 else 0

def retainedActions (E : Finset (State × Action)) (s : State) : Finset Action :=
  Finset.univ.filter (fun a => (s,a) ∈ E)

@[simp] theorem mem_retainedActions (E : Finset (State × Action)) (s : State) (a : Action) :
    a ∈ retainedActions E s ↔ (s,a) ∈ E := by simp [retainedActions]

theorem retainedActions_nonempty (E : Finset (State × Action)) (s : State)
    (hs : s ∈ usedStates Prod.fst E) : (retainedActions E s).Nonempty := by
  obtain ⟨e,he,hs⟩ := Finset.mem_image.mp hs
  exact ⟨e.2, (mem_retainedActions E s e.2).mpr (by simpa [← hs] using he)⟩

/-- One total, seed-independent causal policy, sharing no hidden-model input. -/
def roundRobinPolicy (E : Finset (State × Action)) (fallback : Action) (s₀ : State)
    (_ : R) (h : History Action State) : Action :=
  cycleAction (retainedActions E (observedState s₀ h)) fallback
    0

theorem roundRobinPolicy_measurable (E : Finset (State × Action)) (fallback : Action) (s₀ : State) :
    Measurable (fun z : R × History Action State => roundRobinPolicy E fallback s₀ z.1 z.2) := by
  exact (measurable_of_countable (fun h : History Action State => roundRobinPolicy E fallback s₀ () h)).comp measurable_snd

@[simp] theorem observedState_erase (s₀ : State) (h : History (State × Action) State) :
    observedState s₀ (erasePairSources h) = currentState s₀ h := by cases h <;> rfl

theorem roundRobin_pair_mem (E : Finset (State × Action)) (fallback : Action) (s₀ : State)
    (r : R) (h : History (State × Action) State) (hs : currentState s₀ h ∈ usedStates Prod.fst E) :
    pairPolicy s₀ (roundRobinPolicy E fallback s₀) r h ∈ E := by
  have hm := cycleAction_mem (retainedActions E (currentState s₀ h)) fallback
    (retainedActions_nonempty E _ hs) (historyVisits s₀ (currentState s₀ h) (erasePairSources h))
  simpa only [mem_retainedActions, pairPolicy, roundRobinPolicy, observedState_erase] using hm

/-- The reconstructed departure counter equals the pathwise visit counter on
actual runs, including the initial state's first departure. -/
theorem stack_historyVisits (s₀ s : State) (π : R → History Action State → Action)
    (z : R × FlatStack (State × Action) State) (n : ℕ) :
    historyVisits s₀ s (erasePairSources (stackHistoryTrajectory (pairPolicy s₀ π) z n)) =
      visitsBefore (fun k => (stackActionTrajectory (pairPolicy s₀ π) z k).1) s n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [stack_history_succ]
      simp only [erasePairSources, List.map_cons, historyVisits]
      rw [show List.map (fun z : (State × Action) × State => (z.1.2,z.2))
          (stackHistoryTrajectory (pairPolicy s₀ π) z n) =
          erasePairSources (stackHistoryTrajectory (pairPolicy s₀ π) z n) from rfl]
      rw [observedState_erase, ih]
      rfl

theorem stack_roundRobin_action (E : Finset (State × Action)) (fallback : Action) (s₀ : State)
    (z : R × FlatStack (State × Action) State) (n : ℕ) :
    let x := stackActionTrajectory (pairPolicy s₀ (roundRobinPolicy E fallback s₀)) z
    (x n).2 = cycleAction (retainedActions E (x n).1) fallback
      (visitsBefore (fun k => (x k).1) (x n).1 n) := by
  dsimp only
  rw [← stack_historyVisits]
  simp only [stackActionTrajectory, pairPolicy, roundRobinPolicy, observedState_erase]

/-- Every retained action at a recurrent source state is actually recurrent. -/
theorem stack_roundRobin_fair (E : Finset (State × Action)) (fallback : Action) (s₀ : State)
    (z : R × FlatStack (State × Action) State) (e : State × Action) (he : e ∈ E)
    (hs : e.1 ∈ usedStates Prod.fst
      (recurrentSet (stackActionTrajectory (pairPolicy s₀ (roundRobinPolicy E fallback s₀)) z))) :
    e ∈ recurrentSet (stackActionTrajectory (pairPolicy s₀ (roundRobinPolicy E fallback s₀)) z) := by
  let x := stackActionTrajectory (pairPolicy s₀ (roundRobinPolicy E fallback s₀)) z
  obtain ⟨f,hf,hfs⟩ := Finset.mem_image.mp hs
  have hRec : ∃ᶠ n in atTop, (x n).1 = e.1 :=
    ((mem_recurrentSet x f).mp hf).mono (fun n hn => by simpa [hn] using hfs)
  have ha : e.2 ∈ retainedActions E e.1 := (mem_retainedActions E e.1 e.2).mpr he
  have hBoth := cycle_every_action_recurrent (fun k => (x k).1) e.1
    (retainedActions E e.1) fallback hRec ⟨e.2,ha⟩
  apply (mem_recurrentSet x e).mpr
  apply hBoth.mono
  intro n hn
  apply Prod.ext hn.1
  rw [stack_roundRobin_action E fallback s₀ z n, hn.1]
  exact hn.2

end HiddenParity.Sufficiency
import ExplanatoryGeneration

/-!
The imported SupplyPath is CANDIDATE-rule ancestry. This file tests and repairs
that interface. A selected actual rule, instantiated endpoints, nonreflexive
exercise, and receipt completeness are distinct application obligations.
-/
namespace ActualUseControls
open ExplanatoryGeneration
universe u v
variable {R : Type u} {I : Type v}

def usedSupply (s : Supply R I) (used : I → Prop) : Supply R {i // used i} where
  original := s.original
  needs := fun i => s.needs i.1
  output := fun i => s.output i.1

def UsedReceipt (s : Supply R I) (used : I → Prop) (r : R) : Prop :=
  ∃ i, used i ∧ s.output i = r

def UsedSound (s : Supply R I) (used : I → Prop) (D : R → Prop) : Prop :=
  ∀ i, used i → D (s.output i) ∧ ∀ p, s.needs i p → D p

def SeedSound (s : Supply R I) (used : I → Prop) (D : R → Prop) : Prop :=
  ∀ r, s.original r → D r ∧ ¬ UsedReceipt s used r

-- At least one actual edge is required. Reflexive coverage is insufficient.
def PositiveUsedPath (s : Supply R I) (used : I → Prop) (a b : R) : Prop :=
  ∃ i p, used i ∧ s.needs i p ∧ s.output i = b ∧
    SupplyPath (usedSupply s used) a p

theorem positive_target_actual (s : Supply R I) (used : I → Prop) (D : R → Prop)
    (sound : UsedSound s used D) {a b} (path : PositiveUsedPath s used a b) : D b := by
  obtain ⟨i, p, hi, _, out, _⟩ := path
  rw [← out]; exact (sound i hi).1

theorem actual_anchor_original_witness (s : Supply R I) (used : I → Prop)
    (D : R → Prop) (sound : UsedSound s used D) (seeds : SeedSound s used D)
    (nonempty : NoEmptyRules (usedSupply s used)) {target}
    (anchor : ∃ q, Generated (usedSupply s used) q ∧ PositiveUsedPath s used q target) :
    D target ∧ ∃ o, D o ∧ s.original o ∧ ¬ UsedReceipt s used o ∧
      PositiveUsedPath s used o target := by
  obtain ⟨q, hq, qt⟩ := anchor
  obtain ⟨o, ho, oq⟩ := generated_has_relevant_original (usedSupply s used) nonempty hq
  obtain ⟨i, p, hi, hp, out, qp⟩ := qt
  have ot : PositiveUsedPath s used o target :=
    ⟨i, p, hi, hp, out, SupplyPath.trans oq qp⟩
  exact ⟨positive_target_actual s used D sound ot,
    o, (seeds o ho).1, ho, (seeds o ho).2, ot⟩

theorem positive_target_has_used_receipt (s : Supply R I) (used : I → Prop)
    {a b} (path : PositiveUsedPath s used a b) : UsedReceipt s used b := by
  obtain ⟨i, _, hi, _, out, _⟩ := path
  exact ⟨i, hi, out⟩

theorem positive_original_is_distinct_from_target (s : Supply R I)
    (used : I → Prop) (D : R → Prop) (seeds : SeedSound s used D)
    {o target} (original : s.original o) (path : PositiveUsedPath s used o target) :
    o ≠ target := by
  intro eq
  have rec := positive_target_has_used_receipt s used path
  rw [← eq] at rec
  exact (seeds o original).2 rec

-- Nonreceipt of graph supply is not whole-existence nonreceipt unless every
-- such receipt has been included. This is a conditional interface, not proof
-- that all grounds are productive rules.
theorem whole_nonreceipt_needs_complete_representation
    (s : Supply R I) (used : I → Prop) (wholeReceived : R → Prop)
    (complete : ∀ r, wholeReceived r → UsedReceipt s used r)
    {r} (noSupply : ¬ UsedReceipt s used r) : ¬ wholeReceived r :=
  fun h => noSupply (complete r h)

inductive Node where | seed | blocker | live (n : Nat) | target
  deriving DecidableEq, Repr
inductive Rule where | dormant | flow (n : Nat) | terminal
  deriving DecidableEq, Repr

def dormantModel : Supply Node Rule where
  original := fun r => r = .seed
  needs := fun i r => match i with
    | .dormant => r = .seed ∨ r = .blocker
    | .flow n => r = .live (n+1)
    | .terminal => r = .live 0
  output := fun i => match i with
    | .dormant => .target
    | .flow n => .live n
    | .terminal => .target

def liveAvailable : Node → Prop | .blocker => False | _ => True
def actuallyUsed : Rule → Prop | .dormant => False | _ => True

theorem dormant_local_fixed : LocalFixed dormantModel liveAvailable := by
  intro r
  cases r with
  | seed =>
    constructor
    · intro _; exact Or.inl rfl
    · intro _; trivial
  | blocker =>
    constructor
    · intro h; exact False.elim h
    · intro h
      rcases h with h | ⟨i, hi, _⟩
      · cases h
      · cases i <;> cases hi
  | live n =>
    constructor
    · intro _; exact Or.inr ⟨.flow n, rfl, by
        intro p hp; change p = .live (n+1) at hp; subst p; trivial⟩
    · intro _; trivial
  | target =>
    constructor
    · intro _; exact Or.inr ⟨.terminal, rfl, by
        intro p hp; change p = .live 0 at hp; subst p; trivial⟩
    · intro _; trivial

theorem dormant_used_sound : UsedSound dormantModel actuallyUsed liveAvailable := by
  intro i hi
  cases i with
  | dormant => exact False.elim hi
  | flow n =>
    refine ⟨trivial, ?_⟩
    intro p hp; change p = .live (n+1) at hp; subst p; trivial
  | terminal =>
    refine ⟨trivial, ?_⟩
    intro p hp; change p = .live 0 at hp; subst p; trivial

theorem dormant_seed_sound : SeedSound dormantModel actuallyUsed liveAvailable := by
  intro r hr
  change r = .seed at hr; subst r
  refine ⟨trivial, ?_⟩
  intro h; obtain ⟨i, _, out⟩ := h
  cases i <;> cases out

theorem dormant_syntactic_anchor :
    liveAvailable Node.seed ∧ liveAvailable Node.target ∧ Generated dormantModel Node.seed ∧
    SupplyPath dormantModel Node.seed Node.target := by
  exact ⟨trivial, trivial, Generated.original rfl,
    SupplyPath.step (s := dormantModel) Rule.dormant (SupplyPath.refl Node.seed) (Or.inl rfl)⟩

theorem dormant_rule_disabled :
    ¬ actuallyUsed .dormant ∧ ¬ (∀ p, dormantModel.needs .dormant p → liveAvailable p) := by
  refine ⟨id, ?_⟩
  intro h; exact h .blocker (Or.inr rfl)

theorem used_seed_path_stays_seed {r}
    (path : SupplyPath (usedSupply dormantModel actuallyUsed) .seed r) : r = .seed := by
  induction path with
  | refl => rfl
  | step i _ hp ih =>
    subst_vars
    rcases i with ⟨i, hi⟩
    cases i with
    | dormant => exact False.elim hi
    | flow n => cases hp
    | terminal => cases hp

theorem no_actual_seed_path_to_live_target :
    ¬ PositiveUsedPath dormantModel actuallyUsed .seed .target := by
  intro h
  obtain ⟨i, p, hi, hp, _, path⟩ := h
  have eq := used_seed_path_stays_seed path
  subst p
  cases i with
  | dormant => exact False.elim hi
  | flow n => cases hp
  | terminal => cases hp

-- An acyclic actual supply can enter a designated inductive seed. Thus seed
-- membership and even generated availability are not actual nonreceipt.
def overlappingSeeds : Supply Bool Unit where
  original := fun _ => True
  needs := fun _ r => r = true
  output := fun _ => false

theorem seed_can_receive_actual_supply :
    Generated overlappingSeeds false ∧ UsedReceipt overlappingSeeds (fun _ => True) false ∧
    ¬ SeedSound overlappingSeeds (fun _ => True) (fun _ => True) := by
  have receipt : UsedReceipt overlappingSeeds (fun _ => True) false := ⟨(), trivial, rfl⟩
  exact ⟨Generated.original trivial, receipt, fun h => (h false trivial).2 receipt⟩

theorem overlap_has_only_distinct_supply_endpoints :
    ∀ i p, overlappingSeeds.needs i p → p ≠ overlappingSeeds.output i := by
  intro i p hp
  change p = true at hp; subst p
  change true ≠ false
  decide

end ActualUseControls
import Mathlib

/-!
# An existence-aware audit of a bounded backwards history

The affine-history mechanism is a transparent reconstruction of a contractive
example, not a formalization of all of Billon's explanatory theory. It establishes
genuine infinite property determination. The Option lift then distinguishes an
absent bearer from a present bearer having a numerical value.

The empty fixed point is not asserted to be the actual state or a metaphysically
possible world. No least-fixed-point or causal-foundation axiom is assumed.
-/

namespace Orthemology.Tranche3.ExistenceAwareHistory

noncomputable section

def HalfHistory (c : ℝ) (x : ℕ → ℝ) : Prop :=
  ∀ n, x n = (x (n + 1) + c) / 2

theorem backwards_deviation (c : ℝ) (x : ℕ → ℝ) (h : HalfHistory c x)
    (n k : ℕ) : x (n + k) - c = 2 ^ k * (x n - c) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hs : x (n + k + 1) - c = 2 * (x (n + k) - c) := by
        have hh := h (n + k)
        linarith
      simpa [Nat.add_assoc, pow_succ, ih, mul_comm, mul_left_comm, mul_assoc] using hs

/-- Infinite bounded backwards histories really determine their state values.
This grants the property-explanation mechanism, rather than assuming that an
infinite arrangement can never add explanatory restrictions. -/
theorem bounded_history_constant (c M : ℝ) (x : ℕ → ℝ)
    (h : HalfHistory c x) (bounded : ∀ n, |x n - c| ≤ M) :
    ∀ n, x n = c := by
  intro n
  by_contra hn
  have hd : 0 < |x n - c| := abs_pos.mpr (sub_ne_zero.mpr hn)
  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (M / |x n - c|) (by norm_num : (1 : ℝ) < 2)
  have hlarge : M < 2 ^ k * |x n - c| := (div_lt_iff₀ hd).mp hk
  have hb := bounded (n + k)
  rw [backwards_deviation c x h n k, abs_mul,
    abs_of_nonneg (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) k)] at hb
  linarith

/-- Without the bound every real deviation generates a backwards history. -/
theorem unbounded_family (c d : ℝ) :
    HalfHistory c (fun n => c + 2 ^ n * d) := by
  intro n
  simp only [pow_succ]
  ring

theorem nonconstant_unbounded_control (c : ℝ) :
    HalfHistory c (fun n => c + 2 ^ n) ∧
      (fun n => c + 2 ^ n) ≠ (fun _ => c) := by
  constructor
  · simpa using unbounded_family c 1
  · intro heq
    have hh := congrFun heq 0
    norm_num at hh

def liftHalf (c : ℝ) : Option ℝ → Option ℝ :=
  fun x => some ((x.getD c + c) / 2)

def LiftedHistory (c : ℝ) (h : ℕ → Option ℝ) : Prop :=
  ∀ n, h n = liftHalf c (h (n + 1))

def ConditionallyBounded (c M : ℝ) (h : ℕ → Option ℝ) : Prop :=
  ∀ n x, h n = some x → |x - c| ≤ M

theorem absent_history (c : ℝ) :
    LiftedHistory c (fun _ => none) ∧
      ConditionallyBounded c 0 (fun _ => none) := by
  simp [LiftedHistory, liftHalf, ConditionallyBounded]

theorem present_history (c : ℝ) :
    LiftedHistory c (fun _ => some c) ∧
      ConditionallyBounded c 0 (fun _ => some c) := by
  constructor
  · intro n
    change some c = some ((c + c) / 2)
    congr 1
    ring
  · intro n x hx
    have hcx : c = x := Option.some.inj hx
    subst x
    simp

theorem absence_iff_next (c : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (n : ℕ) :
    h n = none ↔ h (n + 1) = none := by
  rw [hr n]
  cases h (n + 1) <;> simp [liftHalf]

/-- Absence cannot be mixed with presence along this particular backwards law. -/
theorem same_absence_profile (c : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (n : ℕ) : h n = none ↔ h 0 = none := by
  induction n with
  | zero => rfl
  | succ n ih =>
      exact (absence_iff_next c h hr n).symm.trans ih

/-- There are exactly two bounded profiles after an explicit absence lift:
all absent, or all present at the uniquely determined property value. -/
theorem bounded_lifted_classification (c M : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (hm : 0 ≤ M)
    (hb : ConditionallyBounded c M h) :
    (∀ n, h n = none) ∨ (∀ n, h n = some c) := by
  let x : ℕ → ℝ := fun n => (h n).getD c
  have hx : HalfHistory c x := by
    intro n
    change (h n).getD c = ((h (n + 1)).getD c + c) / 2
    rw [hr n]
    cases hh : h (n + 1) with
    | none =>
        change c = (c + c) / 2
        ring
    | some y => rfl
  have hxb : ∀ n, |x n - c| ≤ M := by
    intro n
    cases hh : h n with
    | none => simpa [x, hh] using hm
    | some y => simpa [x, hh] using hb n y hh
  have hxc := bounded_history_constant c M x hx hxb
  by_cases hz : h 0 = none
  · exact Or.inl (fun n => (same_absence_profile c h hr n).mpr hz)
  · right
    intro n
    cases hh : h n with
    | none => exact False.elim (hz ((same_absence_profile c h hr n).mp hh))
    | some y =>
        have hy : y = c := by simpa [x, hh] using hxc n
        exact congrArg some hy

/-- Exact existential separation: both candidates obey the same lifted law and
conditional bound. This does not say that the absent one is actual. -/
theorem two_existence_profiles (c : ℝ) :
    ∃ h₀ h₁ : ℕ → Option ℝ,
      LiftedHistory c h₀ ∧ ConditionallyBounded c 0 h₀ ∧
      LiftedHistory c h₁ ∧ ConditionallyBounded c 0 h₁ ∧
      (∀ n, h₀ n = none) ∧ (∀ n, h₁ n = some c) ∧ h₀ ≠ h₁ := by
  refine ⟨(fun _ => none), (fun _ => some c),
    (absent_history c).1, (absent_history c).2,
    (present_history c).1, (present_history c).2, ?_, ?_, ?_⟩
  · intro n; rfl
  · intro n; rfl
  · intro hh
    have hn := congrFun hh 0
    cases hn

/-- The general audit has no assumption that the configuration is finite,
discrete, singly borne, or described by a well-founded dependency graph. -/
theorem absence_preserving_not_unique_active {H : Type*}
    (T : H → H) (empty active : H)
    (preserves : T empty = empty) (realized : T active = active)
    (different : active ≠ empty) :
    ¬ ∃! h, T h = h := by
  rintro ⟨h, _, unique⟩
  exact different ((unique active realized).trans (unique empty preserves).symm)

/-- Adding a distinct preserved absence state cannot retain global strict
contractivity in an ordinary metric. Thus the audit does not pretend to preserve
every premise of a Banach argument when it changes the state space. -/
theorem no_global_contraction_with_preserved_absence {H : Type*} [MetricSpace H]
    (T : H → H) (empty active : H)
    (preserves : T empty = empty) (realized : T active = active)
    (different : active ≠ empty) (K : NNReal) :
    ¬ ContractingWith K T := by
  intro hc
  exact different (hc.fixedPoint_unique' realized preserves)

/-- Selecting the active profile by a separate existential constraint is
consistent; it does not convert the constraint into a consequence of the law. -/
theorem active_profile_satisfies_existence (c : ℝ) :
    LiftedHistory c (fun _ => some c) ∧
      ConditionallyBounded c 0 (fun _ => some c) ∧
      ∃ n : ℕ, ∃ x, (fun _ : ℕ => (some c : Option ℝ)) n = some x := by
  exact ⟨(present_history c).1, (present_history c).2, 0, c, rfl⟩

#print axioms backwards_deviation
#print axioms bounded_history_constant
#print axioms nonconstant_unbounded_control
#print axioms two_existence_profiles
#print axioms bounded_lifted_classification
#print axioms absence_preserving_not_unique_active
#print axioms no_global_contraction_with_preserved_absence
#print axioms active_profile_satisfies_existence

end
end Orthemology.Tranche3.ExistenceAwareHistory
