/-! Computational definitions are outside classical sections. Only their
correctness proofs use the frozen mathematical recurrence. -/
namespace GuardedTree.Mutated
open Saturation
variable {J E R : Type*} [DecidableEq E] (G : Grammar J E R) [Fintype R]

/-- Explicit finite enumeration; does not use the predecessor's classical
`Fintype (RuleChoice G)` instance. Empty arity has one empty ordered tuple. -/
def choices : Finset (RuleChoice G) :=
  Finset.univ.sigma fun r => Fintype.piFinset fun _ : Fin (G.arity r) =>
    (grammarSupport G).powerset.attach

theorem mem_choices (x : RuleChoice G) : x ∈ choices G := by
  simp [choices]

section Decidable
variable [DecidableEq J] [gd : ∀ r s, Decidable (G.guard r s)]

instance enabledDecidable (D : Table (J := J) (E := E)) (x : RuleChoice G) :
    Decidable (enabled G D x) :=
  inferInstanceAs (Decidable ((∀ i, (D (G.premise x.1 i) (x.2 i).val).isSome) ∧
    G.guard x.1 (fun i => (x.2 i).val)))

/-- Retains the old exact key and evaluates all enabled ordered rule tuples. -/
def candidates (D : Table (J := J) (E := E)) (q : J) (S : Finset E) : Finset ℚ :=
  (D q S).toFinset ∪
    (((choices G).filter (fun x =>
      (∀ i, (D (G.premise x.1 i) (x.2 i).val).isSome) ∧ G.head x.1 = q ∧ outputSupport G x = S)).image (outputCost G D))

/-- Computational finite minimum: decidable nonemptiness and rational order. -/
def minimum (A : Finset ℚ) : Option ℚ :=
  if h : A.Nonempty then some (A.min' h) else none

def step (D : Table (J := J) (E := E)) : Table (J := J) (E := E) :=
  fun q S => minimum (candidates G D q S)

def round : ℕ → Table (J := J) (E := E)
  | 0 => fun _ _ => none
  | h + 1 => step G (round h)

theorem candidates_eq (D : Table (J := J) (E := E)) (q : J) (S : Finset E) :
    candidates G D q S = Saturation.candidates G D q S := by
  classical
  have hc : choices G = Finset.univ := Finset.eq_univ_of_forall (mem_choices G)
  ext c
  simp [candidates, Saturation.candidates, hc]

theorem minimum_eq (A : Finset ℚ) : minimum A = Saturation.minimum A := by
  classical
  simp only [minimum, Saturation.minimum]

theorem step_eq (D : Table (J := J) (E := E)) : step G D = Saturation.step G D := by
  funext q S
  simp only [step, Saturation.step, candidates_eq, minimum_eq]

theorem round_eq (h : ℕ) : round G h = Saturation.round G h := by
  induction h with
  | zero => rfl
  | succ h ih => simp only [round, Saturation.round, ih, step_eq]

#print axioms candidates_eq
#print axioms round_eq
end Decidable
end GuardedTree.Mutated
import TypeInhabitationSearch
import Lean
namespace ActualSourceEnumerability.Controls
open Encodable JointCertificates P01AC P01D AuxiliaryCertificates CodedRuleTemplates
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000

def empty : DerivationCertificate := .node .CtxJ_nil []
def raw : DerivationCertificate := .node (.FormJ_raw []) [empty]
def bottom : DerivationCertificate := .node (.FormJ_bottom []) [empty]
def extension : DerivationCertificate := .node (.CtxJ_ext [] .raw) [empty, raw]
def missing : DerivationCertificate := .node (.CtxJ_ext [] .raw) [empty]
def extra : DerivationCertificate := .node (.CtxJ_ext [] .raw) [empty, raw, empty]
def swapped : DerivationCertificate := .node (.CtxJ_ext [] .raw) [raw, empty]
def rawAtom : DerivationCertificate := .node (.HasJ_rawAtom [] .i) [raw]
def falseConversion : DerivationCertificate :=
  .node (.HasJ_conv [] .raw (.atom .i) (.atom .zero) (.refl (.atom .i))) [raw, rawAtom]
def fullSupport : Rule :=
  .HasJ_finite (.arrow (.var 0) (.var 0)) [] .i [.raw, .bottom] (.i (.var 0))
def droppedUnusedImage : DerivationCertificate := .node fullSupport [raw]

local macro "source_decide" : tactic => `(tactic|
  (simp only [check, Certificate.checkRoot, Certificate.check_node,
    empty, raw, bottom, extension, missing, extra, swapped, rawAtom, falseConversion,
    fullSupport, droppedUnusedImage, Certificate.rule, List.map_cons, List.map_nil,
    List.all_cons, List.all_nil, Rule.checkSide, Rule.premises, Rule.conclusion,
    Bool.true_and, Bool.and_true, Bool.false_and, Bool.and_false, decide_true, decide_false] <;> decide))

theorem acceptEmpty : checkCanonical (encode (Claim.ctxJ [])) (encodeCertificate empty) = true := by
  rw [checkCanonical_encode]; source_decide
theorem acceptExtension : checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate extension) = true := by
  rw [checkCanonical_encode]; source_decide
theorem rejectMissing : checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate missing) = false := by
  rw [checkCanonical_encode]; source_decide
theorem rejectExtra : checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate extra) = false := by
  rw [checkCanonical_encode]; source_decide
/-- This swaps DISTINCT claims. No claim is made that swapping interchangeable
    certificates of the same claim must be rejected. -/
theorem rejectDistinctSwap : checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate swapped) = false := by
  rw [checkCanonical_encode]; source_decide
theorem rejectWrongRoot : checkCanonical (encode (Claim.ctxE [])) (encodeCertificate empty) = false := by
  rw [checkCanonical_encode]; source_decide
theorem rejectFalseConversion : checkCanonical (encode (.hasJ [] (.atom .zero) .raw : Claim))
    (encodeCertificate falseConversion) = false := by
  rw [checkCanonical_encode]; source_decide
/-- Both images remain, including the bottom image unused by the finite type. -/
theorem fullSupportPremises : premisesCode (encode fullSupport) =
    ([.formJ [] .raw, .formJ [] .bottom, .formJ [] (.pi .raw .raw)] : List Claim).map encode := by
  rw [premisesCode_exact]; rfl
theorem rejectDroppedUnusedImage : checkCanonical (encode fullSupport.conclusion)
    (encodeCertificate droppedUnusedImage) = false := by
  rw [checkCanonical_encode]; source_decide

theorem rejectInvalidClaim (c : Nat) (h : CertificateCodeValidity.certValid 11 0 = false) :
    checkCanonical 0 c = false := by simp only [checkCanonical, h, Bool.false_and]

theorem rejectClaimZero : CertificateCodeValidity.certValid 11 0 = false := by
  rw [CertificateCodeValidity.certValid, ExactSyntaxValidity.evaluate]
  decide

theorem rejectCertZero : CertificateCodeValidity.certValid 13 0 = false := by
  rw [CertificateCodeValidity.certValid, ExactSyntaxValidity.evaluate]
  decide

theorem malformedClaimRejectsEveryCertificate (c : Nat) : checkCanonical 0 c = false :=
  rejectInvalidClaim c rejectClaimZero

theorem malformedCertificateRejectsEveryClaim (q : Nat) : checkCanonical q 0 = false := by
  simp only [checkCanonical, rejectCertZero, Bool.and_false, Bool.false_and]

-- Supplied certificate evaluation, not execution of unbounded search.
#eval checkCanonical (encode (Claim.ctxJ [])) (encodeCertificate empty)
#eval checkCanonical (encode (Claim.ctxE [])) (encodeCertificate empty)
#eval checkCanonical 0 (encodeCertificate empty)
#eval checkCanonical (encode (Claim.ctxJ [])) 0
#eval checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate extension)
#eval checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate missing)
#eval checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate extra)
#eval checkCanonical (encode (Claim.ctxJ [.raw])) (encodeCertificate swapped)

#print axioms acceptEmpty
#print axioms acceptExtension
#print axioms rejectMissing
#print axioms rejectExtra
#print axioms rejectDistinctSwap
#print axioms rejectWrongRoot
#print axioms rejectFalseConversion
#print axioms fullSupportPremises
#print axioms rejectDroppedUnusedImage
#print axioms malformedClaimRejectsEveryCertificate
#print axioms malformedCertificateRejectsEveryClaim
end ActualSourceEnumerability.Controls
import CheckedTargetOperation

noncomputable section
open MeasureTheory ProbabilityTheory Filter
open Orthemology.Tranche2
open HiddenParity.Recurrence
open scoped ENNReal BigOperators

namespace RecurrenceIndependentReview
abbrev Two := Fin 2

def biasedChain : FiniteChain Two where
  prob s t := if s = 0 then (if t = 0 then 3/4 else 1/4) else (if t = 0 then 1 else 0)
  nonnegative s t := by split_ifs <;> norm_num
  normalized s := by fin_cases s <;> norm_num [Fin.sum_univ_two]

/-- One coordinate includes the initial state, not one future transition. -/
theorem initial_coordinate_checked :
    avoid biasedChain 0 1 0 = 0 ∧ avoid biasedChain 1 1 0 = 1 := by
  norm_num [avoid, biasedChain, Fin.sum_univ_two]

theorem weighted_second_and_third_coordinates :
    avoid biasedChain 1 2 0 = 3/4 ∧ avoid biasedChain 1 3 0 = 9/16 := by
  norm_num [avoid, biasedChain, Fin.sum_univ_two]

theorem actual_initial_integral (target start : Two) :
    (∫⁻ x, pathAvoid target 0 1 x ∂markovTrajectory (transitionKernel biasedChain) start) =
      ENNReal.ofReal (avoid biasedChain target 1 start) := by
  rw [trajectory_integral_prefix (transitionKernel biasedChain) (pathAvoid target 0 1)
    (pathAvoid_measurable target 0 1) 0 (pathAvoid_depends target 0 0) start]
  exact lmarginal_pathAvoid biasedChain target 0 0 (fun _ => start)

theorem actual_initial_index_distinguishes_target :
    (∫⁻ x, pathAvoid 0 0 1 x ∂markovTrajectory (transitionKernel biasedChain) 0) = 0 ∧
    (∫⁻ x, pathAvoid 1 0 1 x ∂markovTrajectory (transitionKernel biasedChain) 0) = 1 := by
  rw [actual_initial_integral, actual_initial_integral,
    initial_coordinate_checked.1, initial_coordinate_checked.2]
  norm_num

theorem biased_strong : ∀ s t, Relation.ReflTransGen
    (fun s t => 0 < biasedChain.prob s t) s t := by
  intro s t
  fin_cases s <;> fin_cases t
  all_goals first
    | exact Relation.ReflTransGen.refl
    | apply Relation.ReflTransGen.single; norm_num [biasedChain]

theorem biased_all_recur :
    ∀ᵐ x ∂markovTrajectory (transitionKernel biasedChain) 0,
      ∀ t, ∃ᶠ n in atTop, x n = t :=
  all_states_recur_almost_surely biasedChain 0 biased_strong

theorem biased_geometric_bound (k : ℕ) (s : Two) :
    avoid biasedChain 1 (k*2) s ≤ (3/4 : ℝ)^k := by
  apply avoid_blocks_bound biasedChain 1 2 (3/4) (by norm_num)
  intro t
  fin_cases t <;> norm_num [avoid, biasedChain, Fin.sum_univ_two]

#print axioms initial_coordinate_checked
#print axioms weighted_second_and_third_coordinates
#print axioms actual_initial_integral
#print axioms actual_initial_index_distinguishes_target
#print axioms biased_strong
#print axioms biased_all_recur
#print axioms biased_geometric_bound
end RecurrenceIndependentReview
import DeterministicContinuation
