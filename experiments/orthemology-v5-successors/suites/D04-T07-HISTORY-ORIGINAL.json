  "targets": [
    {
      "id": "target-1",
      "source_id": "D04-SRC-1742c264e034bb76f7a4",
      "declaration": "theorem finite_history_safety {n} (c : Config n) (table : Table)\n    {s : State n} {events : List (Event n)}\n    (trace : Trace c (Initial c table) events s) :\n    Consistent c s ∧ s.damaged = false ∧ AuthorizedTrace c (Initial c table) events s := by\n  have init := consistent_initial c table\n  exact ⟨consistent_trace init trace,\n    trace_safe init rfl trace, trace_writes_authorized init trace⟩\n\n/-- Direct universal form for the actual reached pre-state of any finite prefix;\n    no choice of a second trace or an existential success certificate is needed. -/",
      "target_sha256": "7d915e227d32c6b72fea821860950aacd35e1af123863e34ab7e1484ef206419",
      "domain": "UNBOUNDED_MODEL",
      "calculus": "OTHER"
    },
    {
      "id": "target-2",
      "source_id": "D04-SRC-3952d475f5f17ac9323d",
      "declaration": "theorem no_landing_after_cancellation {n} {c : Config n} {s t : State n}\n    {as : List (Event n)} (reachable : Reachable c s) (trace : Trace c s as t)\n    (k : Command n) (requester : Nat) (closed : Cancelled c s k) :\n    ¬Lands c t k requester := by\n  exact cancelled_cannot_land (consistent_trace (reachable_consistent reachable) trace)\n    k requester (trace_cancelled trace k closed)\n\n/-- Exact payload binding is an explicit consequence, not a separate assumption. -/",
      "target_sha256": "a6ec9a7db106a4596024d22de22959af738f23480df4be7db55770a2fbfb78d5",
      "domain": "UNBOUNDED_MODEL",
      "calculus": "OTHER"
    },
    {
      "id": "target-3",
      "source_id": "D04-SRC-1742c264e034bb76f7a4",
      "declaration": "theorem stable_trace_preserves_goal {n} {c : Config n} {s t : State n}\n    {events : List (Event n)} (h : Consistent c s) (restored : Restored c s)\n    (trace : Trace c s events t) (stable : s.epoch = t.epoch) : Restored c t := by\n  induction trace with\n  | nil => exact restored\n  | @cons s u t a as step tail ih =>\n    have su := step_epoch step\n    have ut := trace_epoch tail\n    have same : s.epoch = u.epoch := by omega\n    exact ih (consistent_step h step) (step_restored h restored step same) (by omega)",
      "target_sha256": "c102e157e040456b73a62650751d0420856c6dc961e5dd51b6ed9d93764a8cbf",
      "domain": "UNBOUNDED_MODEL",
      "calculus": "OTHER"
    }
  ],
