end HiddenParity.IndependentOracle

def main : IO Unit := do
  for (i,c) in HiddenParity.IndependentOracle.cases.zipIdx |>.map (fun (c,i) => (i,c)) do
    let (out,tgt) := HiddenParity.IndependentOracle.solve c
    IO.println s!"{i},{out},{tgt}"
import NativeCheckerBridge
set_option maxRecDepth 200000
set_option maxHeartbeats 0
open P03Source OrthemologyV2 OrthemologyV3
