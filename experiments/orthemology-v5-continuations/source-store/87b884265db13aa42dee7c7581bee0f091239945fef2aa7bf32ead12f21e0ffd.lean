import Q8ObserverAbstraction
import UniformComputabilityMachine

/-! Generated-byte and explicit-stack-runtime crosswalk. This uses the exact
recovered P02 source parser and runtime, not a replacement language or assumed
source/Mealy law equality. It does not model Python metering or host failures. -/
namespace Orthemology.CertifiedObserver.ParsedQ8
open Orthemology.Frontier Orthemology.Frontier.MealyMeasure
open P02A2.Q8Machine P02.Codec P02.Codec.UniformComputability
open Set MeasureTheory
open scoped ENNReal

/-- Literal Q8 compiled source in the recovered binary program envelope. -/
def packed {n : ℕ} (M : Machine n) : PackedProgram :=
  ⟨2, 2, P02A2.Q8Compiler.compiled M⟩

def code {n : ℕ} (M : Machine n) : ℕ := programIndex (packed M)

theorem decoded_source_exact {n : ℕ} (M : Machine n) :
    decodeIndex (code M) = some (packed M) := decodeIndex_programIndex _

theorem generated_bytes_exact {n : ℕ} (M : Machine n) :
    decodeBytes (encodeBytes (packed M)) = some (packed M) := decodeBytes_encodeBytes _

def observer {n : ℕ} (M : Machine n) : Cantor → Cantor :=
  P02A2.ObserverCore.output (evaluateIndex (code M))

theorem parsed_output_compiled {n : ℕ} (M : Machine n) :
    observer M = P02A2.Q8Compiler.compiledObserver M := by
  funext x k
  unfold observer P02A2.Q8Compiler.compiledObserver P02A2.ObserverCore.output
  rw [evaluateIndex, decoded_source_exact]
  simp only [packed, ↓reduceIte, Nat.mod_mod]
  rfl

/-- Generated bytes, actual decoding, source execution, and Q8 Mealy ticks
are one exact complete-stream equation. -/
theorem parsed_output_mealy {n : ℕ} (M : Machine n) (hn : 0 < n) :
    observer M = output (Q8.observer M) (initial n hn) := by
  rw [parsed_output_compiled, Q8.compiled_output M hn]

noncomputable def law {n : ℕ} (M : Machine n) : Measure Cantor :=
  P02A2.Q8Measure.fairCantor.map (observer M)

theorem parsed_law_compiled {n : ℕ} (M : Machine n) :
    law M = P02A2.Q8Compiler.compiledLaw M := by
  unfold law P02A2.Q8Compiler.compiledLaw
  rw [parsed_output_compiled]

theorem parsed_finite_solver {n : ℕ} (M : Machine n) (hn : 0 < n)
    {T : Type*} [Fintype T] [DecidableEq T] [Nonempty T] (A : Mealy T)
    (R : Simulation (Q8.observer M) A) (t : T)
    (initial_rel : R.relates (initial n hn) t) :
    (solveDefect A t : ℝ) = P02A2.defect (law M) := by
  rw [parsed_law_compiled]
  exact Q8.compiled_finite_solver M hn A R t initial_rel

def inputWord (x : Cantor) (k : ℕ) : ℕ :=
  P02A2.ObserverCore.sentinel (List.ofFn (fun i : Fin (k+1) => x i.val))

/-- Fuel failure stays none. It is not converted to a zero bit. -/
def runtimeTick {n : ℕ} (fuel : ℕ) (M : Machine n) (x : Cantor) (k : ℕ) : Option Bool :=
  (evaluateIndexFuel fuel (code M) k (inputWord x k)).map (fun v => decide (v % 2 = 1))

theorem runtime_tick_sound {n : ℕ} (M : Machine n) (hn : 0 < n)
    (fuel : ℕ) (x : Cantor) (k : ℕ) (b : Bool)
    (h : runtimeTick fuel M x k = some b) :
    b = output (Q8.observer M) (initial n hn) x k := by
  obtain ⟨v,hv,hb⟩ := Option.map_eq_some_iff.mp h
  have he := evaluateIndexFuel_sound hv
  subst v
  rw [← parsed_output_mealy M hn]
  exact hb.symm

theorem runtime_tick_complete {n : ℕ} (M : Machine n) (hn : 0 < n)
    (x : Cantor) (k : ℕ) : ∃ fuel, ∀ more, fuel ≤ more →
      runtimeTick more M x k = some (output (Q8.observer M) (initial n hn) x k) := by
  obtain ⟨f,hf⟩ := evaluateIndexFuel_eventually (code M) k (inputWord x k)
  refine ⟨f, fun more hm => ?_⟩
  unfold runtimeTick
  rw [hf more hm, ← parsed_output_mealy M hn]
  rfl

/-- One finite budget suffices for a chosen finite trace. There is no claim
that one budget suffices for every stage of the infinite process. -/
theorem runtime_finite_trace {n : ℕ} (M : Machine n) (hn : 0 < n)
    (x : Cantor) (N : ℕ) : ∃ fuel, ∀ more, fuel ≤ more → ∀ k, k < N →
      runtimeTick more M x k = some (output (Q8.observer M) (initial n hn) x k) := by
  induction N with
  | zero => exact ⟨0, by intro more hm k hk; omega⟩
  | succ N ih =>
      obtain ⟨f,hf⟩ := ih
      obtain ⟨g,hg⟩ := runtime_tick_complete M hn x N
      refine ⟨max f g, fun more hm k hk => ?_⟩
      by_cases he : k = N
      · subst k
        exact hg more ((le_max_right f g).trans hm)
      · exact hf more ((le_max_left f g).trans hm) k (by omega)

namespace Fixtures
open Orthemology.Frontier.MealyMeasure.Fixtures Q8.Fixtures

theorem grow_parsed_solver :
    (solveDefect zeroMachine () : ℝ) = P02A2.defect (law grow) :=
  parsed_finite_solver grow (by decide) zeroMachine growSimulation () rfl

theorem halt_parsed_solver :
    (solveDefect copyMachine () : ℝ) = P02A2.defect (law haltNow) :=
  parsed_finite_solver haltNow (by decide) copyMachine haltSimulation () True.intro

/-- Zero fuel cannot issue a semantic bit for a valid generated program. -/
theorem zero_fuel_is_not_zero {n : ℕ} (M : Machine n) (x : Cantor) (k : ℕ) :
    runtimeTick 0 M x k = none := by
  unfold runtimeTick evaluateIndexFuel
  rw [decoded_source_exact]
  simp [packed, runFuel]

theorem timeout_defaulting_corrupts_halt :
    (runtimeTick 0 haltNow (fun _ => true) 0).getD false ≠
      output (Q8.observer haltNow) (initial 1 (by decide)) (fun _ => true) 0 := by
  rw [zero_fuel_is_not_zero]
  decide

#eval decodeIndex (code haltNow) == some (packed haltNow)
#eval runtimeTick 0 haltNow (fun _ => true) 0
#eval runtimeTick 100 haltNow (fun _ => true) 0
#eval runtimeTick 100 grow (fun _ => true) 0

end Fixtures
end Orthemology.CertifiedObserver.ParsedQ8
