import ResetLaw
import Mathlib.Probability.Kernel.IonescuTulcea.Traj
import Mathlib.Probability.ProbabilityMassFunction.Integrals

noncomputable section
open MeasureTheory ProbabilityTheory Finset Preorder
open scoped BigOperators ENNReal

namespace Orthemology.Tranche2
variable {Phase Θ : Type*} {Obs : Phase → Θ → Type*}
    [Fintype Phase] [Fintype Θ] [∀ p a, Fintype (Obs p a)]

abbrev ResetState := Σ p : Phase, PhaseHistory (Obs := Obs) p

instance : Countable (ResetState (Obs := Obs)) := inferInstance
instance resetStateMeasurableSpace : MeasurableSpace (ResetState (Obs := Obs)) := ⊤
instance : MeasurableSingletonClass (ResetState (Obs := Obs)) := ⟨fun _ => trivial⟩

def resetUpdate
    (stay : (p : Phase) → (a : Θ) → Obs p a → Bool)
    (next : (p : Phase) → (a : Θ) → Obs p a → Phase)
    (π : (p : Phase) → PhaseHistory (Obs := Obs) p → Θ)
    (s : ResetState (Obs := Obs)) (y : Obs s.1 (π s.1 s.2)) : ResetState (Obs := Obs) :=
  if stay s.1 (π s.1 s.2) y then ⟨s.1, ⟨π s.1 s.2,y⟩::s.2⟩
  else ⟨next s.1 (π s.1 s.2) y, []⟩

def observationPMF
    (K : (p : Phase) → (θ a : Θ) → Obs p a → ℝ)
    (hK : ∀ p η a y, 0 ≤ K p η a y)
    (hNorm : ∀ p η a, ∑ y, K p η a y = 1)
    (θ : Θ) (p : Phase) (a : Θ) : PMF (Obs p a) :=
  PMF.ofFintype (fun y => ENNReal.ofReal (K p θ a y)) (by
    rw [← ENNReal.ofReal_sum_of_nonneg (fun y _ => hK p θ a y), hNorm]
    exact ENNReal.ofReal_one)

def resetTransitionPMF
    (K : (p : Phase) → (θ a : Θ) → Obs p a → ℝ)
    (stay : (p : Phase) → (a : Θ) → Obs p a → Bool)
    (next : (p : Phase) → (a : Θ) → Obs p a → Phase)
    (π : (p : Phase) → PhaseHistory (Obs := Obs) p → Θ)
    (hK : ∀ p η a y, 0 ≤ K p η a y)
    (hNorm : ∀ p η a, ∑ y, K p η a y = 1)
    (θ : Θ) (s : ResetState (Obs := Obs)) : PMF (ResetState (Obs := Obs)) :=
  (observationPMF K hK hNorm θ s.1 (π s.1 s.2)).map (resetUpdate stay next π s)

def resetTransitionKernel
    (K : (p : Phase) → (θ a : Θ) → Obs p a → ℝ)
    (stay : (p : Phase) → (a : Θ) → Obs p a → Bool)
    (next : (p : Phase) → (a : Θ) → Obs p a → Phase)
    (π : (p : Phase) → PhaseHistory (Obs := Obs) p → Θ)
    (hK : ∀ p η a y, 0 ≤ K p η a y)
    (hNorm : ∀ p η a, ∑ y, K p η a y = 1)
    (θ : Θ) : Kernel (ResetState (Obs := Obs)) (ResetState (Obs := Obs)) where
  toFun s := (resetTransitionPMF K stay next π hK hNorm θ s).toMeasure
  measurable' := measurable_of_countable _

instance resetTransitionKernel_markov
    (K : (p : Phase) → (θ a : Θ) → Obs p a → ℝ)
    (stay : (p : Phase) → (a : Θ) → Obs p a → Bool)
    (next : (p : Phase) → (a : Θ) → Obs p a → Phase)
    (π : (p : Phase) → PhaseHistory (Obs := Obs) p → Θ)
    (hK : ∀ p η a y, 0 ≤ K p η a y)
    (hNorm : ∀ p η a, ∑ y, K p η a y = 1) (θ : Θ) :
    IsMarkovKernel (resetTransitionKernel K stay next π hK hNorm θ) :=
  ⟨fun s => by change IsProbabilityMeasure (resetTransitionPMF K stay next π hK hNorm θ s).toMeasure; infer_instance⟩

section GeneralTrajectory
variable {S : Type*} [MeasurableSpace S]

def markovKernelSequence (M : Kernel S S) (n : ℕ) : Kernel ((i : Iic n) → S) S :=
  M.comap (fun h => h ⟨n, Finset.mem_Iic.mpr le_rfl⟩) (measurable_pi_apply _)

instance markovKernelSequence_markov (M : Kernel S S) [IsMarkovKernel M] (n : ℕ) :
    IsMarkovKernel (markovKernelSequence M n) := by
  unfold markovKernelSequence
  infer_instance

/-- Actual infinite trajectory measure generated by the declared adaptive kernel. -/
def markovTrajectory (M : Kernel S S) [IsMarkovKernel M] (s : S) : Measure (ℕ → S) :=
  Kernel.traj (markovKernelSequence M) 0 (fun _ => s)

instance markovTrajectory_probability (M : Kernel S S) [IsMarkovKernel M] (s : S) :
    IsProbabilityMeasure (markovTrajectory M s) := by
  unfold markovTrajectory
  infer_instance

/-- Its finite-prefix laws are the finite causal kernel compositions. This
contract is obtained from Ionescu–Tulcea, not supplied by a caller. -/
theorem markovTrajectory_finite_law (M : Kernel S S) [IsMarkovKernel M] (s : S) (n : ℕ) :
    (markovTrajectory M s).map (frestrictLe n) =
      Kernel.partialTraj (X := fun _ : ℕ => S) (markovKernelSequence M) 0 n (fun _ => s) :=
  Kernel.traj_map_frestrictLe_apply (X := fun _ : ℕ => S) (κ := markovKernelSequence M) 0 n _

end GeneralTrajectory
end Orthemology.Tranche2
