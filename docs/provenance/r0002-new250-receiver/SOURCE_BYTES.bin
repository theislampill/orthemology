import Countermodel
open FullPolynomialCountermodel FullPolynomialMomentSupport
example : Λ witness = F 0 0 := by
  rw [witness_negative]
  norm_num [F]
import Mathlib

namespace PDChecker
noncomputable section
open scoped ENNReal

inductive Control (Q : Type*)
  | running (q : Q)
  | accept
  | reject
  deriving DecidableEq, Fintype

structure Instruction (Q Γ : Type*) where
  write : Γ
  next : Control Q
  shift : ℤ

structure Machine (Q Γ : Type*) where
  universal : Q → Bool
  step : Q → Γ → Bool → Instruction Q Γ

inductive State (m : ℕ) (Q Γ : Type*)
  | live (index : Fin m) (symbol : Γ) (control : Q) (head : Fin m)
  | top
  | bottom
  deriving DecidableEq, Fintype

inductive Receipt
  | ordinary
  | universal (branch : Bool)
  | accept
  | reject
  deriving DecidableEq, Fintype

abbrev Action (Γ : Type*) := Γ × Bool

/-- Bounds are checked before the destination control, including accepting controls. -/
def checkedHead (m : ℕ) (z : ℤ) : Option (Fin m) :=
  if h : 0 ≤ z ∧ z<(m:ℤ) then some ⟨z.toNat,(Int.toNat_lt h.1).mpr h.2⟩ else none

def isUniversal {m : ℕ} {Q Γ : Type*} (M : Machine Q Γ) : State m Q Γ → Bool
  | .live _ _ q _ => M.universal q
  | .top => false
  | .bottom => false

/-- Actual single-cell validation, checked write, shared control/head update and terminal handling. -/
def advance {m : ℕ} {Q Γ : Type*} [DecidableEq Γ] (M : Machine Q Γ)
    (s : State m Q Γ) (a : Action Γ) (branch : Bool) : State m Q Γ :=
  match s with
  | .top => .top
  | .bottom => .bottom
  | .live i sigma q h =>
    if i=h ∧ sigma≠a.1 then .bottom
    else
      let ins := M.step q a.1 branch
      match checkedHead m ((h:ℕ)+ins.shift) with
      | none => .bottom
      | some h' =>
        match ins.next with
        | .accept => .top
        | .reject => .bottom
        | .running q' => .live i (if i=h then ins.write else sigma) q' h'

/-- Only nonterminal outcomes use the selected public step tag. -/
def emit {m : ℕ} {Q Γ : Type*} (tag : Receipt) (s : State m Q Γ) : Receipt × State m Q Γ :=
  match s with
  | .top => (.accept,.top)
  | .bottom => (.reject,.bottom)
  | .live i sigma q h => (tag,.live i sigma q h)

@[simp] lemma emit_snd {m : ℕ} {Q Γ : Type*} (tag : Receipt) (s : State m Q Γ) :
    (emit tag s).2=s := by cases s <;> rfl

lemma separated_emit {m : ℕ} {Q Γ : Type*} {b c : Bool} (hbc : b≠c)
    (s t : State m Q Γ)
    (h : (emit (.universal b) s).1=(emit (.universal c) t).1) : s=t := by
  cases s <;> cases t <;> simp_all [emit]

def branchOutput {m : ℕ} {Q Γ : Type*} [DecidableEq Γ] (M : Machine Q Γ)
    (s : State m Q Γ) (a : Action Γ) (branch : Bool) : Receipt × State m Q Γ :=
  emit (if isUniversal M s=true then .universal branch else .ordinary) (advance M s a branch)

/-- A normalized exact fair bit, not an abstract distribution premise. -/
def fairBit : PMF Bool := PMF.uniformOfFintype Bool

@[simp] lemma fairBit_apply (b : Bool) : fairBit b=(2:ℝ≥0∞)⁻¹ := by
  simp [fairBit,PMF.uniformOfFintype_apply]

/-- The actual joint receipt/successor kernel: a point mass at existential states,
and the pushforward of one exact fair bit at universal states. -/
def kernel {m : ℕ} {Q Γ : Type*} [DecidableEq Γ] (M : Machine Q Γ)
    (s : State m Q Γ) (a : Action Γ) : PMF (Receipt × State m Q Γ) :=
  if isUniversal M s=true then PMF.map (branchOutput M s a) fairBit
  else PMF.pure (branchOutput M s a a.2)

def PosteriorDeterministic {S A O : Type*} (K : S → A → PMF (O × S)) : Prop :=
  ∀ s a o q r, 0 < K s a (o,q) → 0 < K s a (o,r) → q=r

/-- Posterior determinism is derived from the constructed kernel, with no PD premise. -/
theorem kernel_posterior_deterministic {m : ℕ} {Q Γ : Type*} [DecidableEq Γ]
    (M : Machine Q Γ) : PosteriorDeterministic (kernel (m:=m) M) := by
  intro s a o q r hq hr
  have hqs : (o,q) ∈ (kernel M s a).support := (PMF.mem_support_iff _ _).mpr (ne_of_gt hq)
  have hrs : (o,r) ∈ (kernel M s a).support := (PMF.mem_support_iff _ _).mpr (ne_of_gt hr)
  by_cases hu : isUniversal M s=true
  · rw [kernel,if_pos hu] at hqs hrs
    obtain ⟨b,hb,hbq⟩ := (PMF.mem_support_map_iff _ _ _).mp hqs
    obtain ⟨c,hc,hcr⟩ := (PMF.mem_support_map_iff _ _ _).mp hrs
    by_cases hbc : b=c
    · subst c
      exact congrArg Prod.snd (hbq.symm.trans hcr)
    · have hobs := (congrArg Prod.fst hbq).trans (congrArg Prod.fst hcr).symm
      simp only [branchOutput,if_pos hu] at hobs
      have hs := separated_emit hbc (advance M s a b) (advance M s a c) hobs
      have hqb := congrArg Prod.snd hbq
      have hrc := congrArg Prod.snd hcr
      simp only [branchOutput,emit_snd] at hqb hrc
      exact hqb.symm.trans (hs.trans hrc)
  · rw [kernel,if_neg hu] at hqs hrs
    have hqeq := (PMF.mem_support_pure_iff _ _).mp hqs
    have hreq := (PMF.mem_support_pure_iff _ _).mp hrs
    exact congrArg Prod.snd (hqeq.trans hreq.symm)

end
end PDChecker
import Witness
import Controls

namespace GuardedTree.Witness.Controls
open Tree Executable.Controls

def unitRules : RuleList Unit := ⟨[()], by intro r; cases r; simp⟩
def boolRules : RuleList Bool := ⟨[false, true], by intro r; cases r <;> simp⟩
def reversedBoolRules : RuleList Bool := ⟨[true, false], by intro r; cases r <;> simp⟩
def finRules (n : ℕ) : RuleList (Fin n) := ⟨List.finRange n, by intro r; simp⟩

def outline {J E R : Type*} (G : Grammar J E R) [Repr R] : Tree G → String
  | .node r child => reprStr r ++ "(" ++
      String.intercalate "," (List.ofFn fun i => outline G (child i)) ++ ")"

def checkWitness {J E R : Type*} [DecidableEq J] [DecidableEq E]
    (G : Grammar J E R) [Fintype J] [Fintype R] [Repr R]
    [∀ r s, Decidable (G.guard r s)]
    (label : String) (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E)
    (expected : Option ℚ) (expectedNodes : ℕ := 0) : IO Unit := do
  let actual := extractRound G rs h q S
  unless actual.map (cost G) == expected do
    throw (IO.userError s!"{label}: incorrect returned-tree cost")
  match actual with
  | none => IO.println s!"PASS {label}: no tree"
  | some t =>
    unless accept G q S (cost G t) t do
      throw (IO.userError s!"{label}: verifier rejected returned tree")
    unless nodes G t == expectedNodes do
      throw (IO.userError s!"{label}: incorrect occurrence count")
    IO.println s!"PASS {label}: cost {cost G t}, nodes {nodes G t}, tree {outline G t}"

def orderedLeaf (r : Fin 5) (hr : r.val < 3) : Tree ordered :=
  .node r (fun i => False.elim (by have hi := i.isLt; simp [ordered, hr] at hi))

def reversedTree : Tree ordered :=
  .node 3 (fun i => if i.val = 0 then orderedLeaf 1 (by decide) else orderedLeaf 0 (by decide))

def repeatedTree : Tree ordered :=
  .node 4 (fun _ => orderedLeaf 0 (by decide))

def wrongChildTree : Tree priceDrop :=
  .node 2 (fun _ => .node 1 Fin.elim0)

def checkReject (label : String) (b : Bool) : IO Unit := do
  if b then throw (IO.userError s!"{label}: corrupted certificate accepted")
  IO.println s!"PASS reject {label}"

def runChecks : IO Unit := do
  checkWitness cycle "unsupported zero cycle" unitRules 4 () ∅ none
  checkWitness seeded "global nullary seed" boolRules (grammarBound seeded) () ∅ (some 0) 1
  checkWitness seeded "seeded zero cycle same-order early tie" reversedBoolRules 1 () ∅ (some 0) 1
  checkWitness seeded "seeded zero cycle tie" reversedBoolRules 4 () ∅ (some 0) 4
  checkWitness blocked "blocked nullary" unitRules 1 () ∅ none
  checkWitness ordered "ordered supports" (finRules 5) 2 1 {0,1} (some 1) 3
  checkWitness ordered "repeated charged occurrences" (finRules 5) 2 2 {0} (some (7/6)) 3
  checkWitness ordered "unavailable shrunken support" (finRules 5) 2 1 ∅ none
  checkWitness ordered "external evidence" (finRules 5) 2 0 {999} none
  checkWitness ordered "cheap empty support retained" (finRules 5) 2 0 ∅ (some 0) 1
  checkWitness ordered "dearer required support retained" (finRules 5) 2 0 {0} (some (1/2)) 1
  checkWitness priceDrop "old expensive proof" (finRules 3) 1 1 ∅ (some 10) 1
  checkWitness priceDrop "global improved proof" (finRules 3) (grammarBound priceDrop) 1 ∅ (some 1) 2
  checkWitness decreasing "negative bounded one" boolRules 1 () ∅ (some 0) 1
  checkWitness decreasing "negative bounded two" boolRules 2 () ∅ (some (-1)) 2
  checkWitness seeded "zero rounds" boolRules 0 () ∅ none
  checkReject "reversed premise order" (accept ordered 1 {0,1} 1 reversedTree)
  checkReject "wrong repeated cost" (accept ordered 2 {0} (2/3) repeatedTree)
  checkReject "wrong exact support" (accept ordered 2 ∅ (7/6) repeatedTree)
  checkReject "wrong root judgement" (accept ordered 1 {0} (7/6) repeatedTree)
  checkReject "wrong child judgement" (accept priceDrop 1 ∅ 11 wrongChildTree)
  let blockedTree : Tree blocked := .node () Fin.elim0
  checkReject "false nullary guard" (accept blocked () ∅ 0 blockedTree)
  unless (tuples ([] : List Nat) 0).length == 1 do
    throw (IO.userError "empty cartesian tuple missing")
  unless (tuples ([] : List Nat) 1).isEmpty do
    throw (IO.userError "unsupported positive-arity tuple")
  IO.println "PASS empty-product boundary"

#eval runChecks
end GuardedTree.Witness.Controls
import Mathlib

/-!
# An existence-aware audit of a bounded backwards history

The affine-history mechanism is a transparent reconstruction of a contractive
example, not a formalization of all of Billon's explanatory theory. It establishes
genuine infinite property determination. The Option lift then distinguishes an
absent bearer from a present bearer having a numerical value.

The empty fixed point is not asserted to be the actual state or a metaphysically
possible world. No least-fixed-point or causal-foundation axiom is assumed.
-/

namespace Orthemology.Tranche3.ExistenceAwareHistory

noncomputable section

def HalfHistory (c : ℝ) (x : ℕ → ℝ) : Prop :=
  ∀ n, x n = (x (n + 1) + c) / 2

theorem backwards_deviation (c : ℝ) (x : ℕ → ℝ) (h : HalfHistory c x)
    (n k : ℕ) : x (n + k) - c = 2 ^ k * (x n - c) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hs : x (n + k + 1) - c = 2 * (x (n + k) - c) := by
        have hh := h (n + k)
        linarith
      simpa [Nat.add_assoc, pow_succ, ih, mul_comm, mul_left_comm, mul_assoc] using hs

/-- Infinite bounded backwards histories really determine their state values.
This grants the property-explanation mechanism, rather than assuming that an
infinite arrangement can never add explanatory restrictions. -/
theorem bounded_history_constant (c M : ℝ) (x : ℕ → ℝ)
    (h : HalfHistory c x) (bounded : ∀ n, |x n - c| ≤ M) :
    ∀ n, x n = c := by
  intro n
  by_contra hn
  have hd : 0 < |x n - c| := abs_pos.mpr (sub_ne_zero.mpr hn)
  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (M / |x n - c|) (by norm_num : (1 : ℝ) < 2)
  have hlarge : M < 2 ^ k * |x n - c| := (div_lt_iff₀ hd).mp hk
  have hb := bounded (n + k)
  rw [backwards_deviation c x h n k, abs_mul,
    abs_of_nonneg (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) k)] at hb
  linarith

/-- Without the bound every real deviation generates a backwards history. -/
theorem unbounded_family (c d : ℝ) :
    HalfHistory c (fun n => c + 2 ^ n * d) := by
  intro n
  simp only [pow_succ]
  ring

theorem nonconstant_unbounded_control (c : ℝ) :
    HalfHistory c (fun n => c + 2 ^ n) ∧
      (fun n => c + 2 ^ n) ≠ (fun _ => c) := by
  constructor
  · simpa using unbounded_family c 1
  · intro heq
    have hh := congrFun heq 0
    norm_num at hh

def liftHalf (c : ℝ) : Option ℝ → Option ℝ :=
  Option.map (fun x => (x + c) / 2)

def LiftedHistory (c : ℝ) (h : ℕ → Option ℝ) : Prop :=
  ∀ n, h n = liftHalf c (h (n + 1))

def ConditionallyBounded (c M : ℝ) (h : ℕ → Option ℝ) : Prop :=
  ∀ n x, h n = some x → |x - c| ≤ M

theorem absent_history (c : ℝ) :
    LiftedHistory c (fun _ => none) ∧
      ConditionallyBounded c 0 (fun _ => none) := by
  simp [LiftedHistory, liftHalf, ConditionallyBounded]

theorem present_history (c : ℝ) :
    LiftedHistory c (fun _ => some c) ∧
      ConditionallyBounded c 0 (fun _ => some c) := by
  constructor
  · intro n
    change some c = some ((c + c) / 2)
    congr 1
    ring
  · intro n x hx
    have hcx : c = x := Option.some.inj hx
    subst x
    simp

theorem absence_iff_next (c : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (n : ℕ) :
    h n = none ↔ h (n + 1) = none := by
  rw [hr n]
  cases h (n + 1) <;> simp [liftHalf]

/-- Absence cannot be mixed with presence along this particular backwards law. -/
theorem same_absence_profile (c : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (n : ℕ) : h n = none ↔ h 0 = none := by
  induction n with
  | zero => rfl
  | succ n ih =>
      exact (absence_iff_next c h hr n).symm.trans ih

/-- There are exactly two bounded profiles after an explicit absence lift:
all absent, or all present at the uniquely determined property value. -/
theorem bounded_lifted_classification (c M : ℝ) (h : ℕ → Option ℝ)
    (hr : LiftedHistory c h) (hm : 0 ≤ M)
    (hb : ConditionallyBounded c M h) :
    (∀ n, h n = none) ∨ (∀ n, h n = some c) := by
  let x : ℕ → ℝ := fun n => (h n).getD c
  have hx : HalfHistory c x := by
    intro n
    change (h n).getD c = ((h (n + 1)).getD c + c) / 2
    rw [hr n]
    cases hh : h (n + 1) with
    | none =>
        change c = (c + c) / 2
        ring
    | some y => rfl
  have hxb : ∀ n, |x n - c| ≤ M := by
    intro n
    cases hh : h n with
    | none => simpa [x, hh] using hm
    | some y => simpa [x, hh] using hb n y hh
  have hxc := bounded_history_constant c M x hx hxb
  by_cases hz : h 0 = none
  · exact Or.inl (fun n => (same_absence_profile c h hr n).mpr hz)
  · right
    intro n
    cases hh : h n with
    | none => exact False.elim (hz ((same_absence_profile c h hr n).mp hh))
    | some y =>
        have hy : y = c := by simpa [x, hh] using hxc n
        exact congrArg some hy

/-- Exact existential separation: both candidates obey the same lifted law and
conditional bound. This does not say that the absent one is actual. -/
theorem two_existence_profiles (c : ℝ) :
    ∃ h₀ h₁ : ℕ → Option ℝ,
      LiftedHistory c h₀ ∧ ConditionallyBounded c 0 h₀ ∧
      LiftedHistory c h₁ ∧ ConditionallyBounded c 0 h₁ ∧
      (∀ n, h₀ n = none) ∧ (∀ n, h₁ n = some c) ∧ h₀ ≠ h₁ := by
  refine ⟨(fun _ => none), (fun _ => some c),
    (absent_history c).1, (absent_history c).2,
    (present_history c).1, (present_history c).2, ?_, ?_, ?_⟩
  · intro n; rfl
  · intro n; rfl
  · intro hh
    have hn := congrFun hh 0
    cases hn

/-- The general audit has no assumption that the configuration is finite,
discrete, singly borne, or described by a well-founded dependency graph. -/
theorem absence_preserving_not_unique_active {H : Type*}
    (T : H → H) (empty active : H)
    (preserves : True) (realized : T active = active)
    (different : active ≠ empty) :
    ¬ ∃! h, T h = h := by
  rintro ⟨h, _, unique⟩
  exact different ((unique active realized).trans (unique empty preserves).symm)

/-- Adding a distinct preserved absence state cannot retain global strict
contractivity in an ordinary metric. Thus the audit does not pretend to preserve
every premise of a Banach argument when it changes the state space. -/
theorem no_global_contraction_with_preserved_absence {H : Type*} [MetricSpace H]
    (T : H → H) (empty active : H)
    (preserves : T empty = empty) (realized : T active = active)
    (different : active ≠ empty) (K : NNReal) :
    ¬ ContractingWith K T := by
  intro hc
  exact different (hc.fixedPoint_unique' realized preserves)

/-- Selecting the active profile by a separate existential constraint is
consistent; it does not convert the constraint into a consequence of the law. -/
theorem active_profile_satisfies_existence (c : ℝ) :
    LiftedHistory c (fun _ => some c) ∧
      ConditionallyBounded c 0 (fun _ => some c) ∧
      ∃ n : ℕ, ∃ x, (fun _ : ℕ => (some c : Option ℝ)) n = some x := by
  exact ⟨(present_history c).1, (present_history c).2, 0, c, rfl⟩

#print axioms backwards_deviation
#print axioms bounded_history_constant
#print axioms nonconstant_unbounded_control
#print axioms two_existence_profiles
#print axioms bounded_lifted_classification
#print axioms absence_preserving_not_unique_active
#print axioms no_global_contraction_with_preserved_absence
#print axioms active_profile_satisfies_existence

end
end Orthemology.Tranche3.ExistenceAwareHistory
