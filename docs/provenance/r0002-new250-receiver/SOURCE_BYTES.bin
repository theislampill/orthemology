import TaggedSubstitution
import Lean

/- Check the transitive kernel declaration dependencies, rather than only
   grepping the new source for prohibited completion principles. -/
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  for target in [``TaggedInduction.dependent_induction,
      ``TaggedInduction.hereditary_nat, ``TaggedInduction.dependent_induction_sound] do
    let (_, report) := ((Lean.CollectAxioms.collect target).run env).run {}
    for a in report.axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains a do
        throwError "Unexpected axiom in {target}: {a}"
    for forbidden in [``JointCompletion.sigma_eta, ``JointCompletion.sigma_elimination,
        ``JointCompletion.dependent_induction, ``FullPER.F,
        ``FullPER.TypeLaws, ``FullPER.Fundamental, ``FullPER.ContextLaws] do
      if report.visited.contains forbidden then
        throwError "Forbidden semantic dependency in {target}: {forbidden}"
    logInfo m!"PASS {target}: only standard Lean axioms; no FullPER semantic interpretation, Sigma eta, or joint-completion soundness dependency."
import P01RecursiveModel
namespace IndependentRecursiveControls
open OrthemologyV2 OrthemologyV3 P01D P01R

def arbitraryLinks (ρ τ : OEnv) (rs : ∀ n, Link (ρ n) (τ n)) : REnv where
  left := ρ
  right := τ
  rel := fun n => (rs n).rel
  endpoints := fun n => (rs n).endpoints
  respect := fun n => (rs n).respect

theorem arbitrary_link_environment_represented (ρ τ : OEnv)
    (rs : ∀ n, Link (ρ n) (τ n)) (n : Nat) :
    (arbitraryLinks ρ τ rs).at n = rs n := by
  apply P01R.link_ext
  intro t u
  rfl

def universalPER : PER where
  rel := fun _ _ => True
  sym := fun _ => True.intro
  trans := fun _ _ => True.intro
  raw := fun _ _ _ => True.intro

def crossLink : Link rawPER universalPER where
  rel := fun _ _ => True
  endpoints := fun _ => ⟨Conv.refl _, True.intro⟩
  respect := fun _ _ _ => True.intro

theorem nonempty_heterogeneous_link : crossLink.rel Term.i Term.k := True.intro

theorem polymorphic_identity_derivable : FiniteDerives .i identityCode :=
  .allI (.i (.var 0))

theorem recursive_all_identity_nonempty (ρ : OEnv) :
    ((P01R.interpret identityCode).obj ρ).dom .i :=
  finite_new_model_member polymorphic_identity_derivable ρ

theorem recursive_all_identity_heterogeneous (r : REnv) :
    (P01R.interpret identityCode).rel r .i .i :=
  finite_fundamental polymorphic_identity_derivable r

theorem bottom_has_no_finite_inhabitant (t : Term) : ¬ FiniteDerives t .bottom := by
  intro h
  have hmem := finite_new_model_member h (fun _ => rawPER)
  change False at hmem
  exact hmem

#print axioms arbitrary_link_environment_represented
#print axioms nonempty_heterogeneous_link
#print axioms recursive_all_identity_nonempty
#print axioms recursive_all_identity_heterogeneous
#print axioms bottom_has_no_finite_inhabitant
end IndependentRecursiveControls
import FiniteHullApproximateIff

/-! Literal intrinsic-interior interface for the frozen positive-barycentric
finite-hull theorems. No finite-dimensional assumption is needed for the
centroid/segment-extension certificate itself. -/
noncomputable section
open scoped Topology BigOperators
open Filter Set

namespace IntrinsicBarycentric
variable {E J : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [Fintype J]

lemma finite_convex_weights (v : J → E) (y : E)
    (hy : y ∈ convexHull ℝ (Set.range v)) :
    ∃ w : J → ℝ, (∀ j, 0 ≤ w j) ∧ (∑ j, w j = 1) ∧ (∑ j, w j • v j = y) := by
  classical
  rw [convexHull_range_eq_exists_affineCombination] at hy
  obtain ⟨s, a, ha, hsum, hcenter⟩ := hy
  let w : J → ℝ := fun j => if j ∈ s then a j else 0
  have hmass : ∑ j, w j = ∑ j ∈ s, a j := by simp [w]
  have hsumv : ∑ j, w j • v j = ∑ j ∈ s, a j • v j := by simp [w, ite_smul]
  refine ⟨w, ?_, hmass.trans hsum, ?_⟩
  · intro j
    dsimp [w]
    split_ifs with hj
    · exact ha j hj
    · exact le_rfl
  · rw [hsumv]
    rwa [Finset.affineCombination_eq_linear_combination s v a hsum] at hcenter

/-- Any intrinsic-interior point of a nonempty finite hull admits weights
strictly positive at every listed truth vector, including duplicated entries. -/
theorem intrinsicInterior_positive_barycentric (v : J → E) (p : E)
    (hp : p ∈ convexHull ℝ (Set.range v)) :
    ∃ w : J → ℝ, (∀ j, 0 < w j) ∧ (∑ j, w j = 1) ∧ (∑ j, w j • v j = p) := by
  classical
  have hpC : p ∈ convexHull ℝ (Set.range v) := intrinsicInterior_subset hp
  have hJ : Nonempty J := by
    by_contra hn
    haveI : IsEmpty J := not_nonempty_iff.mp hn
    rw [Set.range_eq_empty v, convexHull_empty] at hpC
    exact hpC
  letI := hJ
  let N : ℝ := Fintype.card J
  have hN : 0 < N := by dsimp [N]; exact_mod_cast (Fintype.card_pos : 0 < Fintype.card J)
  let q : E := ∑ j, (1 / N) • v j
  have hmass : (∑ _ : J, (1 : ℝ) / N) = 1 := by
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    dsimp [N] at *
    field_simp
  have hqC : q ∈ convexHull ℝ (Set.range v) :=
    mem_convexHull_of_exists_fintype (fun _ : J => (1 : ℝ) / N) v
      (fun _ => (div_pos (by norm_num) hN).le) hmass (fun j => Set.mem_range_self j) rfl
  let A := affineSpan ℝ (convexHull ℝ (Set.range v))
  obtain ⟨pA, hpA, hpcoe⟩ := mem_intrinsicInterior.mp hp
  haveI : Nonempty A := ⟨pA⟩
  let qA : A := ⟨q, subset_affineSpan ℝ _ hqC⟩
  have htend : Tendsto (AffineMap.lineMap qA pA) (𝓝 (1 : ℝ)) (𝓝 pA) := by
    have hcont : Continuous (fun t : ℝ => AffineMap.lineMap qA pA t) := by
      simp only [AffineMap.lineMap_apply]
      fun_prop
    simpa using hcont.tendsto 1
  have hev : ∀ᶠ t in 𝓝 (1 : ℝ),
      AffineMap.lineMap qA pA t ∈ ((↑) ⁻¹' convexHull ℝ (Set.range v) : Set A) :=
    htend.eventually (mem_interior_iff_mem_nhds.mp hpA)
  obtain ⟨t, ht, hty⟩ := hev.exists_gt
  let y : E := ↑(AffineMap.lineMap qA pA t)
  have hy : y ∈ convexHull ℝ (Set.range v) := hty
  have hyexpr : y = (1-t) • q + t • p := by
    change t • ((pA : E) - q) + q = (1-t) • q + t • p
    rw [hpcoe]
    module
  obtain ⟨u, hu, husum, hucenter⟩ := finite_convex_weights v y hy
  let alpha : ℝ := (t-1)/t
  let beta : ℝ := 1/t
  have htp : 0 < t := by linarith
  have hap : 0 < alpha := div_pos (by linarith) htp
  have hbp : 0 < beta := div_pos (by norm_num) htp
  have hab : alpha + beta = 1 := by dsimp [alpha, beta]; field_simp
  have hcancel : alpha + beta * (1-t) = 0 := by dsimp [alpha, beta]; field_simp
  have hbt : beta * t = 1 := by dsimp [beta]; field_simp
  refine ⟨(fun j => alpha / N + beta * u j), ?_, ?_, ?_⟩
  · intro j
    exact add_pos_of_pos_of_nonneg (div_pos hap hN) (mul_nonneg hbp.le (hu j))
  · simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      ← Finset.mul_sum, husum, mul_one]
    have hn : (Fintype.card J : ℝ) * (alpha / N) = alpha := by dsimp [N]; field_simp
    rw [hn, hab]
  · calc
      (∑ j, (alpha / N + beta * u j) • v j) = alpha • q + beta • y := by
        rw [← hucenter]
        dsimp [q]
        simp only [add_smul, Finset.sum_add_distrib, Finset.smul_sum, smul_smul]
        congr 1
        apply Finset.sum_congr rfl
        intro j _
        congr 1
        ring
      _ = p := by
        rw [hyexpr, smul_add, smul_smul, smul_smul, ← add_assoc, ← add_smul, hcancel, hbt]
        simp

open LocalRigidity

theorem quadratic_local_common_repair_iff_intrinsicInterior [FiniteDimensional ℝ E]
    {K : Type*}
    (Bs : K → Form E) (k0 : K)
    (hsym : ∀ k x y, Bs k x y = Bs k y x)
    (hpos : ∀ k u, u ≠ 0 → 0 < Bs k u u)
    (v : J → E) (p h : E)
    (hp : p ∈ convexHull ℝ (Set.range v))
    (htrans : h ∉ Submodule.span ℝ (Set.range (fun i => p - v i))) :
    (∃ (e : ℕ → ℝ) (c : ℕ → E),
      (∀ n, 0 < e n) ∧ Tendsto e atTop (𝓝 0) ∧
      (∀ n, c n ∈ convexHull ℝ (Set.range v)) ∧
      (∀ n k i, loss (Bs k) (c n) (v i) ≤ loss (Bs k) (p + e n • h) (v i))) ↔
    (∃ z ∈ Submodule.span ℝ (Set.range (fun i => p - v i)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun i => p - v i)) →
        Bs k (h - z) u = 0) := by
  obtain ⟨w, hw, hsum, hcenter⟩ := intrinsicInterior_positive_barycentric v p hp
  exact LocalRigidity.local_common_repair_iff Bs k0 hsym hpos v w p h hw hsum hcenter htrans

#print axioms intrinsicInterior_positive_barycentric
#check intrinsicInterior_positive_barycentric

section Smooth
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
open SmoothRigidity FiniteHullSmoothRigidity

theorem smooth_finite_hull_approximate_necessary_intrinsicInterior {K : Type*}
    (s : K → ι → SmoothScalar.Score) (k0 : K) (v : J → Vec ι) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1)
    (hri : p ∈ intrinsicInterior ℝ (convexHull ℝ (Set.range v)))
    (e eta : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (heta0 : ∀ n, 0 ≤ eta n) (heta : Tendsto (fun n => eta n / e n) atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range v))
    (hgain : ∀ n k j, totalDiv (s k) (v j) (c n) ≤ totalDiv (s k) (v j) (p + e n • h) + eta n) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun j => p - v j)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun j => p - v j)) →
        hessian (s k) p (h-z) u = 0 := by
  obtain ⟨w, hw, hsum, hcenter⟩ := intrinsicInterior_positive_barycentric v p hri
  exact finite_hull_approximate_hessian_necessary s k0 v w p h hp hw hsum hcenter
    e eta c hepos he heta0 heta hc hcmem hgain

variable {K : Type*}

theorem smooth_finite_hull_approximate_iff_intrinsicInterior
    [Fintype K] (s : K → ι → SmoothScalar.Score) (k0 : K)
    (v : J → Vec ι) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1)
    (hri : p ∈ intrinsicInterior ℝ (convexHull ℝ (Set.range v))) :
    (∃ (e eta : ℕ → ℝ) (c : ℕ → Vec ι),
      (∀ n, 0 < e n) ∧ Tendsto e atTop (𝓝 0) ∧
      (∀ n, 0 ≤ eta n) ∧ Tendsto (fun n => eta n / e n) atTop (𝓝 0) ∧
      (∀ n i, c n i ∈ Ioo 0 1) ∧
      (∀ n, c n ∈ convexHull ℝ (Set.range v)) ∧
      (∀ n k j, totalDiv (s k) (v j) (c n) ≤ totalDiv (s k) (v j) (p + e n • h) + eta n)) ↔
    (∃ z ∈ Submodule.span ℝ (Set.range (fun j => p - v j)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun j => p - v j)) →
        hessian (s k) p (h-z) u = 0) := by
  obtain ⟨w, hw, hsum, hcenter⟩ := intrinsicInterior_positive_barycentric v p hri
  exact FiniteHullApproximateIff.finite_hull_local_approximate_iff s k0 v w p h hp hw hsum hcenter

end Smooth
#print axioms smooth_finite_hull_approximate_iff_intrinsicInterior
#check smooth_finite_hull_approximate_iff_intrinsicInterior
#print axioms quadratic_local_common_repair_iff_intrinsicInterior
#print axioms smooth_finite_hull_approximate_necessary_intrinsicInterior
#check quadratic_local_common_repair_iff_intrinsicInterior
#check smooth_finite_hull_approximate_necessary_intrinsicInterior
end IntrinsicBarycentric

/- Conditional assembly only: neither projection bridge is inhabited here. -/
import ProjectionBoundary
import Application

namespace P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair.CompilerBodyControl
open P01AC.Intensional.Plus (PolyConvPlus)
open FullPER.Application (originalQ)
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

/-- Congruence for the actual state observer. Its identity evidence is HasE,
    while the old endpoint typings suffice to form the two-coordinate motive. -/
theorem image_congr_hasE {Γ : Tel} (hc : Ctx Γ) {f a s t e : Poly}
    (hf : Has Γ f End) (ha : Has Γ a A) (hs : Has Γ s S) (ht : Has Γ t S)
    (he : HasE Γ e (.identity S s t)) :
    HasE Γ (jPoly (.atom .i) t e) (.identity A (image f a s) (image f a t)) := by
  let M : Ty := .identity A
    (image (pren (fun k => k+2) f) (pren (fun k => k+2) a) (pren (fun k => k+2) s))
    (image (pren (fun k => k+2) f) (pren (fun k => k+2) a) (.var 1))
  have hS := S_form hc
  have c1 : Ctx (S :: Γ) := .ext hc hS
  have hP := form_theta_head hc hS hs
  have ct : Ctx (theta Γ S s) := ctx_theta hc hS hs
  have hf2 : Has (theta Γ S s) (pren (fun k => k+2) f) End := by
    simpa only [wk, subst, A, End, arr, pren, psub_comp, psub] using
      (has_wk (has_wk hf hc hS) c1 hP)
  have ha2 : Has (theta Γ S s) (pren (fun k => k+2) a) A := by
    simpa only [wk, subst, A, pren, psub_comp, psub] using
      (has_wk (has_wk ha hc hS) c1 hP)
  have hs2 : Has (theta Γ S s) (pren (fun k => k+2) s) S := by
    simpa only [wk, subst, S, N, NBody, arr, pren, psub_comp, psub] using
      (has_wk (has_wk hs hc hS) c1 hP)
  have hv : Has (theta Γ S s) (.var 1) S :=
    .var (S_form ct) (.succ .zero)
  have hM : Form (theta Γ S s) M :=
    .identity (.param ct) (image_has ct hf2 ha2 hs2) (image_has ct hf2 ha2 hv)
  have at_eq (v r : Poly) : motiveAt M v r =
      .identity A (image f a s) (image f a v) := by
    simp [motiveAt, M, subst, image, sndPoly, pren, psub, psub_comp, cons]
  have his := image_has hc hf ha hs
  have hit := image_has hc hf ha ht
  have base : Form Γ (motiveAt M s (.atom .i)) := by
    rw [at_eq]; exact .identity (.param hc) his his
  have target : Form Γ (motiveAt M t e) := by
    rw [at_eq]; exact .identity (.param hc) his hit
  have d : Has Γ (.atom .i) (motiveAt M s (.atom .i)) := by
    rw [at_eq]; exact .identityIntro (.identity (.param hc) his his) his his (.refl _)
  simpa only [at_eq] using (HasE.j (form_inclusion hS) (form_inclusion hM)
    (form_inclusion (.identity hS hs ht)) (form_inclusion base) (form_inclusion target)
    (has_inclusion hs) (has_inclusion ht) he (has_inclusion d))

/-- Composition with arbitrary HasE identity proofs, not just included Has proofs. -/
theorem trans_hasE {Γ : Tel} (hc : Ctx Γ) {x y z e d : Poly}
    (hx : Has Γ x A) (hy : Has Γ y A) (hz : Has Γ z A)
    (he : HasE Γ e (.identity A x y)) (hd : HasE Γ d (.identity A y z)) :
    HasE Γ (jPoly e z d) (.identity A x z) := by
  let M : Ty := .identity A (pren (fun k => k+2) x) (.var 1)
  have hA : Form Γ A := .param hc
  have c1 : Ctx (A :: Γ) := .ext hc hA
  have hP := form_theta_head hc hA hy
  have ct : Ctx (theta Γ A y) := ctx_theta hc hA hy
  have hx2 : Has (theta Γ A y) (pren (fun k => k+2) x) A := by
    simpa only [wk, subst, A, pren, psub_comp, psub] using
      (has_wk (has_wk hx hc hA) c1 hP)
  have hM : Form (theta Γ A y) M :=
    .identity (.param ct) hx2 (.var (.param ct) (.succ .zero))
  have at_eq (v r : Poly) : motiveAt M v r = .identity A x v := by
    simp [motiveAt, M, subst, pren, psub, psub_comp, cons]
  have base : Form Γ (motiveAt M y (.atom .i)) := by
    rw [at_eq]; exact .identity hA hx hy
  have target : Form Γ (motiveAt M z d) := by
    rw [at_eq]; exact .identity hA hx hz
  have baseproof : HasE Γ e (motiveAt M y (.atom .i)) := by rw [at_eq]; exact he
  simpa only [at_eq] using
    (HasE.j (form_inclusion hA) (form_inclusion hM)
      (form_inclusion (.identity hA hy hz)) (form_inclusion base) (form_inclusion target)
      (has_inclusion hy) (has_inclusion hz) hd baseproof)

/-- Transport the first endpoint along a HasE identity. -/
theorem replace_left_hasE {Γ : Tel} (hc : Ctx Γ) {x y z e d : Poly}
    (hx : Has Γ x A) (hy : Has Γ y A) (hz : Has Γ z A)
    (he : HasE Γ e (.identity A x z)) (hd : HasE Γ d (.identity A x y)) :
    HasE Γ (jPoly e y d) (.identity A y z) := by
  let M : Ty := .identity A (.var 1) (pren (fun k => k+2) z)
  have hA : Form Γ A := .param hc
  have c1 : Ctx (A :: Γ) := .ext hc hA
  have hP := form_theta_head hc hA hx
  have ct : Ctx (theta Γ A x) := ctx_theta hc hA hx
  have hz2 : Has (theta Γ A x) (pren (fun k => k+2) z) A := by
    simpa only [wk, subst, A, pren, psub_comp, psub] using
      (has_wk (has_wk hz hc hA) c1 hP)
  have hM : Form (theta Γ A x) M :=
    .identity (.param ct) (.var (.param ct) (.succ .zero)) hz2
  have at_eq (v r : Poly) : motiveAt M v r = .identity A v z := by
    simp [motiveAt, M, subst, pren, psub, psub_comp, cons]
  have base : Form Γ (motiveAt M x (.atom .i)) := by
    rw [at_eq]; exact .identity hA hx hz
  have target : Form Γ (motiveAt M y d) := by
    rw [at_eq]; exact .identity hA hy hz
  have baseproof : HasE Γ e (motiveAt M x (.atom .i)) := by rw [at_eq]; exact he
  simpa only [at_eq] using
    (HasE.j (form_inclusion hA) (form_inclusion hM)
      (form_inclusion (.identity hA hx hy)) (form_inclusion base) (form_inclusion target)
      (has_inclusion hx) (has_inclusion hy) hd baseproof)

/-- A typed J construction followed by checked conversion, not inversion from
    a raw normal form. The supplied identity remains an indispensable premise. -/
theorem identity_i_hasE {Γ : Tel} (hc : Ctx Γ) {x y e : Poly}
    (hx : Has Γ x A) (hy : Has Γ y A)
    (he : HasE Γ e (.identity A x y)) : HasE Γ (.atom .i) (.identity A x y) := by
  have hr : Has Γ (.atom .i) (.identity A x x) :=
    .identityIntro (.identity (.param hc) hx hx) hx hx (.refl _)
  have hj := trans_hasE hc hx hx hy (has_inclusion hr) he
  exact .conv (form_inclusion (.identity (.param hc) hx hy)) hj
    (ExactScalarFusion.j_conversion (.atom .i) y e) trivial

/-- The explicit witness assembled from the two arbitrary bridge proof terms. -/
def assembledProof (stateEvidence scalarEvidence : Poly) : Poly :=
  let r := graphRun (.var 2) (.var 1) (.var 0)
  let stateImage := image (.var 1) (.var 0) (stateRun (.var 2))
  let qImage := ExactScalarFusion.scalarR originalQ
  jPoly (jPoly (jPoly (sndPoly (sndPoly r)) stateImage
    (jPoly (.atom .i) (stateRun (.var 2)) stateEvidence)) qImage (.atom .i))
    ExactScalarFusion.scalarL scalarEvidence

theorem original_q_has : Has [] originalQ ExactScalarFusion.T :=
  P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed_has

/-- The original scalar leaf follows conditionally from the two bridge judgements. -/
theorem scalar_leaf_from_bridges {stateEvidence scalarEvidence : Poly}
    (hs : HasE scalarContext stateEvidence stateTransport)
    (hx : HasE scalarContext scalarEvidence scalarTransport) :
    HasE scalarContext (assembledProof stateEvidence scalarEvidence)
      (ExactScalarFusion.Leaf originalQ) := by
  have hc := scalar_context_formed
  have hr := graph_run_has hc n_has f_has a_has
  have hs0 := graph_state_has hc f_has a_has hr
  have hs1 := state_run_has hc n_has
  have hx0 := graph_scalar_has hc f_has a_has hr
  have him0 := image_has hc f_has a_has hs0
  have him1 := image_has hc f_has a_has hs1
  have hl := ExactScalarFusion.scalar_n_has hc n_has f_has a_has
  have hq := ExactScalarFusion.closed_has_T original_q_has hc
  have hqn := app_has (ExactScalarFusion.T_form hc) (N_form hc) hq n_has
  have hqr := ExactScalarFusion.scalar_n_has hc hqn f_has a_has
  have him := image_congr_hasE hc f_has a_has hs0 hs1 hs
  have first := trans_hasE hc hx0 him0 him1 literal_graph_invariant him
  have comp : Has scalarContext (.atom .i)
      (.identity A (image (.var 1) (.var 0) (stateRun (.var 2)))
        (ExactScalarFusion.scalarR originalQ)) :=
    .identityIntro (.identity (.param hc) him1 hqr) him1 hqr
      (original_scalar_computation (.var 2) (.var 1) (.var 0)).symm
  have second := trans_hasE hc hx0 him1 hqr first (has_inclusion comp)
  exact replace_left_hasE hc hx0 hl hqr second hx

/-- Exact I witness for the literal leaf, obtained by typed J and conversion. -/
theorem scalar_leaf_i_from_bridges {stateEvidence scalarEvidence : Poly}
    (hs : HasE scalarContext stateEvidence stateTransport)
    (hx : HasE scalarContext scalarEvidence scalarTransport) :
    HasE scalarContext ExactScalarFusion.i (ExactScalarFusion.Leaf originalQ) := by
  have hc := scalar_context_formed
  have hl := ExactScalarFusion.scalar_n_has hc n_has f_has a_has
  have hq := ExactScalarFusion.closed_has_T original_q_has hc
  have hqn := app_has (ExactScalarFusion.T_form hc) (N_form hc) hq n_has
  have hqr := ExactScalarFusion.scalar_n_has hc hqn f_has a_has
  exact identity_i_hasE hc hl hqr (scalar_leaf_from_bridges hs hx)

/-- Conditional literal scalar-fusion assembly. The original q, W and c3 are
    unchanged, and both unproved HasE bridge judgements remain explicit premises. -/
theorem scalar_fusion_from_bridges {stateEvidence scalarEvidence : Poly}
    (hs : HasE scalarContext stateEvidence stateTransport)
    (hx : HasE scalarContext scalarEvidence scalarTransport) :
    HasE [] ExactScalarFusion.c3 (ExactScalarFusion.W originalQ) := by
  have hw := ExactScalarFusion.W_form original_q_has Ctx.nil
  have h0 : Ctx [N] := .ext .nil (N_form .nil)
  have h1 : Ctx [End, N] := .ext h0 (form_arr (.param h0) (.param h0))
  have hleaf : Form [A, End, N] (ExactScalarFusion.Leaf originalQ) :=
    ExactScalarFusion.scalar_leaf_form Ctx.nil
      (ExactScalarFusion.closed_has_T original_q_has scalar_context_formed)
  have hfam := Form.pi (show Form [End, N] A from .param h1) hleaf
  have hffam := Form.pi (form_arr (.param h0) (.param h0)) hfam
  exact .piIntro (form_inclusion hw) (.allIntro (form_inclusion (.all h0 hffam))
    (.piIntro (form_inclusion hffam)
      (.piIntro (form_inclusion hfam) (scalar_leaf_i_from_bridges hs hx)
        (scoped_abstract trivial))
      (scoped_abstract (scoped_abstract trivial)))) (ExactScalarFusion.c3_scoped 0)

#print axioms image_congr_hasE
#print axioms trans_hasE
#print axioms replace_left_hasE
#print axioms identity_i_hasE
#print axioms scalar_leaf_from_bridges
#print axioms scalar_leaf_i_from_bridges
#print axioms scalar_fusion_from_bridges
#check @scalar_fusion_from_bridges
end P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly
import ANDScore

noncomputable section
open scoped BigOperators
open Set PolynomialAND ANDCorrection ANDScore

namespace PolynomialBounds

def value {n : ℕ} (c : Fin n → ℝ) (eps : ℝ) : ℝ := ∑ i, c i*eps^(i.val)
def budget {n : ℕ} (c : Fin n → ℝ) : ℝ := ∑ i, c i

lemma budget_nonneg {n : ℕ} (c : Fin n → ℝ) : 0  ≤  budget c :=
  Finset.sum_nonneg (fun i _ => abs_nonneg (c i))

lemma value_bound {n : ℕ} (c : Fin n → ℝ) (eps : ℝ) (he0 : 0  ≤  eps) (he1 : eps  ≤  1) :
    |value c eps|  ≤  budget c := by
  calc
    |value c eps|  ≤  ∑ i, |c i*eps^(i.val)| := Finset.abs_sum_le_sum_abs _ _
    _  ≤  budget c := by
      apply Finset.sum_le_sum
      intro i _
      rw [abs_mul,abs_of_nonneg (pow_nonneg he0 _)]
      exact mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ he0 he1)

lemma coordinate_bound {n : ℕ} (c : Fin n → ℝ) (i : Fin n) : |c i|  ≤  budget c :=
  Finset.single_le_sum (fun j _ => abs_nonneg (c j)) (Finset.mem_univ i)

def gCoefficients (h1 h2 hz hw b g : ℝ) : Fin 2 → ℝ :=
  ![-b*(h1+h2)-g*(hz+hw),-(b^2+g^2)]

def fCoefficients (s a h1 h2 hz hw b g : ℝ) : Fin 6 → ℝ :=
  let m := mean h1 h2
  let d2 := 1+144*s^2-96*a*s
  let d3 := 48*s-16*a
  ![d3*(h1^3+h2^3-2*m^3)-2*d2*m*b-100*g*(hz+hw),
    12*(h1^4+h2^4-2*m^4)-d2*b^2-6*d3*m^2*b-100*g^2,
    -6*d3*m*b^2-96*m^3*b,
    -2*d3*b^3-144*m^2*b^2,
    -96*m*b^3,-24*b^4]

lemma gRem_eq_value (h1 h2 hz hw b g eps : ℝ) :
    gRem h1 h2 hz hw b g eps=value (gCoefficients h1 h2 hz hw b g) eps := by
  simp [value,gCoefficients,gRem,Fin.sum_univ_succ]
  ring

lemma fRem_eq_value (s a h1 h2 hz hw b g eps : ℝ) :
    fRem s a h1 h2 hz hw b g eps=value (fCoefficients s a h1 h2 hz hw b g) eps := by
  simp [value,fCoefficients,fRem,Fin.sum_univ_succ]
  ring

lemma gRem_bound (h1 h2 hz hw b g eps : ℝ) (he0 : 0  ≤  eps) (he1 : eps  ≤  1) :
    |gRem h1 h2 hz hw b g eps| ≤ budget (gCoefficients h1 h2 hz hw b g) := by
  rw [gRem_eq_value]
  exact value_bound _ eps he0 he1

lemma fRem_bound (s a h1 h2 hz hw b g eps : ℝ) (he0 : 0  ≤  eps) (he1 : eps  ≤  1) :
    |fRem s a h1 h2 hz hw b g eps| ≤ budget (fCoefficients s a h1 h2 hz hw b g) := by
  rw [fRem_eq_value]
  exact value_bound _ eps he0 he1

/-- A fully explicit scale converts an exact polynomial leading margin into
an actual strict gain. No continuity choice or hidden remainder modulus. -/
lemma strict_gain_of_budget (lead m remainder M eps : ℝ)
    (hm : 0 < m) (hM : 0 ≤ M) (hlead : m ≤ lead) (hR : |remainder| ≤ M)
    (he : 0 < eps) (hscale : eps < m/(2*(M+1))) :
    0 < eps^2*(lead+eps*remainder) := by
  have hd : 0 < 2*(M+1) := by positivity
  have hs := (lt_div_iff₀ hd).mp hscale
  have hlo : -M ≤ remainder := neg_le_of_abs_le hR
  have hmul := mul_le_mul_of_nonneg_left hlo he.le
  have hp : 0 < lead+eps*remainder := by nlinarith
  exact mul_pos (pow_pos he 2) hp

#print axioms strict_gain_of_budget
end PolynomialBounds
import RobustBinaryRepair
import Mathlib.Algebra.Order.BigOperators.Ring.Finset

open scoped BigOperators

namespace Orthemology.Tranche3

noncomputable section

variable {ι : Type*} [Fintype ι]

def reportMean (w q : ι → ℝ) : ℝ := ∑ i, w i*q i
def reportVariance (w q : ι → ℝ) : ℝ := ∑ i, w i*(q i-reportMean w q)^2

theorem reportMean_mem (w q : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (hw1 : ∑ i, w i = 1) (hq0 : ∀ i, 0 ≤ q i) (hq1 : ∀ i, q i ≤ 1) :
    0 ≤ reportMean w q ∧ reportMean w q ≤ 1 := by
  constructor
  · exact Finset.sum_nonneg fun i _ => mul_nonneg (hw0 i) (hq0 i)
  · calc
      reportMean w q ≤ ∑ i, w i*1 := Finset.sum_le_sum fun i _ =>
        mul_le_mul_of_nonneg_left (hq1 i) (hw0 i)
      _ = 1 := by simpa using hw1

theorem reportVariance_nonneg (w q : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) :
    0 ≤ reportVariance w q :=
  Finset.sum_nonneg fun i _ => mul_nonneg (hw0 i) (sq_nonneg _)

lemma reportVariance_identity (w q : ι → ℝ) (hw1 : ∑ i, w i = 1) :
    reportVariance w q = (∑ i, w i*(q i)^2) - (reportMean w q)^2 := by
  unfold reportVariance
  calc
    (∑ i, w i * (q i-reportMean w q)^2) =
        (∑ i, ((w i*(q i)^2 - 2*reportMean w q*(w i*q i)) + w i*(reportMean w q)^2)) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = (∑ i, w i*(q i)^2) - (reportMean w q)^2 := by
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_mul]
      rw [hw1]
      change (∑ i, w i*(q i)^2)-2*reportMean w q*reportMean w q+1*(reportMean w q)^2 = _
      ring

/-- Each expected truth-state score decomposes into mean-report loss plus
exactly the randomisation variance. -/
theorem expected_excess_decomposition (w q : ι → ℝ) (hw1 : ∑ i, w i = 1)
    (a e : ℝ) :
    (∑ i, w i*excessZero a e (q i)) = excessZero a e (reportMean w q)+reportVariance w q ∧
    (∑ i, w i*excessOne a e (q i)) = excessOne a e (reportMean w q)+reportVariance w q := by
  rw [reportVariance_identity w q hw1]
  constructor
  · simp only [excessZero, mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hw1]
    ring
  · calc
      (∑ i, w i*excessOne a e (q i)) =
          (∑ i, (w i*(q i)^2 - 2*(w i*q i) + w i*(1-(a*(1/2-e)^2+(1-a)*(1/2)^2)))) := by
        apply Finset.sum_congr rfl
        intro i _
        unfold excessOne
        ring
      _ = excessOne a e (reportMean w q)+((∑ i,w i*(q i)^2)-(reportMean w q)^2) := by
        rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_mul, hw1]
        unfold excessOne reportMean
        ring

/-- Finite randomisation cannot lower minimax expected regret; its entire
variance is an additional cost. This is not a statement about success
probability of individual realised reports. -/
theorem randomised_regret_lower_bound (w q : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i)
    (hw1 : ∑ i,w i = 1) (hq0 : ∀ i, 0 ≤ q i) (hq1 : ∀ i, q i ≤ 1)
    (l u e : ℝ) (hl0 : 0 ≤ l) (hlu : l ≤ u) (hu1 : u ≤ 1)
    (he0 : 0 ≤ e) (he1 : e ≤ 1/4) :
    robustValue l u e + 2*reportVariance w q ≤
      max (∑ i,w i*excessZero l e (q i)) (∑ i,w i*excessOne u e (q i)) := by
  rw [(expected_excess_decomposition w q hw1 l e).1,
      (expected_excess_decomposition w q hw1 u e).2, max_add_add_right]
  have hm := reportMean_mem w q hw0 hw1 hq0 hq1
  exact add_le_add_right (robustValue_le_max l u e (reportMean w q) hl0 hlu hu1 he0 he1 hm.1 hm.2) _

end
end Orthemology.Tranche3

#print axioms Orthemology.Tranche3.expected_excess_decomposition
#print axioms Orthemology.Tranche3.randomised_regret_lower_bound
import IndependentTemplateControls
namespace IndependentRuleMapReview
open Encodable CodedRuleTemplates P01D P01AC JointCertificates AuxiliaryCertificates OrthemologyV2
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000
example : premisesCode (encode (Rule.HasJ_sigmaElim [] .raw .bottom .raw (.var 0) (.atom .i))) = ((Rule.HasJ_sigmaElim [] .raw .bottom .raw (.var 0) (.atom .i)).premises.tail).map encode := by
  rw [premisesCode_exact]; apply congrArg (List.map encode); decide
