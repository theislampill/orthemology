import RationalThresholdCuts

namespace AtomicMembership.RationalThreshold
open P02.Codec.UniformComputability

/-- Exact division semantics includes noncanonical and zero-denominator codes. -/
theorem code_lt_rational_iff (q : ℚ≥0) (i : ℕ) :
    rationalOfCode i < q ↔
      0 < q.num ∧ (i.unpair.2 = 0 ∨ i.unpair.1 * q.den < q.num * i.unpair.2) := by
  by_cases hd : i.unpair.2 = 0
  · simp [rationalOfCode, hd, NNRat.num_pos]
  · have hdq : (0 : ℚ≥0) < i.unpair.2 := by exact_mod_cast Nat.pos_of_ne_zero hd
    have hqd : (0 : ℚ≥0) < q.den := by exact_mod_cast q.den_pos
    have hrepr : (q.num : ℚ≥0) / q.den = q := by
      rw [← divNat_eq_div, NNRat.num_divNat_den]
    have hcross : rationalOfCode i < q ↔ i.unpair.1 * q.den < q.num * i.unpair.2 := by
      calc
        rationalOfCode i < q ↔ (i.unpair.1 : ℚ≥0) / i.unpair.2 < (q.num : ℚ≥0) / q.den := by
          rw [hrepr, rationalOfCode, divNat_eq_div]
        _ ↔ _ := by rw [div_lt_div_iff₀ hdq hqd]; exact_mod_cast Iff.rfl
    rw [hcross]
    constructor
    · intro h
      exact ⟨by nlinarith, Or.inr h⟩
    · rintro ⟨_,h|h⟩
      · exact (hd h).elim
      · exact h

theorem rational_lt_code_iff (q : ℚ≥0) (i : ℕ) :
    q < rationalOfCode i ↔
      i.unpair.2 ≠ 0 ∧ q.num * i.unpair.2 < i.unpair.1 * q.den := by
  by_cases hd : i.unpair.2 = 0
  · simp [rationalOfCode, hd]
  · have hdq : (0 : ℚ≥0) < i.unpair.2 := by exact_mod_cast Nat.pos_of_ne_zero hd
    have hqd : (0 : ℚ≥0) < q.den := by exact_mod_cast q.den_pos
    have hrepr : (q.num : ℚ≥0) / q.den = q := by
      rw [← divNat_eq_div, NNRat.num_divNat_den]
    have hcross : q < rationalOfCode i ↔ q.num * i.unpair.2 < i.unpair.1 * q.den := by
      calc
        q < rationalOfCode i ↔ (q.num : ℚ≥0) / q.den < (i.unpair.1 : ℚ≥0) / i.unpair.2 := by
          rw [hrepr, rationalOfCode, divNat_eq_div]
        _ ↔ _ := by rw [div_lt_div_iff₀ hqd hdq]; exact_mod_cast Iff.rfl
    simpa [hd] using hcross

theorem code_lt_rational_computable (q : ℚ≥0) :
    Computable (fun i : ℕ => decide (rationalOfCode i < q)) := by
  have ha := Primrec.fst.comp Primrec.unpair
  have hd := Primrec.snd.comp Primrec.unpair
  have hpos : PrimrecPred (fun _ : ℕ => 0 < q.num) := Primrec.nat_lt.comp (Primrec.const 0) (Primrec.const q.num)
  have hz := Primrec.eq.comp hd (Primrec.const 0)
  have hc := Primrec.nat_lt.comp (Primrec.nat_mul.comp ha (Primrec.const q.den))
    (Primrec.nat_mul.comp (Primrec.const q.num) hd)
  apply ((hpos.and (hz.or hc)).to_comp).of_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  simpa only [decide_eq_true_eq] using (code_lt_rational_iff q i).symm

theorem rational_lt_code_computable (q : ℚ≥0) :
    Computable (fun i : ℕ => decide (q < rationalOfCode i)) := by
  have ha := Primrec.fst.comp Primrec.unpair
  have hd := Primrec.snd.comp Primrec.unpair
  have hz := (Primrec.eq.comp hd (Primrec.const 0)).not
  have hc := Primrec.nat_lt.comp (Primrec.nat_mul.comp (Primrec.const q.num) hd)
    (Primrec.nat_mul.comp ha (Primrec.const q.den))
  apply ((hz.and hc).to_comp).of_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  simpa only [decide_eq_true_eq] using (rational_lt_code_iff q i).symm

theorem lowerCutMatrix_computable (q : ℚ≥0) :
    Computable (fun p : MatrixInput => decide (lowerCutMatrix q p.1 p.2.1 p.2.2.1 p.2.2.2)) := by
  have hi : Computable (fun p : MatrixInput => p.2.1) := Computable.fst.comp Computable.snd
  have hlt := (rational_lt_code_computable q).comp hi
  have h1 := (code_lt_rational_computable 1).comp hi
  apply (Primrec.and.to_comp.comp hlt (Primrec.and.to_comp.comp h1 membershipMatrix_computable)).of_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  simp [lowerCutMatrix, Bool.and_eq_true]

theorem upperCutMatrix_computable (q : ℚ≥0) :
    Computable (fun p : MatrixInput => decide (upperCutMatrix q p.1 p.2.1 p.2.2.1 p.2.2.2)) := by
  have hi : Computable (fun p : MatrixInput => p.2.1) := Computable.fst.comp Computable.snd
  have hlt := (code_lt_rational_computable q).comp hi
  apply (Primrec.or.to_comp.comp (Primrec.not.to_comp.comp hlt) membershipMatrix_computable).of_eq
  intro p
  apply Bool.eq_iff_iff.mpr
  simp [upperCutMatrix, Bool.or_eq_true, imp_iff_not_or]

end AtomicMembership.RationalThreshold
import Mathlib

/-! Executable finite directed reachability, with soundness and completeness
against Mathlib's ordinary reflexive-transitive closure. -/
namespace HiddenParity.FiniteReachability

variable {State : Type*} [Fintype State] [DecidableEq State]
variable (r : State → State → Prop) [DecidableRel r]

/-- One exact forward-closure round. -/
def grow (R : Finset State) : Finset State :=
  R ∪ R.biUnion (fun s => Finset.univ.filter (r s))

@[simp] theorem mem_grow {R : Finset State} {t : State} :
    t ∈ grow r R ↔ t ∈ R ∨ ∃ s ∈ R, r s t := by
  simp [grow]

theorem subset_grow (R : Finset State) : R ⊆ grow r R := Finset.subset_union_left

/-- Finite fuel computes a forward-closed superset after at most |State| rounds. -/
def saturate : ℕ → Finset State → Finset State
  | 0, R => R
  | n + 1, R => saturate n (grow r R)

theorem subset_saturate (n : ℕ) (R : Finset State) : R ⊆ saturate r n R := by
  induction n generalizing R with
  | zero => exact Finset.Subset.refl R
  | succ n ih => exact (subset_grow r R).trans (ih _)

theorem saturate_eq_of_stable {R : Finset State} (h : grow r R = R) (n : ℕ) :
    saturate r n R = R := by
  induction n with
  | zero => rfl
  | succ n ih => simpa only [saturate, h] using ih

/-- A cardinal bound proves saturation; no maximum simple-path lemma is assumed. -/
theorem saturate_stable (n : ℕ) (R : Finset State)
    (hBound : Fintype.card State - R.card ≤ n) :
    grow r (saturate r n R) = saturate r n R := by
  induction n generalizing R with
  | zero =>
      have hCard : R.card = Fintype.card State := by
        have := Finset.card_le_card (Finset.subset_univ R)
        simp only [Finset.card_univ] at this
        omega
      have hR : R = Finset.univ :=
        Finset.eq_of_subset_of_card_le (Finset.subset_univ R) (by simp [hCard])
      subst R
      simp [saturate, grow]
  | succ n ih =>
      by_cases hs : grow r R = R
      · rw [saturate_eq_of_stable r hs]
        exact hs
      · have hStrict : R ⊂ grow r R :=
          Finset.ssubset_iff_subset_ne.mpr ⟨subset_grow r R, Ne.symm hs⟩
        have hCard := Finset.card_lt_card hStrict
        have hTop : (grow r R).card ≤ Fintype.card State := by
          simpa using Finset.card_le_card (Finset.subset_univ (grow r R))
        exact ih (grow r R) (by omega)

theorem saturate_sound (s : State) (n : ℕ) (R : Finset State)
    (hR : ∀ t ∈ R, Relation.ReflTransGen r s t) :
    ∀ t ∈ saturate r n R, Relation.ReflTransGen r s t := by
  induction n generalizing R with
  | zero => exact hR
  | succ n ih =>
      apply ih
      intro t ht
      rcases (mem_grow r).mp ht with ht | ⟨u, hu, hut⟩
      · exact hR t ht
      · exact (hR u hu).tail hut

/-- Executable complete reachable-state set, with fixed fuel |State|. -/
def reachable (s : State) : Finset State := saturate r 0 {s}

/-- Sound and complete with respect to unbounded ordinary directed reachability. -/
theorem reachable_iff (s t : State) :
    t ∈ reachable r s ↔ Relation.ReflTransGen r s t := by
  constructor
  · exact saturate_sound r s (Fintype.card State) {s} (by
      intro u hu
      have : u = s := Finset.mem_singleton.mp hu
      subst u
      exact Relation.ReflTransGen.refl) t
  · intro h
    have hClosed : ∀ u ∈ reachable r s, ∀ v, r u v → v ∈ reachable r s := by
      intro u hu v huv
      have hst : grow r (reachable r s) = reachable r s :=
        saturate_stable r (Fintype.card State) {s} (Nat.sub_le _ _)
      rw [← hst]
      exact (mem_grow r).mpr (Or.inr ⟨u, hu, huv⟩)
    have hStart : s ∈ reachable r s := subset_saturate r _ _ (Finset.mem_singleton_self s)
    induction h with
    | refl => exact hStart
    | tail _ hyz ih => exact hClosed _ ih _ hyz

end HiddenParity.FiniteReachability
import Controls
import MomentValues

open MvPolynomial TruncatedMoment

-- Check theorem statements against the intended primitive domain and operations.
example (p : MvPolynomial (Fin 3) ℝ) (hdeg : p.totalDegree ≤ 2) (hne : p ≠ 0) :
    0 < TruncatedMoment.Lambda (p * p) := by
  simpa only [pow_two] using every_quadratic_square_positive p hdeg hne

example (v : Fin 3 → ℝ) : 0 ≤ MvPolynomial.eval v witness :=
  witness_nonnegative v

-- The actual witness is exactly degree four, rather than merely bounded above.
theorem independent_witness_degree_exact : witness.totalDegree = 4 := by
  apply Nat.le_antisymm witness_degree
  have hc : witness.coeff (exponent 2 2 0) ≠ 0 := by
    norm_num [witness, term, coeff_monomial, exponent_eq_iff]
  have h := le_totalDegree (mem_support_iff.mpr hc)
  simpa only [exponent_sum] using h

-- Finite atomic positive representations are already excluded by evaluation
-- positivity and the actual negative witness value, with no measure import.
theorem independent_no_finite_atomic_representation {ι : Type*} (s : Finset ι)
    (w : ι → ℝ) (v : ι → Fin 3 → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i)
    (hagrees : ∀ p : Poly, p.totalDegree ≤ 4 →
      Lambda p = ∑ i ∈ s, w i * MvPolynomial.eval (v i) p) : False := by
  have hn : 0 ≤ ∑ i ∈ s, w i * MvPolynomial.eval (v i) witness :=
    Finset.sum_nonneg (fun i hi => mul_nonneg (hw i hi) (witness_nonnegative (v i)))
  rw [← hagrees witness witness_degree, Lambda_witness] at hn
  norm_num at hn

#print axioms independent_witness_degree_exact
#print axioms independent_no_finite_atomic_representation
import Application

/- Complementary model argument: meta-level absence of a source refutation.
The inherited full-PER model semantically validates W, without deriving W. -/
namespace T20SourceIndependence
open P01AC P01D
open P01AC.ExtensionalRepair (HasE)
open P01AC.ExtensionalRepair.ExactScalarFusion (W c3)

 theorem no_internal_negation (p : Poly) :
    ¬ HasE [] p (arr (W FullPER.Application.originalQ) .bottom) := by
  intro h
  have hp := FullPER.fundamental h FullPER.Application.emptyEnv
    FullPER.zeroEnv FullPER.zeroEnv FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩
  rw [FullPER.F_arr] at hp
  exact hp _ _ (FullPER.Application.scalar_target_valid
    FullPER.Application.emptyEnv FullPER.zeroEnv)

#print axioms no_internal_negation
end T20SourceIndependence
