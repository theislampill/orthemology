import Std

/-!
General exact-reset continuation theorem. No finite-instance enumeration is used.
Every state is a complete Boolean valuation. `coords` is any exhaustive finite list.
-/
namespace ResetContinuation

universe u v w s

abbrev State (I : Type u) := I → Bool

def Essential {I : Type u} {O : Type v} (f : State I → O) (i : I) : Prop :=
  ∃ x y, (∀ j, j ≠ i → x j = y j) ∧ f x ≠ f y

inductive Closure {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) : I → Prop where
  | output {i} : Essential h i → Closure h T i
  | dependency {i j} (a : A) : Closure h T j →
      Essential (fun x => T a x j) i → Closure h T i

inductive Action (I : Type u) (A : Type w) where
  | reset : I → Bool → Action I A
  | coupled : A → Action I A

def reset {I : Type u} [DecidableEq I] (i : I) (b : Bool) (x : State I) : State I :=
  fun j => if j = i then b else x j

def step {I : Type u} [DecidableEq I] {A : Type w}
    (T : A → State I → State I) : Action I A → State I → State I
  | .reset i b, x => reset i b x
  | .coupled a, x => T a x

def run {I : Type u} [DecidableEq I] {A : Type w}
    (T : A → State I → State I) : List (Action I A) → State I → State I
  | [], x => x
  | a :: as, x => run T as (step T a x)

def ContinuationEq {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (x y : State I) : Prop :=
  ∀ word, h (run T word x) = h (run T word y)

def Agree {I : Type u} (P : I → Prop) (x y : State I) : Prop :=
  ∀ i, P i → x i = y i

theorem run_append {I : Type u} [DecidableEq I] {A : Type w}
    (T : A → State I → State I) (p q : List (Action I A)) (x : State I) :
    run T (p ++ q) x = run T q (run T p x) := by
  induction p generalizing x with
  | nil => rfl
  | cons a p ih => exact ih (step T a x)

theorem determined_aux {I : Type u} [DecidableEq I] {O : Type v}
    (f : State I → O) (l : List I) {x y : State I}
    (hdiff : ∀ j, x j ≠ y j → j ∈ l)
    (hess : Agree (Essential f) x y) : f x = f y := by
  classical
  induction l generalizing x with
  | nil =>
      have hxy : x = y := by
        funext j
        apply Classical.byContradiction
        intro hne
        exact List.not_mem_nil (hdiff j hne)
      rw [hxy]
  | cons i l ih =>
      let z := reset i (y i) x
      have hxz : f x = f z := by
        by_cases hi : Essential f i
        · have eqxz : x = z := by
            funext j
            by_cases hji : j = i
            · subst j
              simpa [z, reset] using hess i hi
            · simp [z, reset, hji]
          rw [eqxz]
        · apply Classical.byContradiction
          intro hne
          apply hi
          refine ⟨x, z, ?_, hne⟩
          intro j hji
          simp [z, reset, hji]
      apply hxz.trans
      apply ih
      · intro j hne
        have hji : j ≠ i := by
          intro e
          subst j
          exact hne (by simp [z, reset])
        have hxy : x j ≠ y j := by simpa [z, reset, hji] using hne
        exact (List.mem_cons.mp (hdiff j hxy)).resolve_left hji
      · intro j hj
        by_cases hji : j = i
        · subst j
          simp [z, reset]
        · simpa [z, reset, hji] using hess j hj

theorem essential_determines {I : Type u} [DecidableEq I] {O : Type v}
    (coords : List I) (covers : ∀ i, i ∈ coords) (f : State I → O)
    {x y : State I} (hess : Agree (Essential f) x y) : f x = f y :=
  determined_aux f coords (fun j _ => covers j) hess

/-- A concrete common word resets all listed coordinates except the exposed one. -/
def contextWord {I : Type u} [DecidableEq I] {A : Type w}
    (i : I) (u : State I) : List I → List (Action I A)
  | [] => []
  | j :: js => if j = i then contextWord i u js
      else Action.reset j (u j) :: contextWord i u js

theorem contextWord_apply {I : Type u} [DecidableEq I] {A : Type w}
    (T : A → State I → State I) (i : I) (u x : State I) (l : List I) (j : I) :
    run T (contextWord (A := A) i u l) x j =
      if j ≠ i ∧ j ∈ l then u j else x j := by
  induction l generalizing x with
  | nil => simp [contextWord, run]
  | cons k l ih =>
      by_cases hki : k = i
      · subst k
        by_cases hji : j = i
        · subst j
          simp [contextWord, ih]
        · simp [contextWord, ih, hji]
      · simp only [contextWord, if_neg hki, run, step]
        rw [ih]
        by_cases hji : j = i
        · subst j
          simp [hki, Ne.symm hki, reset]
        · by_cases hjk : j = k
          · subst j
            simp [hki, reset]
          · simp [hji, hjk, reset]

theorem contextWord_realizes {I : Type u} [DecidableEq I] {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (T : A → State I → State I) (i : I) (u x : State I) (hi : x i = u i) :
    run T (contextWord (A := A) i u coords) x = u := by
  funext j
  rw [contextWord_apply]
  by_cases hji : j = i
  · subst j
    simpa using hi
  · simp [hji, covers j]

theorem witness_coordinate_diff {I : Type u} {O : Type v}
    (f : State I → O) {i : I} {u v : State I}
    (hother : ∀ j, j ≠ i → u j = v j) (hout : f u ≠ f v) : u i ≠ v i := by
  intro hi
  apply hout
  congr 1
  funext j
  by_cases hji : j = i
  · subst j
    exact hi
  · exact hother j hji

theorem bool_pair_match (a b c d : Bool) (hab : a ≠ b) (hcd : c ≠ d) :
    (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  cases a <;> cases b <;> cases c <;> cases d <;> simp_all

/-- Essentiality can expose every pair differing at that coordinate by a common reset word. -/
theorem expose_essential {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (T : A → State I → State I) (f : State I → O) {i : I}
    (he : Essential f i) {x y : State I} (hxy : x i ≠ y i) :
    ∃ word : List (Action I A), f (run T word x) ≠ f (run T word y) := by
  obtain ⟨u, v, hother, hout⟩ := he
  have huv := witness_coordinate_diff f hother hout
  have hcontext : contextWord (A := A) i u coords = contextWord i v coords := by
    clear covers
    induction coords with
    | nil => rfl
    | cons j js ih =>
        by_cases hji : j = i
        · simp [contextWord, hji, ih]
        · simp [contextWord, hji, hother j hji, ih]
  refine ⟨contextWord i u coords, ?_⟩
  rcases bool_pair_match (x i) (y i) (u i) (v i) hxy huv with h | h
  · rw [contextWord_realizes coords covers T i u x h.1]
    have hy : run T (contextWord i u coords) y = v := by
      rw [hcontext]
      exact contextWord_realizes coords covers T i v y h.2
    rw [hy]
    exact hout
  · have hx : run T (contextWord i u coords) x = v := by
      rw [hcontext]
      exact contextWord_realizes coords covers T i v x h.1
    rw [hx, contextWord_realizes coords covers T i u y h.2]
    exact Ne.symm hout

/-- The strengthened necessity statement, for arbitrary surrounding differences. -/
theorem closure_distinguishes {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) {i : I}
    (hi : Closure h T i) :
    ∀ x y : State I, x i ≠ y i →
      ∃ word, h (run T word x) ≠ h (run T word y) := by
  induction hi with
  | output he =>
      intro x y hxy
      exact expose_essential coords covers T h he hxy
  | @dependency i j a hj he ih =>
      intro x y hxy
      obtain ⟨pre, hp⟩ := expose_essential coords covers T (fun z => T a z j) he hxy
      obtain ⟨suffix, hs⟩ := ih (T a (run T pre x)) (T a (run T pre y)) hp
      refine ⟨pre ++ Action.coupled a :: suffix, ?_⟩
      simpa [run_append, run, step] using hs

theorem closure_output {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) {x y : State I}
    (ha : Agree (Closure h T) x y) : h x = h y :=
  essential_determines coords covers h (fun i hi => ha i (Closure.output hi))

theorem closure_step {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) (a : Action I A)
    {x y : State I} (ha : Agree (Closure h T) x y) :
    Agree (Closure h T) (step T a x) (step T a y) := by
  intro j hj
  cases a with
  | reset i b =>
      by_cases hji : j = i
      · simp [step, reset, hji]
      · simpa [step, reset, hji] using ha j hj
  | coupled a =>
      exact essential_determines coords covers (fun z => T a z j)
        (fun i hi => ha i (Closure.dependency a hj hi))

theorem agreement_continuation {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) {x y : State I}
    (ha : Agree (Closure h T) x y) : ContinuationEq h T x y := by
  intro word
  induction word generalizing x y with
  | nil => exact closure_output coords covers h T ha
  | cons a word ih =>
      exact ih (closure_step coords covers h T a ha)

/-- Main characterization: independently defined behavioral and coordinate relations coincide. -/
theorem continuation_iff_agreement {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) (x y : State I) :
    ContinuationEq h T x y ↔ Agree (Closure h T) x y := by
  constructor
  · intro hc i hi
    apply Classical.byContradiction
    intro hne
    obtain ⟨word, hw⟩ := closure_distinguishes coords covers h T hi x y hne
    exact hw (hc word)
  · exact agreement_continuation coords covers h T

/-- The stages from the source theorem, defined without using behavioral equivalence. -/
def Stage {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) : Nat → I → Prop
  | 0, i => Essential h i
  | n + 1, i => Stage h T n i ∨
      ∃ a j, Stage h T n j ∧ Essential (fun x => T a x j) i

theorem stage_subset_closure {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (n : Nat) {i : I}
    (hi : Stage h T n i) : Closure h T i := by
  induction n generalizing i with
  | zero => exact Closure.output hi
  | succ n ih =>
      rcases hi with hi | ⟨a, j, hj, he⟩
      · exact ih hi
      · exact Closure.dependency a (ih hj) he

theorem closure_iff_stage {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (i : I) :
    Closure h T i ↔ ∃ n, Stage h T n i := by
  constructor
  · intro hi
    induction hi with
    | output he => exact ⟨0, he⟩
    | @dependency i j a hj he ih =>
        obtain ⟨n, hn⟩ := ih
        exact ⟨n + 1, Or.inr ⟨a, j, hn, he⟩⟩
  · rintro ⟨n, hn⟩
    exact stage_subset_closure h T n hn

theorem closure_least {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (P : I → Prop)
    (base : ∀ i, Essential h i → P i)
    (back : ∀ a i j, P j → Essential (fun x => T a x j) i → P i)
    {i : I} (hi : Closure h T i) : P i := by
  induction hi with
  | output he => exact base _ he
  | dependency a hj he ih => exact back a _ _ ih he

abbrev ProjectionState {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) :=
  {i : I // Closure h T i} → Bool

def project {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (x : State I) :
    ProjectionState h T := fun i => x i.val

noncomputable def fill {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I)
    (z : ProjectionState h T) : State I := by
  classical
  exact fun i => if hi : Closure h T i then z ⟨i, hi⟩ else false

theorem project_fill {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (z : ProjectionState h T) :
    project h T (fill h T z) = z := by
  funext i
  simp [project, fill, i.property]

theorem project_eq_iff_agree {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (x y : State I) :
    project h T x = project h T y ↔ Agree (Closure h T) x y := by
  constructor
  · intro he i hi
    exact congrFun he ⟨i, hi⟩
  · intro ha
    funext i
    exact ha i.val i.property

theorem fill_project_agrees {I : Type u} {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (x : State I) :
    Agree (Closure h T) (fill h T (project h T x)) x := by
  apply (project_eq_iff_agree h T _ _).mp
  exact project_fill h T (project h T x)

/-- A deterministic summary must decode the present output and update under each same label. -/
structure Summary {I : Type u} [DecidableEq I] {O : Type v} {A : Type w}
    (h : State I → O) (T : A → State I → State I) (S : Type s) where
  encode : State I → S
  decode : S → O
  update : Action I A → S → S
  decode_encode : ∀ x, decode (encode x) = h x
  update_encode : ∀ a x, update a (encode x) = encode (step T a x)

/-- Explicit zero-filled implementation of the dependency projection. -/
noncomputable def projection_summary {I : Type u} [DecidableEq I]
    {O : Type v} {A : Type w}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) :
    Summary h T (ProjectionState h T) where
  encode := project h T
  decode := fun z => h (fill h T z)
  update := fun a z => project h T (step T a (fill h T z))
  decode_encode := fun x => closure_output coords covers h T (fill_project_agrees h T x)
  update_encode := by
    intro a x
    apply (project_eq_iff_agree h T _ _).mpr
    exact closure_step coords covers h T a (fill_project_agrees h T x)

theorem summary_eq_continuation {I : Type u} [DecidableEq I]
    {O : Type v} {A : Type w} {S : Type s}
    (h : State I → O) (T : A → State I → State I) (M : Summary h T S)
    {x y : State I} (he : M.encode x = M.encode y) : ContinuationEq h T x y := by
  intro word
  have hrun : ∀ (w : List (Action I A)) (x y : State I),
      M.encode x = M.encode y → M.encode (run T w x) = M.encode (run T w y) := by
    intro w
    induction w with
    | nil => intro x y he; exact he
    | cons a w ih =>
        intro x y he
        apply ih
        rw [← M.update_encode, ← M.update_encode, he]
  rw [← M.decode_encode, ← M.decode_encode, hrun word x y he]

/-- Coarseness: no continuation-complete deterministic summary can merge two projection states. -/
theorem every_summary_refines_projection {I : Type u} [DecidableEq I]
    {O : Type v} {A : Type w} {S : Type s}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) (M : Summary h T S)
    {x y : State I} (he : M.encode x = M.encode y) : project h T x = project h T y := by
  apply (project_eq_iff_agree h T x y).mpr
  apply (continuation_iff_agreement coords covers h T x y).mp
  exact summary_eq_continuation h T M he

/-- A recover function exists on the entire summary type, including unreachable summary values. -/
theorem summary_factors_projection {I : Type u} [DecidableEq I]
    {O : Type v} {A : Type w} {S : Type s}
    (coords : List I) (covers : ∀ i, i ∈ coords)
    (h : State I → O) (T : A → State I → State I) (M : Summary h T S) :
    ∃ recover : S → ProjectionState h T, ∀ x, recover (M.encode x) = project h T x := by
  classical
  let recover : S → ProjectionState h T := fun s =>
    if hs : ∃ x, M.encode x = s then project h T (Classical.choose hs) else fun _ => false
  refine ⟨recover, ?_⟩
  intro x
  have hs : ∃ y, M.encode y = M.encode x := ⟨x, rfl⟩
  simp only [recover, dif_pos hs]
  exact every_summary_refines_projection coords covers h T M (Classical.choose_spec hs)

/-- The exact original finite-dimensional product, uniformly for all natural dimensions. -/
theorem fin_continuation_iff_agreement {n : Nat} {O : Type v} {A : Type w}
    (h : State (Fin n) → O) (T : A → State (Fin n) → State (Fin n))
    (x y : State (Fin n)) :
    ContinuationEq h T x y ↔ Agree (Closure h T) x y := by
  apply continuation_iff_agreement (List.ofFn (fun i : Fin n => i))
  intro i
  exact List.mem_ofFn.mpr ⟨i, rfl⟩

#print axioms continuation_iff_agreement
#print axioms closure_iff_stage
#print axioms projection_summary
#print axioms every_summary_refines_projection
#print axioms summary_factors_projection
#print axioms fin_continuation_iff_agreement

end ResetContinuation
import SeparatingProjection
open scoped BigOperators
example {K : Type*} [Field K] [Infinite K] {N d : ℕ}
    (x : Fin N → Fin d → K) :
    ∃ v : Fin d → K, Function.Injective (fun i => ∑ j, v j * x i j) := by
  exact FiniteMoment.exists_separating_projection x
import CandidateWitnesses
open P02A2.ObserverCore P02A2.CandidateSource P02A2.CandidateWitnesses
example : exec (wrongTestBound (matrixCall boundedMatrix 3 0) (.constant 2)) zeroStore 3 = 2 := by
  rw [candidate_checks_inclusive_test_bound.2]
  decide
import StackActionLaw
import RecurrentSupport
import Mathlib.Probability.BorelCantelli

noncomputable section
open MeasureTheory ProbabilityTheory Filter Set
open scoped BigOperators ENNReal
open Orthemology.Tranche2 Orthemology.Tranche2.PolicyEmbedding

namespace HiddenParity.Adaptive
universe u v
variable {A Y : Type u} {R : Type v}
variable [Fintype A] [Fintype Y] [DecidableEq A] [Inhabited Y]
variable [MeasurableSpace R] [MeasurableSpace A] [MeasurableSingletonClass A]
variable [MeasurableSpace Y] [MeasurableSingletonClass Y]

omit [Inhabited Y] [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- Under the actual independent stack experiment, every positive-probability
symbol occurs infinitely in a fixed raw pair tape. No adaptive sample-count
conditioning is used. -/
theorem seeded_tape_positive_symbol_recurs
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (P : A → Y → ℝ) (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (a : A) (y : Y) (hPos : 0 ≤ P a y) :
    ∀ᵐ z ∂ρ.prod (stackMeasure P hP hN), ∃ᶠ n in atTop, seededStackCoordinate a n z = y := by
  let μ := ρ.prod (stackMeasure P hP hN)
  let events : ℕ → Set (R × FlatStack A Y) := fun n => {z | seededStackCoordinate a n z = y}
  have hMeas : ∀ n, MeasurableSet (events n) := fun n =>
    (measurableSet_singleton y).preimage (seededStackCoordinate_measurable a n)
  have hFun := (seededStackCoordinates_independent ρ P hP hN).precomp
    (show Function.Injective (fun n : ℕ => (a,n)) from fun _ _ h => congrArg Prod.snd h)
  have hInd : iIndepSet events μ := by
    rw [iIndepSet_iff_meas_biInter hMeas]
    intro I
    exact hFun.measure_inter_preimage_eq_mul I (fun _ _ => measurableSet_singleton y)
  have hMass : ∀ n, μ (events n) = ENNReal.ofReal (P a y) := by
    intro n
    change (ρ.prod (stackMeasure P hP hN)) (seededStackCoordinate a n ⁻¹' {y}) = _
    rw [← Measure.map_apply (seededStackCoordinate_measurable a n) (measurableSet_singleton y),
      seededStackCoordinate_law ρ P hP hN, actionMeasure_singleton]
  have hSum : (∑' n, μ (events n)) = ∞ := by
    simp_rw [hMass]
    exact ENNReal.tsum_const_eq_top_of_ne_zero (ENNReal.ofReal_pos.mpr hPos).ne'
  have hOne := measure_limsup_eq_one hMeas hInd hSum
  have hEvent : limsup events atTop = {z | ∃ᶠ n in atTop, seededStackCoordinate a n z = y} := by
    ext z
    simp only [limsup_eq_iInf_iSup_of_nat, Set.iInf_eq_iInter, Set.iSup_eq_iUnion,
      Set.mem_iInter, Set.mem_iUnion, Set.mem_setOf_eq, frequently_atTop, events, exists_prop]
  have hRecMeas : MeasurableSet {z : R × FlatStack A Y |
      ∃ᶠ n in atTop, seededStackCoordinate a n z = y} :=
    Orthemology.Tranche2.RecurrentSupport.measurable_recurrence
      (fun z n => seededStackCoordinate a n z) (fun n => seededStackCoordinate_measurable a n) y
  apply (ae_iff_measure_eq hRecMeas.nullMeasurableSet).mpr
  rw [measure_univ]
  rwa [hEvent] at hOne

omit [Inhabited Y] [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- This probability-one raw-tape event is uniform over all pairs and symbols,
and does not depend on which causal policy later consumes them. -/
theorem seeded_all_tapes_recurrent
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (P : A → Y → ℝ) (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1) :
    ∀ᵐ z ∂ρ.prod (stackMeasure P hP hN),
      ∀ a y, 0 < P a y → ∃ᶠ n in atTop, seededStackCoordinate a n z = y := by
  apply ae_all_iff.mpr
  intro a
  apply ae_all_iff.mpr
  intro y
  by_cases h : 0 < P a y
  · exact (seeded_tape_positive_symbol_recurs ρ P hP hN a y h).mono (fun _ hx _ => hx)
  · exact ae_of_all _ (fun _ hx => (h hx).elim)

omit [Inhabited Y] [MeasurableSpace A] [MeasurableSingletonClass A] in
/-- Every actually sampled raw symbol lies in its row's positive support. -/
theorem seeded_all_tapes_supported
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (P : A → Y → ℝ) (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1) :
    ∀ᵐ z ∂ρ.prod (stackMeasure P hP hN), ∀ a n, 0 < P a (seededStackCoordinate a n z) := by
  classical
  have hZero : ∀ a n y, P a y = 0 →
      ∀ᵐ z ∂ρ.prod (stackMeasure P hP hN), seededStackCoordinate a n z ≠ y := by
    intro a n y hz
    rw [ae_iff]
    simp only [not_not]
    change (ρ.prod (stackMeasure P hP hN)) (seededStackCoordinate a n ⁻¹' {y}) = 0
    rw [← Measure.map_apply (seededStackCoordinate_measurable a n) (measurableSet_singleton y),
      seededStackCoordinate_law ρ P hP hN, actionMeasure_singleton, hz, ENNReal.ofReal_zero]
  have hAll : ∀ᵐ z ∂ρ.prod (stackMeasure P hP hN),
      ∀ a n y, P a y = 0 → seededStackCoordinate a n z ≠ y := by
    apply ae_all_iff.mpr
    intro a
    apply ae_all_iff.mpr
    intro n
    apply ae_all_iff.mpr
    intro y
    by_cases hz : P a y = 0
    · exact (hZero a n y hz).mono (fun _ h _ => h)
    · exact ae_of_all _ (fun _ h => (hz h).elim)
  filter_upwards [hAll] with z hz
  intro a n
  by_contra hn
  have hp : P a (seededStackCoordinate a n z) = 0 :=
    le_antisymm (le_of_not_gt hn) (hP a _)
  exact hz a n _ hp rfl

end HiddenParity.Adaptive
import JointSigmaExtraction
import JointExtractionControls
import Lean

namespace JointCompletion.DependentExtraction.Controls
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness (N inputNumeral iterationPoly)
open P01AC.Intensional.Plus (PolyConvPlus)
open JointCompletion.Controls (newMotive newMotive_subst)
open JointCompletion.ExtractionInput (control control_has)
open ClosedScalarInstances (scalarLeft)
set_option maxRecDepth 32768
set_option maxHeartbeats 16000000

/-- Both genuinely dependent in the numeric index and genuinely newly formed. -/
def fiber : Ty := .sigma (.identity N (.var 0) (inputNumeral 2)) (wk newMotive)
def fiberAt (n : Poly) : Ty := .sigma (.identity N n (inputNumeral 2)) newMotive
def evidence : Poly := pairPoly (.atom .i) (.atom .i)
def package : Poly := pairPoly control evidence

theorem fiber_inst (n : Poly) : inst fiber n = fiberAt n := by
  simp [fiber, fiberAt, inst, subst, P01AC.BooleanPrimitive.N_subst, psub, cons,
    P01AC.BooleanPrimitive.psub_closed (P01AC.has_scoped (P01AC.EffectiveCompleteness.inputNumeral_has 2)),
    wk, newMotive_subst]

theorem fiber_form : FormJ [N] fiber := by
  have cN : CtxJ [N] := .ext .nil (Structural.form_nat .nil)
  have hn : HasJ [N] (.var 0) N := .var (Structural.form_nat cN) .zero
  have hk : HasJ [N] (inputNumeral 2) N :=
    closed_has (.hasBase (EffectiveNumerals.old_numeral_has 2)) cN
  have hi := FormJ.identity (Structural.form_nat cN) hn hk
  exact .sigma hi (Structural.form_wk JointCompletion.Controls.new_motive_at_N cN hi)

theorem fiberAt_form (n : Poly) (hn : HasJ [] n N) : FormJ [] (fiberAt n) :=
  fiber_inst n ▸ Structural.form_inst .nil fiber_form hn

theorem evidence_has : HasJ [] evidence (inst fiber control) := by
  rw [fiber_inst]
  have hi : HasJ [] (.atom .i) (.identity N control (inputNumeral 2)) :=
    canonicity_at_count control_has EffectiveNumerals.Controls.control_iteration
  apply HasJ.sigmaIntro (fiberAt_form control control_has)
    (show FormJ [] (inst newMotive (.atom .i)) by
      simpa only [inst, newMotive_subst] using JointCompletion.Controls.new_motive_form Ctx.nil) hi
  simpa only [inst, newMotive_subst] using JointCompletion.Controls.new_motive_reentry

theorem package_has : HasJ [] package (.sigma N fiber) :=
  .sigmaIntro (.sigma (Structural.form_nat .nil) fiber_form)
    (Structural.form_inst .nil fiber_form control_has) control_has evidence_has

/-- This particular inhabited fiber is unavailable even as old-E formation. -/
theorem fiberAt_two_not_old :
    ¬ P01AC.ExtensionalRepair.FormE [] (fiberAt (inputNumeral 2)) := by
  intro h
  have hn := EffectiveNumerals.old_numeral_has 2
  have hI : P01AC.ExtensionalRepair.FormE [] (.identity N (inputNumeral 2) (inputNumeral 2)) :=
    .identity (RigidityInitiality.FullE.N_form .nil) hn hn
  have hi : P01AC.ExtensionalRepair.HasE [] (.atom .i)
      (.identity N (inputNumeral 2) (inputNumeral 2)) :=
    .identityIntro hI hn hn (.refl _)
  cases h with
  | sigma _ hB =>
      have hc := P01AC.ExtensionalRepair.Structural.form_inst .nil hB hi
      apply JointCompletion.Controls.new_motive_not_old
      simpa only [inst, newMotive_subst] using hc

theorem fiber_not_old : ¬ P01AC.ExtensionalRepair.FormE [N] fiber := by
  intro h
  apply fiberAt_two_not_old
  rw [← fiber_inst]
  exact P01AC.ExtensionalRepair.Structural.form_inst .nil h
    (EffectiveNumerals.old_numeral_has 2)

theorem package_type_not_old :
    ¬ P01AC.ExtensionalRepair.FormE [] (.sigma N fiber) := by
  intro h
  cases h with | sigma _ hP => exact fiber_not_old hP

theorem package_type_uninhabited_old (p : Poly) :
    ¬ P01AC.ExtensionalRepair.HasE [] p (.sigma N fiber) :=
  fun h => package_type_not_old (P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed h)

/-- Dependency is real: returning numeral one would leave an empty Joint fiber. -/
theorem wrong_index_uninhabited (p : Poly) :
    ¬ HasJ [] p (fiberAt (inputNumeral 1)) := by
  intro h
  have hS := Structural.has_form h
  have hId := HasJ.sigmaFst (form_sigma_inv hS).1 hS h
  have impossible := identity_implies_count_eq
    (.hasBase (EffectiveNumerals.old_numeral_has 1))
    (.hasBase (EffectiveNumerals.old_numeral_has 2))
    (ClosedChurchIdentity.numeral_observation 1)
    (ClosedChurchIdentity.numeral_observation 2) hId
  cases impossible

theorem package_first : PolyConvPlus (fstPoly package) control := by
  apply ClosedScalarInstances.generic_conversion_reflect
  simpa only [package, JointCompletion.eval_fst, JointCompletion.eval_pair] using
    OpenTermStandardness.fst_pair
      (ImportedOpenTermTransport.interp control OpenTermStandardness.T.var)
      (ImportedOpenTermTransport.interp evidence OpenTermStandardness.T.var)

theorem package_iteration : PolyConvPlus (scalarLeft (fstPoly package)) (iterationPoly 2) :=
  ((PolyConvPlus.app (.app package_first (.refl _)) (.refl _))).trans
    EffectiveNumerals.Controls.control_iteration

theorem package_extracts_two : (extractSigma fiber package package_has).count = 2 :=
  extractSigma_unique package_has package_iteration

theorem preserved_fiber_at_two :
    HasJ [] (sndPoly package) (fiberAt (inputNumeral 2)) := by
  have h := (extractSigma fiber package package_has).fiber_has
  simpa only [package_extracts_two, fiber_inst] using h

#eval @decide _ (decideTypedIdentity control_has (.hasBase (EffectiveNumerals.old_numeral_has 2)))
#eval @decide _ (decideTypedIdentity control_has (.hasBase (EffectiveNumerals.old_numeral_has 1)))
#print axioms fiberAt_two_not_old
#print axioms fiber_not_old
#print axioms package_type_uninhabited_old
#print axioms wrong_index_uninhabited
#eval (extractSigma fiber package package_has).count
#print axioms fiber_form
#print axioms package_has
#print axioms package_extracts_two
#print axioms preserved_fiber_at_two
end JointCompletion.DependentExtraction.Controls

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  for target in [``JointCompletion.DependentExtraction.identity_of_observation,
      ``JointCompletion.DependentExtraction.canonicity_at_count,
      ``JointCompletion.DependentExtraction.extracted_identity,
      ``JointCompletion.DependentExtraction.identity_implies_count_eq,
      ``JointCompletion.DependentExtraction.identity_iff_extracted_count,
      ``JointCompletion.DependentExtraction.decideTypedIdentity,
      ``JointCompletion.DependentExtraction.transport_source,
      ``JointCompletion.DependentExtraction.transport_erased,
      ``JointCompletion.DependentExtraction.extractSigma,
      ``JointCompletion.DependentExtraction.extractSigma_unique,
      ``JointCompletion.DependentExtraction.extracted_continuation,
      ``JointCompletion.DependentExtraction.Controls.package_has,
      ``JointCompletion.DependentExtraction.Controls.wrong_index_uninhabited,
      ``JointCompletion.DependentExtraction.Controls.package_type_uninhabited_old,
      ``JointCompletion.DependentExtraction.Controls.package_extracts_two,
      ``JointCompletion.DependentExtraction.Controls.preserved_fiber_at_two] do
    let (_, report) := ((Lean.CollectAxioms.collect target).run env).run {}
    for a in report.axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains a do
        throwError "Unexpected axiom in {target}: {a}"
    logInfo m!"PASS {target}: only standard logical axioms."
  for target in [``JointCompletion.DependentExtraction.identity_of_observation,
      ``JointCompletion.DependentExtraction.canonicity_at_count,
      ``JointCompletion.DependentExtraction.transport_source,
      ``JointCompletion.DependentExtraction.transport_erased] do
    let (_, source) := ((Lean.CollectAxioms.collect target).run env).run {}
    for forbidden in [``FullPER.fundamental, ``JointCompletion.fundamental,
        ``JointCompletion.sigma_elimination, ``JointCompletion.dependent_induction] do
      if source.visited.contains forbidden then
        throwError "Semantic shortcut in source construction {target}: {forbidden}"
    logInfo m!"PASS {target}: no semantic typing shortcut."
