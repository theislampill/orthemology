  norm_num
import SourceIdentity
import ProductiveCompleteness

/-!
A two-world non-vacuity witness for the declared source package. This shows
compatibility of the formal assumptions with a contingent effect; it does not
establish the interpretation premises in actual metaphysics.
-/

namespace Orthemology.Tranche3.IntegratedContingency
open SourceIdentity ProductiveCompleteness

set_option synthInstance.maxSize 4096

/-- 0 is the source, 1 a particular derivative bearer. -/
def Ex (w : Bool) (x : Fin 2) : Prop := x = 0 ∨ w = true

def Dep (w : Bool) (y x : Fin 2) : Prop :=
  w = true ∧ y = 0 ∧ x = 1

def Will (w : Bool) : Prop := w = true

def Power (_ : Bool) : Prop := True

/-- Both source power and the particular complete will suffice for the effect.
Power alone does not necessitate that this particular will occurs. -/
theorem source_with_contingent_effect :
    Root Ex Dep true 0 ∧
    (∀ x, Ex true x → ¬ Necessary Ex x → Received Dep true x) ∧
    GenericReception Ex Dep ∧
    UniformRoot Ex Dep 0 ∧
    Ex true 1 ∧ Ex false 1 ∧
    (∀ w, Power w) ∧
    (∀ w, Power w ∧ Will w → Ex w 1) ∧
    (¬ ∀ w, Will w) := by
  simp only [Root, Necessary, Received, GenericReception, UniformRoot, Ex, Dep,
    Power, Will]
  decide

/-- In the actual world each production mode has the single unborrowed source.
The source is not counted as a product of its own act. -/
def Complete (s : Fin 2) (_ : Unit) : Prop := s = 0

def Mode (_ _ : Unit) : Prop := True

def Proper (s : Fin 2) (_ : Unit) : Prop := s = 0

def Account (s : Fin 2) (_ : Unit) : Prop := s = 0

theorem productive_package_is_inhabited :
    Complete 0 () ∧
    HistoryComplete Complete Mode Account ∧
    UnborrowedActs Proper Account ∧
    ProductiveWitness Complete Mode Proper := by
  simp only [Complete, HistoryComplete, UnborrowedActs, ProductiveWitness,
    Mode, Account, Proper]
  decide

/-- A single named theorem supplies both positive witnesses at once; neither
part is true solely because there are no actual sources/effects. -/
theorem integrated_noncollapse_witness :
    UniformRoot Ex Dep 0 ∧ Ex true 1 ∧ ¬ Ex false 1 ∧
    Complete 0 () ∧ HistoryComplete Complete Mode Account ∧
    UnborrowedActs Proper Account ∧ ProductiveWitness Complete Mode Proper := by
  exact ⟨source_with_contingent_effect.2.2.2.1,
    source_with_contingent_effect.2.2.2.2.1,
    source_with_contingent_effect.2.2.2.2.2.1,
    productive_package_is_inhabited.1,
    productive_package_is_inhabited.2.1,
    productive_package_is_inhabited.2.2.1,
    productive_package_is_inhabited.2.2.2⟩

#print axioms source_with_contingent_effect
#print axioms productive_package_is_inhabited
#print axioms integrated_noncollapse_witness

end Orthemology.Tranche3.IntegratedContingency
import SectionCorollaries
namespace RigidityInitiality
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open SourceRigidity
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

def shiftedFamily (P : Ty) := subst (pup (fun k => .var (k+1))) P

theorem shifted_family_form {Γ : Tel} {P B : Ty} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hB : Form Γ B) : Form (N :: B :: Γ) (shiftedFamily P) := by
  have hE : Form Γ (total P) := .sigma (N_form hc) hP
  have hEw : Form (B :: Γ) (.sigma N (shiftedFamily P)) := by
    simpa only [total, wk, subst, N_subst] using form_wk hE hc hB
  exact sigma_body_form hEw

theorem shifted_zero (P : Ty) : wk (inst P zero) = inst (shiftedFamily P) zero := by
  rw [wk, subst_inst]
  simp only [SourceRigidity.zero, P01AC.BooleanPrimitive.psub_closed (has_scoped (inputNumeral_has 0))]
  rfl

theorem shifted_step (P : Ty) : wk (dependentStepType P) = dependentStepType (shiftedFamily P) := by
  simp only [wk, dependentStepType, subst, N_subst, subst_arr]
  congr 2
  simp only [successorFamily, shiftedFamily, subst_comp]
  congr 1
  funext k
  cases k with
  | zero => simp [cons, pup, psub, P01AC.BooleanPrimitive.psub_closed (has_scoped succ_has)]
  | succ k => rfl

theorem shifted_at_var (P : Ty) : inst (shiftedFamily P) (.var 0) = P := by
  simp only [inst, shiftedFamily, subst_comp]
  have he : (fun n => psub (cons (.var 0) Poly.var) ((pup (fun k => .var (k+1))) n)) = Poly.var := by
    funext n; cases n <;> rfl
  rw [he, subst_id]

def sectionBody (p s n : Poly) : Poly :=
  sndPoly (.app (.app n (totalStep (uncurriedStep s))) (totalSeed p))

def sectionPoly (p s : Poly) : Poly :=
  abstract (sectionBody (pren Nat.succ p) (pren Nat.succ s) (.var 0))

theorem sectionBody_scoped {Γ : Tel} {P : Ty} {p s n : Poly}
    (hc : Ctx Γ) (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hs : Has Γ s (dependentStepType P)) (hn : Has Γ n N) :
    Scoped Γ.length (sectionBody p s n) := by
  have hE : Form Γ (total P) := .sigma (N_form hc) hP
  have hd := total_step_has hc hP (uncurried_step_has hc hP hs)
  have ha := total_seed_has hc hP hp
  have run := SourceFoldContract.fold_has hc hE hn hd ha
  have first := Has.sigmaFst (N_form hc) hE run
  exact has_scoped (Has.sigmaSnd hE (form_inst_source hc hP first) run)

/-- A single source polynomial inhabits Πn.P(n), provided the rigidity
    evidence has original-Has typing and can therefore use inherited weakening. -/
theorem section_has {Γ : Tel} {P : Ty} {p s r : Poly}
    (hc : Ctx Γ) (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hs : Has Γ s (dependentStepType P)) (hr : Has Γ r Rigidity) :
    HasE Γ (sectionPoly p s) (.pi N P) := by
  have cN := Ctx.ext hc (N_form hc)
  have hP' := shifted_family_form hc hP (N_form hc)
  have hp' : Has (N :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc (N_form hc)
  have hs' : Has (N :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc (N_form hc)
  have hr' : Has (N :: Γ) (pren Nat.succ r) Rigidity := by
    simpa only [wk, rigidity_subst] using has_wk hr hc (N_form hc)
  have hn : Has (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  have body := dependent_section_curried cN hP' hp' hs' (has_inclusion hr') hn
  apply HasE.piIntro (form_inclusion (.pi (N_form hc) hP))
  · simpa only [shifted_at_var] using body
  · exact scoped_abstract (sectionBody_scoped cN hP' hp' hs' hn)


theorem sectionPoly_scoped {Γ : Tel} {P : Ty} {p s : Poly}
    (hc : Ctx Γ) (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hs : Has Γ s (dependentStepType P)) : Scoped Γ.length (sectionPoly p s) := by
  have cN := Ctx.ext hc (N_form hc)
  have hP' := shifted_family_form hc hP (N_form hc)
  have hp' : Has (N :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc (N_form hc)
  have hs' : Has (N :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc (N_form hc)
  have hn : Has (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  exact scoped_abstract (sectionBody_scoped cN hP' hp' hs' hn)

/-- A genuine source implication, uniform in every formed family and its
    original-Has seed/step. Rigidity is bound as an ordinary hypothesis.
    Families are quantified metatheoretically, not through a new universe. -/
theorem rigidity_implies_section {Γ : Tel} {P : Ty} {p s : Poly}
    (hc : Ctx Γ) (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hs : Has Γ s (dependentStepType P)) :
    HasE Γ (abstract (sectionPoly (pren Nat.succ p) (pren Nat.succ s)))
      (arr Rigidity (.pi N P)) := by
  have hR := rigidity_formed hc
  have cR := Ctx.ext hc hR
  have hP' := shifted_family_form hc hP hR
  have hp' : Has (Rigidity :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc hR
  have hs' : Has (Rigidity :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc hR
  have hr : Has (Rigidity :: Γ) (.var 0) Rigidity := by
    have hv : Has (Rigidity :: Γ) (.var 0) (wk Rigidity) := .var (form_wk hR hc hR) .zero
    simpa only [wk, rigidity_subst] using hv
  have body := section_has cR hP' hp' hs' hr
  apply HasE.piIntro (form_inclusion (form_arr hR (.pi (N_form hc) hP)))
  · simpa only [wk, subst, N_subst] using body
  · exact scoped_abstract (sectionPoly_scoped cR hP' hp' hs')

#print axioms section_has
#print axioms rigidity_implies_section
end RigidityInitiality
import Mathlib

noncomputable section
open scoped Topology
open Set Filter

namespace CriticalZero

def psi (t : ℝ) : ℝ := (t-1/2)^2/2+(2/3)*(t-1/2)^3+(t-1/2)^4
def dpsi (t : ℝ) : ℝ := (t-1/2)+2*(t-1/2)^2+4*(t-1/2)^3
def curvature (t : ℝ) : ℝ := 1+4*(t-1/2)+12*(t-1/2)^2
def div (v t : ℝ) : ℝ := psi v-psi t-dpsi t*(v-t)

def loss (q : ℝ) : ℝ := 2*div 1 q
def baselineF (eps : ℝ) : ℝ := div 1 (1/2+eps)+div 1 (1/2)
def baselineG (eps : ℝ) : ℝ := ((1/2+eps)^2+(1/2)^2)/2
def envelope (eps : ℝ) : ℝ := 1/2+eps/2+eps^2/4-eps^3/8

def tailP (eps : ℝ) : ℝ :=
  9*eps^9-72*eps^8+72*eps^7+592*eps^6-816*eps^5-2304*eps^4+
    1696*eps^3+4992*eps^2-17280*eps+2304

lemma psi_deriv (t : ℝ) : HasDerivAt psi (dpsi t) t := by
  have h := (hasDerivAt_id t).sub_const (1/2)
  convert (((h.pow 2).div_const 2).add ((h.pow 3).const_mul (2/3))).add (h.pow 4) using 1 <;>
    simp [psi,dpsi] <;> ring

lemma dpsi_deriv (t : ℝ) : HasDerivAt dpsi (curvature t) t := by
  have h := (hasDerivAt_id t).sub_const (1/2)
  convert (h.add ((h.pow 2).const_mul 2)).add ((h.pow 3).const_mul 4) using 1 <;>
    simp [dpsi,curvature] <;> ring

lemma curvature_pos (t : ℝ) : 0 < curvature t := by
  have heq : curvature t = 12*(t-1/3)^2+2/3 := by dsimp [curvature]; ring
  rw [heq]
  nlinarith [sq_nonneg (t-1/3)]

lemma loss_deriv (q : ℝ) : HasDerivAt loss (2*(q-1)*curvature q) q := by
  have hh := ((((hasDerivAt_const q (psi 1)).sub (psi_deriv q)).sub
    ((dpsi_deriv q).mul ((hasDerivAt_const q 1).sub (hasDerivAt_id q)))).const_mul 2)
  convert hh using 1 <;> dsimp [loss, div] <;> ring

lemma loss_strictAnti : StrictAntiOn loss (Icc 0 1) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc 0 1)
  · intro q hq
    exact (loss_deriv q).continuousAt.continuousWithinAt
  · intro q hq
    have hq' : q ∈ Ioo 0 1 := by simpa only [interior_Icc] using hq
    rw [(loss_deriv q).deriv]
    have hr := curvature_pos q
    exact mul_neg_of_neg_of_pos (mul_neg_of_pos_of_neg (by norm_num) (by linarith [hq'.2])) hr

lemma envelope_excess (eps : ℝ) :
    (envelope eps)^2-baselineG eps = eps^3*(eps^3-4*eps^2-4*eps+8)/64 := by
  dsimp [envelope,baselineG]
  ring

lemma nonlinear_excess (eps : ℝ) :
    loss (envelope eps)-baselineF eps = eps^3*tailP eps/6144 := by
  dsimp [loss,envelope,baselineF,tailP,div,psi,dpsi]
  ring

lemma tailP_pos (eps : ℝ) (he : 0 < eps) (hu : eps ≤ 1) : 0 < tailP eps := by
  have h1 : eps ≤ 1 := by linarith
  have h4 : eps^4 ≤ eps := by simpa using pow_le_pow_of_le_one he.le h1 (show 1 ≤ 4 by norm_num)
  have h5 : eps^5 ≤ eps := by simpa using pow_le_pow_of_le_one he.le h1 (show 1 ≤ 5 by norm_num)
  have h8 : eps^8 ≤ eps := by simpa using pow_le_pow_of_le_one he.le h1 (show 1 ≤ 8 by norm_num)
  have hp : 0 ≤ 9*eps^9+72*eps^7+592*eps^6+1696*eps^3+4992*eps^2 := by positivity
  dsimp [tailP]
  nlinarith

lemma envelope_mem (eps : ℝ) (he : 0 < eps) (hu : eps ≤ 1) : envelope eps ∈ Ioo 0 1 := by
  have h1 : eps ≤ 1 := by linarith
  have h2 : eps^2 ≤ eps := by simpa using pow_le_pow_of_le_one he.le h1 (show 1 ≤ 2 by norm_num)
  have h3 : eps^3 ≤ eps := by simpa using pow_le_pow_of_le_one he.le h1 (show 1 ≤ 3 by norm_num)
  have hp3 : 0 ≤ eps^3 := pow_nonneg he.le 3
  dsimp [envelope]
  constructor <;> nlinarith [sq_nonneg eps]

/-- Actual exact nonlinear failure on a rational interval despite a feasible
zero-margin second-order programme. -/
theorem no_exact_repair (eps : ℝ) (he : 0 < eps) (hu : eps ≤ 1) :
    ¬ ∃ q ∈ Icc (0:ℝ) 1, q^2 ≤ baselineG eps ∧ loss q ≤ baselineF eps := by
  rintro ⟨q,hq,hG,hF⟩
  have henv := envelope_mem eps he hu
  have he2 : eps^2 ≤ (1:ℝ)/10000 := by nlinarith
  have hbr : 0 < eps^3-4*eps^2-4*eps+8 := by nlinarith [pow_pos he 3]
  have hex : 0 < (envelope eps)^2-baselineG eps := by
    rw [envelope_excess]
    exact div_pos (mul_pos (pow_pos he 3) hbr) (by norm_num)
  have hqlt : q < envelope eps := by
    by_contra hn
    have hsq := pow_le_pow_left₀ henv.1.le (le_of_not_gt hn) 2
    linarith
  have hmono := loss_strictAnti hq ⟨henv.1.le,henv.2.le⟩ hqlt
  have hbad : 0 < loss (envelope eps)-baselineF eps := by
    rw [nonlinear_excess]
    exact div_pos (mul_pos (pow_pos he 3) (tailP_pos eps he hu)) (by norm_num)
  linarith

/-- The four second-order coefficients at the specified context and ray. -/
def leading (b : ℝ) : Fin 4 → ℝ := ![1/4-b,1/4+b,3/4-b,b-1/4]

theorem second_order_optimum_zero :
    (∀ i : Fin 4, 0 ≤ leading (1/4) i) ∧
    (∀ b tau : ℝ, (∀ i : Fin 4, tau ≤ leading b i) → tau ≤ 0) := by
  constructor
  · intro i
    fin_cases i <;> norm_num [leading]
  · intro b tau hh
    have h0 := hh 0
    have h3 := hh 3
    norm_num [leading] at h0 h3
    change tau ≤ b-1/4 at h3
    linarith

def fRem (a b eps : ℝ) : ℝ :=
  (5/2-3*a-(3-4*a)*b) + (21/8-(3-4*a)*b^2-(5-6*a)*b)*eps +
    (-(10-12*a)*b^2-3*b)*eps^2 + (-(20/3-8*a)*b^3-9*b^2)*eps^3 -
    12*b^3*eps^4-6*b^4*eps^5

/-- Exact score identity binds the nonlinear pair of LP coefficients. -/
lemma actual_second_order_F (a b eps : ℝ) :
    div a (1/2+eps)+div a (1/2)-2*div a (1/2+eps/2+eps^2*b) =
      eps^2*(1/4+(1/2-a)*(1-2*b)+eps*fRem a b eps) := by
  dsimp [div,psi,dpsi,fRem]
  ring

lemma actual_second_order_G (a b eps : ℝ) :
    ((1/2+eps-a)^2+(1/2-a)^2)/2-(1/2+eps/2+eps^2*b-a)^2 =
      eps^2*(1/4-2*(1/2-a)*b+eps*(-b-eps*b^2)) := by
  ring

#print axioms no_exact_repair
#print axioms second_order_optimum_zero
#print axioms actual_second_order_F
end CriticalZero
import IndependentCodeControls
open AuxiliaryCodeComputability SourceFamilyComputability CodedScope ExactSyntaxValidity IndependentAuxiliaryCodeReview
set_option maxRecDepth 8192
example : AuxiliaryCodeComputability.polyChildren (Nat.pair 0 0,pack 2 [leaf 1,leaf 2,leaf 3,4,5]) = [(Nat.pair 1 3,4),(Nat.pair 1 3,5)] := by
  rw [poly_trans_children]
  decide
import Init

/-!
A semantic discrimination, not a proof of metaphysical premise warrant.
`Available` is an assignment of actual resource instantiations. A rule says
which instantiated resources suffice for the designated consequent resource.
Rules can have infinitely many prerequisites. `Original` means nonreceived
in the fixed existential respect, not an initially occurring temporal act.
-/
namespace ExplanatoryGeneration
universe u v
variable {R : Type u} {I : Type v}

structure Supply (R : Type u) (I : Type v) where
  original : R → Prop
  needs : I → R → Prop
  output : I → R

def Enabled (s : Supply R I) (D : R → Prop) (r : R) : Prop :=
  s.original r ∨ ∃ i, s.output i = r ∧ ∀ p, s.needs i p → D p

def LocalFixed (s : Supply R I) (D : R → Prop) : Prop :=
  ∀ r, D r ↔ Enabled s D r

def Closed (s : Supply R I) (D : R → Prop) : Prop :=
  ∀ r, Enabled s D r → D r

def NoEmptyRules (s : Supply R I) : Prop := ∀ i, ∃ p, s.needs i p

inductive Generated (s : Supply R I) : R → Prop where
  | original {r} : s.original r → Generated s r
  | rule (i) : (∀ p, s.needs i p → Generated s p) → Generated s (s.output i)

-- This condition is the proposed explanatory selection; it is NOT inferred
-- from LocalFixed. It must receive independent philosophical/application warrant.
def NoUngenerated (s : Supply R I) (D : R → Prop) : Prop :=
  ∀ r, D r → Generated s r

theorem generated_closed (s : Supply R I) : Closed s (Generated s) := by
  intro r h
  rcases h with h | ⟨i, hi, hs⟩
  · exact Generated.original h
  · rw [← hi]; exact Generated.rule i hs

theorem generated_local_fixed (s : Supply R I) : LocalFixed s (Generated s) := by
  intro r
  constructor
  · intro h
    cases h with
    | original h => exact Or.inl h
    | rule i h => exact Or.inr ⟨i, rfl, h⟩
  · exact generated_closed s r

theorem generated_least (s : Supply R I) (D : R → Prop)
    (closed : Closed s D) : ∀ r, Generated s r → D r := by
  intro r h
  induction h with
  | original h => exact closed _ (Or.inl h)
  | rule i _ ih => exact closed _ (Or.inr ⟨i, rfl, ih⟩)

theorem selection_iff_least (s : Supply R I) (D : R → Prop)
    (closed : Closed s D) :
    NoUngenerated s D ↔ ∀ r, D r ↔ Generated s r := by
  constructor
  · intro h r
    exact ⟨h r, generated_least s D closed r⟩
  · intro h r hr; exact (h r).mp hr

theorem generated_has_original (s : Supply R I) (nonempty : NoEmptyRules s)
    {r} (h : Generated s r) : ∃ o, s.original o := by
  induction h with
  | original h => exact ⟨_, h⟩
  | rule i _ ih =>
    obtain ⟨p, hp⟩ := nonempty i
    exact ih p hp

theorem actual_generation_has_original (s : Supply R I) (D : R → Prop)
    (nonempty : NoEmptyRules s) (selected : NoUngenerated s D)
    (actual : ∃ r, D r) : ∃ o, s.original o := by
  obtain ⟨r, hr⟩ := actual
  exact generated_has_original s nonempty (selected r hr)

inductive SupplyPath (s : Supply R I) : R → R → Prop where
  | refl (r) : SupplyPath s r r
  | step {a p} (i) : SupplyPath s a p → s.needs i p →
      SupplyPath s a (s.output i)

theorem generated_has_relevant_original (s : Supply R I)
    (nonempty : NoEmptyRules s) {r} (h : Generated s r) :
    ∃ o, s.original o ∧ SupplyPath s o r := by
  induction h with
  | original h => exact ⟨_, h, SupplyPath.refl _⟩
  | rule i _ ih =>
    obtain ⟨p, hp⟩ := nonempty i
    obtain ⟨o, ho, path⟩ := ih p hp
    exact ⟨o, ho, SupplyPath.step i path hp⟩

theorem selected_actual_target_has_same_original_resource
    (s : Supply R I) (D : R → Prop)
    (fixed : LocalFixed s D) (nonempty : NoEmptyRules s)
    (selected : NoUngenerated s D) {r} (actual : D r) :
    ∃ o, D o ∧ s.original o ∧ SupplyPath s o r := by
  obtain ⟨o, ho, path⟩ :=
    generated_has_relevant_original s nonempty (selected r actual)
  exact ⟨o, (fixed o).mpr (Or.inl ho), ho, path⟩

theorem SupplyPath.trans {s : Supply R I} {a b c}
    (hab : SupplyPath s a b) (hbc : SupplyPath s b c) : SupplyPath s a c := by
  induction hbc with
  | refl => exact hab
  | step i _ hp ih => exact SupplyPath.step i ih hp

/-- This requires only one generated, actual contribution to the target.
It does not require the target, all its branches, or the whole field generated. -/
theorem one_generated_contribution_suffices (s : Supply R I) (D : R → Prop)
    (fixed : LocalFixed s D) (nonempty : NoEmptyRules s) {target}
    (anchor : ∃ q, D q ∧ Generated s q ∧ SupplyPath s q target) :
    ∃ o, D o ∧ s.original o ∧ SupplyPath s o target := by
  obtain ⟨q, _, hq, qt⟩ := anchor
  obtain ⟨o, ho, oq⟩ := generated_has_relevant_original s nonempty hq
  exact ⟨o, (fixed o).mpr (Or.inl ho), ho, SupplyPath.trans oq qt⟩

-- A fully infinite acyclic, all-received account. There is no artificial last
-- node or finite truncation; each n receives from n+1.
def regress : Supply Nat Nat where
  original := fun _ => False
  needs := fun n p => p = n + 1
  output := id

theorem regress_no_empty : NoEmptyRules regress := fun n => ⟨n+1, rfl⟩
theorem regress_local : LocalFixed regress (fun _ => True) := by
  intro n
  constructor
  · intro _; exact Or.inr ⟨n, rfl, fun _ _ => trivial⟩
  · intro _; trivial

theorem regress_has_no_generated (n : Nat) : ¬ Generated regress n := by
  intro h
  obtain ⟨o, ho⟩ := generated_has_original regress regress_no_empty h
  exact ho

theorem regress_selection_fails : ¬ NoUngenerated regress (fun _ => True) := by
  intro h; exact regress_has_no_generated 0 (h 0 trivial)

theorem regress_fixed_succ (D : Nat → Prop) (fixed : LocalFixed regress D)
    (n : Nat) : D n ↔ D (n+1) := by
  constructor
  · intro h
    rcases (fixed n).mp h with impossible | ⟨i, hi, hs⟩
    · exact False.elim impossible
    · change i = n at hi
      subst i
      exact hs (n+1) rfl
  · intro h
    apply (fixed n).mpr
    refine Or.inr ⟨n, rfl, ?_⟩
    intro p hp
    change p = n+1 at hp
    rw [hp]; exact h

/-- The observed nonempty solution is globally determinate, still seedless.
Observation is a constraint, not an original supply token. -/
theorem regress_observation_determines_profile (D : Nat → Prop)
    (fixed : LocalFixed regress D) (observed : D 0) : ∀ n, D n := by
  intro n
  induction n with
  | zero => exact observed
  | succ n ih => exact (regress_fixed_succ D fixed n).mp ih

-- Every prerequisite index strictly exceeds its output; strict natural-number
-- order is an acyclic majorant. This is not a graph with hidden self-loops.
theorem regress_strict (i p : Nat) (h : regress.needs i p) :
    regress.output i < p := by
  change p = i+1 at h
  rw [h]
  exact Nat.lt_succ_self i

-- A nonempty original component does not select the unsupported branch.
def island : Supply (Option Nat) Nat where
  original := fun r => r = none
  needs := fun n p => p = some (n+1)
  output := some

theorem island_local : LocalFixed island (fun _ => True) := by
  intro r; constructor
  · intro _; cases r with
    | none => exact Or.inl rfl
    | some n => exact Or.inr ⟨n, rfl, fun _ _ => trivial⟩
  · intro _; trivial

theorem island_generated_only_original {r} (h : Generated island r) : r = none := by
  induction h with
  | original h => exact h
  | rule i _ ih =>
    have bad := ih (some (i+1)) rfl
    cases bad

theorem island_original_but_ungenerated_branch :
    (∃ o, island.original o) ∧ ¬ NoUngenerated island (fun _ => True) := by
  refine ⟨⟨none, rfl⟩, ?_⟩
  intro h
  have bad := island_generated_only_original (h (some 0) trivial)
  cases bad

-- A target has a genuinely relevant original contributor while a second
-- actual requisite branch remains ungenerated. T17's existential witness and
-- T19's complete original coverage must therefore be assessed separately.
def mixedTarget : Supply (Option Nat) Nat where
  original := fun r => r = none
  needs := fun n p => p = some (n+1) ∨ (n = 0 ∧ p = none)
  output := some

theorem mixedTarget_local : LocalFixed mixedTarget (fun _ => True) := by
  intro r; constructor
  · intro _; cases r with
    | none => exact Or.inl rfl
    | some n => exact Or.inr ⟨n, rfl, fun _ _ => trivial⟩
  · intro _; trivial

theorem mixedTarget_only_seed_generated {r}
    (h : Generated mixedTarget r) : r = none := by
  induction h with
  | original h => exact h
  | rule i _ ih =>
    have bad := ih (some (i+1)) (Or.inl rfl)
    cases bad

theorem weaker_anchor_without_target_generation :
    (∃ q, Generated mixedTarget q ∧ SupplyPath mixedTarget q (some 0)) ∧
    ¬ Generated mixedTarget (some 0) := by
  constructor
  · refine ⟨none, Generated.original rfl, ?_⟩
    exact SupplyPath.step 0 (SupplyPath.refl none) (Or.inr ⟨rfl, rfl⟩)
  · intro h
    have bad := mixedTarget_only_seed_generated h
    cases bad

-- An infinite family of prerequisites is allowed. some n has n-step generated
-- support; the output none requires every some n. There is no finite bound on
-- the requisite derivation depths even though the output has a generated proof.
def infiniteFan : Supply (Option Nat) (Option Nat) where
  original := fun r => r = some 0
  needs := fun i p => match i with
    | some n => p = some n
    | none => ∃ n, p = some n
  output := fun i => match i with
    | some n => some (n+1)
    | none => none

theorem infiniteFan_no_empty : NoEmptyRules infiniteFan := by
  intro i; cases i with
  | none => exact ⟨some 0, 0, rfl⟩
  | some n => exact ⟨some n, rfl⟩

theorem infiniteFan_finite_generated (n : Nat) : Generated infiniteFan (some n) := by
  induction n with
  | zero => exact Generated.original rfl
  | succ n ih =>
    apply Generated.rule (some n)
    intro p hp
    change p = some n at hp
    rw [hp]; exact ih

theorem infiniteFan_limit_generated : Generated infiniteFan none := by
  apply Generated.rule none
  intro p hp
  obtain ⟨n, hn⟩ := hp
  rw [hn]; exact infiniteFan_finite_generated n

theorem infiniteFan_all_generated : NoUngenerated infiniteFan (fun _ => True) := by
  intro r _; cases r with
  | none => exact infiniteFan_limit_generated
  | some n => exact infiniteFan_finite_generated n

-- Finite-stage iteration does NOT exhaust arbitrary-arity generation.
def Stage (s : Supply R I) : Nat → R → Prop
  | 0 => fun _ => False
  | n+1 => Enabled s (Stage s n)

theorem infiniteFan_stage_bound (n : Nat) :
    ∀ r, Stage infiniteFan n r → ∃ k, r = some k ∧ k < n := by
  induction n with
  | zero => intro r h; exact False.elim h
  | succ n ih =>
    intro r h
    rcases h with horig | ⟨i, hi, hs⟩
    · exact ⟨0, horig, Nat.zero_lt_succ n⟩
    · cases i with
      | none =>
        have hn := hs (some n) ⟨n, rfl⟩
        obtain ⟨k, hk, hkn⟩ := ih (some n) hn
        have eq : n = k := Option.some.inj hk
        subst k
        exact False.elim (Nat.lt_irrefl n hkn)
      | some k =>
        have hk := hs (some k) rfl
        obtain ⟨j, hj, hjn⟩ := ih (some k) hk
        have eq : k = j := Option.some.inj hj
        subst j
        exact ⟨k+1, hi.symm, Nat.succ_lt_succ hjn⟩

theorem generated_beyond_every_finite_stage :
    Generated infiniteFan none ∧ ∀ n, ¬ Stage infiniteFan n none := by
  refine ⟨infiniteFan_limit_generated, ?_⟩
  intro n h
  obtain ⟨k, hk, _⟩ := infiniteFan_stage_bound n none h
  cases hk

inductive RegPath : Nat → Nat → Prop where
  | edge {a b} : regress.needs b a → RegPath a b
  | trans {a b c} : RegPath a b → RegPath b c → RegPath a c

theorem regress_path_strict {a b} (h : RegPath a b) : b < a := by
  induction h with
  | edge h => exact regress_strict _ _ h
  | trans _ _ h1 h2 => exact Nat.lt_trans h2 h1

theorem regress_acyclic (a : Nat) : ¬ RegPath a a := by
  intro h; exact Nat.lt_irrefl a (regress_path_strict h)

-- Empty received rules would manufacture an original-looking availability
-- without any original input. NoEmptyRules is therefore a genuine guard.
def emptyRule : Supply Unit Unit where
  original := fun _ => False
  needs := fun _ _ => False
  output := fun _ => ()

theorem empty_rule_breaks_seed_conclusion :
    Generated emptyRule () ∧ ¬ (∃ o, emptyRule.original o) ∧
    ¬ NoEmptyRules emptyRule := by
  refine ⟨Generated.rule () (fun _ h => False.elim h), ?_, ?_⟩
  · intro h; obtain ⟨_, h⟩ := h; exact h
  · intro h; obtain ⟨_, h⟩ := h (); exact h

-- A source-internal adverse control: mutually conditioned created powers can
-- derive from one common giver (Safadiyya S003 L207). Necessary co-presence must
-- not automatically become prior generative supply.
def confusedConditions : Supply (Option Bool) Bool where
  original := fun r => r = none
  needs := fun i p => p = none ∨ p = some (!i)
  output := some

def commonProvision : Supply (Option Bool) Bool where
  original := fun r => r = none
  needs := fun _ p => p = none
  output := some

def CoPresent (D : Option Bool → Prop) : Prop :=
  D (some false) ↔ D (some true)

theorem confused_local : LocalFixed confusedConditions (fun _ => True) := by
  intro r; constructor
  · intro _; cases r with
    | none => exact Or.inl rfl
    | some b => exact Or.inr ⟨b, rfl, fun _ _ => trivial⟩
  · intro _; trivial

theorem confused_generated_only_original {r}
    (h : Generated confusedConditions r) : r = none := by
  induction h with
  | original h => exact h
  | rule i _ ih =>
    have bad := ih (some (!i)) (Or.inr rfl)
    cases bad

theorem common_provision_generates_both :
    ∀ r, Generated commonProvision r := by
  intro r; cases r with
  | none => exact Generated.original rfl
  | some b =>
    apply Generated.rule b
    intro p hp
    exact Generated.original hp

theorem same_copresence_different_generativity :
    CoPresent (fun _ => True) ∧
    LocalFixed confusedConditions (fun _ => True) ∧
    (∀ r, Generated commonProvision r) ∧
    ¬ NoUngenerated confusedConditions (fun _ => True) := by
  refine ⟨Iff.rfl, confused_local, common_provision_generates_both, ?_⟩
  intro h
  have bad := confused_generated_only_original (h (some false) trivial)
  cases bad

-- Temporal action tokens are deliberately a distinct type/level from standing
-- resources. Reverse-Nat order supplies an infinite past (ending at index 0).
-- All actions have the original resource, yet there is no earliest token.
def actionEarlier (a b : Nat) : Prop := b < a

def actionOccurs (_ : Nat) : Prop := True

def standing : Supply Unit Empty where
  original := fun _ => True
  needs := fun i => nomatch i
  output := fun i => nomatch i

theorem standing_all_generated : ∀ r, Generated standing r :=
  fun _ => Generated.original trivial

theorem beginningless_actions_with_original_resource :
    (∀ n, actionOccurs n ∧ Generated standing ()) ∧
    (∀ n, ∃ m, actionOccurs m ∧ actionEarlier m n) := by
  constructor
  · intro n; exact ⟨trivial, standing_all_generated ()⟩
  · intro n; exact ⟨n+1, trivial, Nat.lt_succ_self n⟩

-- If the very same recurrence is misapplied as a resource-generation rule,
-- the original standing resource is lost and every token is ungenerated.
-- The discrepancy is a semantic typing failure, not a refutation of the source.
theorem recurrence_cannot_select_explanatory_level :
    (∀ n, ∃ m, actionEarlier m n) ∧
    LocalFixed regress actionOccurs ∧
    (∀ n, ¬ Generated regress n) := by
  exact ⟨fun n => ⟨n+1, Nat.lt_succ_self n⟩, regress_local,
    regress_has_no_generated⟩

end ExplanatoryGeneration
/-
P03 attempt-0002 NEW PROPOSAL. UNVERIFIED: no compiler was acquired here.
Target Lean 4.19.0. Core-only formalisation; not historical declaration recovery.
The model carries local target-indexed evidence and retains authority/root paths.
It does NOT assume a field asserting the desired whole-path warrant conclusion.
Exact-image graph carriers are an explicit emitted-certificate representation.
Semantic truth, actual authority and currentness require their own local witnesses.
-/
import P03GuardedGraph
namespace P03A2
universe u

structure EvidenceState (O : Type) where
  required : O → Prop
  discharged : O → Prop
  valid : O → Prop

def Sound {O : Type} (s : EvidenceState O) : Prop :=
  ∀ o, s.discharged o → s.valid o

def Closed {O : Type} (s : EvidenceState O) : Prop :=
  ∀ o, s.required o → s.valid o

structure EvidenceHop {O : Type} (a b : EvidenceState O) where
  preserved : O → Prop
  revalidated : O → Prop
  kept : ∀ o, preserved o → a.discharged o
  carry : ∀ o, preserved o → a.valid o → b.valid o
  fresh : ∀ o, revalidated o → b.valid o
  outExact : ∀ o, b.discharged o ↔ preserved o ∨ revalidated o
  coverage : ∀ o, b.required o → preserved o ∨ revalidated o

theorem EvidenceHop.sound {O : Type} {a b : EvidenceState O}
    (h : EvidenceHop a b) (hs : Sound a) : Sound b := by
  intro o ho
  cases (h.outExact o).mp ho with
  | inl hp => exact h.carry o hp (hs o (h.kept o hp))
  | inr hr => exact h.fresh o hr

theorem EvidenceHop.closed {O : Type} {a b : EvidenceState O}
    (h : EvidenceHop a b) (hs : Sound a) : Closed b := by
  intro o ho
  cases h.coverage o ho with
  | inl hp => exact h.carry o hp (hs o (h.kept o hp))
  | inr hr => exact h.fresh o hr

structure SemanticState where
  World : Type
  meaning : World → Prop

structure SemanticHop (a b : SemanticState) where
  map : a.World → b.World
  square : ∀ w, b.meaning (map w) ↔ a.meaning w

def SemanticHop.comp {a b c : SemanticState}
    (f : SemanticHop a b) (g : SemanticHop b c) : SemanticHop a c where
  map := fun w => g.map (f.map w)
  square := fun w => (g.square (f.map w)).trans (f.square w)

theorem SemanticHop.composite_square {a b c : SemanticState}
    (f : SemanticHop a b) (g : SemanticHop b c) (w : a.World) :
    c.meaning ((SemanticHop.comp f g).map w) ↔ a.meaning w :=
  (SemanticHop.comp f g).square w

structure Frame (O V R C : Type) where
  graph : P03Q1f.ReasonDAG
  reasons : EvidenceState O
  semantics : SemanticState
  version : V
  root : R
  claim : C

structure Policy (O V R C : Type) where
  epoch : Nat
  authority : Frame O V R C → Frame O V R C → Prop
  redelegate : Frame O V R C → Prop
  versionAllowed : V → Prop
  invalidatorsClosed : Frame O V R C → Prop
  rootStep : R → R → Prop

structure Hop {O V R C : Type} (p : Policy O V R C)
    (a b : Frame O V R C) where
  graphMap : P03Q1f.Hom a.graph b.graph
  onto : ∀ v, ∃ u, graphMap.node u = v
  reasons : EvidenceHop a.reasons b.reasons
  semantics : SemanticHop a.semantics b.semantics
  authority : p.authority a b
  targetVersion : p.versionAllowed b.version
  noOpenInvalidator : p.invalidatorsClosed b
  rootCustody : p.rootStep a.root b.root

/-- Indexed adjacency enforces the entire prior/output frame, not only version. -/
inductive Path {O V R C : Type} (p : Policy O V R C) :
    Frame O V R C → Frame O V R C → Type 1 where
  | one {a b} (h : Hop p a b) : Path p a b
  | cons {a b c} (h : Hop p a b) (rest : Path p b c)
      (allowMiddle : p.redelegate b) : Path p a c

inductive Via {α : Sort u} (rel : α → α → Prop) : α → α → Prop where
  | one {a b} : rel a b → Via rel a b
  | comp {a b c} : Via rel a b → Via rel b c → Via rel a c

variable {O V R C : Type} {p : Policy O V R C}
variable {a b c : Frame O V R C}

def Path.graph : Path p a b → P03Q1f.Hom a.graph b.graph
  | .one h => h.graphMap
  | .cons h rest _ => P03Q1f.Hom.compose h.graphMap (Path.graph rest)

def Path.preimage : (q : Path p a b) →
    ∀ v : Fin b.graph.size, ∃ u : Fin a.graph.size, (Path.graph q).node u = v
  | .one h, v => h.onto v
  | .cons h rest _, v => by
      obtain ⟨mid, hm⟩ := Path.preimage rest v
      obtain ⟨src, hs⟩ := h.onto mid
      refine ⟨src, ?_⟩
      change (Path.graph rest).node (h.graphMap.node src) = v
      rw [hs]
      exact hm

def Path.semantics : Path p a b → SemanticHop a.semantics b.semantics
  | .one h => h.semantics
  | .cons h rest _ => SemanticHop.comp h.semantics (Path.semantics rest)

def Path.transportSound : (q : Path p a b) → Sound a.reasons → Sound b.reasons
  | .one h, hs => h.reasons.sound hs
  | .cons h rest _, hs => Path.transportSound rest (h.reasons.sound hs)

def Path.closeTarget : (q : Path p a b) → Sound a.reasons → Closed b.reasons
  | .one h, hs => h.reasons.closed hs
  | .cons h rest _, hs => Path.closeTarget rest (h.reasons.sound hs)

def Path.finalVersion : (q : Path p a b) → p.versionAllowed b.version
  | .one h => h.targetVersion
  | .cons _ rest _ => Path.finalVersion rest

def Path.finalInvalidators : (q : Path p a b) → p.invalidatorsClosed b
  | .one h => h.noOpenInvalidator
  | .cons _ rest _ => Path.finalInvalidators rest

def Path.rootTrace : (q : Path p a b) → Via p.rootStep a.root b.root
  | .one h => .one h.rootCustody
  | .cons h rest _ => .comp (.one h.rootCustody) (Path.rootTrace rest)

def Path.authorityTrace : (q : Path p a b) → Via p.authority a b
  | .one h => .one h.authority
  | .cons h rest _ => .comp (.one h.authority) (Path.authorityTrace rest)

theorem Path.mapEdge (q : Path p a b) {u v : Fin a.graph.size}
    (h : a.graph.Edge u v) : b.graph.Edge ((Path.graph q).node u) ((Path.graph q).node v) :=
  (Path.graph q).edge h

/-- The new conclusion is constructed from local evidence; it is not a Hop field.
Authority is a path witness, NOT an assumed transitive direct permission.
Currentness is at p.epoch only; changing Policy does not inherit this theorem.
-/
theorem guarded_reason_version_composition (q : Path p a b) (hs : Sound a.reasons) :
    Sound b.reasons ∧ Closed b.reasons ∧
    (∀ w, b.semantics.meaning ((Path.semantics q).map w) ↔ a.semantics.meaning w) ∧
    p.versionAllowed b.version ∧ p.invalidatorsClosed b ∧
    Via p.rootStep a.root b.root ∧ Via p.authority a b :=
  ⟨Path.transportSound q hs, Path.closeTarget q hs,
   (Path.semantics q).square, Path.finalVersion q,
   Path.finalInvalidators q, Path.rootTrace q, Path.authorityTrace q⟩

theorem Path.semantic_truth_transport (q : Path p a b) (w : a.semantics.World)
    (hw : a.semantics.meaning w) :
    b.semantics.meaning ((Path.semantics q).map w) :=
  ((Path.semantics q).square w).mpr hw

theorem Via.eq_endpoints {α : Sort u} {x y : α} (h : Via (fun a b => a = b) x y) : x = y := by
  induction h with
  | one e => exact e
  | comp _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A nonempty graph walk cannot collapse under the composed graph map. -/
theorem Path.no_collapse {u v : Fin a.graph.size} (q : Path p a b)
    (h : P03Q1f.Walk a.graph u v) : (Path.graph q).node u ≠ (Path.graph q).node v :=
  P03Q1f.Hom.noCollapseOfWalk (Path.graph q) h

end P03A2
import Std
namespace TraceReduction

-- New real-created token, faithful total history, and distinction from the
-- solo total suffice. This is set-membership, not a physical conservation law.
theorem new_created_token_forces_total_difference {Token : Type}
    (solo joint extra : Token → Prop)
    (retained : ∀ x, extra x → joint x)
    (new_token : ∃ x, extra x ∧ ¬ solo x) :
    ∃ x, joint x ∧ ¬ solo x := by
  obtain ⟨x, hx, hnot⟩ := new_token
  exact ⟨x, retained x hx, hnot⟩

-- Empty background/current production episode. With fixed background S,
-- one must additionally show that the extra token is not already in S.
theorem fixed_manifestation_disjoint_retained_gives_growth {Token : Type}
    (own peer solo joint : Token → Prop)
    (solo_exact : ∀ x, solo x ↔ own x)
    (peer_nonempty : ∃ x, peer x)
    (disjoint : ∀ x, peer x → ¬ own x)
    (retained : ∀ x, peer x → joint x) :
    ∃ x, joint x ∧ ¬ solo x := by
  obtain ⟨x, hx⟩ := peer_nonempty
  refine ⟨x, retained x hx, ?_⟩
  intro hs
  exact disjoint x hx ((solo_exact x).mp hs)

-- CND supplies disjointness only after the source-owned entire contribution
-- interpretation is justified. It does not produce those witnesses itself.
theorem cnd_disjoins_entire_owned_tokens {Agent Token : Type}
    (Entire : Agent → Token → Prop) (a b : Agent) (ha : a ≠ b)
    (CND : ∀ g h x, Entire g x → Entire h x → g = h)
    (ca cb : Token → Prop)
    (ownedA : ∀ x, ca x → Entire a x)
    (ownedB : ∀ x, cb x → Entire b x) :
    ∀ x, ca x → ¬ cb x := by
  intro x hca hcb
  exact ha (CND a b x (ownedA x hca) (ownedB x hcb))

-- Arbitrary signed projection permits interaction/cancellation while the
-- real occurrence history retains more entries. No physical units assumed.
theorem signed_interaction_equal_projection_distinct_history :
    ((1 : Int) + 1 + (-1) = 1) ∧ ([1,1,-1] : List Int) ≠ [1] := by decide

end TraceReduction
#print axioms TraceReduction.new_created_token_forces_total_difference
#print axioms TraceReduction.fixed_manifestation_disjoint_retained_gives_growth
#print axioms TraceReduction.cnd_disjoins_entire_owned_tokens
#print axioms TraceReduction.signed_interaction_equal_projection_distinct_history
import StageTargetOrExit

namespace HiddenParity.Necessity
open HiddenParity.Stage

universe u w
variable {State Action : Type u} {Model : Type w}
variable [Fintype State] [Fintype Action] [DecidableEq State] [DecidableEq Action] [DecidableEq Model]

instance reachDecidable (source : (State × Action) → State) (succ : (State × Action) → Finset State)
    (E : Finset (State × Action)) (s t : State) : Decidable (Reach source succ E s t) :=
  decidable_of_iff (t ∈ FiniteReachability.reachable (Edge source succ E) s)
    (FiniteReachability.reachable_iff (Edge source succ E) s t)

instance reachableExitDecidable (P : RationalKernel Model (State × Action) State)
    (B : Finset Model) (θ : Model) (allowed : Finset (State × Action)) (s : State) :
    Decidable (ReachableExit P B θ allowed s) := by
  unfold ReachableExit
  infer_instance

/-- Actual all-branch stage licensing: hard menu, current region, same-support
successors in W, and every nonempty proper-support successor in its lower region. -/
def regionAllowed (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (B : Finset Model)
    (lower : Finset Model → Finset State) (W : Finset State) : Finset (State × Action) :=
  Finset.univ.filter (fun e => e.1 ∈ W ∧ e.2 ∈ menu B e.1 ∧
    ∀ y, (liveUpdate P B e y).Nonempty →
      if liveUpdate P B e y = B then y ∈ W else y ∈ lower (liveUpdate P B e y))

@[simp] theorem mem_regionAllowed (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (B : Finset Model)
    (lower : Finset Model → Finset State) (W : Finset State) (e : State × Action) :
    e ∈ regionAllowed P menu B lower W ↔ e.1 ∈ W ∧ e.2 ∈ menu B e.1 ∧
      ∀ y, (liveUpdate P B e y).Nonempty →
        if liveUpdate P B e y = B then y ∈ W else y ∈ lower (liveUpdate P B e y) := by
  simp [regionAllowed]

/-- One finite descending region step. Targets are computed by the proved
exhaustive parity reference; paths use proved finite directed reachability. -/
def regionStep (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (lower : Finset Model → Finset State) (W : Finset State) : Finset State :=
  W.filter (fun s => ∀ θ ∈ B,
    ReachableExit P B θ (regionAllowed P menu B lower W) s ∨
      ∃ t ∈ markovTargetStates P Prod.fst B priority θ (regionAllowed P menu B lower W),
        Reach Prod.fst (internalSuccessors P B) (regionAllowed P menu B lower W) s t)

@[simp] theorem mem_regionStep (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (lower : Finset Model → Finset State) (W : Finset State) (s : State) :
    s ∈ regionStep P menu priority B lower W ↔ s ∈ W ∧ ∀ θ ∈ B,
      ReachableExit P B θ (regionAllowed P menu B lower W) s ∨
        ∃ t ∈ markovTargetStates P Prod.fst B priority θ (regionAllowed P menu B lower W),
          Reach Prod.fst (internalSuccessors P B) (regionAllowed P menu B lower W) s t := by
  simp [regionStep]

def descend (F : Finset State → Finset State) : ℕ → Finset State → Finset State
  | 0, W => W
  | n+1, W => descend F n (F W)

/-- Bottom-up live-support recursion with bounded state descent. Fuel is at
least the current support cardinality; only proper child supports matter. -/
def computedRegion (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ) :
    ℕ → Finset Model → Finset State
  | 0, _ => ∅
  | n+1, B => if B.Nonempty then
      descend (regionStep P menu priority B (computedRegion P menu priority n))
        0 Finset.univ else ∅

def winningRegion (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) : Finset State := computedRegion P menu priority B.card B

theorem regionAllowed_mono (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (B : Finset Model)
    (lower : Finset Model → Finset State) {W V : Finset State} (hWV : W ⊆ V) :
    regionAllowed P menu B lower W ⊆ regionAllowed P menu B lower V := by
  intro e he
  obtain ⟨hs, hm, hSafe⟩ := (mem_regionAllowed P menu B lower W e).mp he
  apply (mem_regionAllowed P menu B lower V e).mpr
  refine ⟨hWV hs, hm, ?_⟩
  intro y hC
  have h := hSafe y hC
  by_cases heq : liveUpdate P B e y = B
  · simp only [heq, if_true] at h ⊢
    exact hWV h
  · simpa only [heq, if_false] using h

theorem targetStates_mono (P : RationalKernel Model (State × Action) State)
    (B : Finset Model) (priority : Model → (State × Action) → ℕ) (θ : Model)
    {D E : Finset (State × Action)} (hDE : D ⊆ E) :
    markovTargetStates P Prod.fst B priority θ D ⊆ markovTargetStates P Prod.fst B priority θ E := by
  intro s hs
  obtain ⟨C, hQ, hsC⟩ := (markovTargetStates_exact P Prod.fst B priority θ D s).mp hs
  exact (markovTargetStates_exact P Prod.fst B priority θ E s).mpr
    ⟨C, ⟨hQ.1.trans hDE, hQ.2⟩, hsC⟩

theorem reachableExit_mono (P : RationalKernel Model (State × Action) State)
    (B : Finset Model) (θ : Model) {D E : Finset (State × Action)} (hDE : D ⊆ E)
    {s : State} (h : ReachableExit P B θ D s) : ReachableExit P B θ E s := by
  obtain ⟨e, he, hReach, hExit⟩ := h
  exact ⟨e, hDE he, reach_mono hDE hReach, hExit⟩

theorem regionStep_subset (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (lower : Finset Model → Finset State) (W : Finset State) :
    regionStep P menu priority B lower W ⊆ W := Finset.filter_subset _ _

theorem regionStep_mono (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (lower : Finset Model → Finset State) :
    Monotone (regionStep P menu priority B lower) := by
  intro W V hWV s hs
  obtain ⟨hsW, hAll⟩ := (mem_regionStep P menu priority B lower W s).mp hs
  refine (mem_regionStep P menu priority B lower V s).mpr ⟨hWV hsW, ?_⟩
  intro θ hθ
  have hA := regionAllowed_mono P menu B lower hWV
  rcases hAll θ hθ with hExit | ⟨t, ht, hPath⟩
  · exact Or.inl (reachableExit_mono P B θ hA hExit)
  · exact Or.inr ⟨t, targetStates_mono P B priority θ hA ht, reach_mono hA hPath⟩

/-- Every postfixed set survives all finite descending rounds. -/
theorem postfixed_subset_descend (F : Finset State → Finset State) (hMono : Monotone F)
    {V W : Finset State} (hPost : V ⊆ F V) (hVW : V ⊆ W) (n : ℕ) :
    V ⊆ descend F n W := by
  induction n generalizing W with
  | zero => exact hVW
  | succ n ih => exact ih (hPost.trans (hMono hVW))

theorem descend_eq_of_stable (F : Finset State → Finset State) {W : Finset State}
    (h : F W = W) (n : ℕ) : descend F n W = W := by
  induction n with
  | zero => rfl
  | succ n ih => simpa only [descend, h] using ih

/-- Contracting finite state descent stabilizes within the original state count. -/
theorem descend_stable (F : Finset State → Finset State) (hContract : ∀ W, F W ⊆ W)
    (n : ℕ) (W : Finset State) (hBound : W.card ≤ n) :
    F (descend F n W) = descend F n W := by
  induction n generalizing W with
  | zero =>
      have hW : W = ∅ := Finset.card_eq_zero.mp (by omega)
      subst W
      exact Finset.eq_empty_iff_forall_not_mem.mpr (fun e he => Finset.not_mem_empty e (hContract ∅ he))
  | succ n ih =>
      by_cases h : F W = W
      · rw [descend_eq_of_stable F h]
        exact h
      · have hLt := Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hContract W, h⟩)
        exact ih (F W) (by omega)

theorem computedRegion_fixed_stage (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (n : ℕ) (B : Finset Model) (hB : B.Nonempty) :
    regionStep P menu priority B (computedRegion P menu priority n)
      (computedRegion P menu priority (n+1) B) = computedRegion P menu priority (n+1) B := by
  simp only [computedRegion, if_pos hB]
  exact descend_stable _ (regionStep_subset P menu priority B _) _ _ (by simp)

/-- Only proper lower-support regions are consulted by stage licensing. -/
theorem regionAllowed_congr_lower (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (B : Finset Model)
    (lower lower' : Finset Model → Finset State)
    (hEq : ∀ C, C ⊂ B → lower C = lower' C) (W : Finset State) :
    regionAllowed P menu B lower W = regionAllowed P menu B lower' W := by
  ext e
  simp only [mem_regionAllowed]
  have hChild : ∀ y, (if liveUpdate P B e y = B then y ∈ W else y ∈ lower (liveUpdate P B e y)) ↔
      (if liveUpdate P B e y = B then y ∈ W else y ∈ lower' (liveUpdate P B e y)) := by
    intro y
    by_cases h : liveUpdate P B e y = B
    · simp [h]
    · rw [if_neg h, if_neg h]
      have hProper : liveUpdate P B e y ⊂ B :=
        Finset.ssubset_iff_subset_ne.mpr ⟨Finset.filter_subset _ _, h⟩
      rw [hEq (liveUpdate P B e y) hProper]
  simp only [hChild]

theorem regionStep_congr_lower (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (lower lower' : Finset Model → Finset State)
    (hEq : ∀ C, C ⊂ B → lower C = lower' C) :
    regionStep P menu priority B lower = regionStep P menu priority B lower' := by
  funext W
  simp only [regionStep, regionAllowed_congr_lower P menu B lower lower' hEq W]

/-- Excess recursion fuel does not change the result once it covers support
cardinality. This identifies the bounded reference with true bottom-up support recursion. -/
theorem computedRegion_fuel_irrelevant (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (m n : ℕ) (hm : B.card ≤ m) (hn : B.card ≤ n) :
    computedRegion P menu priority m B = computedRegion P menu priority n B := by
  induction B using Finset.strongInductionOn generalizing m n with
  | _ B ih =>
      by_cases hB : B.Nonempty
      · have hc : 0 < B.card := Finset.card_pos.mpr hB
        cases m with
        | zero => omega
        | succ m =>
            cases n with
            | zero => omega
            | succ n =>
                simp only [computedRegion, if_pos hB]
                have he := regionStep_congr_lower P menu priority B
                  (computedRegion P menu priority m) (computedRegion P menu priority n) (by
                    intro C hC
                    have hCard := Finset.card_lt_card hC
                    exact ih C hC m n (by omega) (by omega))
                rw [he]
      · cases m <;> cases n <;> simp [computedRegion, hB]

/-- The bounded result is a genuine fixed point with canonical child regions. -/
theorem winningRegion_fixed (P : RationalKernel Model (State × Action) State)
    (menu : Finset Model → State → Finset Action) (priority : Model → (State × Action) → ℕ)
    (B : Finset Model) (hB : B.Nonempty) :
    regionStep P menu priority B (winningRegion P menu priority) (winningRegion P menu priority B) =
      winningRegion P menu priority B := by
  have hc : 0 < B.card := Finset.card_pos.mpr hB
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hc)
  have he := regionStep_congr_lower P menu priority B (computedRegion P menu priority n)
    (winningRegion P menu priority) (by
      intro C hC
      have hCard := Finset.card_lt_card hC
      exact computedRegion_fuel_irrelevant P menu priority C n C.card (by omega) (le_refl _))
  change regionStep P menu priority B (winningRegion P menu priority)
    (computedRegion P menu priority B.card B) = computedRegion P menu priority B.card B
  rw [hn, ← he]
  exact computedRegion_fixed_stage P menu priority n B hB

end HiddenParity.Necessity
