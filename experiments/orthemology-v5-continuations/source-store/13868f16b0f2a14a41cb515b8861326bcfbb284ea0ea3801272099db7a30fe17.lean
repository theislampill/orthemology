import PERRefinement

/-!
# Universal-input Mealy refinement

This is the operator in repository v5 `mathematics/DEFECT_COMPUTABILITY.md`, §5:
all independent pairs of input bits are compared. It is not same-input bisimulation.
-/
namespace Orthemology.Frontier

structure Mealy (S : Type*) where
  next : S → Bool → S
  out : S → Bool → Bool

namespace Mealy
variable {S : Type*}

def refine (M : Mealy S) (R : PER S) : PER S where
  rel s t := ∀ b c, M.out s b = M.out t c ∧ R.rel (M.next s b) (M.next t c)
  symm := by
    intro s t h b c
    exact ⟨(h c b).1.symm, R.symm (h c b).2⟩
  trans := by
    intro s t u hst htu b c
    exact ⟨(hst b false).1.trans (htu false c).1,
      R.trans (hst b false).2 (htu false c).2⟩

def approx (M : Mealy S) : ℕ → PER S
  | 0 => PER.universal
  | n+1 => M.refine (M.approx n)

theorem approx_decreasing (M : Mealy S) (n : ℕ) (s t : S) :
    (M.approx (n+1)).rel s t → (M.approx n).rel s t := by
  induction n generalizing s t with
  | zero => exact fun _ => trivial
  | succ n ih =>
    intro h b c
    exact ⟨(h b c).1, ih _ _ (h b c).2⟩

/-- The concrete source-derived operator reaches a fixed point after at most `2m-1` rounds. -/
theorem stabilization_bound [Finite S] [Nonempty S] (M : Mealy S) :
    M.approx (2 * Nat.card S) = M.approx (2 * Nat.card S - 1) := by
  exact PER.stabilization_bound M.approx M.refine rfl (fun _ => rfl)
    M.approx_decreasing

/-- The fixed point remains unchanged at every later round. -/
theorem stable_after_bound [Finite S] [Nonempty S] (M : Mealy S) (k : ℕ) :
    M.approx (2 * Nat.card S - 1 + k) = M.approx (2 * Nat.card S - 1) := by
  apply PER.stationary_after M.approx M.refine (fun _ => rfl)
  have hp : 0 < Nat.card S := Nat.card_pos
  have hb := M.stabilization_bound
  convert hb using 1
  congr 1
  omega

/-- A complete infinite-output equivalence is the intersection of all finite approximants. -/
def infiniteRel (M : Mealy S) (s t : S) : Prop := ∀ n, (M.approx n).rel s t

/-- Finite bounded refinement computes that entire intersection, not merely a postfixed relation. -/
theorem bound_iff_infinite [Finite S] [Nonempty S] (M : Mealy S) (s t : S) :
    (M.approx (2 * Nat.card S - 1)).rel s t ↔ M.infiniteRel s t := by
  constructor
  · intro h n
    by_cases hn : 2 * Nat.card S - 1 ≤ n
    · have heq := M.stable_after_bound (n - (2 * Nat.card S - 1))
      rw [Nat.add_sub_of_le hn] at heq
      simpa [heq] using h
    · have hmono : ∀ k j, j ≤ k → (M.approx k).rel s t → (M.approx j).rel s t := by
        intro k
        induction k with
        | zero =>
          intro j hj h
          have hj0 : j = 0 := by omega
          simpa [hj0] using h
        | succ k ih =>
          intro j hj hk
          by_cases heq : j = k+1
          · simpa [heq] using hk
          · exact ih j (by omega) (M.approx_decreasing k s t hk)
      exact hmono _ _ (by omega) h
  · intro h
    exact h _

/-- Output generated by a finite input word, preserving every synchronous tick. -/
def outputWord (M : Mealy S) : S → List Bool → List Bool
  | _, [] => []
  | s, b :: bs => M.out s b :: M.outputWord (M.next s b) bs

/-- Exact source correspondence: approximation `n` compares all independent input words of length `n`. -/
theorem approx_iff_words (M : Mealy S) (n : ℕ) (s t : S) :
    (M.approx n).rel s t ↔ ∀ u v : List Bool, u.length = n → v.length = n →
      M.outputWord s u = M.outputWord t v := by
  induction n generalizing s t with
  | zero =>
    constructor
    · intro _ u v hu hv
      have hu' : u = [] := List.length_eq_zero_iff.mp hu
      have hv' : v = [] := List.length_eq_zero_iff.mp hv
      simp [hu', hv', outputWord]
    · intro _
      trivial
  | succ n ih =>
    constructor
    · intro h u v hu hv
      cases u with
      | nil => simp at hu
      | cons b bs =>
        cases v with
        | nil => simp at hv
        | cons c cs =>
          have hb : bs.length = n := by simpa using hu
          have hc : cs.length = n := by simpa using hv
          exact congrArg₂ List.cons (h b c).1 ((ih _ _).mp (h b c).2 bs cs hb hc)
    · intro h b c
      constructor
      · have hw := h (b :: List.replicate n false) (c :: List.replicate n false)
          (by simp) (by simp)
        exact (List.cons.inj hw).1
      · apply (ih _ _).mpr
        intro u v hu hv
        have hw := h (b :: u) (c :: v) (by simp [hu]) (by simp [hv])
        exact (List.cons.inj hw).2

/-- Every failed infinite-output diagonal has two equal-length distinguishing input words
of length `2m-1`; shorter witnesses may be padded to this uniform horizon. -/
theorem distinguishing_words [Finite S] [Nonempty S] (M : Mealy S) (s : S)
    (h : ¬ M.infiniteRel s s) :
    ∃ u v : List Bool, u.length = 2 * Nat.card S - 1 ∧
      v.length = 2 * Nat.card S - 1 ∧ M.outputWord s u ≠ M.outputWord s v := by
  have hn : ¬ (M.approx (2 * Nat.card S - 1)).rel s s := by
    intro hr
    exact h ((M.bound_iff_infinite s s).mp hr)
  rw [approx_iff_words] at hn
  push_neg at hn
  obtain ⟨u, v, hu, hv, hne⟩ := hn
  exact ⟨u, v, hu, hv, hne⟩

namespace Fixtures

def twoState : Mealy (Fin 2) where
  out s _ := decide (s = 1)
  next s b := if s = 0 ∧ b = true then 1 else 0

/-- A concrete counterexample to a literal `m` refinement-round bound. -/
theorem two_state_requires_three :
    (twoState.approx 2).rel 1 1 ∧ ¬ (twoState.approx 3).rel 1 1 := by
  simp only [approx, refine, PER.universal, twoState]
  decide

def threeState : Mealy (Fin 3) where
  out s _ := decide (s = 2)
  next s b := if s = 0 then (if b then 1 else 0) else if s = 1 then 2 else 0

theorem three_state_requires_five :
    (threeState.approx 4).rel 1 1 ∧ ¬ (threeState.approx 5).rel 1 1 := by
  simp only [approx, refine, PER.universal, threeState]
  decide

end Fixtures
end Mealy
end Orthemology.Frontier
