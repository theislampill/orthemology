theorem Rule_bounds (c : Nat) (h : ∃ a : Rule, encode a = c) :
    ∀ d ∈ localChildren ruleDescription c, d.2 < c := by
  obtain ⟨a,rfl⟩ := h
  cases a with
  | CtxJ_ctxBase a0 => exact rule_bounds_0 a0
  | CtxJ_nil  => exact rule_bounds_1 
  | CtxJ_ext a0 a1 => exact rule_bounds_2 a0 a1
  | FormJ_formBase a0 a1 => exact rule_bounds_3 a0 a1
  | FormJ_param a0 a1 => exact rule_bounds_4 a0 a1
  | FormJ_bottom a0 => exact rule_bounds_5 a0
  | FormJ_all a0 a1 => exact rule_bounds_6 a0 a1
  | FormJ_raw a0 => exact rule_bounds_7 a0
  | FormJ_pi a0 a1 a2 => exact rule_bounds_8 a0 a1 a2
  | FormJ_sigma a0 a1 a2 => exact rule_bounds_9 a0 a1 a2
  | FormJ_identity a0 a1 a2 a3 => exact rule_bounds_10 a0 a1 a2 a3
  | HasJ_hasBase a0 a1 a2 => exact rule_bounds_11 a0 a1 a2
  | HasJ_var a0 a1 a2 a3 => exact rule_bounds_12 a0 a1 a2 a3
  | HasJ_i a0 a1 => exact rule_bounds_13 a0 a1
  | HasJ_k a0 a1 a2 => exact rule_bounds_14 a0 a1 a2
  | HasJ_s a0 a1 a2 a3 => exact rule_bounds_15 a0 a1 a2 a3
  | HasJ_finite a0 a1 a2 a3 a4 => exact rule_bounds_16 a0 a1 a2 a3 a4
  | HasJ_allIntro a0 a1 a2 => exact rule_bounds_17 a0 a1 a2
  | HasJ_allElim a0 a1 a2 a3 => exact rule_bounds_18 a0 a1 a2 a3
  | HasJ_rawAtom a0 a1 => exact rule_bounds_19 a0 a1
  | HasJ_rawApp a0 a1 a2 => exact rule_bounds_20 a0 a1 a2
  | HasJ_piIntro a0 a1 a2 a3 => exact rule_bounds_21 a0 a1 a2 a3
  | HasJ_piElim a0 a1 a2 a3 a4 => exact rule_bounds_22 a0 a1 a2 a3 a4
  | HasJ_sigmaIntro a0 a1 a2 a3 a4 => exact rule_bounds_23 a0 a1 a2 a3 a4
  | HasJ_sigmaFst a0 a1 a2 a3 => exact rule_bounds_24 a0 a1 a2 a3
  | HasJ_sigmaSnd a0 a1 a2 a3 => exact rule_bounds_25 a0 a1 a2 a3
  | HasJ_identityIntro a0 a1 a2 a3 a4 => exact rule_bounds_26 a0 a1 a2 a3 a4
  | HasJ_proofErase a0 a1 a2 a3 a4 => exact rule_bounds_27 a0 a1 a2 a3 a4
  | HasJ_j a0 a1 a2 a3 a4 a5 a6 => exact rule_bounds_28 a0 a1 a2 a3 a4 a5 a6
  | HasJ_conv a0 a1 a2 a3 a4 => exact rule_bounds_29 a0 a1 a2 a3 a4
  | HasJ_piExt a0 a1 a2 a3 a4 a5 => exact rule_bounds_30 a0 a1 a2 a3 a4 a5
  | HasJ_allExt a0 a1 a2 a3 a4 => exact rule_bounds_31 a0 a1 a2 a3 a4
  | HasJ_sigmaElim a0 a1 a2 a3 a4 a5 => exact rule_bounds_32 a0 a1 a2 a3 a4 a5
  | HasJ_natInduction a0 a1 a2 a3 => exact rule_bounds_33 a0 a1 a2 a3
  | CtxE_nil  => exact rule_bounds_34 
  | CtxE_ext a0 a1 => exact rule_bounds_35 a0 a1
  | FormE_param a0 a1 => exact rule_bounds_36 a0 a1
  | FormE_bottom a0 => exact rule_bounds_37 a0
  | FormE_all a0 a1 => exact rule_bounds_38 a0 a1
  | FormE_raw a0 => exact rule_bounds_39 a0
  | FormE_pi a0 a1 a2 => exact rule_bounds_40 a0 a1 a2
  | FormE_sigma a0 a1 a2 => exact rule_bounds_41 a0 a1 a2
  | FormE_identity a0 a1 a2 a3 => exact rule_bounds_42 a0 a1 a2 a3
  | HasE_var a0 a1 a2 a3 => exact rule_bounds_43 a0 a1 a2 a3
  | HasE_i a0 a1 => exact rule_bounds_44 a0 a1
  | HasE_k a0 a1 a2 => exact rule_bounds_45 a0 a1 a2
  | HasE_s a0 a1 a2 a3 => exact rule_bounds_46 a0 a1 a2 a3
  | HasE_finite a0 a1 a2 a3 a4 => exact rule_bounds_47 a0 a1 a2 a3 a4
  | HasE_allIntro a0 a1 a2 => exact rule_bounds_48 a0 a1 a2
  | HasE_allElim a0 a1 a2 a3 => exact rule_bounds_49 a0 a1 a2 a3
  | HasE_rawAtom a0 a1 => exact rule_bounds_50 a0 a1
  | HasE_rawApp a0 a1 a2 => exact rule_bounds_51 a0 a1 a2
  | HasE_piIntro a0 a1 a2 a3 => exact rule_bounds_52 a0 a1 a2 a3
  | HasE_piElim a0 a1 a2 a3 a4 => exact rule_bounds_53 a0 a1 a2 a3 a4
  | HasE_sigmaIntro a0 a1 a2 a3 a4 => exact rule_bounds_54 a0 a1 a2 a3 a4
  | HasE_sigmaFst a0 a1 a2 a3 => exact rule_bounds_55 a0 a1 a2 a3
  | HasE_sigmaSnd a0 a1 a2 a3 => exact rule_bounds_56 a0 a1 a2 a3
  | HasE_identityIntro a0 a1 a2 a3 a4 => exact rule_bounds_57 a0 a1 a2 a3 a4
  | HasE_proofErase a0 a1 a2 a3 a4 => exact rule_bounds_58 a0 a1 a2 a3 a4
  | HasE_j a0 a1 a2 a3 a4 a5 a6 => exact rule_bounds_59 a0 a1 a2 a3 a4 a5 a6
  | HasE_conv a0 a1 a2 a3 a4 => exact rule_bounds_60 a0 a1 a2 a3 a4
  | HasE_piExt a0 a1 a2 a3 a4 a5 => exact rule_bounds_61 a0 a1 a2 a3 a4 a5
  | HasE_allExt a0 a1 a2 a3 a4 => exact rule_bounds_62 a0 a1 a2 a3 a4

end CertificateCodeValidity
import Mathlib.Tactic
import Mathlib.Data.Finset.Max

open scoped BigOperators

namespace Orthemology.Tranche3
noncomputable section

variable {Ω : Type*} [Fintype Ω]

def upperTail (p : Ω → ℝ) (stat : Ω → ℕ) (x : Ω) : ℝ :=
  ∑ y, if stat x < stat y then p y else 0

def lowerTail (p : Ω → ℝ) (stat : Ω → ℕ) (x : Ω) : ℝ :=
  ∑ y, if stat y ≤ stat x then p y else 0

/-- Inclusive finite upper-tail p-values are superuniform. This result needs
only nonnegative masses; probability normalization is supplied by applications. -/
theorem upperTail_superuniform (p : Ω → ℝ) (stat : Ω → ℕ)
    (hp : ∀ x, 0 ≤ p x) (beta : ℝ) (hb : 0 ≤ beta) :
    (∑ x, if upperTail p stat x ≤ beta then p x else 0) ≤ beta := by
  classical
  let A := Finset.univ.filter (fun x => upperTail p stat x ≤ beta)
  rw [← Finset.sum_filter]
  change (∑ x ∈ A, p x) ≤ beta
  by_cases hA : A.Nonempty
  · obtain ⟨x,hx,hm⟩ := A.exists_min_image stat hA
    have hb' : upperTail p stat x ≤ beta := (Finset.mem_filter.mp hx).2
    have hs : A ⊆ Finset.univ.filter (fun y => stat x ≤ stat y) := by
      intro y hy
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,hm y hy⟩
    calc
      (∑ x ∈ A, p x) ≤ ∑ y ∈ Finset.univ.filter (fun y => stat x ≤ stat y), p y :=
        Finset.sum_le_sum_of_subset_of_nonneg hs (fun y _ _ => hp y)
      _ = upperTail p stat x := by simp [upperTail, Finset.sum_filter]
      _ ≤ beta := hb'
  · have he : A = ∅ := Finset.not_nonempty_iff_eq_empty.mp hA
    simpa [he] using hb

/-- The lower-tail analogue retains ties and zero-mass observations. -/
theorem lowerTail_superuniform (p : Ω → ℝ) (stat : Ω → ℕ)
    (hp : ∀ x, 0 ≤ p x) (beta : ℝ) (hb : 0 ≤ beta) :
    (∑ x, if lowerTail p stat x ≤ beta then p x else 0) ≤ beta := by
  classical
  let A := Finset.univ.filter (fun x => lowerTail p stat x ≤ beta)
  rw [← Finset.sum_filter]
  change (∑ x ∈ A, p x) ≤ beta
  by_cases hA : A.Nonempty
  · obtain ⟨x,hx,hm⟩ := A.exists_max_image stat hA
    have hb' : lowerTail p stat x ≤ beta := (Finset.mem_filter.mp hx).2
    have hs : A ⊆ Finset.univ.filter (fun y => stat y ≤ stat x) := by
      intro y hy
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,hm y hy⟩
    calc
      (∑ x ∈ A, p x) ≤ ∑ y ∈ Finset.univ.filter (fun y => stat y ≤ stat x), p y :=
        Finset.sum_le_sum_of_subset_of_nonneg hs (fun y _ _ => hp y)
      _ = lowerTail p stat x := by simp [lowerTail, Finset.sum_filter]
      _ ≤ beta := hb'
  · have he : A = ∅ := Finset.not_nonempty_iff_eq_empty.mp hA
    simpa [he] using hb

/-- Tail-inversion certificates yield a finite-sample coverage bound, for an
arbitrary real true parameter. The two implications are checked by the
parameter-monotonicity layer of a concrete statistical family. -/
theorem tail_inversion_coverage (p : Ω → ℝ) (stat : Ω → ℕ)
    (hp : ∀ x, 0 ≤ p x) (beta : ℝ) (hb : 0 ≤ beta)
    (a : ℝ) (lower upper : Ω → ℝ)
    (hl : ∀ x, a < lower x → upperTail p stat x ≤ beta)
    (hu : ∀ x, upper x < a → lowerTail p stat x ≤ beta) :
    (∑ x, if a < lower x ∨ upper x < a then p x else 0) ≤ 2*beta := by
  classical
  calc
    (∑ x, if a < lower x ∨ upper x < a then p x else 0) ≤
        ∑ x, ((if upperTail p stat x ≤ beta then p x else 0) +
              (if lowerTail p stat x ≤ beta then p x else 0)) := by
      apply Finset.sum_le_sum
      intro x _
      by_cases h : a < lower x ∨ upper x < a
      · rw [if_pos h]
        rcases h with h | h
        · rw [if_pos (hl x h)]
          split_ifs <;> linarith [hp x]
        · rw [if_pos (hu x h)]
          split_ifs <;> linarith [hp x]
      · rw [if_neg h]
        split_ifs <;> linarith [hp x]
    _ ≤ 2*beta := by
      rw [Finset.sum_add_distrib]
      linarith [upperTail_superuniform p stat hp beta hb,lowerTail_superuniform p stat hp beta hb]

end
end Orthemology.Tranche3

#print axioms Orthemology.Tranche3.upperTail_superuniform
#print axioms Orthemology.Tranche3.lowerTail_superuniform
#print axioms Orthemology.Tranche3.tail_inversion_coverage
import Std

/-!
Conditional mathematics for the provision/identity frontier. Theorems validate
no historical or metaphysical premise. In particular no source-owned act is
identified with a created effect, and no conservation axiom is postulated.
-/
namespace ProvisionIdentity

inductive Root where | a | b deriving DecidableEq, Repr
inductive Policy where | coalesce | redundant | priorityA | priorityB
  deriving DecidableEq, Repr

-- Intrinsic event inputs. The sole created event is represented by occurrence.
-- Shared occurrence variables do NOT prove transworld numerical identity.
def created (_ : Policy) (a b : Bool) : Bool := a || b

-- Positive derivation support, calculated from the operational rules.
def rootsA (p : Policy) (a b : Bool) : Bool :=
  match p with
  | .coalesce => a
  | .redundant => a
  | .priorityA => a
  | .priorityB => a && !b

def rootsB (p : Policy) (a b : Bool) : Bool :=
  match p with
  | .coalesce => b
  | .redundant => b
  | .priorityA => b && !a
  | .priorityB => b

def entireA (p : Policy) (a b : Bool) : Bool := rootsA p a b && !rootsB p a b
def entireB (p : Policy) (a b : Bool) : Bool := rootsB p a b && !rootsA p a b

theorem same_created_table (p q : Policy) : created p = created q := rfl

theorem actual_provision_differs :
    entireA .priorityA true true = true ∧ entireA .coalesce true true = false := by decide

theorem whole_effect_cnd (p : Policy) (a b : Bool) :
    ¬ (entireA p a b = true ∧ entireB p a b = true) := by
  cases p <;> cases a <;> cases b <;> decide

theorem nonempty_whole_effect_provision : entireA .coalesce true false = true := by decide

theorem coalescence_fixed_act_solo :
    created .coalesce true true = true ∧ created .coalesce true false = true := by decide

-- The direct-event construction generalizes beyond a single Boolean target:
-- any event-indexed target predicate can be issued by either same bearer.
-- This does NOT say all metaphysical products are event-indexed sets.
def eventProduction {E : Type} (a b : E → Prop) : E → Prop := fun e => a e ∨ b e

theorem every_event_target_solo {E : Type} (q : E → Prop) :
    ∀ e, eventProduction q (fun _ => False) e ↔ q e := by
  intro e
  simp [eventProduction]

theorem every_event_target_double {E : Type} (q : E → Prop) :
    ∀ e, eventProduction q q e ↔ q e := by
  intro e
  simp [eventProduction]


-- No decoder from the COMPLETE chosen extensional table can recover actual
-- entire-A provision for both operational factorizations.
theorem no_extensional_provision_decoder :
    ¬ ∃ decode : (Bool → Bool → Bool) → Bool,
      decode (created .coalesce) = entireA .coalesce true true ∧
      decode (created .priorityA) = entireA .priorityA true true := by
  intro ⟨decode, hc, hp⟩
  have h : entireA .coalesce true true = entireA .priorityA true true := hc.symm.trans hp
  cases h

-- Individually different act tokens need not have different outputs. Any
-- inference from act inequality to output inequality needs a map condition.
theorem distinct_acts_can_have_same_created_effect :
    ∃ f : Root → Unit, Root.a ≠ Root.b ∧ f .a = f .b := by
  exact ⟨fun _ => (), by decide, rfl⟩

theorem act_distinction_transports_under_injectivity
    {Act Effect : Type} (f : Act → Effect)
    (inj : ∀ ⦃x y⦄, f x = f y → x = y) (a b : Act) (hne : a ≠ b) : f a ≠ f b := by
  intro eq
  exact hne (inj eq)

-- Positive created-output accounting, when independently justified, proves
-- nonabsorption without assuming that provenance fixes numerical identity.
theorem positive_accounting_excludes_unchanged_joint
    {Effect : Type} (measure : Effect → Nat) (solo joint : Effect)
    (amountA amountB : Nat)
    (solo_account : measure solo = amountA)
    (joint_account : measure joint = amountA + amountB)
    (genuine_extra : 0 < amountB) : joint ≠ solo := by
  intro eq
  rw [eq] at joint_account
  omega

-- Cancellation is a sufficient but stronger algebraic condition. No global
-- algebra or positivity assumption is hidden in a structure declaration.
theorem cancellation_excludes_absorption
    {M : Type} (op : M → M → M) (zero : M)
    (identity : ∀ a, op a zero = a)
    (cancel : ∀ a b c, op a b = op a c → b = c)
    (a b : M) (eq : op a b = a) : b = zero := by
  exact cancel a b zero (eq.trans (identity a).symm)

-- Completeness of a physical-accounting refinement and identity of its
-- qualitative projection are different properties.
def physical (a b : Nat) : Nat × Nat := (min 1 (a+b), (a+b)-min 1 (a+b))
theorem display_equal_with_extra_created_waste :
    (physical 1 1).1 = (physical 1 0).1 ∧ physical 1 1 ≠ physical 1 0 := by decide

-- Requiring EVERY jointly grounded event to have an earlier jointly grounded
-- mechanism is incompatible with well-founded temporal/derivational depth.
-- This is stronger than mere contingent-event efficient explanation.
theorem no_well_founded_joint_mechanism_regress
    (Joint : Nat → Prop)
    (earlier : ∀ n, Joint n → ∃ m, m < n ∧ Joint m) : ∀ n, ¬ Joint n := by
  intro n
  induction n using Nat.strongRecOn with
  | ind n ih =>
    intro hn
    obtain ⟨m, hmn, hm⟩ := earlier n hn
    exact ih m hmn hm

-- Primitive entire-provision relation is deliberately NONFUNCTIONAL.
-- CND rejects duplicate whole production; it is not encoded by a function.
def PrimitiveCND (Entire : Root → Prop) : Prop :=
  ∀ g h, Entire g → Entire h → g = h

theorem double_primitive_entire_violates_cnd :
    ¬ PrimitiveCND (fun _ => True) := by
  intro h
  have bad : Root.a = Root.b := h .a .b True.intro True.intro
  cases bad

theorem cnd_does_not_entail_entire_coverage :
    PrimitiveCND (fun _ => False) ∧ ¬ ∃ g : Root, (fun _ : Root => False) g := by
  constructor
  · intro g h hg
    exact False.elim hg
  · intro ⟨g, hg⟩
    exact hg

-- Positive reduced-signature counterexample, rather than only a failed
-- full-source model: exact output, same-act solo outcome and CND coexist
-- with no individual entire actual provider at the cooperative target.
theorem reduced_signature_provision_independence :
    created .coalesce true true = true ∧
    created .coalesce true false = true ∧
    created .coalesce false true = true ∧
    (¬ (entireA .coalesce true true = true ∧ entireB .coalesce true true = true)) ∧
    entireA .coalesce true true = false ∧ entireB .coalesce true true = false := by decide


end ProvisionIdentity

#print axioms ProvisionIdentity.same_created_table
#print axioms ProvisionIdentity.actual_provision_differs
#print axioms ProvisionIdentity.whole_effect_cnd
#print axioms ProvisionIdentity.nonempty_whole_effect_provision
#print axioms ProvisionIdentity.coalescence_fixed_act_solo
#print axioms ProvisionIdentity.no_extensional_provision_decoder
#print axioms ProvisionIdentity.distinct_acts_can_have_same_created_effect
#print axioms ProvisionIdentity.act_distinction_transports_under_injectivity
#print axioms ProvisionIdentity.positive_accounting_excludes_unchanged_joint
#print axioms ProvisionIdentity.cancellation_excludes_absorption
#print axioms ProvisionIdentity.display_equal_with_extra_created_waste
#print axioms ProvisionIdentity.no_well_founded_joint_mechanism_regress

#print axioms ProvisionIdentity.every_event_target_solo
#print axioms ProvisionIdentity.every_event_target_double

#print axioms ProvisionIdentity.double_primitive_entire_violates_cnd
#print axioms ProvisionIdentity.cnd_does_not_entail_entire_coverage
#print axioms ProvisionIdentity.reduced_signature_provision_independence
import P01CanonicalCarrierProjection
open OrthemologyV2 OrthemologyV3 P01D P01R P01DF
example : carrierCode (IdPER totalPER .i P01DF.skk) = equalityCode (carrierCode totalPER) .i P01DF.skk := by
  exact raw_identity_carrier_square .i P01DF.skk
import MatrixEndpointChecks

/-! Supplemental compiled execution vectors, not substitutes for kernel proofs. -/
namespace MatrixIndependentAudit
open P02.Codec P02.Codec.UniformComputability AtomicMembership

def vectorPrograms : List (String × ℕ) :=
  [("invalid",0),("echo",programIndex echoProgram),("mixed",programIndex mixedProgram)]

def vectorRationals : List (ℕ × ℕ) :=
  [(0,0),(7,0),(0,3),(1,4),(2,4),(1,2),(3,4),(1,1),(3,2),(6,8)]

def vectorRows : List String :=
  vectorPrograms.flatMap (fun p => (List.range 4).flatMap (fun N =>
    (List.range 4).flatMap (fun k => vectorRationals.map (fun q =>
      String.intercalate "," [p.1,toString N,toString k,toString q.1,toString q.2,
        toString (heavyCount p.2 k N),toString (integerMatrix (p.2,Nat.pair q.1 q.2,k,N)),
        toString (decide (membershipMatrix p.2 (Nat.pair q.1 q.2) k N))]))))

#eval vectorRows.forM IO.println
end MatrixIndependentAudit
import SCCParity
namespace IndependentMECOracle
set_option maxRecDepth 200000
set_option maxHeartbeats 0
abbrev S := Fin 3
abbrev E := Fin 4
abbrev M := Fin 3
structure Case where
  mode : Nat
  sources : Nat
  successors : Nat
  rows : Nat
  priorities : Nat
  live : Nat
  candidate : Nat
  allowed : Nat

def digit (x base i : Nat) : Nat := (x / base^i)%base
def source (c : Case) (e : E) : S := ⟨digit c.sources 3 e.val, Nat.mod_lt _ (by decide)⟩
def successors (c : Case) (e : E) : Finset S :=
  Finset.univ.filter (fun s => digit (digit c.successors 8 e.val) 2 s.val = 1)
def rows (c : Case) (m : M) (e : E) : Nat := digit c.rows 4 (m.val*4+e.val)
def pvalue (x : Nat) : Nat := if x<4 then x else 2^70+x-4
def priorities (c : Case) (m : M) (e : E) : Nat := pvalue (digit c.priorities 7 (m.val*4+e.val))
def allowed (c : Case) : Finset E := Finset.univ.filter (fun e => digit c.allowed 2 e.val=1)
def live (c : Case) : Finset M := Finset.univ.filter (fun m => digit c.live 2 m.val=1)
def solve (c : Case) : Nat × Nat :=
  let result := if c.mode=0 then HiddenParity.SCCPruning.mecs (source c) (successors c) (allowed c)
    else HiddenParity.SCCPruning.parityOutput (source c) (successors c) (live c) (rows c) (priorities c)
      ⟨c.candidate%3,Nat.mod_lt _ (by decide)⟩ (allowed c)
  (result.sum (fun D => 2^(D.sum (fun e => 2^e.val))),
    (result.biUnion (HiddenParity.usedStates (source c))).sum (fun s => 2^s.val))
