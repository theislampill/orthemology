import JointSubstitution

/- A separate, unadopted joint-completion syntax. Has, HasE and HasC are imported
unchanged. The original HasE constructor block is reproduced exactly under fresh
names, and neither completion rule has a semantic-validity premise. -/
namespace JointCompletion
open P01AC P01D OrthemologyV2 OrthemologyV3 P01R
open P01AC.Intensional.Plus (PolyConvPlus)
mutual
  inductive CtxJ : Tel → Prop
    | ctxBase : P01AC.ExtensionalRepair.CtxE Γ → CtxJ Γ
    | nil : CtxJ []
    | ext : CtxJ Γ → FormJ Γ A → CtxJ (A :: Γ)
  inductive FormJ : Tel → Ty → Prop
    | formBase : P01AC.ExtensionalRepair.FormE Γ A → FormJ Γ A
    | param : CtxJ Γ → FormJ Γ (.param n)
    | bottom : CtxJ Γ → FormJ Γ .bottom
    | all : CtxJ Γ → FormJ (twkTel Γ) B → FormJ Γ (.all B)
    | raw : CtxJ Γ → FormJ Γ .raw
    | pi : FormJ Γ A → FormJ (A :: Γ) B → FormJ Γ (.pi A B)
    | sigma : FormJ Γ A → FormJ (A :: Γ) B → FormJ Γ (.sigma A B)
    | identity : FormJ Γ A → HasJ Γ p A → HasJ Γ q A → FormJ Γ (.identity A p q)
  inductive HasJ : Tel → Poly → Ty → Prop
    | hasBase : P01AC.ExtensionalRepair.HasE Γ p A → HasJ Γ p A
    | var : FormJ Γ A → Lookup Γ n A → HasJ Γ (.var n) A
    | i : FormJ Γ A → FormJ Γ (arr A A) → HasJ Γ (.atom .i) (arr A A)
    | k : FormJ Γ A → FormJ Γ B → FormJ Γ (arr A (arr B A)) →
        HasJ Γ (.atom .k) (arr A (arr B A))
    | s : FormJ Γ A → FormJ Γ B → FormJ Γ C →
        FormJ Γ (arr (arr A (arr B C)) (arr (arr A B) (arr A C))) →
        HasJ Γ (.atom .s) (arr (arr A (arr B C)) (arr (arr A B) (arr A C)))
    | finite : (τ : List Ty) → finSupport C ≤ τ.length →
        (∀ n, n < τ.length → FormJ Γ (typeImages τ n)) →
        FormJ Γ (tsubst (typeImages τ) (fin C)) → FiniteDerives t C →
        HasJ Γ (.atom t) (tsubst (typeImages τ) (fin C))
    | allIntro : FormJ Γ (.all B) → HasJ (twkTel Γ) p B → HasJ Γ p (.all B)
    | allElim : FormJ Γ (.all B) → FormJ Γ A → FormJ Γ (tinst B A) →
        HasJ Γ p (.all B) → HasJ Γ p (tinst B A)
    | rawAtom : FormJ Γ .raw → HasJ Γ (.atom t) .raw
    | rawApp : FormJ Γ .raw → HasJ Γ f .raw → HasJ Γ a .raw → HasJ Γ (.app f a) .raw
    | piIntro : FormJ Γ (.pi A B) → HasJ (A :: Γ) b B → Scoped Γ.length (abstract b) →
        HasJ Γ (abstract b) (.pi A B)
    | piElim : FormJ Γ (.pi A B) → FormJ Γ (inst B a) →
        HasJ Γ f (.pi A B) → HasJ Γ a A → HasJ Γ (.app f a) (inst B a)
    | sigmaIntro : FormJ Γ (.sigma A B) → FormJ Γ (inst B a) →
        HasJ Γ a A → HasJ Γ b (inst B a) → HasJ Γ (pairPoly a b) (.sigma A B)
    | sigmaFst : FormJ Γ A → FormJ Γ (.sigma A B) → HasJ Γ z (.sigma A B) →
        HasJ Γ (fstPoly z) A
    | sigmaSnd : FormJ Γ (.sigma A B) → FormJ Γ (inst B (fstPoly z)) →
        HasJ Γ z (.sigma A B) → HasJ Γ (sndPoly z) (inst B (fstPoly z))
    | identityIntro : FormJ Γ (.identity A p q) → HasJ Γ p A → HasJ Γ q A →
        PolyConvPlus p q → HasJ Γ (.atom .i) (.identity A p q)
    | proofErase : FormJ Γ .raw → FormJ Γ (.identity A x y) →
        HasJ Γ p (.identity A x y) → HasJ Γ p .raw
    | j : FormJ Γ A → FormJ (theta Γ A x) B →
        FormJ Γ (.identity A x y) → FormJ Γ (motiveAt B x (.atom .i)) →
        FormJ Γ (motiveAt B y e) → HasJ Γ x A → HasJ Γ y A →
        HasJ Γ e (.identity A x y) → HasJ Γ d (motiveAt B x (.atom .i)) →
        HasJ Γ (jPoly d y e) (motiveAt B y e)
    | conv : FormJ Γ A → HasJ Γ p A → PolyConvPlus p q → Scoped Γ.length q → HasJ Γ q A
    /-- Exactly §3.1: all explicit formation and scope premises are retained. -/
    | piExt : FormJ Γ A → FormJ (A :: Γ) B → FormJ Γ (.pi A B) →
        HasJ Γ p (.pi A B) → HasJ Γ q (.pi A B) →
        FormJ (A :: Γ) (.identity B (.app (pren Nat.succ p) (.var 0))
          (.app (pren Nat.succ q) (.var 0))) →
        FormJ Γ (.pi A (.identity B (.app (pren Nat.succ p) (.var 0))
          (.app (pren Nat.succ q) (.var 0)))) →
        HasJ Γ h (.pi A (.identity B (.app (pren Nat.succ p) (.var 0))
          (.app (pren Nat.succ q) (.var 0)))) →
        FormJ Γ (.identity (.pi A B) p q) →
        Scoped Γ.length p → Scoped Γ.length q → Scoped Γ.length h →
        TyScoped Γ.length A → TyScoped (Γ.length + 1) B →
        HasJ Γ (.atom .i) (.identity (.pi A B) p q)
    /-- Exactly §3.2: one finite body proof under the type-weakened telescope. -/
    | allExt : FormJ (twkTel Γ) B → FormJ Γ (.all B) →
        HasJ Γ p (.all B) → HasJ Γ q (.all B) →
        FormJ (twkTel Γ) (.identity B p q) →
        HasJ (twkTel Γ) h (.identity B p q) →
        FormJ Γ (.identity (.all B) p q) →
        Scoped Γ.length p → Scoped Γ.length q → Scoped Γ.length h →
        TyScoped Γ.length B → HasJ Γ (.atom .i) (.identity (.all B) p q)
    /-- All actual recursively formed motives and newly typed inputs are allowed. -/
    | sigmaElim : CtxJ Γ → FormJ Γ A → FormJ (A :: Γ) B →
        FormJ (.sigma A B :: Γ) P →
        HasJ (B :: A :: Γ) d (SigmaCompletion.branchType P) → HasJ Γ z (.sigma A B) →
        HasJ Γ (SigmaCompletion.branchAt d (fstPoly z) (sndPoly z)) (inst P z)
    /-- Full dependent induction; the witness is the retained uniform polynomial. -/
    | natInduction : CtxJ Γ → FormJ (P01AC.EffectiveCompleteness.N :: Γ) P →
        HasJ Γ p (inst P SourceRigidity.zero) → HasJ Γ s (RigidityInitiality.dependentStepType P) →
        HasJ Γ (RigidityInitiality.sectionPoly p s) (.pi P01AC.EffectiveCompleteness.N P)
end

end JointCompletion
import RobustBinaryRepair

namespace Orthemology.Tranche3

/-- Literal one-model correctness, retaining coherent admissibility. -/
def LiteralRepairGood (a e q : ℝ) : Prop :=
  0 ≤ q ∧ q ≤ 1 ∧ excessZero a e q ≤ 0 ∧ excessOne a e q ≤ 0

/-- Positive-weight successful reports occupy a shrinking punctured
neighbourhood of the zero-weight oracle report. -/
theorem positive_weight_punctured_cell (a e q : ℝ)
    (ha : 0 < a) (he0 : 0 < e) (he1 : e ≤ 1/4)
    (h : LiteralRepairGood a e q) :
    1/2 < q ∧ q ≤ 1/2+a*e := by
  rcases h with ⟨hq0,hq1,hz,ho⟩
  rw [excessZero_expand] at hz
  rw [excessOne_expand] at ho
  have hp : 0 < a*e*(1-e) := mul_pos (mul_pos ha he0) (by linarith)
  constructor
  · nlinarith [sq_nonneg (q-1/2)]
  · nlinarith [sq_nonneg (q-1/2)]

/-- The closed-family endpoint has exactly one coherent weak repair. -/
theorem zero_weight_unique (e q : ℝ) : LiteralRepairGood 0 e q ↔ q=1/2 := by
  constructor
  · rintro ⟨hq0,hq1,hz,ho⟩
    simp only [excessZero,excessOne] at hz ho
    nlinarith [sq_nonneg (q-1/2)]
  · rintro rfl
    norm_num [LiteralRepairGood,excessZero,excessOne]

/-- The opposite endpoint has the analogous unique repair. -/
theorem one_weight_unique (e q : ℝ) (he0 : 0 ≤ e) (he1 : e ≤ 1/4) :
    LiteralRepairGood 1 e q ↔ q=1/2+e := by
  constructor
  · rintro ⟨hq0,hq1,hz,ho⟩
    simp only [excessZero,excessOne] at hz ho
    rcases le_total q (1/2+e) with h | h <;> nlinarith [sq_nonneg (q-(1/2+e))]
  · rintro rfl
    constructor
    · linarith
    constructor
    · linarith
    constructor <;> simp [excessZero,excessOne]
    all_goals ring_nf
    all_goals norm_num

/-- At weights below one, the other endpoint is also approached through a
punctured cell. Its width is controlled directly, with epsilon fixed. -/
theorem below_one_punctured_cell (a e q : ℝ)
    (ha : a < 1) (he0 : 0 < e) (he1 : e ≤ 1/4)
    (h : LiteralRepairGood a e q) :
    1/2+e-2*e*(1-a) ≤ q ∧ q < 1/2+e := by
  rcases h with ⟨hq0,hq1,hz,ho⟩
  rw [excessZero_expand] at hz
  rw [excessOne_expand] at ho
  have hgap : 0 < (1-a)*e*(1+e) := mul_pos (mul_pos (by linarith) he0) (by linarith)
  have hq : q < 1/2+e := by nlinarith
  have hd : 0 ≤ 1/2+e-q := by linarith
  have hprod := mul_nonneg (by linarith : 0 ≤ 1/2-2*e) hd
  have hpositive := mul_nonneg (sub_nonneg.mpr ha.le) (sq_nonneg e)
  constructor
  · nlinarith [sq_nonneg (1/2+e-q)]
  · exact hq

end Orthemology.Tranche3

#print axioms Orthemology.Tranche3.positive_weight_punctured_cell
#print axioms Orthemology.Tranche3.zero_weight_unique
#print axioms Orthemology.Tranche3.one_weight_unique
#print axioms Orthemology.Tranche3.below_one_punctured_cell
import MixedSpecializations
import TypeCodeSubstitution
namespace CodedMixedTransformations
open OrthemologyV2 OrthemologyV3 P01AC Encodable SourceFamilyComputability CodedScope ExactSyntaxValidity CodedPolyTransformations
set_option maxRecDepth 8192
set_option maxHeartbeats 12000000

def tcPlainChildren (s : SubstState) : List SubstState :=
  if tag s.2 = 2 then [(s.1,arg1 s.2)]
  else if tag s.2 = 1 then [(s.1,arg1 s.2),(s.1,arg2 s.2)] else []

theorem primrec_tcPlainChildren : Primrec tcPlainChildren := by
  have ht := primrec_tag.comp (Primrec.snd : Primrec (fun s : SubstState => s.2))
  have ha : Primrec (fun s : SubstState => (s.1,arg1 s.2)) := Primrec.fst.pair (primrec_arg1.comp Primrec.snd)
  have hb : Primrec (fun s : SubstState => (s.1,arg2 s.2)) := Primrec.fst.pair (primrec_arg2.comp Primrec.snd)
  exact Primrec.ite (Primrec.eq.comp ht (.const 2)) (Primrec.list_cons.comp ha (.const []))
    (Primrec.ite (Primrec.eq.comp ht (.const 1))
      (Primrec.list_cons.comp ha (Primrec.list_cons.comp hb (.const []))) (.const []))

def supportStep (s : SubstState) (values : List Nat) : Nat :=
  if tag s.2 = 0 then varIndex s.2 + 1
  else if tag s.2 = 2 then (values[0]?.getD 0) - 1
  else if tag s.2 = 1 then max (values[0]?.getD 0) (values[1]?.getD 0)
  else 0

def finStep (s : SubstState) (values : List Nat) : Nat :=
  if tag s.2 = 0 then paramCode (varIndex s.2)
  else if tag s.2 = 2 then unary 2 (values[0]?.getD 0)
  else if tag s.2 = 1 then binary 4 (values[0]?.getD 0) (wkTyCode (values[1]?.getD 0))
  else encode Ty.bottom

theorem primrec_supportStep : Primrec₂ supportStep := by
  have hc : Primrec (fun p : SubstState × List Nat => p.1.2) := Primrec.snd.comp Primrec.fst
  have ht := primrec_tag.comp hc
  have h0 : Primrec (fun p : SubstState × List Nat => p.2[0]?.getD 0) :=
    Primrec.option_getD.comp (Primrec.list_getElem?.comp Primrec.snd (.const 0)) (.const 0)
  have h1 : Primrec (fun p : SubstState × List Nat => p.2[1]?.getD 0) :=
    Primrec.option_getD.comp (Primrec.list_getElem?.comp Primrec.snd (.const 1)) (.const 0)
  exact Primrec.ite (Primrec.eq.comp ht (.const 0)) (Primrec.succ.comp (primrec_varIndex.comp hc))
    (Primrec.ite (Primrec.eq.comp ht (.const 2)) (Primrec.pred.comp h0)
      (Primrec.ite (Primrec.eq.comp ht (.const 1)) (Primrec.nat_max.comp h0 h1) (.const 0)))

theorem primrec_finStep : Primrec₂ finStep := by
  have hc : Primrec (fun p : SubstState × List Nat => p.1.2) := Primrec.snd.comp Primrec.fst
  have ht := primrec_tag.comp hc
  have h0 : Primrec (fun p : SubstState × List Nat => p.2[0]?.getD 0) :=
    Primrec.option_getD.comp (Primrec.list_getElem?.comp Primrec.snd (.const 0)) (.const 0)
  have h1 : Primrec (fun p : SubstState × List Nat => p.2[1]?.getD 0) :=
    Primrec.option_getD.comp (Primrec.list_getElem?.comp Primrec.snd (.const 1)) (.const 0)
  exact Primrec.ite (Primrec.eq.comp ht (.const 0)) (primrec_paramCode.comp (primrec_varIndex.comp hc))
    (Primrec.ite (Primrec.eq.comp ht (.const 2)) ((primrec_unary_fixed 2).comp h0)
      (Primrec.ite (Primrec.eq.comp ht (.const 1))
        ((primrec_binary_fixed 4).comp h0 (primrec_wkTyCode.comp h1)) (.const _)))

def finSupportCode (c : Nat) : Nat := foldSubst tcPlainChildren supportStep (([],0),c)
def finCode (c : Nat) : Nat := foldSubst tcPlainChildren finStep (([],0),c)

theorem primrec_finSupportCode : Primrec finSupportCode :=
  (primrec_foldSubst primrec_tcPlainChildren primrec_supportStep).comp ((Primrec.const ([],0)).pair Primrec.id)
theorem primrec_finCode : Primrec finCode :=
  (primrec_foldSubst primrec_tcPlainChildren primrec_finStep).comp ((Primrec.const ([],0)).pair Primrec.id)

theorem supportFold_exact (env : List Nat × Nat) (A : TypeCode) :
    foldSubst tcPlainChildren supportStep (env,encode A) = finSupport A := by
  induction A with
  | var n => rw [foldSubst_eq]; simp [supportStep,finSupport,varIndex,leaf]
  | bottom => rw [foldSubst_eq]; simp [supportStep,finSupport]
  | all B ih =>
    rw [foldSubst_eq]
    have h := unary_child_lt 2 (encode B)
    simp [supportStep,tcPlainChildren,boundedInputs,h,ih,finSupport]
  | arrow A B iha ihb =>
    rw [foldSubst_eq]
    have ha := binary_left_lt 1 (encode A) (encode B)
    have hb := binary_right_lt 1 (encode A) (encode B)
    simp [supportStep,tcPlainChildren,boundedInputs,ha,hb,iha,ihb,finSupport]

theorem finFold_exact (env : List Nat × Nat) (A : TypeCode) :
    foldSubst tcPlainChildren finStep (env,encode A) = encode (fin A) := by
  induction A with
  | var n => rw [foldSubst_eq]; simp [finStep,fin,varIndex,leaf,paramCode]
  | bottom => rw [foldSubst_eq]; simp [finStep,fin]
  | all B ih =>
    rw [foldSubst_eq]
    have h := unary_child_lt 2 (encode B)
    simp [finStep,tcPlainChildren,boundedInputs,h,ih,fin]
  | arrow A B iha ihb =>
    rw [foldSubst_eq]
    have ha := binary_left_lt 1 (encode A) (encode B)
    have hb := binary_right_lt 1 (encode A) (encode B)
    simp [finStep,tcPlainChildren,boundedInputs,ha,hb,iha,ihb,fin,arr,wkTyCode_exact]

theorem finSupportCode_exact (A : TypeCode) : finSupportCode (encode A) = finSupport A := supportFold_exact _ A
theorem finCode_exact (A : TypeCode) : finCode (encode A) = encode (fin A) := finFold_exact _ A

#print axioms primrec_finSupportCode
#print axioms finCode_exact
end CodedMixedTransformations
