    {
      "id": "t15-univariate-reference-validate",
      "source_id": "identity-src-2c1183a4725481f50cfc",
      "declaration": "def validate(s):\n    if type(s) is not list or not s or type(s[0]) is not str:\n        raise ValueError('root expression must be a tagged array')\n    if s[0] == 'old' and len(s) == 2:\n        restricted.validate(1,s[1])\n    elif s[0] == 'test' and len(s) == 3:\n        _pure(s[1]); _pure(s[2])\n    else:\n        raise ValueError('unknown or malformed root expression')",
      "target_sha256": "79838fb222f088045bca7f8c381580b7f219dda5e81d2688639071d944b38bf2",
      "domain": "REFERENCE_EXECUTION",
      "calculus": "NONE"
    },
    {
      "id": "t15-univariate-reference-root_bound",
      "source_id": "identity-src-2c1183a4725481f50cfc",
      "declaration": "def root_bound(p):\n    \"\"\"Nonzero integer polynomial cannot vanish at n >= this bound.\n\n    The zero polynomial is assigned 1 for bookkeeping only; it has no\n    nonvanishing assertion. Exponent keys are validated nonnegative integers.\n    \"\"\"\n    if type(p) is not dict or any(type(k) is not int or k<0 or type(v) is not int for k,v in p.items()):\n        raise ValueError('expected finite integer coefficient map')\n    p = {k:v for k,v in p.items() if v}\n    if not p or max(p)==0: return 1\n    degree = max(p)\n    return 1+sum(abs(v) for k,v in p.items() if k<degree)",
      "target_sha256": "0add58a81cd582824dcae391d4eef9bee743217e8bce5d427f55bb8f29b990c8",
      "domain": "REFERENCE_EXECUTION",
      "calculus": "NONE"
    },
    {
      "id": "t15-univariate-reference-comparison_bound",
      "source_id": "identity-src-2c1183a4725481f50cfc",
      "declaration": "def comparison_bound(s,t):\n    bs,ps = tail(s)\n    bt,pt = tail(t)\n    return max(bs,bt,root_bound(_difference(ps,pt)))",
      "target_sha256": "cb949994ac395e975e4688bfec3897d9f9a7ab1738950fcb649015dbd7ec8a04",
      "domain": "REFERENCE_EXECUTION",
      "calculus": "NONE"
    },
    {
      "id": "t15-univariate-reference-distinguish",
      "source_id": "identity-src-2c1183a4725481f50cfc",
      "declaration": "def distinguish(s,t):\n    \"\"\"Return a checked natural counterexample, or None for universal equality.\n\n    Equal tails require a finite prefix check. Different tails give the bound\n    itself as a guaranteed witness. This does not claim the least witness.\n    \"\"\"\n    bs,ps = tail(s)\n    bt,pt = tail(t)\n    d = _difference(ps,pt)\n    if d:\n        n = max(bs,bt,root_bound(d))\n        if evaluate(s,n)==evaluate(t,n): raise AssertionError('tail separation failed')\n        return n\n    for n in range(max(bs,bt)):\n        if evaluate(s,n)!=evaluate(t,n): return n\n    return None",
      "target_sha256": "90641bc32f20bef9eb1d0763657f4cdbe4b819d432336101ab17d9bb946d4887",
      "domain": "REFERENCE_EXECUTION",
      "calculus": "NONE"
    },
    {
      "id": "t15-univariate-reference-equivalent",
      "source_id": "identity-src-2c1183a4725481f50cfc",
      "declaration": "def equivalent(s,t):\n    return distinguish(s,t) is None",
      "target_sha256": "cb93bef6b060ef550cb54da1de2753dc34654d7549f4037b384238ef17b945fc",
      "domain": "REFERENCE_EXECUTION",
      "calculus": "NONE"
    }
  ],
