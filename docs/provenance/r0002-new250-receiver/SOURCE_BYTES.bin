def run : IO Unit := do
 for (i,(t,m,p)) in (cases.zipIdx.map (fun (x,i) => (i,x))).drop 350 do
  let out := (List.range 4).map (fun b => mask (winningRegion (kernel t) (menu m) (priority p) (support b)))
  IO.println s!"{i},{out[0]!},{out[1]!},{out[2]!},{out[3]!}"
end IndependentRegionOracle
def main : IO Unit := IndependentRegionOracle.run
import SmoothRobustness

/-!
General finite-truth-hull smooth necessity. Truth indices and coordinate indices
are distinct. The interior certificate is a strictly positive barycentric
presentation, not a literal Mathlib intrinsicInterior input. This module does
not formalize the separate diagonal-stabilizer/matroid component theorem.
-/
noncomputable section
open scoped Topology BigOperators
open Filter Set Asymptotics SmoothRigidity SmoothRobustness LocalRigidity

namespace FiniteHullSmoothRigidity
variable {ι J : Type*} [Fintype ι] [DecidableEq ι] [Fintype J]

omit [DecidableEq ι] in
lemma weighted_approximate_regret_bound
    (s : ι → SmoothScalar.Score) (v : J → Vec ι) (w : J → ℝ) (p b c : Vec ι)
    (hw : ∀ j, 0 ≤ w j) (hsum : ∑ j, w j = 1) (hcenter : ∑ j, w j • v j = p)
    (eta : ℝ) (hgain : ∀ j, totalDiv s (v j) c ≤ totalDiv s (v j) b + eta) :
    totalDiv s p c ≤ totalDiv s p b + eta := by
  have hh : -eta ≤ ∑ j, w j * (totalDiv s (v j) b - totalDiv s (v j) c) := by
    calc
      -eta = ∑ j, w j * (-eta) := by rw [← Finset.sum_mul, hsum, one_mul]
      _ ≤ _ := Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_left
        (by linarith [hgain j]) (hw j))
  rw [weighted_bregman_gain (potential s) (gradient s) v w p b c hsum hcenter] at hh
  linarith

lemma weighted_approximate_repairs_tendsto
    (s : ι → SmoothScalar.Score) (v : J → Vec ι) (w : J → ℝ) (p : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hw : ∀ j, 0 ≤ w j)
    (hsum : ∑ j, w j = 1) (hcenter : ∑ j, w j • v j = p)
    (b c : ℕ → Vec ι) (eta : ℕ → ℝ)
    (hb : Tendsto b atTop (𝓝 p)) (heta : Tendsto eta atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hgain : ∀ n j, totalDiv s (v j) (c n) ≤ totalDiv s (v j) (b n) + eta n) :
    Tendsto c atTop (𝓝 p) := by
  have hregret := fun n => weighted_approximate_regret_bound s v w p (b n) (c n)
    hw hsum hcenter (eta n) (hgain n)
  have hlim : Tendsto (fun n => totalDiv s p (b n) + eta n) atTop (𝓝 0) := by
    have hh := (score_hasFDerivAt s p p hp).continuousAt.tendsto.comp hb
    have ht := hh.add heta
    simpa [totalDiv, bregman, Function.comp_def] using ht
  apply tendsto_pi_nhds.mpr
  intro i
  apply SmoothScalar.tendsto_of_divergence_tendsto_zero (s i) (p i) (hp i) (fun n => c n i)
    (fun n => hc n i)
  exact squeeze_zero
    (fun n => SmoothScalar.divergence_nonneg (s i) (p i) (c n i) (hp i) (hc n i))
    (fun n => (scalar_divergence_le_total s p (c n) hp (hc n) i).trans (hregret n)) hlim

lemma finite_hull_normalized_approximate_repairs_bounded (s : ι → SmoothScalar.Score) (v : J → Vec ι) (w : J → ℝ) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hw : ∀ j, 0 ≤ w j)
    (hsum : ∑ j, w j = 1) (hcenter : ∑ j, w j • v j = p)
    (e eta : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (heta0 : ∀ n, 0 ≤ eta n)
    (heta : Tendsto (fun n => eta n / e n) atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range v))
    (hgain : ∀ n i, totalDiv s (v i) (c n) ≤
      totalDiv s (v i) (p + e n • h) + eta n) :
    ∃ R : ℝ, ∀ᶠ n in atTop, ‖(e n)⁻¹ • (c n - p)‖ ≤ R := by
  have hne : Nonempty J := by
    by_contra hn
    have : IsEmpty J := not_nonempty_iff.mp hn
    simp at hsum
  letI := hne
  let N : ℝ := Fintype.card J
  have hN : 0 < N := by
    dsimp [N]
    exact_mod_cast (Fintype.card_pos : 0 < Fintype.card J)
  let f : J → Vec ι → ℝ := fun i => totalDiv s (v i)
  let L : J → Vec ι →L[ℝ] ℝ := fun i => hessian s p (p - v i)
  have hf : ∀ i, HasFDerivAt (f i) (L i) p := fun i => score_hasFDerivAt s (v i) p hp
  obtain ⟨a, ha, hco⟩ := positive_derivative_coercive (hessian s p)
    (fun x hx => hessian_positive s p x hp hx) v w p hw hsum hcenter
  let base : ℕ → Vec ι := fun n => p + e n • h
  have hbase : Tendsto base atTop (𝓝 p) := by
    simpa [base] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => p) atTop (𝓝 p)).add
        (he.smul (tendsto_const_nhds : Tendsto (fun _ : ℕ => h) atTop (𝓝 h)))
  have hct := weighted_approximate_repairs_tendsto s v w p hp (fun j => (hw j).le) hsum hcenter base c eta hbase
    (sublinear_tolerance_tendsto_zero e eta hepos he heta) hc hgain
  have hxi : Tendsto (fun n => c n - p) atTop (𝓝 (0 : Vec ι)) := by
    simpa using hct.sub (tendsto_const_nhds : Tendsto (fun _ : ℕ => p) atTop (𝓝 p))
  have hrem : ∀ᶠ n in atTop, ∀ i,
      |f i (c n) - f i p - L i (c n - p)| ≤ (a / (2 * N)) * ‖c n - p‖ := by
    apply Filter.eventually_all.mpr
    intro i
    have hlo := (hasFDerivAt_iff_isLittleO_nhds_zero.mp (hf i)).comp_tendsto hxi
    have hh := isLittleO_iff.mp hlo (c := a / (2 * N)) (div_pos ha (mul_pos (by norm_num) hN))
    have hid : ∀ n, p + (c n - p) = c n := by intro n; abel
    simpa only [Function.comp_apply, hid, Real.norm_eq_abs] using hh
  let M : ℝ := ∑ i, (|L i h| + 1)
  have hM : 0 ≤ M := Finset.sum_nonneg (fun i _ => by positivity)
  have hbasebound : ∀ᶠ n in atTop, ∀ i, f i (base n) - f i p ≤ e n * M := by
    apply Filter.eventually_all.mpr
    intro i
    have ht := varying_direction_limit (f i) (L i) p h (hf i) e (fun _ => h) hepos he tendsto_const_nhds
    have hh : ∀ᶠ n in atTop, (f i (base n) - f i p) / e n ≤ |L i h| + 1 := by
      have hevent : ∀ᶠ n in atTop, (f i (base n) - f i p) / e n < |L i h| + 1 :=
        ht (Iio_mem_nhds (show L i h < |L i h| + 1 by linarith [le_abs_self (L i h)]))
      exact hevent.mono (fun n hn => hn.le)
    filter_upwards [hh] with n hn
    have hm : |L i h| + 1 ≤ M := by
      dsimp [M]
      exact Finset.single_le_sum (fun j (_ : j ∈ Finset.univ) => add_nonneg (abs_nonneg (L j h)) (by norm_num)) (Finset.mem_univ i)
    have hdiv := (div_le_iff₀ (hepos n)).mp hn
    calc
      f i (base n) - f i p ≤ (|L i h| + 1) * e n := hdiv
      _ ≤ M * e n := mul_le_mul_of_nonneg_right hm (hepos n).le
      _ = e n * M := mul_comm _ _
  have hetabound : ∀ᶠ n in atTop, eta n ≤ e n := by
    have hh := heta (Iio_mem_nhds (show (0 : ℝ) < 1 by norm_num))
    filter_upwards [hh] with n hn
    simpa only [one_mul] using ((div_lt_iff₀ (hepos n)).mp hn).le
  refine ⟨2 * N * (M + 1) / a, ?_⟩
  filter_upwards [hrem, hbasebound, hetabound] with n hnrem hnbase hneta
  have hlow := hco (c n - p) (convexHull_sub_mem v p (c n) (hcmem n))
  have hupper : (∑ i, max (L i (c n - p)) 0) ≤
      N * (e n * M + eta n) + a / 2 * ‖c n - p‖ := by
    have hi : ∀ i, max (L i (c n - p)) 0 ≤
        e n * M + eta n + (a / (2 * N)) * ‖c n - p‖ := by
      intro i
      apply max_le
      · have hh := (abs_le.mp (hnrem i)).1
        have hg := hgain n i
        have hb := hnbase i
        change f i (c n) ≤ f i (base n) + eta n at hg
        linarith
      · exact add_nonneg (add_nonneg (mul_nonneg (hepos n).le hM) (heta0 n))
          (mul_nonneg (div_nonneg ha.le (mul_pos (by norm_num) hN).le) (norm_nonneg _))
    have hh := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hi i)
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at hh
    convert hh using 1
    dsimp [N]
    field_simp
    ring
  change a * ‖c n - p‖ ≤ ∑ i, max (L i (c n - p)) 0 at hlow
  have hlin : a * ‖c n - p‖ ≤ 2 * N * e n * (M + 1) := by
    nlinarith [norm_nonneg (c n - p)]
  rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos (hepos n)]
  apply (le_div_iff₀ ha).mpr
  calc
    (e n)⁻¹ * ‖c n - p‖ * a = (a * ‖c n - p‖) / e n := by ring
    _ ≤ 2 * N * (M + 1) := (div_le_iff₀ (hepos n)).mpr (by nlinarith [hlin])


theorem finite_hull_approximate_hessian_necessary {K : Type*}
    (s : K → ι → SmoothScalar.Score) (k0 : K)
    (v : J → Vec ι) (w : J → ℝ) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hw : ∀ j, 0 ≤ w j)
    (hsum : ∑ j, w j = 1) (hcenter : ∑ j, w j • v j = p)
    (e eta : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (heta0 : ∀ n, 0 ≤ eta n)
    (heta : Tendsto (fun n => eta n / e n) atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range v))
    (hgain : ∀ n k i, totalDiv (s k) (v i) (c n) ≤
      totalDiv (s k) (v i) (p + e n • h) + eta n) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun i => p - v i)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun i => p - v i)) →
        hessian (s k) p (h - z) u = 0 := by
  let r : ℕ → Vec ι := fun n => (e n)⁻¹ • (c n - p)
  obtain ⟨R, hR⟩ := finite_hull_normalized_approximate_repairs_bounded (s k0) v w p h hp hw hsum hcenter e eta c hepos he heta0 heta hc hcmem
    (fun n i => hgain n k0 i)
  have hrball : ∀ᶠ n in atTop, r n ∈ Metric.closedBall (0 : Vec ι) R := by
    simpa only [Metric.mem_closedBall, dist_zero_right] using hR
  obtain ⟨z, hzball, phi, hphi, hzlim⟩ :=
    (isCompact_closedBall (0 : Vec ι) R).tendsto_subseq' hrball.frequently
  let T : Submodule ℝ (Vec ι) := Submodule.span ℝ (Set.range (fun i => p - v i))
  have hrmem : ∀ n, r n ∈ T := by
    intro n
    exact T.smul_mem ((e n)⁻¹) (LocalRigidity.convexHull_sub_mem v p (c n) (hcmem n))
  have hzmem : z ∈ T := (Submodule.closed_of_finiteDimensional T).mem_of_tendsto hzlim
    (Filter.Eventually.of_forall (fun n => hrmem (phi n)))
  have hrepr : ∀ n, p + e n • r n = c n := by
    intro n
    dsimp [r]
    rw [smul_smul, mul_inv_cancel₀ (ne_of_gt (hepos n)), one_smul]
    abel
  refine ⟨z, hzmem, ?_⟩
  intro k u hu
  have hn : ∀ i, 0 ≤ hessian (s k) p (p - v i) (h - z) := by
    intro i
    apply approximate_first_order_nonnegative (totalDiv (s k) (v i))
      (hessian (s k) p (p - v i)) p h z (score_hasFDerivAt (s k) (v i) p hp)
      (e ∘ phi) (eta ∘ phi) (r ∘ phi) (fun n => hepos (phi n))
      (he.comp hphi.tendsto_atTop) (heta.comp hphi.tendsto_atTop) hzlim
    intro n
    simp only [Function.comp_apply]
    rw [hrepr]
    exact hgain (phi n) k i
  have hzall := LocalRigidity.barycenter_nonnegative_vanish (hessian (s k) p) v w p (h - z)
    hw hsum hcenter hn
  rw [hessian_symmetric]
  exact LocalRigidity.orthogonal_span (hessian (s k) p) v p (h - z) hzall u hu



/-- Exact common repairs are the zero-tolerance specialization. -/
theorem finite_hull_common_hessian_necessary {K : Type*}
    (s : K → ι → SmoothScalar.Score) (k0 : K)
    (v : J → Vec ι) (w : J → ℝ) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hw : ∀ j, 0 ≤ w j)
    (hsum : ∑ j, w j = 1) (hcenter : ∑ j, w j • v j = p)
    (e : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range v))
    (hgain : ∀ n k j, totalDiv (s k) (v j) (c n) ≤ totalDiv (s k) (v j) (p + e n • h)) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun j => p - v j)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun j => p - v j)) →
        hessian (s k) p (h - z) u = 0 := by
  apply finite_hull_approximate_hessian_necessary s k0 v w p h hp hw hsum hcenter
    e (fun _ => 0) c hepos he (fun _ => le_rfl) ?_ hc hcmem
  · simpa only [add_zero] using hgain
  · simpa only [zero_div] using (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))

#print axioms finite_hull_normalized_approximate_repairs_bounded
#print axioms finite_hull_approximate_hessian_necessary
#print axioms finite_hull_common_hessian_necessary
#check finite_hull_approximate_hessian_necessary
#check finite_hull_common_hessian_necessary

end FiniteHullSmoothRigidity
import GuardedObserver
import UniformComputabilityMachine
import Q8Compiler

/-! The initial state and transition store exactly the acquired prefix. The
actual decoder/evaluator, rather than a supplied initializer, fixes the output. -/
namespace Orthemology.CertifiedObserver.Indexed
open Orthemology.Frontier Orthemology.Frontier.MealyMeasure
open P02.Codec
open Set MeasureTheory
open scoped ENNReal
open P02A2.Q8Measure (fairCantor)

abbrev Config := ℕ × ℕ

def initial : Config := (0,1)

def appendBit (word : ℕ) (b : Bool) : ℕ := word + if b then 1 else 0

def machine (index : ℕ) : Mealy Config where
  next cfg b := (cfg.1+1, appendBit cfg.2 b)
  out cfg b := decide (evaluateIndex index cfg.1 (appendBit cfg.2 b) % 2 = 1)

theorem sentinel_succ (x : Cantor) (k : ℕ) :
    P02A2.ObserverCore.sentinel (pref (k+1) x) =
      appendBit (P02A2.ObserverCore.sentinel (pref k x)) (x k) := by
  unfold pref appendBit
  rw [List.ofFn_succ', List.concat_eq_append, P02A2.Q8Compiler.sentinel_append_bit]
  rfl

/-- Source-state invariant with literal stage and acquired input word. -/
theorem literal_state (index : ℕ) (x : Cantor) (k : ℕ) :
    state (machine index) initial x k = (k, P02A2.ObserverCore.sentinel (pref k x)) := by
  induction k with
  | zero => rfl
  | succ k ih =>
      change ((state (machine index) initial x k).1+1,
        appendBit (state (machine index) initial x k).2 (x k)) = _
      rw [ih, sentinel_succ]

/-- Exact entire behavior of the actual indexed prefix evaluator. -/
theorem source_output_exact (index : ℕ) :
    output (machine index) initial = P02A2.ObserverCore.output (evaluateIndex index) := by
  funext x k
  change decide (evaluateIndex index (state (machine index) initial x k).1
    (appendBit (state (machine index) initial x k).2 (x k)) % 2 = 1) = _
  rw [literal_state]
  change decide (evaluateIndex index k
    (appendBit (P02A2.ObserverCore.sentinel (pref k x)) (x k)) % 2 = 1) = _
  rw [← sentinel_succ]
  rfl

noncomputable def sourceLaw (index : ℕ) : Measure Cantor :=
  fairCantor.map (P02A2.ObserverCore.output (evaluateIndex index))

theorem source_law_exact (index : ℕ) : sourceLaw index = law (machine index) initial := by
  unfold sourceLaw law
  rw [source_output_exact]

instance sourceLaw_probability (index : ℕ) : IsProbabilityMeasure (sourceLaw index) := by
  rw [source_law_exact]
  infer_instance

theorem acquired_prefix_only (index : ℕ) (x y : Cantor) (k : ℕ)
    (h : pref k x = pref k y) :
    state (machine index) initial x k = state (machine index) initial y k := by
  rw [literal_state, literal_state, h]

theorem unbounded_stage (index : ℕ) (x : Cantor) (k : ℕ) :
    (state (machine index) initial x k).1 = k := by rw [literal_state]

/-- A finite abstraction certificate now applies directly to every numeric
index, including the actual decoder's rejection/default conventions. -/
theorem certified_index_defect (index : ℕ)
    {T : Type*} [Fintype T] [DecidableEq T] [Nonempty T] (A : Mealy T)
    (R : Simulation (machine index) A) (t : T) (h : R.relates initial t) :
    (solveDefect A t : ℝ) = P02A2.defect (sourceLaw index) := by
  rw [source_law_exact]
  exact certified_defect_exact R h

theorem certified_index_error (index : ℕ)
    {T : Type*} [Fintype T] [DecidableEq T] [Nonempty T] (A : Mealy T)
    (R : GuardedSimulation (machine index) A) (t : T) (h : R.relates initial t)
    (δ : ℝ) (hδ : 0 ≤ δ) (ε : ℕ → ℝ≥0∞)
    (hε : ∀ k, fairCantor (badAt R initial t k) ≤ ε k)
    (budget : (∑' k, ε k) ≤ ENNReal.ofReal δ) :
    |P02A2.defect (sourceLaw index) - (solveDefect A t : ℝ)| ≤ δ := by
  rw [source_law_exact]
  exact guarded_defect_error_budget R h δ hδ ε hε budget

end Orthemology.CertifiedObserver.Indexed
/-
P03 attempt-0002 NEW PROPOSAL. UNVERIFIED: no compiler was acquired here.
Target Lean 4.19.0. Core-only formalisation; not historical declaration recovery.
The model carries local target-indexed evidence and retains authority/root paths.
It does NOT assume a field asserting the desired whole-path warrant conclusion.
Exact-image graph carriers are an explicit emitted-certificate representation.
Semantic truth, actual authority and currentness require their own local witnesses.
-/
import P03GuardedGraph
namespace P03A2
universe u

structure EvidenceState (O : Type) where
  required : O → Prop
  discharged : O → Prop
  valid : O → Prop

def Sound {O : Type} (s : EvidenceState O) : Prop :=
  ∀ o, s.discharged o → s.valid o

def Closed {O : Type} (s : EvidenceState O) : Prop :=
  ∀ o, s.required o → s.valid o

structure EvidenceHop {O : Type} (a b : EvidenceState O) where
  preserved : O → Prop
  revalidated : O → Prop
  kept : ∀ o, preserved o → a.discharged o
  carry : ∀ o, preserved o → a.valid o → b.valid o
  fresh : ∀ o, revalidated o → b.valid o
  outExact : ∀ o, b.discharged o ↔ preserved o ∨ revalidated o
  coverage : ∀ o, b.required o → preserved o ∨ revalidated o

theorem EvidenceHop.sound {O : Type} {a b : EvidenceState O}
    (h : EvidenceHop a b) (hs : Sound a) : Sound b := by
  intro o ho
  cases (h.outExact o).mp ho with
  | inl hp => exact h.carry o hp (hs o (h.kept o hp))
  | inr hr => exact h.fresh o hr

theorem EvidenceHop.closed {O : Type} {a b : EvidenceState O}
    (h : EvidenceHop a b) (hs : Sound a) : Closed b := by
  intro o ho
  cases h.coverage o ho with
  | inl hp => exact h.carry o hp (hs o (h.kept o hp))
  | inr hr => exact h.fresh o hr

structure SemanticState where
  World : Type
  meaning : World → Prop

structure SemanticHop (a b : SemanticState) where
  map : a.World → b.World
  square : ∀ w, b.meaning (map w) ↔ a.meaning w

def SemanticHop.comp {a b c : SemanticState}
    (f : SemanticHop a b) (g : SemanticHop b c) : SemanticHop a c where
  map := fun w => g.map (f.map w)
  square := fun w => (g.square (f.map w)).trans (f.square w)

theorem SemanticHop.composite_square {a b c : SemanticState}
    (f : SemanticHop a b) (g : SemanticHop b c) (w : a.World) :
    c.meaning ((SemanticHop.comp f g).map w) ↔ a.meaning w :=
  (SemanticHop.comp f g).square w

structure Frame (O V R C : Type) where
  graph : P03Q1f.ReasonDAG
  reasons : EvidenceState O
  semantics : SemanticState
  version : V
  root : R
  claim : C

structure Policy (O V R C : Type) where
  epoch : Nat
  authority : Frame O V R C → Frame O V R C → Prop
  redelegate : Frame O V R C → Prop
  versionAllowed : V → Prop
  invalidatorsClosed : Frame O V R C → Prop
  rootStep : R → R → Prop

structure Hop {O V R C : Type} (p : Policy O V R C)
    (a b : Frame O V R C) where
  graphMap : P03Q1f.Hom a.graph b.graph
  onto : ∀ v, ∃ u, graphMap.node u = v
  reasons : EvidenceHop a.reasons b.reasons
  semantics : SemanticHop a.semantics b.semantics
  authority : p.authority a b
  targetVersion : p.versionAllowed b.version
  noOpenInvalidator : p.invalidatorsClosed b
  rootCustody : p.rootStep a.root b.root

/-- Indexed adjacency enforces the entire prior/output frame, not only version. -/
inductive Path {O V R C : Type} (p : Policy O V R C) :
    Frame O V R C → Frame O V R C → Type 1 where
  | one {a b} (h : Hop p a b) : Path p a b
  | cons {a b c} (h : Hop p a b) (rest : Path p b c)
      (allowMiddle : p.redelegate b) : Path p a c

inductive Via {α : Sort u} (rel : α → α → Prop) : α → α → Prop where
  | one {a b} : rel a b → Via rel a b
  | comp {a b c} : Via rel a b → Via rel b c → Via rel a c

/-- Permission is composable only with explicit intermediate re-delegation.
This is not transitive closure of pairwise authority with the guard erased. -/
inductive AuthorityPath {O V R C : Type} (p : Policy O V R C) :
    Frame O V R C → Frame O V R C → Prop where
  | one {a b} : p.authority a b → AuthorityPath p a b
  | cons {a b c} : p.authority a b → p.redelegate b →
      AuthorityPath p b c → AuthorityPath p a c

variable {O V R C : Type} {p : Policy O V R C}
variable {a b c : Frame O V R C}

def Path.graph : Path p a b → P03Q1f.Hom a.graph b.graph
  | .one h => h.graphMap
  | .cons h rest _ => P03Q1f.Hom.compose h.graphMap (Path.graph rest)

def Path.preimage : (q : Path p a b) →
    ∀ v : Fin b.graph.size, ∃ u : Fin a.graph.size, (Path.graph q).node u = v
  | .one h, v => h.onto v
  | .cons h rest _, v => by
      obtain ⟨mid, hm⟩ := Path.preimage rest v
      obtain ⟨src, hs⟩ := h.onto mid
      refine ⟨src, ?_⟩
      change (Path.graph rest).node (h.graphMap.node src) = v
      rw [hs]
      exact hm

def Path.semantics : Path p a b → SemanticHop a.semantics b.semantics
  | .one h => h.semantics
  | .cons h rest _ => SemanticHop.comp h.semantics (Path.semantics rest)

def Path.transportSound : (q : Path p a b) → Sound a.reasons → Sound b.reasons
  | .one h, hs => h.reasons.sound hs
  | .cons h rest _, hs => Path.transportSound rest (h.reasons.sound hs)

def Path.closeTarget : (q : Path p a b) → Sound a.reasons → Closed b.reasons
  | .one h, hs => h.reasons.closed hs
  | .cons h rest _, hs => Path.closeTarget rest (h.reasons.sound hs)

def Path.finalVersion : (q : Path p a b) → p.versionAllowed b.version
  | .one h => h.targetVersion
  | .cons _ rest _ => Path.finalVersion rest

def Path.finalInvalidators : (q : Path p a b) → p.invalidatorsClosed b
  | .one h => h.noOpenInvalidator
  | .cons _ rest _ => Path.finalInvalidators rest

def Path.rootTrace : (q : Path p a b) → Via p.rootStep a.root b.root
  | .one h => .one h.rootCustody
  | .cons h rest _ => .comp (.one h.rootCustody) (Path.rootTrace rest)

def Path.authorityTrace : (q : Path p a b) → Via p.authority a b
  | .one h => .one h.authority
  | .cons h rest _ => .comp (.one h.authority) (Path.authorityTrace rest)

theorem Path.mapEdge (q : Path p a b) {u v : Fin a.graph.size}
    (h : a.graph.Edge u v) : b.graph.Edge ((Path.graph q).node u) ((Path.graph q).node v) :=
  (Path.graph q).edge h

/-- The new conclusion is constructed from local evidence; it is not a Hop field.
Authority is a path witness, NOT an assumed transitive direct permission.
Currentness is at p.epoch only; changing Policy does not inherit this theorem.
-/
theorem guarded_reason_version_composition (q : Path p a b) (hs : Sound a.reasons) :
    Sound b.reasons ∧ Closed b.reasons ∧
    (∀ w, b.semantics.meaning ((Path.semantics q).map w) ↔ a.semantics.meaning w) ∧
    p.versionAllowed b.version ∧ p.invalidatorsClosed b ∧
    Via p.rootStep a.root b.root ∧ AuthorityPath p a b :=
  ⟨Path.transportSound q hs, Path.closeTarget q hs,
   (Path.semantics q).square, Path.finalVersion q,
   Path.finalInvalidators q, Path.rootTrace q, Path.authorityTrace q⟩

theorem Path.semantic_truth_transport (q : Path p a b) (w : a.semantics.World)
    (hw : a.semantics.meaning w) :
    b.semantics.meaning ((Path.semantics q).map w) :=
  ((Path.semantics q).square w).mpr hw

theorem Via.eq_endpoints {α : Sort u} {x y : α} (h : Via (fun a b => a = b) x y) : x = y := by
  induction h with
  | one e => exact e
  | comp _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A nonempty graph walk cannot collapse under the composed graph map. -/
theorem Path.no_collapse {u v : Fin a.graph.size} (q : Path p a b)
    (h : P03Q1f.Walk a.graph u v) : (Path.graph q).node u ≠ (Path.graph q).node v :=
  P03Q1f.Hom.noCollapseOfWalk (Path.graph q) h

end P03A2
import JointRegularity
import JointSoundness
import OpenDevelopments
import ClosedChurchIdentity

namespace JointCompletion.EffectiveNumerals
open OrthemologyV2 P01D P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness (N inputNumeral iterationPoly)
open P01AC.Intensional.Plus (PolyConvPlus)
open OpenTermStandardness (T Conv iter UniformIter)
open ImportedOpenTermTransport (interp)
open ClosedScalarInstances (scalarLeft scalarRight)
open OpenDevelopments (run readIteration)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Joint soundness retains full open-carrier Church membership for every
closed Joint numeral, including inputs obtained through the completion rules. -/
theorem closed_church {n : Poly} (hn : HasJ [] n N) :
    OpenTermStandardness.Church (interp n T.var) := by
  rw [ClosedScalarInstances.interp_closed (Structural.has_scoped hn) _ FullPER.zeroEnv]
  exact JointCompletion.fundamental hn FullPER.Application.emptyEnv _ _
    FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩

theorem closed_uniform_iteration {n : Poly} (hn : HasJ [] n N) :
    UniformIter (interp n T.var) := OpenTermStandardness.church_standard _ (closed_church hn)

/-- The retained exact complete-development strategy terminates on the applied
observation. No normalization statement about unapplied n is made. -/
theorem applied_development_terminates {n : Poly} (hn : HasJ [] n N) :
    ∃ k r, run r (interp (scalarLeft n) T.var) = iter (.var 1) (.var 0) k := by
  obtain ⟨k,hk⟩ := closed_uniform_iteration hn
  obtain ⟨r,hr⟩ := OpenDevelopments.development_complete (OpenDevelopments.iter_normal k)
    (hk (.var 1) (.var 0))
  exact ⟨k,r,hr⟩

theorem applied_readback_exists {n : Poly} (hn : HasJ [] n N) :
    ∃ r, (readIteration (run r (interp (scalarLeft n) T.var))).isSome = true := by
  obtain ⟨k,r,hr⟩ := applied_development_terminates hn
  exact ⟨r, hr ▸ OpenDevelopments.readIteration_iter k⟩

/-- The same executable Nat.find/run/readIteration search used by the retained
E extractor. Only its erased termination certificate now accepts Joint typing. -/
def extractIteration (n : Poly) (hn : HasJ [] n N) :
    { k : Nat // PolyConvPlus (scalarLeft n) (iterationPoly k) } := by
  have h := applied_readback_exists hn
  let r := Nat.find h
  let result := (readIteration (run r (interp (scalarLeft n) T.var))).get (Nat.find_spec h)
  refine ⟨result.val, ClosedScalarInstances.generic_conversion_reflect ?_⟩
  rw [ClosedScalarInstances.iteration_interp]
  have hc := OpenDevelopments.run_conv r (interp (scalarLeft n) T.var)
  rw [result.property] at hc
  exact hc

/-- The extension leaves the old executable extractor literally unchanged. -/
theorem extractIteration_oldE (n : Poly) (hn : P01AC.ExtensionalRepair.HasE [] n N) :
    extractIteration n (.hasBase hn) = OpenDevelopments.extractIteration n hn := rfl

/-- The extracted count is unique among all source-applied iteration certificates. -/
theorem extractIteration_unique {n : Poly} (hn : HasJ [] n N) {k : Nat}
    (hk : PolyConvPlus (scalarLeft n) (iterationPoly k)) :
    (extractIteration n hn).val = k := by
  have he := ImportedOpenTermTransport.source_plus_sound (extractIteration n hn).property T.var
  have ho := ImportedOpenTermTransport.source_plus_sound hk T.var
  rw [ClosedScalarInstances.iteration_interp] at he ho
  exact OpenDevelopments.iter_conv_injective (he.symm.trans ho)

theorem extractIteration_uniform (n : Poly) (hn : HasJ [] n N) :
    ∀ f a, Conv ((interp n T.var).app f |>.app a)
      (iter f a (extractIteration n hn).val) := by
  obtain ⟨k,hk⟩ := closed_uniform_iteration hn
  have he := ImportedOpenTermTransport.source_plus_sound (extractIteration n hn).property T.var
  rw [ClosedScalarInstances.iteration_interp] at he
  have eq := OpenDevelopments.iter_conv_injective ((hk (.var 1) (.var 0)).symm.trans he)
  exact eq ▸ hk

/-- The representative is an original-source numeral, hence also old E typed. -/
theorem old_numeral_has (k : Nat) : P01AC.ExtensionalRepair.HasE [] (inputNumeral k) N :=
  P01AC.ExtensionalRepair.has_inclusion (P01AC.EffectiveCompleteness.inputNumeral_has k)

/-- Literal generic-open source observations agree with the recovered numeral. -/
theorem recovered_observation (n : Poly) (hn : HasJ [] n N) :
    PolyConvPlus (scalarLeft n) (scalarLeft (inputNumeral (extractIteration n hn).val)) :=
  (extractIteration n hn).property.trans (ClosedChurchIdentity.numeral_observation _).symm

/-- Source-faithful equivalence after any supplied source iterator and seed.
This is applied observational conservativity, not raw conversion n = numeral. -/
theorem recovered_source_applications (n : Poly) (hn : HasJ [] n N) (f a : Poly) :
    PolyConvPlus (.app (.app n f) a)
      (.app (.app (inputNumeral (extractIteration n hn).val) f) a) := by
  have h := P01AC.ExtensionalRepair.Structural.polyConvPlus_subst
    (recovered_observation n hn) (cons a (cons f Poly.var))
  simpa only [scalarLeft, psub, cons,
    P01AC.BooleanPrimitive.psub_closed (Structural.has_scoped hn),
    P01AC.BooleanPrimitive.psub_closed
      (P01AC.has_scoped (P01AC.EffectiveCompleteness.inputNumeral_has _))] using h

/-- The same old numeral agrees uniformly on every open-carrier pair of inputs. -/
theorem recovered_open_applications (n : Poly) (hn : HasJ [] n N) (f a : T) :
    Conv ((interp n T.var).app f |>.app a)
      ((interp (inputNumeral (extractIteration n hn).val) T.var).app f |>.app a) := by
  let k := (extractIteration n hn).val
  have h1 := Conv.app (ImportedOpenTermTransport.interp_abstraction_beta
    (abstract (iterationPoly k)) T.var f) (Conv.refl a)
  have h2 := ImportedOpenTermTransport.interp_abstraction_beta
    (iterationPoly k) (OpenTermStandardness.cons f T.var) a
  have num : Conv ((interp (inputNumeral k) T.var).app f |>.app a) (iter f a k) :=
    h1.trans ((ClosedChurchIdentity.interp_iteration k _ _ _) ▸ h2)
  exact (extractIteration_uniform n hn f a).trans num.symm

/-- Explicit closed-N observational conservativity of Joint over old E. The
representative's index is returned by the checked executable extractor. -/
theorem closed_N_observational_conservativity (n : Poly) (hn : HasJ [] n N) :
    P01AC.ExtensionalRepair.HasE [] (inputNumeral (extractIteration n hn).val) N ∧
    (∀ f a : Poly, PolyConvPlus (.app (.app n f) a)
      (.app (.app (inputNumeral (extractIteration n hn).val) f) a)) ∧
    (∀ f a : T, Conv ((interp n T.var).app f |>.app a)
      ((interp (inputNumeral (extractIteration n hn).val) T.var).app f |>.app a)) :=
  ⟨old_numeral_has _, recovered_source_applications n hn, recovered_open_applications n hn⟩

#print axioms closed_church
#print axioms applied_development_terminates
#print axioms extractIteration
#print axioms extractIteration_oldE
#print axioms extractIteration_unique
#print axioms extractIteration_uniform
#print axioms recovered_source_applications
#print axioms recovered_open_applications
#print axioms closed_N_observational_conservativity
end JointCompletion.EffectiveNumerals
import CanonicalHistoryPMF

noncomputable section
set_option linter.unusedSectionVars false
open MeasureTheory ProbabilityTheory Finset Filter
open scoped BigOperators ENNReal
attribute [local instance] Classical.propDecidable
namespace Orthemology.Tranche3.CanonicalMicro
open Orthemology.Tranche2.PolicyEmbedding
universe u v
variable {A Y : Type u} [Fintype A] [Fintype Y] [DecidableEq A]

/-- Accumulated cost of the literally acquired actions, newest first. -/
def historyCost (c : A → ℝ≥0∞) (h : History A Y) : ℝ≥0∞ := (h.tail.map (fun ay => c ay.1)).sum

omit [Fintype A] in
lemma historyPMF_invariant (π : History A Y → A) (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (I : History A Y → Prop) (hI : I [])
    (hnext : ∀ h y, I h → 0 < P (π h) y → I ((π h,y)::h))
    (n : ℕ) (h : History A Y) (hp : historyPMF π P hP hN n h ≠ 0) : I h := by
  induction n generalizing h with
  | zero =>
    have he : h = [] := by
      by_contra he
      simp [historyPMF,PMF.pure_apply,he] at hp
    simpa only [he] using hI
  | succ n ih =>
    cases h with
    | nil => exact (hp (historyPMF_succ_nil π P hP hN n)).elim
    | cons ay h =>
      rcases ay with ⟨a,y⟩
      rw [historyPMF_succ_cons] at hp
      split_ifs at hp with he
      · have hp' := mul_ne_zero_iff.mp hp
        have hy : 0 < P a y := ENNReal.ofReal_pos.mp (pos_iff_ne_zero.mpr hp'.2)
        subst a
        exact hnext h y (ih h hp'.1) hy
      · exact (hp rfl).elim

omit [Fintype A] [DecidableEq A] in
lemma pmfMean_nextHistory (π : History A Y → A) (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (h : History A Y) (f : History A Y → ℝ≥0∞) :
    pmfMean (nextHistoryPMF π P hP hN h) f =
      ∑ y, ENNReal.ofReal (P (π h) y) * f ((π h,y)::h) := by
  rw [nextHistoryPMF,pmfMean_map,pmfMean,tsum_fintype]
  rfl

omit [Fintype A] in
/-- A nonnegative one-step potential pays for every deterministic history
horizon under the actual finite controlled-iid experiment. -/
theorem historyPMF_cost_potential_bound (π : History A Y → A) (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (c : A → ℝ≥0∞) (V : History A Y → ℝ≥0∞)
    (I : History A Y → Prop) (hI : I [])
    (hnext : ∀ h y, I h → 0 < P (π h) y → I ((π h,y)::h))
    (hstep : ∀ h, I h → c (π h) + ∑ y, ENNReal.ofReal (P (π h) y) * V ((π h,y)::h) ≤ V h)
    (n : ℕ) :
    pmfMean (historyPMF π P hP hN n) (fun h => historyCost c h + V h) ≤ V [] := by
  induction n with
  | zero => simp [historyPMF,pmfMean_pure,historyCost]
  | succ n ih =>
    rw [historyPMF,pmfMean_bind]
    apply le_trans (pmfMean_mono_on_support _ _ _ ?_) ih
    intro h hh
    have hi := historyPMF_invariant π P hP hN I hI hnext n h hh
    have hc : pmfMean (nextHistoryPMF π P hP hN h) (fun k => historyCost c k + V k) =
        historyCost c h + c (π h) + ∑ y, ENNReal.ofReal (P (π h) y) * V ((π h,y)::h) := by
      rw [nextHistoryPMF,pmfMean_map]
      have he : (fun y => historyCost c ((π h,y)::h) + V ((π h,y)::h)) =
          fun y => (historyCost c h + c (π h)) + V ((π h,y)::h) := by
        funext y
        simp only [historyCost,List.map_cons,List.sum_cons,Prod.fst]
        simp only [add_assoc,add_comm,add_left_comm]
      rw [he,pmfMean_add,pmfMean_const]
      congr 1
      rw [pmfMean,tsum_fintype]
      rfl
    rw [hc,add_assoc]
    exact add_le_add_left (hstep h hi) _

section CanonicalLaw
variable {R : Type v} [Inhabited Y] [MeasurableSpace R]
    [MeasurableSpace A] [MeasurableSingletonClass A]
    [MeasurableSpace Y] [MeasurableSingletonClass Y]

def ignoreSeed (π : History A Y → A) (_ : R) (h : History A Y) : A := π h

omit [DecidableEq A] [Inhabited Y] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
lemma ignoreSeed_measurable (π : History A Y → A) :
    Measurable (fun z : R × History A Y => ignoreSeed π z.1 z.2) :=
  (measurable_of_countable π).comp measurable_snd

omit [Fintype A] [Fintype Y] [DecidableEq A] [Inhabited Y] [MeasurableSpace R]
    [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
lemma actionCompatible_ignoreSeed (π : History A Y → A) (r : R) (h : History A Y) :
    ActionCompatible (ignoreSeed π) r h ↔ ActionCompatible (fun (_ : Unit) h => π h) () h := by
  induction h with
  | nil => rfl
  | cons ay h ih => simp only [ActionCompatible,ignoreSeed,ih]

/-- Exact finite-law identification with the pre-existing canonical fresh-row
experiment, for any common private-seed law. The constructed policy ignores the
seed, but its law is literally the original actionLaw interface. -/
theorem historyPMF_eq_canonical_marginal (π : History A Y → A)
    (ρ : Measure R) [IsProbabilityMeasure ρ] (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1) (n : ℕ) :
    (historyPMF π P hP hN n).toMeasure =
      (ρ.prod (feedbackLaw P P hP hN hP hN)).map
        (fun z => historyTrajectory ∅ (ignoreSeed π) z n) := by
  apply Measure.ext_of_singleton
  intro h
  rw [PMF.toMeasure_apply_singleton _ h (measurableSet_singleton h),historyPMF_apply,
    history_marginal_formula ∅ (ignoreSeed π) (ignoreSeed_measurable π) ρ P P hP hN hP hN
      (fun a ha => (Finset.not_mem_empty a ha).elim)]
  have he : {r : R | ActionCompatible (ignoreSeed π) r h} =
      if ActionCompatible (fun (_ : Unit) h => π h) () h then Set.univ else ∅ := by
    ext r
    simp only [Set.mem_setOf_eq,actionCompatible_ignoreSeed]
    split_ifs <;> simp_all
  rw [he]
  by_cases hn : n = h.length <;> by_cases hc : ActionCompatible (fun (_ : Unit) h => π h) () h <;>
    simp [hn,hc]

lemma pmf_lintegral_eq_mean {α : Type*} [Countable α] [MeasurableSpace α] [MeasurableSingletonClass α]
    (p : PMF α) (f : α → ℝ≥0∞) : (∫⁻ a, f a ∂p.toMeasure) = pmfMean p f := by
  rw [lintegral_countable']
  simp only [PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton _),pmfMean,mul_comm]

omit [Fintype A] [Fintype Y] [Inhabited Y] [MeasurableSpace R]
    [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
lemma acquired_history_cost (π : R → History A Y → A) (U : Finset A)
    (oracle : ℕ → A → Y) (r : R) (X : Stack A Y) (c : A → ℝ≥0∞) (n : ℕ) :
    (∑ t ∈ Finset.range n, c (π r (observedHistory U π oracle r X t))) =
      historyCost c (observedHistory U π oracle r X n) := by
  induction n with
  | zero => simp [observedHistory,historyCost]
  | succ n ih =>
    rw [Finset.sum_range_succ,ih]
    simp only [observedHistory,historyCost,List.map_cons,List.sum_cons,Prod.fst]
    exact add_comm _ _

/-- Literal physical prefix-cost equality in the canonical action law. -/
theorem canonical_prefix_cost_eq_historyPMF (π : History A Y → A)
    (ρ : Measure R) [IsProbabilityMeasure ρ] (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (c : A → ℝ≥0∞) (d : A) (n : ℕ) :
    (∫⁻ x, ∑ t ∈ Finset.range n, c (x t) ∂actionLaw (ignoreSeed π) ρ P hP hN d) =
      pmfMean (historyPMF π P hP hN n) (historyCost c) := by
  have hf : Measurable (fun x : ℕ → A => ∑ t ∈ Finset.range n, c (x t)) := by fun_prop
  have hh := historyTrajectory_measurable (∅ : Finset A) (ignoreSeed (R := R) π) (ignoreSeed_measurable π)
  have hfH : Measurable (fun H : ℕ → History A Y => ∑ t ∈ Finset.range n, c (historyAction d H t)) :=
    hf.comp (historyAction_measurable d)
  rw [actionLaw,lintegral_map hf (historyAction_measurable d),observedTraceLaw,
    lintegral_map hfH hh]
  have he : (fun z : Input R A Y => ∑ t ∈ Finset.range n,
      c (historyAction d (historyTrajectory ∅ (ignoreSeed π) z) t)) =
      fun z => historyCost c (historyTrajectory ∅ (ignoreSeed π) z n) := by
    funext z
    change (∑ t ∈ Finset.range n, c (((observedHistory ∅ (ignoreSeed π) z.2.2 z.1
      (fun a k => z.2.1 (a,k)) (t+1)).headD (d,default)).1)) = _
    simp only [observedHistory,List.headD_cons,Prod.fst]
    exact acquired_history_cost (ignoreSeed π) ∅ z.2.2 z.1 (fun a k => z.2.1 (a,k)) c n
  rw [he,← lintegral_map (measurable_of_countable (historyCost c))
    (historyTrajectory_coordinate_measurable ∅ (ignoreSeed π) (ignoreSeed_measurable π) n),
    ← historyPMF_eq_canonical_marginal π ρ P hP hN n,pmf_lintegral_eq_mean]

/-- End-to-end canonical-law drift principle. It assumes only a one-step
algebraic potential certificate on positive reachable histories. -/
theorem canonical_total_cost_of_drift (π : History A Y → A)
    (ρ : Measure R) [IsProbabilityMeasure ρ] (P : A → Y → ℝ)
    (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (c : A → ℝ≥0∞) (V : History A Y → ℝ≥0∞)
    (I : History A Y → Prop) (hI : I [])
    (hnext : ∀ h y, I h → 0 < P (π h) y → I ((π h,y)::h))
    (hstep : ∀ h, I h → c (π h) + ∑ y, ENNReal.ofReal (P (π h) y) * V ((π h,y)::h) ≤ V h)
    (d : A) :
    (∫⁻ x, ∑' t, c (x t) ∂actionLaw (ignoreSeed π) ρ P hP hN d) ≤ V [] := by
  rw [lintegral_tsum (fun t : ℕ => (show Measurable (fun x : ℕ → A => c (x t)) from by fun_prop).aemeasurable)]
  apply ENNReal.tsum_le_of_sum_range_le
  intro n
  rw [← lintegral_finset_sum (Finset.range n) (fun i _ => by fun_prop),
    canonical_prefix_cost_eq_historyPMF π ρ P hP hN c d n]
  exact (pmfMean_mono_on_support _ _ _ (fun h _ => le_self_add)).trans
    (historyPMF_cost_potential_bound π P hP hN c V I hI hnext hstep n)
end CanonicalLaw
end Orthemology.Tranche3.CanonicalMicro
import Constructive
import Boundary
namespace IndependentEliminationReview
open P01AC P01D P01AC.ExtensionalRepair
open SigmaCompletion

-- The constructor is fixed, rather than merely an unspecified existential output.
theorem fixed_term {Γ A B P d z e} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) (hP : Form (.sigma A B :: Γ) P)
    (hd : Has (B :: A :: Γ) d (branchType P)) (hz : Has Γ z (.sigma A B))
    (he : HasE Γ e (.identity (.sigma A B) z (reconstruct z))) :
    HasE Γ (elim d z e) (inst P z) ∧
      P01DF.PolyConv (elim d z e) (branchAt d (fstPoly z) (sndPoly z)) :=
  ⟨elim_of_eta hc hA hB hP hd hz he,elim_erases d z e⟩

-- Eta is not being inferred merely by proving an equivalence of schemas.
theorem schema_not_available : ¬ EtaSchema := by
  intro h
  let S := SigmaTagBoundary.SigmaRaw
  have hs : Form [] S := .sigma (.raw .nil) (.raw (.ext .nil (.raw .nil)))
  have hc : Ctx [S] := .ext .nil hs
  have hs' : Form [S] S := .sigma (.raw hc) (.raw (.ext hc (.raw hc)))
  have hz : Has [S] (.var 0) S := .var hs' .zero
  obtain ⟨e,he⟩ := h [S] .raw .raw (.var 0) hc (.raw hc) (.raw (.ext hc (.raw hc))) hz
  have sem := TaggedPER.fundamental he SigmaTagBoundary.emptyEnv
    (TaggedPER.cons OpenTermStandardness.T.i TaggedPER.zeroEnv)
    (TaggedPER.cons OpenTermStandardness.T.i TaggedPER.zeroEnv)
    SigmaTagBoundary.empty_admissible
    ⟨⟨rfl,rfl⟩,SigmaTagBoundary.ghost_member _ _⟩
  exact SigmaTagBoundary.eta_at_ghost_empty _ _ _ _ sem

theorem weak_schema_not_available : ¬ WeakEliminationSchema :=
  fun h => schema_not_available (weak_elimination_implies_eta h)

theorem strong_schema_not_available : ¬ EliminationSchema :=
  fun h => schema_not_available (elimination_implies_eta h)

-- Computation is independent of any typing, formation, or equality-of-proofs assumption.
theorem raw_computation_all_terms (d a b e : Poly) :
    P01DF.PolyConv (elim d (pairPoly a b) e) (branchAt d a b) :=
  elim_pair_computation d a b e

-- Proof arguments may vary; the same raw computation holds without identifying them.
theorem proof_variation (d a b e f : Poly) :
    P01DF.PolyConv (elim d (pairPoly a b) e) (elim d (pairPoly a b) f) :=
  (elim_pair_computation d a b e).trans (elim_pair_computation d a b f).symm

#print axioms fixed_term
#print axioms schema_not_available
#print axioms weak_schema_not_available
#print axioms raw_computation_all_terms
#print axioms proof_variation
#check SigmaCompletion.EtaSchema
#print SigmaCompletion.EtaSchema
#print SigmaCompletion.EliminationSchema
end IndependentEliminationReview
import ClosedScalarInstances
import EffectiveCanonicalTests
import HasEClosedWeakening

/- Finite source extensionality for closed Church endpoints. The conditional
   construction exposes its exact lifting obligation; the final theorems
   discharge it with actual HasE structural renaming for every closed input. -/
namespace ClosedChurchIdentity
open OrthemologyV2 OrthemologyV3 P01D P01AC P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness (N NBody iterationPoly inputNumeral)
open P01AC.ExtensionalRepair.ExactScalarFusion (A End i)
open P01AC.Intensional.Plus (PolyConvPlus)
open ClosedScalarInstances (scalarLeft)
open ImportedOpenTermTransport (interp)
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

abbrev ctx1 : Ctx [End] := .ext .nil (ExactScalarFusion.End_form .nil)
abbrev ctx2 : Ctx [A,End] := .ext ctx1 (ExactScalarFusion.A_form ctx1)

theorem formEnd {Γ} (h : Ctx Γ) : FormE Γ End :=
  form_inclusion (ExactScalarFusion.End_form h)
theorem formBody {Γ} (h : Ctx Γ) : FormE Γ NBody :=
  form_inclusion (form_arr (ExactScalarFusion.End_form h) (ExactScalarFusion.End_form h))
theorem formN {Γ} (h : Ctx Γ) : FormE Γ N :=
  form_inclusion (EffectiveCompleteness.N_form h)

theorem body_of_N {Γ n} (hΓ : Ctx Γ) (hn : HasE Γ n N) : HasE Γ n NBody :=
  .allElim (formN hΓ) (.param (ctx_inclusion hΓ)) (formBody hΓ) hn

def point (p : Poly) : Poly := .app p (.var 0)

theorem point_has {n} (hn : HasE [End] n NBody) : HasE [End] (point n) End :=
  .piElim (formBody ctx1) (formEnd ctx1) hn (.var (formEnd ctx1) .zero)

theorem observation_has {p} (hp : HasE [] p N) : HasE [A,End] (scalarLeft p) A :=
  (ClosedScalarInstances.scalar_endpoints hp).1

/-- Two applications suffice once the original once-applied endpoints can be
    typed in their one-variable context. No weakening theorem is assumed here. -/
theorem identity_of_observation {p q : Poly}
    (hp : HasE [] p N) (hq : HasE [] q N)
    (lp : HasE [End] p NBody) (lq : HasE [End] q NBody)
    (hc : PolyConvPlus (scalarLeft p) (scalarLeft q)) :
    HasE [] i (.identity N p q) := by
  have sp := ClosedProofCanonicalisation.has_scope hp
  have sq := ClosedProofCanonicalisation.has_scope hq
  have hp1 := point_has lp
  have hq1 := point_has lq
  have hp2 := observation_has hp
  have hq2 := observation_has hq
  have hf2 : FormE [A,End] (.identity A (scalarLeft p) (scalarLeft q)) :=
    .identity (.param (ctx_inclusion ctx2)) hp2 hq2
  have hi2 : HasE [A,End] i (.identity A (scalarLeft p) (scalarLeft q)) :=
    .identityIntro hf2 hp2 hq2 hc
  have ep : .app (pren Nat.succ (point p)) (.var 0) = scalarLeft p := by
    simp [point, scalarLeft, pren, psub, ExactScalarFusion.psub_closed sp]
  have eq : .app (pren Nat.succ (point q)) (.var 0) = scalarLeft q := by
    simp [point, scalarLeft, pren, psub, ExactScalarFusion.psub_closed sq]
  have hfpi : FormE [End] (.pi A (.identity A (scalarLeft p) (scalarLeft q))) :=
    .pi (.param (ctx_inclusion ctx1)) hf2
  have hhpi : HasE [End] (abstract i)
      (.pi A (.identity A (scalarLeft p) (scalarLeft q))) :=
    .piIntro hfpi hi2 (scoped_abstract trivial)
  have hi1 : HasE [End] i (.identity End (point p) (point q)) := by
    apply HasE.piExt (.param (ctx_inclusion ctx1)) (.param (ctx_inclusion ctx2))
      (formEnd ctx1) hp1 hq1
    · simpa only [ep, eq] using hf2
    · simpa only [ep, eq] using hfpi
    · simpa only [ep, eq] using hhpi
    · exact .identity (formEnd ctx1) hp1 hq1
    · exact ClosedProofCanonicalisation.has_scope hp1
    · exact ClosedProofCanonicalisation.has_scope hq1
    · exact scoped_abstract trivial
    · trivial
    · trivial
  have hp0 := body_of_N Ctx.nil hp
  have hq0 := body_of_N Ctx.nil hq
  have hf1 : FormE [End] (.identity End (point p) (point q)) :=
    .identity (formEnd ctx1) hp1 hq1
  have efp : .app (pren Nat.succ p) (.var 0) = point p := by
    rw [ExactScalarFusion.pren_closed sp]; rfl
  have efq : .app (pren Nat.succ q) (.var 0) = point q := by
    rw [ExactScalarFusion.pren_closed sq]; rfl
  have hf0 : FormE [] (.pi End (.identity End (point p) (point q))) :=
    .pi (formEnd .nil) hf1
  have hh0 : HasE [] (abstract i) (.pi End (.identity End (point p) (point q))) :=
    .piIntro hf0 hi1 (scoped_abstract trivial)
  have hi0 : HasE [] i (.identity NBody p q) := by
    apply HasE.piExt (formEnd .nil) (formEnd ctx1) (formBody .nil) hp0 hq0
    · simpa only [efp,efq] using hf1
    · simpa only [efp,efq] using hf0
    · simpa only [efp,efq] using hh0
    · exact .identity (formBody .nil) hp0 hq0
    · exact sp
    · exact sq
    · exact scoped_abstract trivial
    · exact ⟨trivial,trivial⟩
    · exact ⟨trivial,trivial⟩
  exact .allExt (formBody .nil) (formN .nil) hp hq
    (.identity (formBody .nil) hp0 hq0) hi0 (.identity (formN .nil) hp hq)
    sp sq trivial ⟨⟨trivial,trivial⟩,⟨trivial,trivial⟩⟩

/-- The pre-existing old-Has lifting result is used only on old-Has inputs. -/
theorem old_lift {p : Poly} (hp : Has [] p N) : HasE [End] p NBody := by
  have h : Has [End] p N :=
    BooleanPrimitive.closed_has hp BooleanPrimitive.N_subst ctx1
  exact body_of_N ctx1 (has_inclusion h)

theorem interp_iteration (k : Nat) (f a : OpenTermStandardness.T)
    (η : Nat → OpenTermStandardness.T) :
    interp (iterationPoly k) (OpenTermStandardness.cons a (OpenTermStandardness.cons f η)) =
      OpenTermStandardness.iter f a k := by
  induction k with
  | zero => rfl
  | succ k ih => exact congrArg (OpenTermStandardness.T.app f) ih

/-- Literal bracket numerals have the required generic-open conversion. -/
theorem numeral_observation (k : Nat) :
    PolyConvPlus (scalarLeft (inputNumeral k)) (iterationPoly k) := by
  apply ClosedScalarInstances.generic_conversion_reflect
  rw [ClosedScalarInstances.iteration_interp]
  have h1 := OpenTermStandardness.Conv.app
    (ImportedOpenTermTransport.interp_abstraction_beta
      (abstract (iterationPoly k)) OpenTermStandardness.T.var (.var 1))
    (OpenTermStandardness.Conv.refl (.var 0))
  have h2 := ImportedOpenTermTransport.interp_abstraction_beta
    (iterationPoly k) (OpenTermStandardness.cons (.var 1) OpenTermStandardness.T.var) (.var 0)
  exact h1.trans ((interp_iteration k _ _ _) ▸ h2)

/-- A conversion at source variables yields every closed raw test by evaluation,
    without any semantic-to-syntactic converse. -/
theorem observation_uniform {p : Poly} {k : Nat} (hp : Scoped 0 p)
    (h : PolyConvPlus (scalarLeft p) (iterationPoly k)) :
    ∀ f a, Conv (.app (.app (eval p zeroEnv) f) a) (iterateTerm f k a) := by
  intro f a
  have h' := Intensional.Plus.polyConvPlus_sound h
    (P01F.cons a (P01F.cons f zeroEnv))
  change Conv (.app (.app (eval p (P01F.cons a (P01F.cons f zeroEnv))) f) a)
    (eval (iterationPoly k) (P01F.cons a (P01F.cons f zeroEnv))) at h'
  rw [BooleanPrimitive.eval_closed hp _ zeroEnv, EffectiveCompleteness.eval_iteration] at h'
  exact h'

/-- Any source identity proof, including a noncanonical witness, forces equal
    counts. This direction needs no endpoint-lifting hypothesis. -/
theorem identity_implies_count_eq {p q r : Poly} {j k : Nat}
    (hp : HasE [] p N) (hq : HasE [] q N)
    (cp : PolyConvPlus (scalarLeft p) (iterationPoly j))
    (cq : PolyConvPlus (scalarLeft q) (iterationPoly k))
    (h : HasE [] r (.identity N p q)) : j = k := by
  have rel : F N (fun _ => rawPER) zeroEnv (eval p zeroEnv) (eval q zeroEnv) :=
    (ExtensionalRepair.unary_fundamental h (ρ := fun _ => rawPER) ⟨rfl,rfl⟩).1
  exact IdentityComplexity.related_same_index rel
    (observation_uniform (ClosedProofCanonicalisation.has_scope hp) cp)
    (observation_uniform (ClosedProofCanonicalisation.has_scope hq) cq)

/-- Canonicity for actual closed HasE n, conditional only on its one-context lift. -/
theorem canonicity_with_lift {n : Poly} {k : Nat} (hn : HasE [] n N)
    (lift : HasE [End] n NBody)
    (count : PolyConvPlus (scalarLeft n) (iterationPoly k)) :
    HasE [] i (.identity N n (inputNumeral k)) :=
  identity_of_observation hn (has_inclusion (EffectiveCompleteness.inputNumeral_has k))
    lift (old_lift (EffectiveCompleteness.inputNumeral_has k))
    (count.trans (numeral_observation k).symm)

/-- A finite source-identity completeness theorem for the inherited old-Has
    closed Church fragment, at the unchanged source endpoints. -/
theorem old_canonicity {n : Poly} (hn : Has [] n N) :
    ∃ k, HasE [] i (.identity N n (inputNumeral k)) := by
  obtain ⟨k,hk⟩ := ClosedScalarInstances.source_uniform_iteration (has_inclusion hn)
  exact ⟨k,canonicity_with_lift (has_inclusion hn) (old_lift hn) hk⟩

theorem identity_iff_count_eq_with_lift {p q : Poly} {j k : Nat}
    (hp : HasE [] p N) (hq : HasE [] q N)
    (lp : HasE [End] p NBody) (lq : HasE [End] q NBody)
    (cp : PolyConvPlus (scalarLeft p) (iterationPoly j))
    (cq : PolyConvPlus (scalarLeft q) (iterationPoly k)) :
    HasE [] i (.identity N p q) ↔ j = k := by
  constructor
  · exact identity_implies_count_eq hp hq cp cq
  · intro e
    subst k
    exact identity_of_observation hp hq lp lq (cp.trans cq.symm)

/-- Every actual closed HasE Church derivation has a finite source identity
    to the standard numeral at its generic-open count. -/
theorem canonicity_at_count {n : Poly} {k : Nat} (hn : HasE [] n N)
    (count : PolyConvPlus (scalarLeft n) (iterationPoly k)) :
    HasE [] i (.identity N n (inputNumeral k)) :=
  canonicity_with_lift hn
    (body_of_N ctx1 (Structural.closed_church_weaken hn)) count

theorem closed_canonicity {n : Poly} (hn : HasE [] n N) :
    ∃ k, HasE [] i (.identity N n (inputNumeral k)) := by
  obtain ⟨k,hk⟩ := ClosedScalarInstances.source_uniform_iteration hn
  exact ⟨k,canonicity_at_count hn hk⟩

/-- Source-identity completeness is restricted to closed, already typed Church
    endpoints. The input derivations and original polynomials are unchanged. -/
theorem identity_iff_count_eq {p q : Poly} {j k : Nat}
    (hp : HasE [] p N) (hq : HasE [] q N)
    (cp : PolyConvPlus (scalarLeft p) (iterationPoly j))
    (cq : PolyConvPlus (scalarLeft q) (iterationPoly k)) :
    HasE [] i (.identity N p q) ↔ j = k :=
  identity_iff_count_eq_with_lift hp hq
    (body_of_N ctx1 (Structural.closed_church_weaken hp))
    (body_of_N ctx1 (Structural.closed_church_weaken hq)) cp cq

theorem identity_exists_iff_count_eq {p q : Poly} {j k : Nat}
    (hp : HasE [] p N) (hq : HasE [] q N)
    (cp : PolyConvPlus (scalarLeft p) (iterationPoly j))
    (cq : PolyConvPlus (scalarLeft q) (iterationPoly k)) :
    (∃ r, HasE [] r (.identity N p q)) ↔ j = k := by
  constructor
  · rintro ⟨r,h⟩
    exact identity_implies_count_eq hp hq cp cq h
  · intro e
    exact ⟨i,(identity_iff_count_eq hp hq cp cq).mpr e⟩

#print axioms canonicity_at_count
#print axioms closed_canonicity
#print axioms identity_iff_count_eq
#print axioms identity_exists_iff_count_eq
#print axioms numeral_observation
#print axioms identity_implies_count_eq
#print axioms canonicity_with_lift
#print axioms old_canonicity
#print axioms identity_iff_count_eq_with_lift
#print axioms identity_of_observation
#print axioms old_lift
end ClosedChurchIdentity
import TypeSubstitutionApplications
namespace HasEMixedReviewReject
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01AC.ExtensionalRepair
open P01AC.ExtensionalRepair.Structural
example {Γ Δ : Tel} {τ : Nat → Ty}
 (ht : ∀ n, FormE Δ (τ n)) : TypeSubstitution Γ Δ τ := by
 exact TypeSubstitution.empty ht
end HasEMixedReviewReject
import MeasurablePhysicalFlattening
open Filter MeasureTheory
open Orthemology.Tranche2.PhysicalFlattening
namespace IndependentDecoder

theorem empty_decode (d t : ℕ) : decode d (fun _ => []) t = d := by
  have hh : ∀ N, prefixActions (fun _ : ℕ => ([] : List ℕ)) N = [] := by
    intro N
    induction N with
    | zero => rfl
    | succ N ih => rw [prefixActions_succ,ih]; rfl
  unfold decode
  rw [hh]
  rfl

theorem finite_prefix_values : prefixActions (fun n => if n=0 then [0,1] else if n=1 then [] else [2]) 3 = [0,1,2] := by decide

theorem nonempty_default_independent (d e : A) (blocks : ℕ → List A)
    (hn : ∀ n, blocks n ≠ []) (t : ℕ) : decode d blocks t = decode e blocks t := by
  rw [decode_eq_flatten d blocks hn t,decode_eq_flatten e blocks hn t]

def sparse (n : ℕ) : List ℕ := if n%2=0 then [n/2] else []
lemma sparse_prefix (k : ℕ) : prefixLength sparse (2*k) = k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show 2*(k+1) = 2*k+1+1 by omega,prefixLength_succ,prefixLength_succ,ih]
    simp [sparse,Nat.add_mod,Nat.mul_mod]
lemma sparse_unbounded : Unbounded sparse := by
  intro t
  refine ⟨2*t+1,?_⟩
  rw [show 2*t+1+1 = 2*(t+1) by omega,sparse_prefix]
  omega
lemma sparse_fallback : decode 99 sparse 1 = 99 := by decide
lemma sparse_actual_value : flatten sparse sparse_unbounded 1 = 1 := by
  have h := prefix_getD_eq_flatten sparse sparse_unbounded 99 3 1 (by decide)
  have hv : (prefixActions sparse 3).getD 1 99 = 1 := by decide
  rw [hv] at h
  exact h.symm
lemma unbounded_does_not_suffice_for_decoder_identity : decode 99 sparse 1 ≠ flatten sparse sparse_unbounded 1 := by
  rw [sparse_fallback,sparse_actual_value]
  decide

section MeasurableMixed
local instance : MeasurableSpace (List ℕ) := ⊤
local instance : MeasurableSingletonClass (List ℕ) := ⟨fun _ => trivial⟩
def mixed (n ω : ℕ) : List ℕ := if ω=0 then [] else [n]
theorem mixed_decode_measurable (d t : ℕ) :
    Measurable (fun ω => decode d (fun n => mixed n ω) t) :=
  decode_measurable d mixed (fun _ => measurable_of_countable _) t
lemma mixed_invalid_fallback : decode 99 (fun n => mixed n 0) 1 = 99 := by decide
lemma mixed_valid_action : decode 99 (fun n => mixed n 1) 1 = 1 := by decide
end MeasurableMixed

end IndependentDecoder
#print axioms IndependentDecoder.empty_decode
#print axioms IndependentDecoder.finite_prefix_values
#print axioms IndependentDecoder.nonempty_default_independent
#print axioms IndependentDecoder.sparse_unbounded
#print axioms IndependentDecoder.sparse_fallback
#print axioms IndependentDecoder.sparse_actual_value
#print axioms IndependentDecoder.unbounded_does_not_suffice_for_decoder_identity
#print axioms IndependentDecoder.mixed_decode_measurable
#print axioms IndependentDecoder.mixed_invalid_fallback
#print axioms IndependentDecoder.mixed_valid_action
/- Additive Joint port of the credited actual-E total-space proof. -/
import JointInductionInitiality
namespace JointCompletion.InductionComputation
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open SourceRigidity RigidityInitiality
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem pi_body_form {Γ : Tel} {X P : Ty} (h : FormJ Γ (.pi X P)) :
    FormJ (X :: Γ) P := by
  cases h with
  | formBase h => cases h with | pi _ h => exact .formBase h
  | pi _ h => exact h


theorem uncurried_step_has {Γ : Tel} {P : Ty} {s : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hs : HasJ Γ s (dependentStepType P)) :
    HasJ (total P :: Γ) (uncurriedStep s) (totalStepType P) := by
  have hE : FormJ Γ (total P) := .sigma (N_form hc) hP
  have cE := CtxJ.ext hc hE
  let P' := subst (pup (fun k => .var (k+1))) P
  have hEw : FormJ (total P :: Γ) (.sigma N P') := by
    simpa only [total, wk, subst, N_subst] using form_wk hE hc hE
  have hv : HasJ (total P :: Γ) (.var 0) (.sigma N P') := by
    have h : HasJ (total P :: Γ) (.var 0) (wk (total P)) := .var (form_wk hE hc hE) .zero
    simpa only [total, wk, subst, N_subst] using h
  have hfst := HasJ.sigmaFst (N_form cE) hEw hv
  have hleaf := form_inst_source cE (sigma_body_form hEw) hfst
  have hsnd := HasJ.sigmaSnd hEw hleaf hv
  have hsw : HasJ (total P :: Γ) (pren Nat.succ s)
      (.pi N (subst (pup (fun k => .var (k+1))) (arr P (successorFamily P)))) := by
    simpa only [dependentStepType, wk, subst, N_subst] using has_wk hs hc hE
  have hsform := has_form hsw
  have target := form_inst_source cE (pi_body_form hsform) hfst
  have first := HasJ.piElim hsform target hsw hfst
  have target_eq : inst (subst (pup (fun k => .var (k+1))) (arr P (successorFamily P)))
      (fstPoly (.var 0)) = arr (inst P' (fstPoly (.var 0))) (totalStepType P) := by
    simp only [subst_arr, inst, subst_arr]
    congr 1
    simp only [successorFamily, totalStepType, inst, subst_comp]
    congr 1
    funext k
    cases k with
    | zero =>
      simp [cons, pup, psub, nextIndex,
        P01AC.BooleanPrimitive.psub_closed (P01AC.has_scoped succ_has)]
    | succ k => rfl
  have first' := target_eq ▸ first
  have target' := target_eq ▸ target
  have hresult : FormJ (total P :: Γ) (totalStepType P) := by
    simpa only [inst_wk] using form_inst_source cE (pi_body_form target') hsnd
  exact app_has target' hresult first' hsnd


theorem dependent_section_explicit {Γ : Tel} {P : Ty} {p d r n : Poly}
    (hc : CtxJ Γ) (hP : FormJ (N :: Γ) P)
    (hp : HasJ Γ p (inst P zero))
    (hd : HasJ (total P :: Γ) d (totalStepType P))
    (hr : HasJ Γ r Rigidity) (hn : HasJ Γ n N) :
    HasJ Γ (sndPoly (.app (.app n (totalStep d)) (totalSeed p))) (inst P n) := by
  let D := totalStep d
  let a := totalSeed p
  let u := projectedFold D a
  let run : Poly := .app (.app n D) a
  have hD := total_step_has hc hP hd
  have ha := total_seed_has hc hP hp
  have hu : HasJ Γ u NT := projectedFold_has hc hP hD ha
  have hE : FormJ Γ (total P) := .sigma (N_form hc) hP
  have hrun : HasJ Γ run (total P) := fold_has hc hE hn hD ha
  have hfst : HasJ Γ (fstPoly run) N := .sigmaFst (N_form hc) hE hrun
  have hsnd : HasJ Γ (sndPoly run) (inst P (fstPoly run)) :=
    .sigmaSnd hE (form_inst_source hc hP hfst) hrun
  have huN := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) hu hn
  have rid := rigidity_elim hc hu hr
    ((projected_zero_evidence hc hP hp hd))
    ((projected_step_evidence hc hP hp hd))
  have point := rigidity_pointwise hc hu hn rid
  have link : HasJ Γ ident (.identity N (fstPoly run) (.app u n)) :=
    identityIntro_raw (.identity (N_form hc) hfst huN) hfst huN (projectedFold_beta D a n).symm
  have back := nat_identity_trans hc hfst huN hn (link) point
  have transported := transport_source hc (N_form hc) hP hfst hn back (hsnd)
  exact HasJ.conv ((form_inst_source hc hP hn)) transported
    ((P01AC.Intensional.Plus.PolyConvPlus.app (.k _ _) (.refl _)).trans (.k _ _))
    (has_scoped hsnd)



theorem dependent_section_curried {Γ : Tel} {P : Ty} {p s r n : Poly}
    (hc : CtxJ Γ) (hP : FormJ (N :: Γ) P)
    (hp : HasJ Γ p (inst P zero)) (hs : HasJ Γ s (dependentStepType P))
    (hr : HasJ Γ r Rigidity) (hn : HasJ Γ n N) :
    HasJ Γ (sndPoly (.app (.app n (totalStep (uncurriedStep s))) (totalSeed p))) (inst P n) :=
  dependent_section_explicit hc hP hp (uncurried_step_has hc hP hs) hr hn


end JointCompletion.InductionComputation
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

/-!
Scalar support for the full-polynomial moment countermodel.

This file checks only the displayed scalar polynomial and seed arithmetic.
It does not formalize the recursive infinite moment functional, positive
 definiteness of all its Gram matrices, or the nonexistence of a representing
measure. Those claims require the accompanying mathematical construction.
-/

namespace FullPolynomialMomentSupport

/-- The globally positive polynomial separated by the proposed functional. -/
def F (x y : ℝ) : ℝ :=
  1 + x ^ 4 * y ^ 2 + x ^ 2 * y ^ 4 - x ^ 2 * y ^ 2

/-- An elementary bound in the nonnegative variables `u = x²`, `v = y²`. -/
theorem nonnegative_variables_lower_bound (u v : ℝ) (hu : 0 ≤ u) (hv : 0 ≤ v) :
    (3 : ℝ) / 4 ≤ 1 + u ^ 2 * v + u * v ^ 2 - u * v := by
  have huv : 0 ≤ u * v := mul_nonneg hu hv
  by_cases hs : 1 ≤ u + v
  · have hprod : 0 ≤ u * v * (u + v - 1) :=
      mul_nonneg huv (by linarith)
    nlinarith [hprod]
  · have hsum : 0 ≤ u + v := add_nonneg hu hv
    have hrest : 0 ≤ 1 - (u + v) := by linarith
    have hsum_square : (u + v) ^ 2 ≤ 1 := by
      nlinarith [mul_nonneg hsum hrest]
    have huv_upper : u * v ≤ (1 : ℝ) / 4 := by
      nlinarith [sq_nonneg (u - v)]
    have hpositive : 0 ≤ u * v * (u + v) := mul_nonneg huv hsum
    nlinarith [hpositive]

/-- The scalar polynomial is uniformly bounded away from zero on all of `ℝ²`. -/
theorem F_lower_bound (x y : ℝ) : (3 : ℝ) / 4 ≤ F x y := by
  have h := nonnegative_variables_lower_bound (x ^ 2) (y ^ 2)
    (sq_nonneg x) (sq_nonneg y)
  dsimp [F]
  nlinarith [h]

theorem F_positive (x y : ℝ) : 0 < F x y := by
  have h := F_lower_bound x y
  linarith

/-- The seed values prescribed for the four monomials of `F` give `-1`.
This is scalar arithmetic, not yet a formal definition of a linear functional. -/
theorem separating_seed_value : (1 : ℝ) + 1 + 1 - 4 = -1 := by
  norm_num

#print axioms nonnegative_variables_lower_bound
#print axioms F_lower_bound
#print axioms F_positive
#print axioms separating_seed_value

end FullPolynomialMomentSupport
import SCCParity
namespace HiddenParity.IndependentOracle
set_option maxRecDepth 100000
set_option maxHeartbeats 0
abbrev S := Fin 2
abbrev P := Fin 4
abbrev M := Fin 3
structure Case where
  graph : Nat
  rows : Nat
  priority : Nat
  live : Nat
  candidate : Nat
  allowed : Nat

def digit (n b i : Nat) : Nat := (n / b^i) % b

def src (e : P) : S := ⟨e.val / 2, by omega⟩
def successors (c : Case) (e : P) : Finset S :=
  Finset.univ.filter (fun s => digit (digit c.graph 4 e.val) 2 s.val = 1)
def rows (c : Case) (m : M) (e : P) : Nat := digit c.rows 4 (m.val*4+e.val)
def priorities (c : Case) (m : M) (e : P) : Nat := digit c.priority 6 (m.val*4+e.val)
def live (c : Case) : Finset M := Finset.univ.filter (fun m => digit c.live 2 m.val = 1)
def allowed (c : Case) : Finset P := Finset.univ.filter (fun e => digit c.allowed 2 e.val = 1)
def pairMask (E : Finset P) : Nat := E.sum (fun e => 2^e.val)
def solve (c : Case) : Nat × Nat :=
  let result := SCCPruning.parityOutput src (successors c) (live c) (rows c) (priorities c)
    ⟨c.candidate % 3, Nat.mod_lt _ (by decide)⟩ (allowed c)
  (result.sum (fun E => 2 ^ pairMask E), (result.biUnion (usedStates src)).sum (fun s => 2^s.val))
