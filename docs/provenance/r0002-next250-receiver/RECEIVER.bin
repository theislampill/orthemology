import HasEDependentSubstitution

namespace P01AC.ExtensionalRepair.Structural
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01F (cons)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Actual-E context formation supplies the declaration types needed by maps. -/
theorem lookup_form {Γ : Tel} {n : Nat} {A : Ty} (hΓ : CtxE Γ)
    (h : Lookup Γ n A) : FormE Γ A := by
  induction h with
  | zero =>
      cases hΓ with
      | ext hΓ hA => exact form_wk hA hΓ hA
  | succ h ih =>
      cases hΓ with
      | ext hΓ hB => exact form_wk (ih hΓ) hΓ hB

theorem TypedSubstitution.single {Γ : Tel} {A : Ty} {a : Poly}
    (hΓ : CtxE Γ) (ha : HasE Γ a A) :
    TypedSubstitution (A :: Γ) Γ (cons a Poly.var) := by
  constructor
  intro n B h
  cases h with
  | zero => simpa only [subst_wk_cancel, subst_id, cons] using ha
  | succ h => simpa only [subst_wk_cancel, subst_id, cons] using
      (HasE.var (lookup_form hΓ h) h)

/-- Formation under an actual HasE endpoint, not just an original-Has one. -/
theorem form_inst {Γ : Tel} {A B : Ty} {a : Poly}
    (hΓ : CtxE Γ) (hB : FormE (A :: Γ) B) (ha : HasE Γ a A) : FormE Γ (inst B a) :=
  form_subst hB hΓ (TypedSubstitution.single hΓ ha)

/-- Literal dependent beta substitution, including an actual-E branch. -/
theorem has_inst {Γ : Tel} {A B : Ty} {d a : Poly}
    (hΓ : CtxE Γ) (hd : HasE (A :: Γ) d B) (ha : HasE Γ a A) :
    HasE Γ (psub (cons a Poly.var) d) (inst B a) :=
  has_subst hd hΓ (TypedSubstitution.single hΓ ha)

/-- A two-component dependent substitution admits actual HasE data at both
    components; the second component's type depends on the first. -/
theorem TypedSubstitution.pair {Γ : Tel} {A B : Ty} {a b : Poly}
    (hΓ : CtxE Γ) (ha : HasE Γ a A) (hb : HasE Γ b (inst B a)) :
    TypedSubstitution (B :: A :: Γ) Γ (cons b (cons a Poly.var)) := by
  constructor
  intro n C h
  cases h with
  | zero => simpa only [subst_wk_cancel, cons] using hb
  | succ h =>
      cases h with
      | zero => simpa only [subst_wk_cancel, subst_id, cons] using ha
      | succ h => simpa only [subst_wk_cancel, subst_id, cons] using
          (HasE.var (lookup_form hΓ h) h)

/-- The same literal pair substitution used by the retained Sigma-elimination
    theorem; this module upgrades its branch typing without adding Sigma eta. -/
def pairSub : Nat → Poly := cons (pairPoly (.var 1) (.var 0)) (fun n => .var (n+2))
def branchType (P : Ty) : Ty := subst pairSub P
def branchAt (d a b : Poly) : Poly := psub (cons b (cons a Poly.var)) d

theorem branch_type_at (P : Ty) (a b : Poly) :
    subst (cons b (cons a Poly.var)) (branchType P) = inst P (pairPoly a b) := by
  rw [branchType, subst_comp]
  congr 1
  funext n
  cases n <;> rfl

/-- Full actual-HasE version of the previously original-Has-only dependent
    Sigma branch-substitution lemma. Context, branch, and endpoints are E. -/
theorem dependent_branch_substitution {Γ : Tel} {A B P : Ty} {d a b : Poly}
    (hΓ : CtxE Γ) (hd : HasE (B :: A :: Γ) d (branchType P))
    (ha : HasE Γ a A) (hb : HasE Γ b (inst B a)) :
    HasE Γ (branchAt d a b) (inst P (pairPoly a b)) := by
  have q := has_subst hd hΓ (TypedSubstitution.pair hΓ ha hb)
  simpa only [branchAt, branch_type_at] using q

#print axioms form_inst
#print axioms has_inst
#print axioms dependent_branch_substitution
end P01AC.ExtensionalRepair.Structural
import RawMotiveBoundary

/- Reviewer-only controls. These add no source rules or axioms. -/
namespace P01AC.ExtensionalRepair.RawMotiveBoundary.IndependentReview
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01F (cons)
open P01AC.EffectiveCompleteness
open P01AC.UnaryIdentity.IntensionalBoundary

set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

theorem exact_theta_shape : theta [] EndN p =
    [.identity (wk EndN) (pren Nat.succ p) (.var 0), EndN] := rfl

theorem exact_endpoint_coordinates :
    eval (.var 0) (cons p0 zeroEnv) = p0 ∧
    eval (.var 0) (cons .i (cons p0 zeroEnv)) = .i ∧
    eval (.var 1) (cons .i (cons p0 zeroEnv)) = p0 ∧
    eval (.var 1) (cons .i (cons q0 zeroEnv)) = q0 :=
  ⟨rfl, rfl, rfl, rfl⟩

theorem theta_both_inhabited (ρ : OEnv) :
    D (theta [] EndN p) ρ (cons .i (cons p0 zeroEnv)) ∧
    D (theta [] EndN p) ρ (cons .i (cons q0 zeroEnv)) :=
  (context_sound theta_context_formed).ends (theta_environments ρ)

theorem assumption_inhabited (ρ : OEnv) : D [B] ρ (cons .i zeroEnv) :=
  ((context_sound assumed_context_formed).ends (assumed_identity_environment ρ)).1

/-- Closed polynomial syntax is raw-typable by structural recursion; this does
    not introduce any erasure or quotation rule for a bound typed variable. -/
theorem raw_closed_at {Γ : Tel} {s : Poly} (hΓ : CtxE Γ) (hs : Scoped 0 s) :
    HasE Γ s .raw := by
  induction s with
  | var n => exact False.elim (Nat.not_lt_zero n hs)
  | atom t => exact .rawAtom (.raw hΓ)
  | app f a ihf iha => exact .rawApp (.raw hΓ) (ihf hs.1) (iha hs.2)

/-- The negative assumed-context target is genuinely formed, so its failure
    is not merely the earlier failed formation of the varying-endpoint motive. -/
theorem reflection_target_formed : FormE [B] (.identity .raw p q) :=
  .identity (.raw assumed_context_formed)
    (raw_closed_at assumed_context_formed (has_scoped variableExpr.closed_has))
    (raw_closed_at assumed_context_formed (has_scoped redundantExpr.closed_has))

theorem q_is_raw_in_theta : HasE (theta [] EndN p) q .raw :=
  raw_closed_at theta_context_formed (has_scoped redundantExpr.closed_has)

theorem reflection_target_has_no_witness : ¬ ∃ r, HasE [B] r (.identity .raw p q) := by
  rintro ⟨r, hr⟩
  exact no_raw_reflection_under_assumption r hr

#print axioms exact_theta_shape
#print axioms exact_endpoint_coordinates
#print axioms theta_both_inhabited
#print axioms assumption_inhabited
#print axioms raw_closed_at
#print axioms reflection_target_formed
#print axioms q_is_raw_in_theta
#print axioms reflection_target_has_no_witness
end P01AC.ExtensionalRepair.RawMotiveBoundary.IndependentReview
import Indexing
import Recurrence
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! The genuine finite-support bridge from the recursive Gram matrices to
strict positivity on squares in the complete bivariate polynomial algebra. -/
namespace FullFunctionalPolynomialBridge
open FullFunctionalIndexing FullFunctionalRecurrence FullFunctionalSchur
open MvPolynomial Matrix

abbrev Polynomial := MvPolynomial (Fin 2) ℝ
abbrev MultiExponent := Fin 2 →₀ ℕ

def decode (d : MultiExponent) : Exponent := (d 0, d 1)
noncomputable def encode (e : Exponent) : MultiExponent :=
  Finsupp.single 0 e.1 + Finsupp.single 1 e.2

@[simp] theorem decode_encode (e : Exponent) : decode (encode e) = e := by
  rcases e with ⟨a,b⟩
  simp [decode, encode]

@[simp] theorem encode_decode (d : MultiExponent) : encode (decode d) = d := by
  ext i
  have hi : i = 0 ∨ i = 1 := by
    have h := i.isLt
    omega
  rcases hi with rfl | rfl <;> simp [encode, decode]

@[simp] theorem decode_add (d e : MultiExponent) : decode (d + e) = decode d + decode e := by
  rfl

theorem encode_injective : Function.Injective encode := by
  intro e f h
  have he := congrArg decode h
  simpa using he

/-- Evaluation of a polynomial against any full moment sequence. -/
noncomputable def functional (μ : Exponent → ℝ) : Polynomial →ₗ[ℝ] ℝ :=
  Finsupp.linearCombination ℝ (fun d : MultiExponent => μ (decode d))

@[simp] theorem functional_monomial (μ : Exponent → ℝ) (d : MultiExponent) (r : ℝ) :
    functional μ (monomial d r) = r * μ (decode d) := by
  exact Finsupp.linearCombination_single ℝ r d

@[simp] theorem functional_encoded_monomial (μ : Exponent → ℝ) (e : Exponent) (r : ℝ) :
    functional μ (monomial (encode e) r) = r * μ e := by simp

@[simp] theorem functional_one (μ : Exponent → ℝ) :
    functional μ 1 = μ (0,0) := by
  rw [MvPolynomial.one_def, functional_monomial]
  exact one_mul _

@[simp] theorem functional_X_pow_mul_X_pow (μ : Exponent → ℝ) (a b : ℕ) :
    functional μ ((X (0 : Fin 2)) ^ a * (X (1 : Fin 2)) ^ b) = μ (a,b) := by
  simp [X_pow_eq_monomial, monomial_mul, decode]

noncomputable def exponent (n : ℕ) (i : Index n) : MultiExponent :=
  encode (exponentAt (position i))

theorem exponent_injective (n : ℕ) : Function.Injective (exponent n) := by
  intro i j h
  apply position_injective n
  apply exponentAt_injective
  exact encode_injective h

/-- Every finite polynomial support fits into one of the recursively extended
index sets. This is the only bound chosen, and depends on the given polynomial. -/
theorem support_fits (p : Polynomial) :
    ∃ n, ∀ d ∈ p.support, ∃ i : Index n, exponent n i = d := by
  classical
  let n := p.support.sup (fun d => index (decode d))
  refine ⟨n, ?_⟩
  intro d hd
  have hb : index (decode d) ≤ n := Finset.le_sup (f := fun d => index (decode d)) hd
  obtain ⟨i,hi⟩ := position_surjective n (index (decode d) - 1) (by omega)
  refine ⟨i, ?_⟩
  simp [exponent, hi]

/-- Coefficients outside the original support are included as zeros. -/
theorem expand_of_support_fits (p : Polynomial) (n : ℕ)
    (h : ∀ d ∈ p.support, ∃ i : Index n, exponent n i = d) :
    p = ∑ i : Index n, monomial (exponent n i) (coeff (exponent n i) p) := by
  classical
  ext d
  rw [coeff_sum]
  by_cases hd : ∃ i : Index n, exponent n i = d
  · obtain ⟨i,rfl⟩ := hd
    symm
    rw [Finset.sum_eq_single i]
    · simp
    · intro j hj hji
      rw [coeff_monomial]
      simp [show exponent n j ≠ exponent n i from fun he => hji (exponent_injective n he)]
    · simp
  · have hz : coeff d p = 0 := by
      by_contra hz
      exact hd (h d (by simpa only [mem_support_iff] using hz))
    rw [hz]
    symm
    apply Finset.sum_eq_zero
    intro i hi
    rw [coeff_monomial]
    simp [show exponent n i ≠ d from fun he => hd ⟨i, he⟩]

/-- All polynomials, without a global degree cutoff, have finite Gram coordinates. -/
theorem finite_expansion (p : Polynomial) :
    ∃ n, ∃ u : Index n → ℝ, p = ∑ i : Index n, monomial (exponent n i) (u i) := by
  obtain ⟨n,hn⟩ := support_fits p
  exact ⟨n, (fun i => coeff (exponent n i) p), expand_of_support_fits p n hn⟩

noncomputable def gram (μ : Exponent → ℝ) (n : ℕ) : Matrix (Index n) (Index n) ℝ :=
  fun i j => μ (exponentAt (position i) + exponentAt (position j))

/-- The moment functional of a square equals its finite Gram quadratic form. -/
theorem functional_square_expansion (μ : Exponent → ℝ) (n : ℕ) (u : Index n → ℝ) :
    functional μ ((∑ i : Index n, monomial (exponent n i) (u i)) ^ 2) =
      u ⬝ᵥ gram μ n *ᵥ u := by
  classical
  rw [pow_two, Finset.sum_mul]
  simp only [Finset.mul_sum, map_sum, monomial_mul, functional_monomial,
    decode_add, exponent, decode_encode]
  simp only [dotProduct, mulVec, gram, Finset.mul_sum]
  congr 1
  funext i
  apply Finset.sum_congr rfl
  intro j hj
  ring

/-- The bridge's sole positivity hypothesis is discharged by the actual moment
recursion. It concerns every finite recursive Gram matrix, not the polynomial. -/
theorem square_strict_positive (μ : Exponent → ℝ)
    (hgram : ∀ n, Positive (gram μ n)) (p : Polynomial) (hp : p ≠ 0) :
    0 < functional μ (p ^ 2) := by
  obtain ⟨n,u,hu⟩ := finite_expansion p
  have hne : u ≠ 0 := by
    intro hz
    apply hp
    rw [hu, hz]
    simp
  rw [hu, functional_square_expansion]
  exact hgram n u hne

#print axioms finite_expansion
#print axioms functional_square_expansion
#print axioms square_strict_positive
end FullFunctionalPolynomialBridge
import IndependentCodeControls
open AuxiliaryCodeComputability SourceFamilyComputability CodedScope ExactSyntaxValidity IndependentAuxiliaryCodeReview
set_option maxRecDepth 8192
example : AuxiliaryCodeComputability.lookupChildren (Nat.pair 0 (Nat.pair 0 0),pack 1 [leaf 1,leaf 2,leaf 3,leaf 4,5]) = [(Nat.pair 1 (Nat.pair 2 4),5)] := by
  rw [lookup_succ_children]
  decide
/- Curry System F, including unrestricted term contexts with the correct
   type-variable lifting at universal introduction. No reduction rule is added
   to typing. Subject reduction is proved from substitution and lambda generation.
   New attempt-0003 authored source; UNCOMPILED, no kernel claim. -/
import P01LambdaSyntax
namespace P01F
open OrthemologyV2 OrthemologyV3
abbrev Context := Nat → Ty

def shiftContext (Γ : Context) : Context := fun n => rename Nat.succ (Γ n)
def subContext (σ : Nat → Ty) (Γ : Context) : Context := fun n => substitute σ (Γ n)

inductive Has : Context → LTerm → Ty → Prop where
  | var (Γ) (n) : Has Γ (.var n) (Γ n)
  | lam {Γ b A B} : Has (cons A Γ) b B → Has Γ (.lam b) (.arrow A B)
  | app {Γ f a A B} : Has Γ f (.arrow A B) → Has Γ a A → Has Γ (.app f a) B
  | allI {Γ t B} : Has (shiftContext Γ) t B → Has Γ t (.all B)
  | allE {Γ t B} : Has Γ t (.all B) → (A : Ty) → Has Γ t (instantiateType B A)

@[simp] theorem subContext_cons (σ) (A) (Γ) :
    subContext σ (cons A Γ) = cons (substitute σ A) (subContext σ Γ) := by
  funext n; cases n <;> rfl

@[simp] theorem subContext_up (σ) (Γ) :
    subContext (upSub σ) (shiftContext Γ) = shiftContext (subContext σ Γ) := by
  funext n; exact ty_sub_up_shift (Γ n) σ

@[simp] theorem subContext_single_shift (A) (Γ) :
    subContext (singleSub A) (shiftContext Γ) = Γ := by
  funext n; exact ty_inst_shift (Γ n) A

/-- Type substitution changes both assumptions and the conclusion; runtime syntax
    is unchanged. No term assumption is held fixed across a type binder. -/
theorem type_substitution {Γ t A} (h : Has Γ t A) (σ : Nat → Ty) :
    Has (subContext σ Γ) t (substitute σ A) := by
  induction h generalizing σ with
  | var Γ n => exact .var _ n
  | lam h ih =>
      apply Has.lam
      simpa only [subContext_cons] using ih σ
  | app hf ha ihf iha => exact .app (ihf σ) (iha σ)
  | allI h ih =>
      apply Has.allI
      simpa only [subContext_up] using ih (upSub σ)
  | allE h A ih =>
      rw [ty_sub_inst]
      exact .allE (ih σ) (substitute σ A)

theorem type_renaming {Γ t A} (h : Has Γ t A) (r : Nat → Nat) :
    Has (fun n => rename r (Γ n)) t (rename r A) := by
  simpa only [subContext, ty_sub_vars] using
    type_substitution h (fun n => TypeCode.var (r n))

theorem term_renaming {Γ t A} (h : Has Γ t A) :
    ∀ (Δ : Context) (r : Nat → Nat), (∀ n, Γ n = Δ (r n)) →
      Has Δ (ren r t) A := by
  induction h with
  | var Γ n =>
      intro Δ r e
      rw [e n]
      exact .var Δ (r n)
  | lam h ih =>
      intro Δ r e
      apply Has.lam
      apply ih (cons _ Δ) (liftRen r)
      intro n; cases n with
      | zero => rfl
      | succ n => exact e n
  | app hf ha ihf iha =>
      intro Δ r e
      exact .app (ihf Δ r e) (iha Δ r e)
  | allI h ih =>
      intro Δ r e
      apply Has.allI
      apply ih (shiftContext Δ) r
      intro n; exact congrArg (rename Nat.succ) (e n)
  | allE h X ih =>
      intro Δ r e
      exact .allE (ih Δ r e) X

theorem term_weakening {Γ t A} (h : Has Γ t A) (B : Ty) :
    Has (cons B Γ) (ren Nat.succ t) A :=
  term_renaming h (cons B Γ) Nat.succ (fun _ => rfl)

/-- Simultaneous, capture-avoiding term substitution, including the allI case. -/
theorem term_substitution {Γ t A} (h : Has Γ t A) :
    ∀ (Δ : Context) (σ : Nat → LTerm), (∀ n, Has Δ (σ n) (Γ n)) →
      Has Δ (sub σ t) A := by
  induction h with
  | var Γ n => intro Δ σ hs; exact hs n
  | lam h ih =>
      intro Δ σ hs
      apply Has.lam
      apply ih (cons _ Δ) (up σ)
      intro n
      cases n with
      | zero => exact .var _ 0
      | succ n => exact term_weakening (hs n) _
  | app hf ha ihf iha =>
      intro Δ σ hs
      exact .app (ihf Δ σ hs) (iha Δ σ hs)
  | allI h ih =>
      intro Δ σ hs
      apply Has.allI
      apply ih (shiftContext Δ) σ
      intro n
      exact type_renaming (hs n) Nat.succ
  | allE h X ih =>
      intro Δ σ hs
      exact .allE (ih Δ σ hs) X

theorem instantiate_term {Γ b a A B}
    (hb : Has (cons A Γ) b B) (ha : Has Γ a A) : Has Γ (inst b a) B := by
  apply term_substitution hb Γ (single a)
  intro n
  cases n with
  | zero => exact ha
  | succ n => exact .var Γ n

/-- Lambda-headed typing without an allE constructor. This is an auxiliary view
    derived below, not an alternative assumption about Curry typing. -/
inductive LamView : Context → LTerm → Ty → Prop where
  | arrow {Γ b A B} : Has (cons A Γ) b B → LamView Γ b (.arrow A B)
  | all {Γ b B} : LamView (shiftContext Γ) b B → LamView Γ b (.all B)

theorem lamView_substitution {Γ b A} (h : LamView Γ b A) (σ : Nat → Ty) :
    LamView (subContext σ Γ) b (substitute σ A) := by
  induction h generalizing σ with
  | arrow h =>
      apply LamView.arrow
      simpa only [subContext_cons] using type_substitution h σ
  | all h ih =>
      apply LamView.all
      simpa only [subContext_up] using ih (upSub σ)

theorem lamView_instantiation {Γ b B} (h : LamView Γ b (.all B)) (A : Ty) :
    LamView Γ b (instantiateType B A) := by
  cases h with
  | all h =>
      simpa only [subContext_single_shift] using
        lamView_substitution h (singleSub A)

/-- The difficult Curry inversion step: universal introduction/elimination
    surrounding a lambda is eliminated by actual type substitution. -/
theorem lambda_view {Γ t A} (h : Has Γ t A) :
    ∀ b, t = .lam b → LamView Γ b A := by
  induction h with
  | var Γ n => intro b e; cases e
  | lam h ih => intro b e; cases e; exact .arrow h
  | app hf ha ihf iha => intro b e; cases e
  | allI h ih => intro b e; exact .all (ih b e)
  | allE h X ih => intro b e; exact lamView_instantiation (ih b e) X

theorem lambda_generation {Γ b A B} (h : Has Γ (.lam b) (.arrow A B)) :
    Has (cons A Γ) b B := by
  have hv := lambda_view h b rfl
  cases hv with
  | arrow hb => exact hb

/-- Standard compatible beta subject reduction. Reduction is NOT a typing rule. -/
theorem subject_reduction {Γ t A} (h : Has Γ t A) :
    ∀ {u}, Beta t u → Has Γ u A := by
  induction h with
  | var Γ n => intro u r; cases r
  | lam hb ih =>
      intro u r
      cases r with
      | under r => exact .lam (ih r)
  | app hf ha ihf iha =>
      intro u r
      cases r with
      | root b a => exact instantiate_term (lambda_generation hf) ha
      | left r a => exact .app (ihf r) ha
      | right f r => exact .app hf (iha r)
  | allI h ih => intro u r; exact .allI (ih r)
  | allE h X ih => intro u r; exact .allE (ih r) X

theorem subject_reduction_star {Γ t u A} (h : Has Γ t A) (r : BStar t u) :
    Has Γ u A := by
  induction r with
  | refl => exact h
  | tail s r ih => exact ih (subject_reduction h s)
end P01F
import SourceAttemptTransport

namespace TransportIndependentReview
open SharedAlias SharedAlias.OrderTransport OperationalJoin
open OperationalJoin.Typed (BoundedEnvelope interface path)
noncomputable section
open Classical

-- No second support-dependent choice is available after the first swap.
theorem no_complete_key_collision {m} (A : Profile m) (a b : BoundedEnvelope m) :
    selected A a = selected A b ↔ a = b := (selectedEquiv A).injective.eq_iff

theorem same_support_does_not_collapse {m} (A : Profile m) (a b : BoundedEnvelope m)
    (_same : path a = path b) (different : a ≠ b) : selected A a ≠ selected A b :=
  fun eq => different ((no_complete_key_collision A a b).mp eq)

def sortCommand {m} (k : BoundedEnvelope m) : BoundedEnvelope m :=
  ⟨{k.val with path := SharedAlias.Progress.labelList (path k)},
    SharedAlias.Progress.labelList_nodup _, SharedAlias.Progress.labelList_bounded _⟩

theorem sorting_collapses_a_nonfixed_pair {m} (T : Symmetry m) (k : BoundedEnvelope m) :
    sortCommand (T.command k) = sortCommand k := by
  apply Subtype.ext
  apply ComposedExecution.Envelope.ext <;> simp only [sortCommand, T.action, T.successor, T.nonce, T.support]

theorem sorting_not_injective_if_nonfixed {m} (T : Symmetry m) (k : BoundedEnvelope m)
    (different : T.command k ≠ k) : ¬Function.Injective (sortCommand (m := m)) := by
  intro inj
  exact different (inj (sorting_collapses_a_nonfixed_pair T k))

-- All fields omitted by record-update syntax remain exactly equal.
theorem full_unchanged_fields {m} (T : Symmetry m) (C : SharedAlias.State (interface m)) :
    (state T C).epoch = C.epoch ∧ (state T C).pending = C.pending ∧
    (state T C).acks = C.acks ∧ (state T C).certificates = C.certificates ∧
    (state T C).plant = C.plant := ⟨rfl,rfl,rfl,rfl,rfl⟩

theorem full_root_fields {m} (T : Symmetry m) (z : RootState (interface m)) :
    (root T z).descriptor = z.descriptor ∧ (root T z).revoked = z.revoked ∧
    (∀ k, T.command k ∈ (root T z).commitments ↔ k ∈ z.commitments) ∧
    (∀ k, T.command k ∈ (root T z).cancelled ↔ k ∈ z.cancelled) := by
  exact ⟨rfl, rfl, fun _ => mem_memory_command T _ _, fun _ => mem_memory_command T _ _⟩

theorem effect_exact {m} (T : Symmetry m) (p : ComposedExecution.Plant) (k : BoundedEnvelope m) :
    (interface m).effect p (T.command k) = (interface m).effect p k := T.successor k

theorem traces_keep_positions {m} (T : Symmetry m) (a b : Event (interface m))
    (rest : List (Event (interface m))) :
    (a :: b :: rest).map (event T) = event T a :: event T b :: rest.map (event T) := rfl

theorem corrupt_payload_and_order {m} (T : Symmetry m) (i : Fin m)
    (z : RootState (interface m)) (k : BoundedEnvelope m) (who : String) (t : Nat) :
    ([Event.corrupt i z, Event.prepare i k who t, Event.close k]).map (event T) =
    [Event.corrupt i (root T z), Event.prepare i (T.command k) who t, Event.close (T.command k)] := rfl

-- Same-state close-event legality changes when only the command key is swapped.
theorem close_iff_key_quorum {m} (E : Environment (interface m))
    (C : SharedAlias.State (interface m)) (k : BoundedEnvelope m) :
    SharedAlias.Step E C (.close k) C ↔ E.labelBudget < (C.cancelAcks k).card := by
  constructor
  · intro h; cases h; assumption
  · exact SharedAlias.Step.close C k

theorem unchanged_state_close_failure {m} (T : Symmetry m) (E : Environment (interface m))
    (C : SharedAlias.State (interface m)) (k : BoundedEnvelope m) (different : T.command k ≠ k)
    (qs : Finset (Fin m)) (enough : E.labelBudget < qs.card) :
    let D : SharedAlias.State (interface m) :=
      { C with cancelAcks := Function.update (fun _ => ∅) k qs }
    SharedAlias.Step E D (.close k) D ∧ ¬SharedAlias.Step E D (.close (T.command k)) D := by
  dsimp
  rw [close_iff_key_quorum, close_iff_key_quorum]
  simpa [Function.update_apply, different] using enough

-- Exact false and true source results, with arbitrary rather than reachable states.
theorem withholding_preserved {m} (A : Profile m) (E : Environment (interface m))
    (C : SharedAlias.State (interface m)) (k : BoundedEnvelope m) (who : String) (t : Nat) :
    Progress.applied E (state (profileSymmetry A) C) (selected A k) who t false =
    Progress.applied E C k who t false := applied_eq (profileSymmetry A) E C k who t false

theorem opening_preserved {m} (A : Profile m) (E : Environment (interface m))
    (C : SharedAlias.State (interface m)) (k : BoundedEnvelope m) (who : String) (t : Nat) :
    Progress.applied E (state (profileSymmetry A) C) (selected A k) who t true =
    Progress.applied E C k who t true := applied_eq (profileSymmetry A) E C k who t true

end
end TransportIndependentReview
import IndependentTemplateControls
namespace IndependentRuleMapReview
open Encodable CodedRuleTemplates P01D P01AC JointCertificates AuxiliaryCertificates OrthemologyV2
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000
example : motiveAtCode (encode (Ty.all (.identity .raw (.var 0) (.var 1)))) (encode (Poly.var 3)) (encode (Poly.var 4)) = encode (Ty.all (.identity .raw (.var 5) (.var 4))) := by
  rw [motiveAtCode_exact]; apply congrArg encode; decide
end IndependentRuleMapReview
import Candidates

/-! Height induction for the actual synchronous numeric recurrence. -/
namespace GuardedTree.Saturation
open Tree
variable {J E R : Type*} [DecidableEq E] (G : Grammar J E R) [Fintype R]

noncomputable def round : ℕ → Table (J := J) (E := E)
  | 0 => fun _ _ => none
  | h + 1 => step G (round h)

/-- Sound entries have actual bounded witnesses. Every bounded proof has a
reachable entry no dearer than that proof. Together these are exact minima. -/
def Correct (D : Table (J := J) (E := E)) (h : ℕ) : Prop :=
  (∀ q S c, D q S = some c →
    ∃ t : Tree G, Bounded G h t ∧ Valid G t ∧
      judgement G t = q ∧ support G t = S ∧ cost G t = c) ∧
  (∀ t : Tree G, Bounded G h t → Valid G t →
    ∃ c, D (judgement G t) (support G t) = some c ∧ c ≤ cost G t)

omit [DecidableEq E] [Fintype R] in
theorem bounded_mono {h k : ℕ} (hk : h ≤ k) {t : Tree G}
    (ht : Bounded G h t) : Bounded G k t :=
  fun p hp => (ht p hp).trans hk

omit [DecidableEq E] [Fintype R] in
theorem bounded_node (h : ℕ) (r : R) (child : Fin (G.arity r) → Tree G)
    (hc : ∀ i, Bounded G h (child i)) : Bounded G (h + 1) (.node r child) := by
  intro p hp
  cases hp with
  | root => simp
  | down _ _ i p hp => exact Nat.succ_le_succ (hc i p hp)

omit [DecidableEq E] [Fintype R] in
theorem bounded_child (h : ℕ) (r : R) (child : Fin (G.arity r) → Tree G)
    (hb : Bounded G (h + 1) (.node r child)) (i : Fin (G.arity r)) :
    Bounded G h (child i) := by
  intro p hp
  exact Nat.le_of_succ_le_succ (hb (.node r child :: p) (.down r child i p hp))

/-- Each price candidate, including a retained old price, has a real bounded
witness. Rule candidates assemble witnesses with equal ordered supports. -/
theorem candidate_sound (h : ℕ) (D : Table (J := J) (E := E))
    (hD : Correct G D h) (q : J) (S : Finset E) (c : ℚ)
    (hc : c ∈ candidates G D q S) :
    ∃ t : Tree G, Bounded G (h + 1) t ∧ Valid G t ∧
      judgement G t = q ∧ support G t = S ∧ cost G t = c := by
  classical
  rcases (mem_candidates_iff G D q S c).mp hc with hold | hnew
  · obtain ⟨t, hb, hv, hq, hs, hp⟩ := hD.1 q S c hold
    exact ⟨t, bounded_mono G (Nat.le_succ h) hb, hv, hq, hs, hp⟩
  · obtain ⟨r, s, p, _, hp, hg, hq, hs, hc⟩ := hnew
    choose child hb hv hj hsup hcost using
      (fun i => hD.1 (G.premise r i) (s i) (p i) (hp i))
    have heq : (fun i => support G (child i)) = s := funext hsup
    refine ⟨.node r child, bounded_node G h r child hb,
      ⟨fun i => ⟨hv i, hj i⟩, ?_⟩, hq, ?_, ?_⟩
    · simpa only [heq] using hg
    · simpa only [support, heq] using hs
    · simpa only [cost, hcost] using hc

/-- For every height-(h+1) tree, the actual generator has a no-dearer candidate.
This substitutes least-price children at exactly their old supports. -/
theorem candidate_complete (h : ℕ) (D : Table (J := J) (E := E))
    (hD : Correct G D h) (t : Tree G) (hb : Bounded G (h + 1) t)
    (hv : Valid G t) :
    ∃ c ∈ candidates G D (judgement G t) (support G t), c ≤ cost G t := by
  classical
  cases t with
  | node r child =>
    choose p hp hle using (fun i => hD.2 (child i)
      (bounded_child G h r child hb i) (hv.1 i).1)
    refine ⟨G.price r + ∑ i, p i, ?_, ?_⟩
    · apply (mem_candidates_iff G D _ _ _).mpr
      refine Or.inr ⟨r, fun i => support G (child i), p,
        fun i => support_subset_grammarSupport G (child i), ?_, hv.2, rfl, rfl, rfl⟩
      intro i
      simpa only [(hv.1 i).2] using hp i
    · exact add_le_add_left (Finset.sum_le_sum (fun i _ => hle i)) _

theorem step_correct (h : ℕ) (D : Table (J := J) (E := E))
    (hD : Correct G D h) : Correct G (step G D) (h + 1) := by
  constructor
  · intro q S c hc
    exact candidate_sound G h D hD q S c ((step_some_iff G D q S c).mp hc).1
  · intro t hb hv
    obtain ⟨c, hc, hle⟩ := candidate_complete G h D hD t hb hv
    obtain ⟨d, hd, hdc⟩ := minimum_le (candidates G D (judgement G t) (support G t)) c hc
    exact ⟨d, hd, hdc.trans hle⟩

/-- Proved by height induction from an all-unreachable numeric table. The
recurrence is not defined as a minimum over bounded trees. -/
theorem round_correct (h : ℕ) : Correct G (round G h) h := by
  induction h with
  | zero =>
    constructor
    · intro q S c hc
      simp [round] at hc
    · intro t hb _
      have hz := hb [t] (.root t)
      simp at hz
  | succ h ih => exact step_correct G h (round G h) ih

/-- Exact bounded-height minimum semantics, including a realizing witness. -/
theorem round_some_iff (h : ℕ) (q : J) (S : Finset E) (c : ℚ) :
    round G h q S = some c ↔
      (∃ t : Tree G, Bounded G h t ∧ Valid G t ∧
        judgement G t = q ∧ support G t = S ∧ cost G t = c) ∧
      (∀ t : Tree G, Bounded G h t → Valid G t →
        judgement G t = q → support G t = S → c ≤ cost G t) := by
  constructor
  · intro hc
    refine ⟨(round_correct G h).1 q S c hc, ?_⟩
    intro t hb hv hq hs
    obtain ⟨d, hd, hle⟩ := (round_correct G h).2 t hb hv
    rw [hq, hs, hc] at hd
    exact Option.some.inj hd ▸ hle
  · rintro ⟨⟨t, hb, hv, hq, hs, hp⟩, hmin⟩
    obtain ⟨d, hd, hle⟩ := (round_correct G h).2 t hb hv
    rw [hq, hs] at hd
    obtain ⟨u, hub, huv, huq, hus, hup⟩ := (round_correct G h).1 q S d hd
    have hcd : c ≤ d := by simpa only [hup] using hmin u hub huv huq hus
    have hdc : d ≤ c := by simpa only [hp] using hle
    exact (le_antisymm hdc hcd) ▸ hd

/-- No entry is equivalent to no valid tree below this round's height. -/
theorem round_none_iff (h : ℕ) (q : J) (S : Finset E) :
    round G h q S = none ↔
      ¬ ∃ t : Tree G, Bounded G h t ∧ Valid G t ∧
        judgement G t = q ∧ support G t = S := by
  constructor
  · intro hn ⟨t, hb, hv, hq, hs⟩
    obtain ⟨c, hc, _⟩ := (round_correct G h).2 t hb hv
    rw [hq, hs, hn] at hc
    contradiction
  · intro hnone
    cases hc : round G h q S with
    | none => rfl
    | some c =>
      obtain ⟨t, hb, hv, hq, hs, _⟩ := (round_correct G h).1 q S c hc
      exact False.elim (hnone ⟨t, hb, hv, hq, hs⟩)

#print axioms round_correct
#print axioms round_some_iff
#print axioms round_none_iff
end GuardedTree.Saturation
import CoveringPortfolio

/-! Adaptive opaque search at the fixed prepared-family interface.
A policy may inspect the entire selected-path/observation history. The only
restriction used for the lower bound is a world-independent failed macro reply.
The reply can contain preparation, cancellation, all allowed timings and nonce.
The physical success predicate is explicitly disjointness from the bad set. -/
namespace CoveringKernel
open Finset
variable {α : Type*} [Fintype α] [DecidableEq α]

abbrev Path (F : Finset (Finset α)) := {P : Finset α // P ∈ F}
abbrev Policy (F : Finset (Finset α)) (O : Type*) :=
  List (Path F × O) → Path F

/-- New attempts have a fresh ordinal n. Histories contain full selected paths
and replies; extending after success is harmless because the cap tests the first hit. -/
def history {F : Finset (Finset α)} {O : Type*} (π : Policy F O)
    (reply : ℕ → Path F → O) : ℕ → List (Path F × O)
  | 0 => []
  | n+1 => let h := history π reply n; (π h, reply n (π h)) :: h

def spine {F : Finset (Finset α)} {O : Type*} (π : Policy F O)
    (failedReply : ℕ → Path F → O) (n : ℕ) : Path F :=
  π (history π failedReply n)

def spinePortfolio {F : Finset (Finset α)} {O : Type*} (π : Policy F O)
    (failedReply : ℕ → Path F → O) (N : ℕ) : Finset (Finset α) :=
  (range N).image (fun i => (spine π failedReply i).val)

/-- Homogeneity is only required on failed paths in candidate maximal worlds.
It does not restrict the reply produced by a successful attempt. -/
def Opaque {F : Finset (Finset α)} {O : Type*} (k : ℕ)
    (observe : Finset α → ℕ → Path F → O) (failedReply : ℕ → Path F → O) : Prop :=
  ∀ T, T.card = k → ∀ n P, ¬Disjoint P.val T → observe T n P = failedReply n P

def SuccessWithin {F : Finset (Finset α)} {O : Type*} (π : Policy F O)
    (observe : Finset α → ℕ → Path F → O) (T : Finset α) (N : ℕ) : Prop :=
  ∃ i < N, Disjoint (π (history π (observe T) i)).val T

omit [Fintype α] [DecidableEq α] in
theorem history_length {F : Finset (Finset α)} {O : Type*} (π : Policy F O)
    (reply : ℕ → Path F → O) (n : ℕ) : (history π reply n).length = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [history, ih]

omit [Fintype α] [DecidableEq α] in
theorem common_history_of_spine_failure {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (T : Finset α)
    (hop : ∀ n P, ¬Disjoint P.val T → observe T n P = failedReply n P)
    (N : ℕ) (hbad : ∀ i < N, ¬Disjoint (spine π failedReply i).val T) :
    history π (observe T) N = history π failedReply N := by
  induction N with
  | zero => rfl
  | succ N ih =>
    have heq := ih (fun i hi => hbad i (by omega))
    simp only [history, heq]
    have hr := hop N _ (hbad N (by omega))
    change observe T N (π (history π failedReply N)) = _ at hr
    rw [hr]
    rfl

omit [Fintype α] [DecidableEq α] in
theorem common_history_of_actual_failure {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (T : Finset α)
    (hop : ∀ n P, ¬Disjoint P.val T → observe T n P = failedReply n P)
    (N : ℕ) (hbad : ∀ i < N,
      ¬Disjoint (π (history π (observe T) i)).val T) :
    history π (observe T) N = history π failedReply N := by
  induction N with
  | zero => rfl
  | succ N ih =>
    have heq := ih (fun i hi => hbad i (by omega))
    simp only [history]
    rw [hop N _ (hbad N (by omega)), heq]

omit [Fintype α] in
theorem successWithin_iff_spine {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (T : Finset α)
    (hop : ∀ n P, ¬Disjoint P.val T → observe T n P = failedReply n P)
    (N : ℕ) :
    SuccessWithin π observe T N ↔ ∃ P ∈ spinePortfolio π failedReply N, Disjoint P T := by
  classical
  constructor
  · intro hs
    by_contra hn
    have hbad : ∀ i < N, ¬Disjoint (spine π failedReply i).val T := by
      intro i hi hd
      exact hn ⟨_, mem_image.mpr ⟨i, mem_range.mpr hi, rfl⟩, hd⟩
    obtain ⟨i, hi, hd⟩ := hs
    have heq := common_history_of_spine_failure π observe failedReply T hop i
      (fun j hj => hbad j (by omega))
    rw [heq] at hd
    exact hbad i hi hd
  · intro hs
    by_contra hn
    have hbad : ∀ i < N, ¬Disjoint (π (history π (observe T) i)).val T := by
      intro i hi hd
      exact hn ⟨i, hi, hd⟩
    obtain ⟨P, hP, hd⟩ := hs
    obtain ⟨i, hi, rfl⟩ := mem_image.mp hP
    have hiN := mem_range.mp hi
    have heq := common_history_of_actual_failure π observe failedReply T hop i
      (fun j hj => hbad j (by omega))
    apply hbad i hiN
    simpa [heq, spine] using hd

omit [Fintype α] in
theorem cap_iff_spine_available {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (k N : ℕ) (hop : Opaque k observe failedReply) :
    (∀ T : Finset α, T.card = k → SuccessWithin π observe T N) ↔
      Available k (spinePortfolio π failedReply N) := by
  constructor
  · intro h T hT
    exact (successWithin_iff_spine π observe failedReply T (hop T hT) N).mp (h T hT)
  · intro h T hT
    exact (successWithin_iff_spine π observe failedReply T (hop T hT) N).mpr (h T hT)

omit [Fintype α] in
theorem spinePortfolio_uniform {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (failedReply : ℕ → Path F → O) (q N : ℕ)
    (hu : Uniform q F) : Uniform q (spinePortfolio π failedReply N) := by
  intro P hP
  obtain ⟨i, _, rfl⟩ := mem_image.mp hP
  exact hu _ (spine π failedReply i).property

omit [Fintype α] in
theorem spinePortfolio_card_le {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (failedReply : ℕ → Path F → O) (N : ℕ) :
    (spinePortfolio π failedReply N).card ≤ N := by
  simpa [spinePortfolio] using card_image_le (s := range N)
    (f := fun i => (spine π failedReply i).val)

theorem deterministic_cap_lower_bound {F : Finset (Finset α)} {O : Type*}
    (π : Policy F O) (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (q k N : ℕ)
    (hu : Uniform q F) (hop : Opaque k observe failedReply)
    (hcap : ∀ T : Finset α, T.card = k → SuccessWithin π observe T N) :
    coveringNumber α (Fintype.card α-q) k < N := by
  have hav := (cap_iff_spine_available π observe failedReply k N hop).mp hcap
  exact (coveringNumber_le_portfolio_card q k _
    (spinePortfolio_uniform π failedReply q N hu) hav).trans
      (spinePortfolio_card_le π failedReply N)

/- An available family is nonempty whenever maximal worlds exist. -/
omit [DecidableEq α] in
theorem available_nonempty (k : ℕ) (F : Finset (Finset α))
    (hk : k ≤ Fintype.card α) (ha : Available k F) : F.Nonempty := by
  obtain ⟨T, _, hT⟩ := exists_subset_card_eq
    (show k ≤ (univ : Finset α).card by simpa using hk)
  obtain ⟨P, hP, _⟩ := ha T hT
  exact ⟨P, hP⟩

/-- A prepared portfolio is enumerated once, then repeats an arbitrary member.
This policy has no access to the bad set and ignores all observations. -/
noncomputable def enumeratePolicy (F : Finset (Finset α)) (hne : F.Nonempty)
    (O : Type*) : Policy F O := fun h =>
  if hi : h.length < F.card then F.equivFin.symm ⟨h.length, hi⟩
  else ⟨hne.choose, hne.choose_spec⟩

omit [Fintype α] [DecidableEq α] in
theorem enumeratePolicy_at (F : Finset (Finset α)) (hne : F.Nonempty)
    {O : Type*} (reply : ℕ → Path F → O) (i : Fin F.card) :
    enumeratePolicy F hne O (history (enumeratePolicy F hne O) reply i.val) =
      F.equivFin.symm i := by
  simp [enumeratePolicy, history_length, i.isLt]

omit [Fintype α] [DecidableEq α] in
theorem enumerating_policy_hit (F : Finset (Finset α))
    (hne : F.Nonempty) {O : Type*} (observe : Finset α → ℕ → Path F → O)
    (T : Finset α) (hhit : ∃ P ∈ F, Disjoint P T) :
    SuccessWithin (enumeratePolicy F hne O) observe T F.card := by
  obtain ⟨P, hP, hd⟩ := hhit
  let i : Fin F.card := F.equivFin ⟨P, hP⟩
  refine ⟨i.val, i.isLt, ?_⟩
  rw [enumeratePolicy_at F hne (observe T) i]
  simpa [i] using hd

omit [Fintype α] [DecidableEq α] in
theorem enumerating_policy_cap (k : ℕ) (F : Finset (Finset α))
    (hne : F.Nonempty) (ha : Available k F) {O : Type*}
    (observe : Finset α → ℕ → Path F → O) :
    ∀ T : Finset α, T.card = k →
      SuccessWithin (enumeratePolicy F hne O) observe T F.card := by
  intro T hT
  obtain ⟨P, hP, hd⟩ := ha T hT
  let i : Fin F.card := F.equivFin ⟨P, hP⟩
  refine ⟨i.val, i.isLt, ?_⟩
  rw [enumeratePolicy_at F hne (observe T) i]
  simpa [i] using hd

/-- The covering number is attained by a fixed finite prepared family and a
non-adaptive enumeration, independently of what observations successes return. -/
theorem deterministic_cap_attained (q k : ℕ) (hq : q ≤ Fintype.card α)
    (hk : k ≤ Fintype.card α-q) (O : Type*) :
    ∃ F : Finset (Finset α), Uniform q F ∧
      ∃ π : Policy F O, ∀ observe : Finset α → ℕ → Path F → O,
        ∀ T : Finset α, T.card = k →
          SuccessWithin π observe T (coveringNumber α (Fintype.card α-q) k) := by
  obtain ⟨F, hu, ha, hsize⟩ := minimal_portfolio_attained q k hq hk
  have hne := available_nonempty k F (by omega) ha
  refine ⟨F, hu, enumeratePolicy F hne O, ?_⟩
  intro observe T hT
  rw [← hsize]
  exact enumerating_policy_cap k F hne ha observe T hT

/-- At q=m-k each block is a k-set; no block can cover two distinct maximal worlds. -/
theorem complementary_threshold_exact_cap (k : ℕ) (hk : k ≤ Fintype.card α) :
    coveringNumber α (Fintype.card α-(Fintype.card α-k)) k =
      (Fintype.card α).choose k := by
  rw [Nat.sub_sub_self hk]
  exact coveringNumber_self k hk

/-- Accepted minimum-label specialization, m=3k+1 and q=2k+1. -/
theorem minimum_labels_exact_cap (k : ℕ) (hm : Fintype.card α = 3*k+1) :
    coveringNumber α (Fintype.card α-(2*k+1)) k = (3*k+1).choose k := by
  have hb : Fintype.card α-(2*k+1) = k := by omega
  rw [hb, coveringNumber_self k (by omega), hm]

#print axioms successWithin_iff_spine
#print axioms cap_iff_spine_available
#print axioms deterministic_cap_lower_bound
#print axioms deterministic_cap_attained
#print axioms minimum_labels_exact_cap
end CoveringKernel
/- Capture avoidance for both type parameters and raw term indices. -/
import P01DependentModel
namespace P01DF
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01F (cons)

def renameType (r : Nat → Nat) : Ty → Ty
  | .param n => .param (r n)
  | .bottom => .bottom
  | .raw => .raw
  | .identity p q => .identity p q
  | .arrow A B => .arrow (renameType r A) (renameType r B)
  | .pi B => .pi (renameType r B)
  | .sigma B => .sigma (renameType r B)
  | .all B => .all (renameType (liftRen r) B)

theorem piModel_congr {B C : Term → Model}
    {hb : ∀ {x y}, Conv x y → B x = B y}
    {hc : ∀ {x y}, Conv x y → C x = C y} (h : ∀ x, B x = C x) :
    piModel B hb = piModel C hc := by
  have e : B = C := funext h
  cases e; rfl

theorem sigmaModel_congr {B C : Term → Model}
    {hb : ∀ {x y}, Conv x y → B x = B y}
    {hc : ∀ {x y}, Conv x y → C x = C y} (h : ∀ x, B x = C x) :
    sigmaModel B hb = sigmaModel C hc := by
  have e : B = C := funext h
  cases e; rfl

theorem piModel_rename (B : Term → Model) (h : ∀ {x y}, Conv x y → B x = B y)
    (r : Nat → Nat) :
    piModel (fun x => (B x).rename r) (fun e => congrArg (fun M : Model => M.rename r) (h e)) =
      (piModel B h).rename r := rfl

theorem sigmaModel_rename (B : Term → Model) (h : ∀ {x y}, Conv x y → B x = B y)
    (r : Nat → Nat) :
    sigmaModel (fun x => (B x).rename r) (fun e => congrArg (fun M : Model => M.rename r) (h e)) =
      (sigmaModel B h).rename r := rfl

theorem interpret_type_rename (A : Ty) (r : Nat → Nat) (η : Env) :
    (interpret (renameType r A)).run η = ((interpret A).run η).rename r := by
  induction A generalizing r η with
  | param n => rfl
  | bottom => rfl
  | raw => rfl
  | identity p q => rfl
  | arrow A B ha hb =>
      change arrowModel _ _ = _
      rw [ha,hb]; rfl
  | pi B ih =>
      change piModel (fun x => (interpret (renameType r B)).run (cons x η))
        (fun h => (interpret (renameType r B)).coherent (index_cons (index_refl η) h)) = _
      apply Eq.trans ?_ (piModel_rename (fun x => (interpret B).run (cons x η))
        (fun h => (interpret B).coherent (index_cons (index_refl η) h)) r)
      exact piModel_congr (fun x => ih r (cons x η))
  | sigma B ih =>
      change sigmaModel (fun x => (interpret (renameType r B)).run (cons x η))
        (fun h => (interpret (renameType r B)).coherent (index_cons (index_refl η) h)) = _
      apply Eq.trans ?_ (sigmaModel_rename (fun x => (interpret B).run (cons x η))
        (fun h => (interpret B).coherent (index_cons (index_refl η) h)) r)
      exact sigmaModel_congr (fun x => ih r (cons x η))
  | all B ih =>
      change allModel _ = _
      rw [ih]
      exact rename_all _ r

def liftTypes (σ : Nat → Ty) : Nat → Ty
  | 0 => .param 0
  | n+1 => renameType Nat.succ (σ n)

def liftIndices (σ : Nat → Ty) : Nat → Ty :=
  fun n => σ n

def substType (σ : Nat → Ty) : Ty → Ty
  | .param n => σ n
  | .bottom => .bottom
  | .raw => .raw
  | .identity p q => .identity p q
  | .arrow A B => .arrow (substType σ A) (substType σ B)
  | .pi B => .pi (substType (liftIndices σ) B)
  | .sigma B => .sigma (substType (liftIndices σ) B)
  | .all B => .all (substType (liftTypes σ) B)

theorem interpret_liftTypes (σ : Nat → Ty) (η : Env) :
    (fun n => (interpret (liftTypes σ n)).run η) =
      liftModels (fun n => (interpret (σ n)).run η) := by
  funext n; cases n with
  | zero => rfl
  | succ n => exact interpret_type_rename _ _ _

theorem interpret_liftIndices (σ : Nat → Ty) (η : Env) (x : Term) :
    (fun n => (interpret (liftIndices σ n)).run (cons x η)) =
      (fun n => (interpret (σ n)).run η) := by
  funext n
  rw [liftIndices,interpret_index_substitution]
  rfl

theorem piModel_substitute (B : Term → Model) (h : ∀ {x y}, Conv x y → B x = B y)
    (σ : Nat → Model) :
    piModel (fun x => (B x).substitute σ)
      (fun e => congrArg (fun M : Model => M.substitute σ) (h e)) =
      (piModel B h).substitute σ := rfl

theorem sigmaModel_substitute (B : Term → Model) (h : ∀ {x y}, Conv x y → B x = B y)
    (σ : Nat → Model) :
    sigmaModel (fun x => (B x).substitute σ)
      (fun e => congrArg (fun M : Model => M.substitute σ) (h e)) =
      (sigmaModel B h).substitute σ := rfl

/-- Substitution of arbitrary dependent types for parameters. Passing through
    an index binder shifts free term indices in every substituted type; passing
    through All shifts its free type parameters. -/
theorem interpret_type_substitution (A : Ty) (σ : Nat → Ty) (η : Env) :
    (interpret (substType σ A)).run η =
      ((interpret A).run η).substitute (fun n => (interpret (σ n)).run η) := by
  induction A generalizing σ η with
  | param n => rfl
  | bottom => rfl
  | raw => rfl
  | identity p q => rfl
  | arrow A B ha hb =>
      change arrowModel _ _ = _
      rw [ha,hb]; rfl
  | pi B ih =>
      change piModel (fun x => (interpret (substType (liftIndices σ) B)).run (cons x η))
        (fun h => (interpret (substType (liftIndices σ) B)).coherent (index_cons (index_refl η) h)) = _
      apply Eq.trans ?_ (piModel_substitute (fun x => (interpret B).run (cons x η))
        (fun h => (interpret B).coherent (index_cons (index_refl η) h))
        (fun n => (interpret (σ n)).run η))
      apply piModel_congr
      intro x
      rw [ih,interpret_liftIndices]
  | sigma B ih =>
      change sigmaModel (fun x => (interpret (substType (liftIndices σ) B)).run (cons x η))
        (fun h => (interpret (substType (liftIndices σ) B)).coherent (index_cons (index_refl η) h)) = _
      apply Eq.trans ?_ (sigmaModel_substitute (fun x => (interpret B).run (cons x η))
        (fun h => (interpret B).coherent (index_cons (index_refl η) h))
        (fun n => (interpret (σ n)).run η))
      apply sigmaModel_congr
      intro x
      rw [ih,interpret_liftIndices]
  | all B ih =>
      change allModel _ = _
      rw [ih,interpret_liftTypes]
      exact substitute_all _ _

def instantiateType (B A : Ty) : Ty := substType (cons A Ty.param) B

theorem interpret_type_instantiate (B A : Ty) (η : Env) :
    (interpret (instantiateType B A)).run η =
      ((interpret B).run η).substitute (cons ((interpret A).run η) varModel) := by
  rw [instantiateType,interpret_type_substitution]
  congr 1
  funext n; cases n <;> rfl

theorem type_instantiate_rel (B A : Ty) (η : Env) (r : REnv) (t u : Term) :
    ((interpret (instantiateType B A)).run η).rel r t u ↔
      ((interpret B).run η).rel (extendEnv (((interpret A).run η).asLink r) r) t u := by
  rw [interpret_type_instantiate]
  change ((interpret B).run η).rel (r.substitute (cons ((interpret A).run η) varModel)) t u ↔ _
  rw [single_rel_environment]

theorem type_instantiate_obj (B A : Ty) (η : Env) (ρ : OEnv) :
    ((interpret (instantiateType B A)).run η).obj ρ =
      ((interpret B).run η).obj (cons (((interpret A).run η).obj ρ) ρ) := by
  rw [interpret_type_instantiate]
  exact congrArg ((interpret B).run η).obj (single_obj_environment ((interpret A).run η) ρ)

end P01DF
import NativeExecutionData
namespace EntryRed
open SharedAlias.Native ComposedExecution
def laterActor : Actor := ⟨OperationalJoin.Typed.Examples.source 1, Concrete.installed, "A", 23, 2000⟩
def repairAction : Action := .repair OperationalJoin.Typed.Examples.repairCommand
#eval do
  if !(orderedProgram laterActor repairAction sevenOrderedPaths).isSome then
    throw (IO.userError "SETUP: expected valid epoch-one proposal")
  if !(runInitial Executed.worstRouting laterActor repairAction sevenOrderedPaths Executed.withholding).isSome then
    throw (IO.userError "EXPECTED RED: accepted entry rejects valid epoch-one repair")
end EntryRed
import Attainment
import CertificateFrontier

/-! Bridge to the inherited terminal support/cost frontier. All support-sensitive
guards have already been discharged in the represented valid trees. -/
namespace GuardedTree
variable {J E R : Type*} [DecidableEq E] [Fintype J] [Fintype R]
    (G : Grammar J E R)
open Tree

/-- Each terminal pair is backed by an actual valid bounded tree, separately
for its scoped judgement. It is not supplied as an admitted catalogue. -/
noncomputable def terminalCatalogue (q : J) : Finset (CertificateFrontier.Pair E ℚ) := by
  classical
  exact ((validCatalogue G).filter (fun t => judgement G t = q)).image
    (fun t => (support G t, cost G t))

theorem mem_terminalCatalogue_iff (q : J) (p : CertificateFrontier.Pair E ℚ) :
    p ∈ terminalCatalogue G q ↔
      ∃ t ∈ validCatalogue G, judgement G t = q ∧
        support G t = p.1 ∧ cost G t = p.2 := by
  classical
  constructor
  · intro hp
    obtain ⟨t, ht, heq⟩ := Finset.mem_image.mp hp
    obtain ⟨hm, hq⟩ := Finset.mem_filter.mp ht
    exact ⟨t, hm, hq, congrArg Prod.fst heq, congrArg Prod.snd heq⟩
  · rintro ⟨t, ht, hq, hs, hc⟩
    exact Finset.mem_image.mpr ⟨t, Finset.mem_filter.mpr ⟨ht, hq⟩,
      Prod.ext hs hc⟩

/-- Exact agreement between the finite terminal cost observation and existence
of an unrestricted finite valid proof under a finite price threshold. -/
theorem terminal_cost_le_iff (hw : ∀ r, 0 ≤ G.price r)
    (q : J) (U : Finset E) (c : ℚ) :
    CertificateFrontier.cost (terminalCatalogue G q) U ≤ (c : WithTop ℚ) ↔
      ∃ t : Tree G, Valid G t ∧ judgement G t = q ∧
        support G t ⊆ U ∧ cost G t ≤ c := by
  rw [CertificateFrontier.cost_le_iff]
  constructor
  · rintro ⟨p, hp, hsub, hc⟩
    obtain ⟨t, ht, hq, hs, hcost⟩ := (mem_terminalCatalogue_iff G q p).mp hp
    exact ⟨t, ((mem_validCatalogue_iff G t).mp ht).2, hq,
      hs ▸ hsub, hcost ▸ hc⟩
  · rintro ⟨t, ht, hq, hsub, hc⟩
    obtain ⟨u, hu, hqu, hsu, hcu⟩ := validCatalogue_cover G hw t ht
    refine ⟨(support G u, cost G u), ?_, ?_, hcu.trans hc⟩
    · exact (mem_terminalCatalogue_iff G q _).mpr ⟨u, hu, hqu.trans hq, rfl, rfl⟩
    · exact hsu ▸ hsub

/-- Every retained Pareto pair still has an actual original tree witness.
This is an existence theorem, not an extracted reconstruction algorithm. -/
theorem terminal_frontier_witness (q : J) (p : CertificateFrontier.Pair E ℚ)
    (hp : p ∈ CertificateFrontier.frontier (terminalCatalogue G q)) :
    ∃ t ∈ validCatalogue G, Valid G t ∧ judgement G t = q ∧
      support G t = p.1 ∧ cost G t = p.2 := by
  obtain ⟨t, ht, hq, hs, hc⟩ := (mem_terminalCatalogue_iff G q p).mp
    (CertificateFrontier.frontier_subset _ hp)
  exact ⟨t, ht, ((mem_validCatalogue_iff G t).mp ht).2, hq, hs, hc⟩

/-- An available terminal proof has an attained least price across all its
eligible exact supports, not just among trees of one chosen support. -/
theorem terminal_minimum_when_reachable (hw : ∀ r, 0 ≤ G.price r)
    (q : J) (U : Finset E)
    (hex : ∃ t : Tree G, Valid G t ∧ judgement G t = q ∧ support G t ⊆ U) :
    ∃ u ∈ validCatalogue G, Valid G u ∧ judgement G u = q ∧ support G u ⊆ U ∧
      CertificateFrontier.cost (terminalCatalogue G q) U = (cost G u : WithTop ℚ) ∧
      ∀ t : Tree G, Valid G t → judgement G t = q → support G t ⊆ U →
        cost G u ≤ cost G t := by
  classical
  let A := (validCatalogue G).filter (fun t => judgement G t = q ∧ support G t ⊆ U)
  have hA : A.Nonempty := by
    obtain ⟨t, ht, hq, hs⟩ := hex
    obtain ⟨u, hu, hqu, hsu, _⟩ := validCatalogue_cover G hw t ht
    exact ⟨u, Finset.mem_filter.mpr ⟨hu, hqu.trans hq, hsu ▸ hs⟩⟩
  obtain ⟨u, hu, hmin⟩ := Finset.exists_min_image A (cost G) hA
  obtain ⟨hum, huq, hus⟩ := Finset.mem_filter.mp hu
  have huv := ((mem_validCatalogue_iff G u).mp hum).2
  have hglobal : ∀ t : Tree G, Valid G t → judgement G t = q → support G t ⊆ U →
      cost G u ≤ cost G t := by
    intro t ht hq hs
    obtain ⟨v, hv, hvq, hvs, hvc⟩ := validCatalogue_cover G hw t ht
    exact (hmin v (Finset.mem_filter.mpr ⟨hv, hvq.trans hq, hvs ▸ hs⟩)).trans hvc
  refine ⟨u, hum, huv, huq, hus, ?_, hglobal⟩
  apply le_antisymm
  · exact (terminal_cost_le_iff G hw q U _).mpr ⟨u, huv, huq, hus, le_rfl⟩
  · apply Finset.le_inf
    intro p hp
    by_cases hsub : p.1 ⊆ U
    · simp only [if_pos hsub, WithTop.coe_le_coe]
      obtain ⟨t, ht, hq, hs, hc⟩ := (mem_terminalCatalogue_iff G q p).mp hp
      rw [← hc]
      exact hglobal t ((mem_validCatalogue_iff G t).mp ht).2 hq (hs ▸ hsub)
    · simp only [if_neg hsub]
      exact le_top

/-- Future terminal feasibility/price is exactly recovered by the old checked
inventory frontier, now fed by a derived guarded-tree catalogue. -/
theorem inventory_frontier_cost_le_iff (hw : ∀ r, 0 ≤ G.price r)
    (q : J) (K U : Finset E) (c : ℚ) :
    CertificateFrontier.cost
      (CertificateFrontier.inventoryFrontier (terminalCatalogue G q) K) U ≤
        (c : WithTop ℚ) ↔
      ∃ t : Tree G, Valid G t ∧ judgement G t = q ∧
        support G t ⊆ K ∪ U ∧ cost G t ≤ c := by
  rw [CertificateFrontier.inventory_cost_recovery, CertificateFrontier.futureCost]
  exact terminal_cost_le_iff G hw q (K ∪ U) c

/-- A residual frontier pair retains an original tree witness; only its missing
support, not its original proof support, equals the residual pair support. -/
theorem inventory_frontier_witness (q : J) (K : Finset E)
    (p : CertificateFrontier.Pair E ℚ)
    (hp : p ∈ CertificateFrontier.inventoryFrontier (terminalCatalogue G q) K) :
    ∃ t ∈ validCatalogue G, Valid G t ∧ judgement G t = q ∧
      support G t \ K = p.1 ∧ cost G t = p.2 := by
  have hm := CertificateFrontier.frontier_subset
    (CertificateFrontier.residual (terminalCatalogue G q) K) hp
  obtain ⟨s, hs, heq⟩ := Finset.mem_image.mp hm
  obtain ⟨t, ht, hq, hsupport, hcost⟩ := (mem_terminalCatalogue_iff G q s).mp hs
  refine ⟨t, ht, ((mem_validCatalogue_iff G t).mp ht).2, hq, ?_, ?_⟩
  · exact (congrArg (fun x => x \ K) hsupport).trans (congrArg Prod.fst heq)
  · have hprice := congrArg (fun x : CertificateFrontier.Pair E ℚ => x.2) heq
    exact hcost.trans hprice

#print axioms terminal_cost_le_iff
#print axioms terminal_minimum_when_reachable
#print axioms terminal_frontier_witness
#print axioms inventory_frontier_cost_le_iff
#print axioms inventory_frontier_witness
end GuardedTree
import SourceCorrectionHistories
import Mathlib.Tactic.FinCases

namespace FiniteSidecar.Controls
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open JointCompletion (HasJ)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Accepted coarse state 0 has four support/price classes; rejected state 1 has two.
This is a declared finite operational example, not an actual-warrant assignment. -/
def withdrawA : Tables :=
  ⟨[[0,0,1,1],[0,0,0,0]], [[1,1,0,0],[1,1,1,1]], [[0,1,2,3],[0,1,0,1]]⟩
def costRows : List (List Nat) := [[1,9,1,9],[1,9,0,0]]
def currentRows : List (List Nat) := [[1,1,1,1],[0,0,0,0]]

theorem table_separates {z i j : Nat} (rows : List (List Nat))
    (h : tableValue rows 0 z i ≠ tableValue rows 0 z j) :
    ObservablyDifferent (encodeState z i) (encodeState z j) :=
  ⟨tableObserver rows, tableValue rows 0 z i, tableValue rows 0 z j,
    oldJ (tableObserver_has rows 0), tableObserver_observes rows 0 (encoded_represents z i),
    tableObserver_observes rows 0 (encoded_represents z j), h⟩

/-- Current accepted verdict alone does not distinguish the four classes. -/
theorem current_same (i : Fin 4) :
    NatObs (eval (.app (tableObserver currentRows) (encodeState 0 i.val)) zeroEnv) 1 := by
  have h := tableObserver_observes currentRows 0 (encoded_represents 0 i.val)
  fin_cases i <;> exact h

/-- The specified cost and withdrawal observers jointly require all four classes. -/
theorem four_required (i j : Fin 4) (hij : i ≠ j) :
    ObservablyDifferent (encodeState 0 i.val) (encodeState 0 j.val) := by
  fin_cases i <;> fin_cases j
  all_goals first
    | exact (hij rfl).elim
    | exact table_separates costRows (by decide)
    | exact table_separates withdrawA.branch (by decide)

/-- First two supporting classes are withdrawn; the other two retain accepted status. -/
example : (runCodes [withdrawA] 0 0) = ([0], (1,0)) := rfl
example : (runCodes [withdrawA] 0 1) = ([0], (1,1)) := rfl
example : (runCodes [withdrawA] 0 2) = ([1], (0,2)) := rfl
example : (runCodes [withdrawA] 0 3) = ([1], (0,3)) := rfl
example : (runCodes [withdrawA,withdrawA] 0 0) = ([0,0], (1,0)) := rfl

/-- These are literal source outputs, with source identities for each branch. -/
example : List.Forall₂ (fun b n => HasJ [] (.atom .i) (.identity N b (inputNumeral n)))
    (runSource [withdrawA,withdrawA] (encodeState 0 0)).1 [0,0] :=
  runSource_branch_identities [withdrawA,withdrawA] (encodeState_has 0 0) (encoded_represents 0 0)

/-- Reusing tag 0 across different retained coarse values remains distinguishable. -/
example : ¬ ∃ e, HasJ [] e (.identity State (encodeState 0 0) (encodeState 1 0)) := by
  rw [encoded_identity_iff]
  decide

/-- Two ordinary tags cannot encode four source-observable required states,
even if the proof terms are all chosen differently. -/
theorem two_tags_cannot_hide_four (tag : Fin 4 → Fin 2) (evidence : Fin 4 → Poly)
    (he : ∀ i, HasJ [] (evidence i) Evidence) :
    ¬ (∀ i j, i ≠ j → ObservablyDifferent
      (withEvidence 0 (tag i).val (evidence i))
      (withEvidence 0 (tag j).val (evidence j))) := by
  intro h
  have impossible := finite_fibre_lower_bound 0 tag evidence he h
  omega

example : (∀ z : Fin 2, ([4,2][z.val]?.getD 0) ≤ 4) := by decide
example : (∃ tags : (z : Fin 2) → Fin ([4,2][z.val]?.getD 0) → Fin 4,
    ∃ evidence : (z : Fin 2) → Fin ([4,2][z.val]?.getD 0) → Poly,
      (∀ z i, HasJ [] (evidence z i) Evidence) ∧
      (∀ z i j, i ≠ j → ObservablyDifferent
        (withEvidence z.val (tags z i).val (evidence z i))
        (withEvidence z.val (tags z j).val (evidence z j)))) := by
  apply (common_alphabet_exact (fun z : Fin 2 => [4,2][z.val]?.getD 0)).mpr
  decide

/-- Empty and out-of-range tables follow their declared default, not an invented Fin typing. -/
example : tableValue [] 73 0 0 = 73 := rfl
example : tableValue [[5]] 73 4 0 = 73 := rfl
example : tableValue [[5]] 73 0 4 = 73 := rfl
example : tableValue (tabulate 0 0 (fun _ _ => 7)) 0 0 0 = 0 := rfl
example : (runCodes [] 9 11) = ([], (9,11)) := rfl

/-- Failure of rectangle closure is visible: the source type alone does not block it. -/
def escaping : Tables := ⟨[[0]], [[7]], [[0]]⟩
example : ¬ ClosedRectangle 1 1 escaping := by
  intro h
  have bad := (h 0 0 (by decide) (by decide)).1
  change 7 < 1 at bad
  omega
example : Has [] (controller escaping) (arr State Reply) := controller_has escaping
example : (runCodes [escaping,escaping] 0 0) = ([0,0], (0,0)) := rfl

#print axioms four_required
#print axioms two_tags_cannot_hide_four
end FiniteSidecar.Controls
import SourceRigidity
import AllStructural
namespace RigidityInitiality
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open SourceRigidity
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem form_inst_source {Γ : Tel} {X P : Ty} {x : Poly}
    (hc : Ctx Γ) (hP : Form (X :: Γ) P) (hx : Has Γ x X) : Form Γ (inst P x) := by
  have s : MixedSubstitution (X :: Γ) Γ (cons x Poly.var) Ty.param := by
    refine ⟨fun _ => .param hc, ?_⟩
    intro n A h
    cases h with
    | zero => simpa only [mixed_param, subst_wk_cancel, subst_id, cons] using hx
    | succ h => simpa only [mixed_param, subst_wk_cancel, subst_id, cons] using
        (Has.var (lookup_form hc h) h)
  simpa only [mixed_param] using form_mixed hP hc s

theorem transport_source {Γ : Tel} {X P : Ty} {x y e d : Poly}
    (hc : Ctx Γ) (hX : Form Γ X) (hP : Form (X :: Γ) P)
    (hx : Has Γ x X) (hy : Has Γ y X)
    (he : HasE Γ e (.identity X x y)) (hd : HasE Γ d (inst P x)) :
    HasE Γ (jPoly d y e) (inst P y) := by
  have hM : Form (theta Γ X x) (wk P) :=
    form_wk hP (.ext hc hX) (form_theta_head hc hX hx)
  have at_eq (v r : Poly) : motiveAt (wk P) v r = inst P v := by
    exact subst_wk_cancel P r (cons v Poly.var)
  have h := HasE.j (form_inclusion hX) (form_inclusion hM)
    (form_inclusion (.identity hX hx hy))
    (form_inclusion (at_eq x (.atom .i) ▸ form_inst_source hc hP hx))
    (form_inclusion (at_eq y e ▸ form_inst_source hc hP hy))
    (has_inclusion hx) (has_inclusion hy) he
    (show HasE Γ d (motiveAt (wk P) x (.atom .i)) from (at_eq x (.atom .i)).symm ▸ hd)
  simpa only [at_eq] using h

/-- Same-source elimination, for any Peano endomorphism, of the explicit
    rigidity hypothesis. No compiler, semantic relation or new rule occurs. -/
theorem rigidity_elim {Γ : Tel} {r u z s : Poly} (hc : Ctx Γ)
    (hu : Has Γ u NT) (hr : HasE Γ r Rigidity)
    (hz : HasE Γ z (ZeroAt u)) (hs : HasE Γ s (StepAt u)) :
    HasE Γ (.app (.app (.app r u) z) s) (ResultAt u) := by
  have hZ := zeroAt_formed hc hu
  have hS := stepAt_formed hc hu
  have hR := resultAt_formed hc hu
  have first : HasE Γ (.app r u) (arr (ZeroAt u) (arr (StepAt u) (ResultAt u))) := by
    have h := HasE.piElim (form_inclusion (rigidity_formed hc))
      (form_inclusion (show Form Γ (inst _ u) from
        (rigidity_inst u).symm ▸ form_arr hZ (form_arr hS hR))) hr (has_inclusion hu)
    simpa only [rigidity_inst] using h
  have second : HasE Γ (.app (.app r u) z) (arr (StepAt u) (ResultAt u)) := by
    have h := HasE.piElim (form_inclusion (form_arr hZ (form_arr hS hR)))
      (form_inclusion (show Form Γ (inst (wk (arr (StepAt u) (ResultAt u))) z) from
        by simpa only [inst_wk] using form_arr hS hR)) first hz
    simpa only [inst_wk] using h
  have h := HasE.piElim (form_inclusion (form_arr hS hR))
    (form_inclusion (show Form Γ (inst (wk (ResultAt u)) s) from
      by simpa only [inst_wk] using hR)) second hs
  simpa only [inst_wk] using h

/-- Evaluate a function equality with orientation suitable for dependent
    transport back from the total-space projection to the input. -/
theorem rigidity_pointwise {Γ : Tel} {u n e : Poly} (hc : Ctx Γ)
    (hu : Has Γ u NT) (hn : Has Γ n N) (he : HasE Γ e (ResultAt u)) :
    HasE Γ (jPoly ident u e) (.identity N (.app u n) n) := by
  let M : Ty := .identity N (.app (.var 1) (pren (fun k => k+2) n))
    (pren (fun k => k+2) n)
  have hNT := form_arr (N_form hc) (N_form hc)
  have hi : Has Γ ident NT := ExactScalarFusion.i_T hc
  have c1 := Ctx.ext hc hNT
  have hP := form_theta_head hc hNT hi
  have ct := ctx_theta hc hNT hi
  have hn2 : Has (theta Γ NT ident) (pren (fun k => k+2) n) N := by
    simpa only [wk, N_subst, pren, psub_comp, psub] using
      has_wk (has_wk hn hc hNT) c1 hP
  have hv : Has (theta Γ NT ident) (.var 1) NT :=
    .var (form_arr (N_form ct) (N_form ct)) (.succ .zero)
  have hM : Form (theta Γ NT ident) M := .identity (N_form ct)
    (app_has (form_arr (N_form ct) (N_form ct)) (N_form ct) hv hn2) hn2
  have at_eq (v r : Poly) : motiveAt M v r = .identity N (.app v n) n := by
    simp [M, motiveAt, N, NBody, arr, subst, wk, psub, pren, psub_comp, cons]
  have hin := app_has hNT (N_form hc) hi hn
  have hun := app_has hNT (N_form hc) hu hn
  have hb : Form Γ (.identity N (.app ident n) n) := .identity (N_form hc) hin hn
  have ht : Form Γ (.identity N (.app u n) n) := .identity (N_form hc) hun hn
  have hd : Has Γ ident (.identity N (.app ident n) n) := .identityIntro hb hin hn (.i n)
  have h := HasE.j (form_inclusion hNT) (form_inclusion hM)
    (form_inclusion (resultAt_formed hc hu))
    (form_inclusion ((at_eq ident ident).symm ▸ hb))
    (form_inclusion ((at_eq u e).symm ▸ ht))
    (has_inclusion hi) (has_inclusion hu) he
    (show HasE Γ ident (motiveAt M ident ident) from (at_eq ident ident).symm ▸ has_inclusion hd)
  simpa only [at_eq] using h

def total (P : Ty) : Ty := .sigma N P

def nextIndex : Poly := .app succPoly (fstPoly (.var 0))
def totalStep (d : Poly) : Poly := abstract (pairPoly nextIndex d)
def totalSeed (p : Poly) : Poly := pairPoly zero p

def totalStepType (P : Ty) : Ty :=
  inst (subst (pup (fun k => .var (k+1))) P) nextIndex

theorem sigma_body_form {Γ : Tel} {X P : Ty} (h : Form Γ (.sigma X P)) :
    Form (X :: Γ) P := by cases h; assumption

theorem total_step_has {Γ : Tel} {P : Ty} {d : Poly} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hd : Has (total P :: Γ) d (totalStepType P)) :
    Has Γ (totalStep d) (arr (total P) (total P)) := by
  have hE : Form Γ (total P) := .sigma (N_form hc) hP
  have cE := Ctx.ext hc hE
  have hEw : Form (total P :: Γ) (wk (total P)) := form_wk hE hc hE
  have hEw' : Form (total P :: Γ) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hEw
  have hv : Has (total P :: Γ) (.var 0) (wk (total P)) := .var hEw .zero
  have hv' : Has (total P :: Γ) (.var 0) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hv
  have hfst := Has.sigmaFst (N_form cE) hEw' hv'
  have hnext : Has (total P :: Γ) nextIndex N :=
    app_has (form_arr (N_form cE) (N_form cE)) (N_form cE) (succ_has_NT cE) hfst
  have hleaf := form_inst_source cE (sigma_body_form hEw') hnext
  have hb := Has.sigmaIntro hEw' hleaf hnext hd
  apply Has.piIntro (form_arr hE hE)
  · simpa only [total, wk, subst, N_subst] using hb
  · exact scoped_abstract (has_scoped hb)

theorem total_seed_has {Γ : Tel} {P : Ty} {p : Poly} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero)) :
    Has Γ (totalSeed p) (total P) :=
  .sigmaIntro (.sigma (N_form hc) hP) (form_inst_source hc hP (zero_has_N hc))
    (zero_has_N hc) hp

def projectedFold (D a : Poly) : Poly :=
  abstract (fstPoly (.app (.app (.var 0) (pren Nat.succ D)) (pren Nat.succ a)))

theorem projectedFold_beta (D a n : Poly) : P01DF.PolyConv
    (.app (projectedFold D a) n) (fstPoly (.app (.app n D) a)) := by
  have h := poly_beta (fstPoly (.app (.app (.var 0) (pren Nat.succ D)) (pren Nat.succ a))) n
  simpa [projectedFold, fstPoly, psub, pren, psub_comp, cons] using h

theorem projectedFold_has {Γ : Tel} {P : Ty} {D a : Poly} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hD : Has Γ D (arr (total P) (total P)))
    (ha : Has Γ a (total P)) : Has Γ (projectedFold D a) NT := by
  have hE : Form Γ (total P) := .sigma (N_form hc) hP
  have cN := Ctx.ext hc (N_form hc)
  have hEw := form_wk hE hc (N_form hc)
  have hD1 : Has (N :: Γ) (pren Nat.succ D) (arr (wk (total P)) (wk (total P))) := by
    simpa only [wk, subst_arr] using has_wk hD hc (N_form hc)
  have ha1 := has_wk ha hc (N_form hc)
  have hn : Has (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  have run := SourceFoldContract.fold_has cN hEw hn hD1 ha1
  have hEw' : Form (N :: Γ) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hEw
  have run' : Has (N :: Γ) (.app (.app (.var 0) (pren Nat.succ D)) (pren Nat.succ a))
      (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using run
  have hb := Has.sigmaFst (N_form cN) hEw' run'
  exact .piIntro (form_arr (N_form hc) (N_form hc)) hb (scoped_abstract (has_scoped hb))

theorem totalStep_projection (d x : Poly) : P01DF.PolyConv
    (fstPoly (.app (totalStep d) x)) (.app succPoly (fstPoly x)) := by
  have h := poly_beta (pairPoly nextIndex d) x
  have h' : P01DF.PolyConv (.app (totalStep d) x)
      (pairPoly (.app succPoly (fstPoly x)) (psub (cons x Poly.var) d)) := by
    simpa [totalStep, nextIndex, pairPoly, fstPoly, psub, cons,
      P01AC.BooleanPrimitive.psub_closed (has_scoped succ_has)] using h
  exact (P01DF.PolyConv.app h' (.refl _)).trans (pair_first _ _)

theorem projected_zero (d p : Poly) : P01DF.PolyConv
    (.app (projectedFold (totalStep d) (totalSeed p)) zero) zero :=
  (projectedFold_beta _ _ _).trans
    ((P01DF.PolyConv.app (zero_beta _ _) (.refl _)).trans (pair_first _ _))

theorem projected_succ (d p n : Poly) : P01DF.PolyConv
    (.app (projectedFold (totalStep d) (totalSeed p)) (.app succPoly n))
    (.app succPoly (.app (projectedFold (totalStep d) (totalSeed p)) n)) :=
  (projectedFold_beta _ _ _).trans
    ((P01DF.PolyConv.app (succ_beta n _ _) (.refl _)).trans
      ((totalStep_projection _ _).trans (.app (.refl _) (projectedFold_beta _ _ _).symm)))

theorem projected_ren (d p : Poly) :
    pren Nat.succ (projectedFold (totalStep d) (totalSeed p)) =
    projectedFold (totalStep (psub (pup (fun k => .var (k+1))) d))
      (totalSeed (pren Nat.succ p)) := by
  have hs := has_scoped succ_has
  have hz := has_scoped (inputNumeral_has 0)
  simp [projectedFold, totalStep, totalSeed, nextIndex, pairPoly, fstPoly, zero,
    pren, ← abstraction_naturality, psub, pup, psub_comp,
    P01AC.BooleanPrimitive.psub_closed hs, P01AC.BooleanPrimitive.psub_closed hz]
  congr 15 <;> (first | rfl | (funext n; cases n <;> rfl))

theorem projected_zero_evidence {Γ : Tel} {P : Ty} {d p : Poly} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hd : Has (total P :: Γ) d (totalStepType P)) :
    Has Γ ident (ZeroAt (projectedFold (totalStep d) (totalSeed p))) := by
  have hu := projectedFold_has hc hP (total_step_has hc hP hd) (total_seed_has hc hP hp)
  have hz := zero_has_N hc
  have huz := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) hu hz
  exact .identityIntro (zeroAt_formed hc hu) huz hz (projected_zero d p)

theorem projected_step_evidence {Γ : Tel} {P : Ty} {d p : Poly} (hc : Ctx Γ)
    (hP : Form (N :: Γ) P) (hp : Has Γ p (inst P zero))
    (hd : Has (total P :: Γ) d (totalStepType P)) :
    Has Γ (abstract ident) (StepAt (projectedFold (totalStep d) (totalSeed p))) := by
  let u := projectedFold (totalStep d) (totalSeed p)
  have hu := projectedFold_has hc hP (total_step_has hc hP hd) (total_seed_has hc hP hp)
  have c1 := Ctx.ext hc (N_form hc)
  have hu1 : Has (N :: Γ) (pren Nat.succ u) NT := has_wk hu hc (N_form hc)
  have hn : Has (N :: Γ) (.var 0) N := .var (N_form c1) .zero
  have hs := succ_has_NT c1
  have sn := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hs hn
  have un := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hu1 hn
  have left := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hu1 sn
  have right := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hs un
  apply Has.piIntro (stepAt_formed hc hu)
  · apply Has.identityIntro (.identity (N_form c1) left right) left right
    change P01DF.PolyConv (.app (pren Nat.succ u) (.app succPoly (.var 0)))
      (.app succPoly (.app (pren Nat.succ u) (.var 0)))
    simp only [u, projected_ren]
    exact projected_succ _ _ _
  · exact scoped_abstract trivial

theorem nat_identity_trans {Γ : Tel} {x y z e d : Poly} (hc : Ctx Γ)
    (hx : Has Γ x N) (hy : Has Γ y N) (hz : Has Γ z N)
    (he : HasE Γ e (.identity N x y)) (hd : HasE Γ d (.identity N y z)) :
    HasE Γ (jPoly e z d) (.identity N x z) := by
  let P : Ty := .identity N (pren Nat.succ x) (.var 0)
  have cN := Ctx.ext hc (N_form hc)
  have hx1 : Has (N :: Γ) (pren Nat.succ x) N := has_wk hx hc (N_form hc)
  have hP : Form (N :: Γ) P := .identity (N_form cN) hx1 (.var (N_form cN) .zero)
  have at_eq (v : Poly) : inst P v = .identity N x v := by
    simp [P, inst, subst, N, NBody, arr, wk, pren, psub, psub_comp, cons]
  have h := transport_source hc (N_form hc) hP hy hz hd
    (show HasE Γ e (inst P y) from (at_eq y).symm ▸ he)
  simpa only [at_eq] using h

/-- Dependent section existence for every original-source formed family.
    The step is expressed on its total space: given (n,p), d returns P(succ n).
    This is a theorem of the unchanged Has/HasE judgements with explicit
    Rigidity evidence. It asserts no zero/successor computation law for
    the transported section and no coherence/uniqueness of proof objects. -/
theorem dependent_section_from_rigidity {Γ : Tel} {P : Ty} {p d r n : Poly}
    (hc : Ctx Γ) (hP : Form (N :: Γ) P)
    (hp : Has Γ p (inst P zero))
    (hd : Has (total P :: Γ) d (totalStepType P))
    (hr : HasE Γ r Rigidity) (hn : Has Γ n N) :
    ∃ e, HasE Γ e (inst P n) := by
  let D := totalStep d
  let a := totalSeed p
  let u := projectedFold D a
  let run : Poly := .app (.app n D) a
  have hD := total_step_has hc hP hd
  have ha := total_seed_has hc hP hp
  have hu : Has Γ u NT := projectedFold_has hc hP hD ha
  have hE : Form Γ (total P) := .sigma (N_form hc) hP
  have hrun : Has Γ run (total P) := SourceFoldContract.fold_has hc hE hn hD ha
  have hfst : Has Γ (fstPoly run) N := .sigmaFst (N_form hc) hE hrun
  have hsnd : Has Γ (sndPoly run) (inst P (fstPoly run)) :=
    .sigmaSnd hE (form_inst_source hc hP hfst) hrun
  have huN := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) hu hn
  have rid := rigidity_elim hc hu hr
    (has_inclusion (projected_zero_evidence hc hP hp hd))
    (has_inclusion (projected_step_evidence hc hP hp hd))
  have point := rigidity_pointwise hc hu hn rid
  have link : Has Γ ident (.identity N (fstPoly run) (.app u n)) :=
    .identityIntro (.identity (N_form hc) hfst huN) hfst huN (projectedFold_beta D a n).symm
  have back := nat_identity_trans hc hfst huN hn (has_inclusion link) point
  exact ⟨_, transport_source hc (N_form hc) hP hfst hn back (has_inclusion hsnd)⟩

#print axioms dependent_section_from_rigidity
#print axioms transport_source
#print axioms projected_step_evidence
end RigidityInitiality
