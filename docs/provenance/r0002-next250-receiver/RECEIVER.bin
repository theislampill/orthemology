import AuxiliaryCertificates
namespace IndependentAuxiliarySourceReview
open AuxiliaryCertificates OrthemologyV2 OrthemologyV3 P01D P01AC
set_option maxRecDepth 8192
set_option maxHeartbeats 1000000
-- This module imports only the retained source checker, never candidate exactness.
theorem step_i (x t u : Term) : checkStep (.i x) t u = decide (t = .app .i x ∧ u = x) := rfl
theorem step_k (x y t u : Term) : checkStep (.k x y) t u = decide (t = .app (.app .k x) y ∧ u = x) := rfl
theorem step_s (f g x t u : Term) : checkStep (.s f g x) t u = decide (t = .app (.app (.app .s f) g) x ∧ u = .app (.app f x) (.app g x)) := rfl
theorem step_left (f g x t u : Term) (c : StepCert) : checkStep (.left f g x c) t u = (decide (t = .app f x ∧ u = .app g x) && checkStep c f g) := rfl
theorem step_right (f x y t u : Term) (c : StepCert) : checkStep (.right f x y c) t u = (decide (t = .app f x ∧ u = .app f y) && checkStep c x y) := rfl
theorem red_refl (t a b : Term) : checkRed (.refl t) a b = decide (a = t ∧ b = t) := rfl
theorem red_tail (t u v a b : Term) (s : StepCert) (r : RedCert) : checkRed (.tail t u v s r) a b = (decide (a = t ∧ b = v) && checkStep s t u && checkRed r u v) := rfl

theorem finite_i (A C : TypeCode) (t : Term) : checkFinite (.i A) t C = decide (t = .i ∧ C = .arrow A A) := rfl
theorem finite_k (A B C : TypeCode) (t : Term) : checkFinite (.k A B) t C = decide (t = .k ∧ C = .arrow A (.arrow B A)) := rfl
theorem finite_s (A B C D : TypeCode) (t : Term) : checkFinite (.s A B C) t D = decide (t = .s ∧ D = .arrow (.arrow A (.arrow B C)) (.arrow (.arrow A B) (.arrow A C))) := rfl
theorem finite_app (f x t : Term) (A B C : TypeCode) (p q : FiniteCert) : checkFinite (.app f x A B p q) t C = (decide (t = .app f x ∧ C = B) && checkFinite p f (.arrow A B) && checkFinite q x A) := rfl
theorem finite_allI (t u : Term) (B C : TypeCode) (p : FiniteCert) : checkFinite (.allI t B p) u C = (decide (u = t ∧ C = .all B) && checkFinite p t B) := rfl
theorem finite_allE (t u : Term) (B A C : TypeCode) (p : FiniteCert) : checkFinite (.allE t B A p) u C = (decide (u = t ∧ C = instantiateType B A) && checkFinite p t (.all B)) := rfl
theorem finite_reduce (t u v : Term) (A C : TypeCode) (p : FiniteCert) (r : RedCert) : checkFinite (.reduce t u A p r) v C = (decide (v = u ∧ C = A) && checkFinite p t A && checkRed r t u) := rfl

theorem poly_refl (p a b : Poly) : checkPoly (.refl p) a b = decide (a = p ∧ b = p) := rfl
theorem poly_symm (p q a b : Poly) (c : PolyCert) : checkPoly (.symm p q c) a b = (decide (a = q ∧ b = p) && checkPoly c p q) := rfl
theorem poly_trans (p q r a b : Poly) (c d : PolyCert) : checkPoly (.trans p q r c d) a b = (decide (a = p ∧ b = r) && checkPoly c p q && checkPoly d q r) := rfl
theorem poly_app (f g p q a b : Poly) (c d : PolyCert) : checkPoly (.app f g p q c d) a b = (decide (a = .app f p ∧ b = .app g q) && checkPoly c f g && checkPoly d p q) := rfl
theorem poly_i (p a b : Poly) : checkPoly (.i p) a b = decide (a = .app (.atom .i) p ∧ b = p) := rfl
theorem poly_k (p q a b : Poly) : checkPoly (.k p q) a b = decide (a = .app (.app (.atom .k) p) q ∧ b = p) := rfl
theorem poly_s (p q r a b : Poly) : checkPoly (.s p q r) a b = decide (a = .app (.app (.app (.atom .s) p) q) r ∧ b = .app (.app p r) (.app q r)) := rfl
theorem poly_bridge (r t : Term) (a b : Poly) : checkPoly (.bridge r t) a b = decide (a = .atom (.app r t) ∧ b = .app (.atom r) (.atom t)) := rfl

theorem lookup_zero (Γ Δ : Tel) (A B : Ty) (n : Nat) : checkLookup (.zero Γ A) Δ n B = decide (Δ = A :: Γ ∧ n = 0 ∧ B = wk A) := rfl
theorem lookup_succ (Γ Δ : Tel) (A B C : Ty) (n k : Nat) (c : LookupCert) : checkLookup (.succ Γ n A B c) Δ k C = (decide (Δ = B :: Γ ∧ k = n+1 ∧ C = wk A) && checkLookup c Γ n A) := rfl

-- Discriminating nested/concrete tests, independent of codec/exactness.
def nestedBody : TypeCode := .all (.arrow (.var 1) (.var 1))
def polyIdentity : FiniteCert := .allI .i nestedBody (.allI .i (.arrow (.var 1) (.var 1)) (.i (.var 1)))
def instCert : FiniteCert := .allE .i nestedBody (.var 2) polyIdentity
theorem allE_capture_avoiding : checkFinite instCert .i (.all (.arrow (.var 3) (.var 3))) = true := by decide
theorem allE_capture_reject : checkFinite instCert .i (.all (.arrow (.var 2) (.var 2))) = false := by decide

def idType : TypeCode := .arrow .bottom .bottom
def typedII : FiniteCert := .app .i .i idType idType (.i idType) (.i .bottom)
def redII : RedCert := .tail (.app .i .i) .i .i (.i .i) (.refl .i)
theorem reduce_valid : checkFinite (.reduce (.app .i .i) .i idType typedII redII) .i idType = true := by decide
theorem reduce_wrong_start : checkFinite (.reduce (.app .i .i) .i idType typedII (.refl .i)) .i idType = false := by decide

def A (n : Nat) : Ty := .identity .raw (.var n) (.var n)
def lookup0 : LookupCert := .zero [] (A 0)
def lookup1 : LookupCert := .succ [A 0] 0 (A 1) .raw lookup0
def lookup2 : LookupCert := .succ [.raw,A 0] 1 (A 2) .bottom lookup1
theorem repeated_wk : checkLookup lookup2 [.bottom,.raw,A 0] 2 (A 3) = true := by decide
theorem one_wk_missing : checkLookup lookup2 [.bottom,.raw,A 0] 2 (A 2) = false := by decide
theorem wrong_context : checkLookup lookup2 [.raw,.bottom,A 0] 2 (A 3) = false := by decide

theorem bad_step_child : checkStep (.right .s (.app .i .k) .k (.i .s)) (.app .s (.app .i .k)) (.app .s .k) = false := by decide
theorem bad_reduction_middle : checkRed (.tail (.app .i .k) .s .s (.i .k) (.refl .s)) (.app .i .k) .s = false := by decide
theorem reversed_symmetry : checkPoly (.symm (.app (.atom .i) (.var 0)) (.var 0) (.i (.var 0))) (.var 0) (.app (.atom .i) (.var 0)) = true := by decide
theorem wrong_symmetry : checkPoly (.symm (.app (.atom .i) (.var 0)) (.var 0) (.i (.var 0))) (.app (.atom .i) (.var 0)) (.var 0) = false := by decide
theorem disconnected_trans : checkPoly (.trans (.var 0) (.var 1) (.var 0) (.refl (.var 0)) (.refl (.var 0))) (.var 0) (.var 0) = false := by decide
theorem swapped_bridge : checkPoly (.bridge .i .k) (.app (.atom .i) (.atom .k)) (.atom (.app .i .k)) = false := by decide
theorem collapsed_bridge : checkPoly (.bridge .i .k) (.app (.atom .i) (.atom .k)) (.app (.atom .i) (.atom .k)) = false := by decide
end IndependentAuxiliarySourceReview
import Mathlib.LinearAlgebra.Vandermonde
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-!
# Finite-support moment recovery

Fresh formal verification of the finite algebraic core of
`tensor-moment-continuation-20261009/RESULT.md`, Theorem 1.
The support is known and pairwise distinct, weights are arbitrary, and N is arbitrary.
No interpolation, recovery, or nonsingularity is assumed. These facts are proved
from the Vandermonde determinant product and the distinctness hypothesis.
-/

noncomputable section

open scoped BigOperators
open Matrix

namespace FiniteMoment

variable {K : Type*} [Field K] {N : ℕ}

/-- Degree-r scalar moment, including the degree-zero total mass. -/
def moment (a w : Fin N → K) (r : ℕ) : K := ∑ j, w j * a j ^ r

/-- The retained degrees are exactly 0 through N-1, even for N=0. -/
def record (a w : Fin N → K) : Fin N → K := fun r => moment a w r.val

/-- Recovery coefficients depend on the known support alone. -/
def recoveryCoefficient (a : Fin N → K) (j r : Fin N) : K :=
  (Matrix.vandermonde a)⁻¹ r j

/-- Explicit linear reconstruction from a prospective moment record. -/
def recover (a : Fin N → K) (s : Fin N → K) : Fin N → K :=
  fun j => ∑ r, s r * recoveryCoefficient a j r

/-- Proved from the determinant product; no invertibility premise is hidden here. -/
theorem determinant_ne_zero (a : Fin N → K) (ha : Function.Injective a) :
    (Matrix.vandermonde a).det ≠ 0 := by
  rw [Matrix.det_vandermonde]
  apply Finset.prod_ne_zero_iff.mpr
  intro i _
  apply Finset.prod_ne_zero_iff.mpr
  intro j hj
  apply sub_ne_zero.mpr
  exact fun h => (Finset.mem_Ioi.mp hj).ne' (ha h)

/-- The actual finite moment record is multiplication by the Vandermonde matrix. -/
theorem record_eq_vecMul (a w : Fin N → K) :
    record a w = w ᵥ* Matrix.vandermonde a := rfl

/-- The displayed reconstruction is multiplication by its nonsingular inverse. -/
theorem recover_eq_vecMul (a s : Fin N → K) :
    recover a s = s ᵥ* (Matrix.vandermonde a)⁻¹ := rfl

/-- All arbitrary field-valued weights are recovered from degrees 0 through N-1. -/
theorem recover_record (a : Fin N → K) (ha : Function.Injective a) (w : Fin N → K) :
    recover a (record a w) = w := by
  rw [recover_eq_vecMul, record_eq_vecMul, Matrix.vecMul_vecMul,
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (determinant_ne_zero a ha)),
    Matrix.vecMul_one]

/-- Conversely, reconstruction produces exactly the proposed finite moment tuple. -/
theorem record_recover (a : Fin N → K) (ha : Function.Injective a) (s : Fin N → K) :
    record a (recover a s) = s := by
  rw [record_eq_vecMul, recover_eq_vecMul, Matrix.vecMul_vecMul,
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr (determinant_ne_zero a ha)),
    Matrix.vecMul_one]

/-- For known distinct support, the finite moment record is an explicit linear equivalence. -/
def recordLinearEquiv (a : Fin N → K) (ha : Function.Injective a) :
    (Fin N → K) ≃ₗ[K] (Fin N → K) :=
  { (Matrix.vandermonde a).vecMulLinear with
    invFun := recover a
    left_inv := recover_record a ha
    right_inv := record_recover a ha }

/-- Coordinate version of the explicit finite reconstruction formula. -/
theorem weight_eq_sum_moments (a : Fin N → K) (ha : Function.Injective a)
    (w : Fin N → K) (j : Fin N) :
    w j = ∑ r : Fin N, moment a w r.val * recoveryCoefficient a j r := by
  exact (congrFun (recover_record a ha w) j).symm

/-- Equal first N moments of known distinct support determine every weight. -/
theorem weights_eq_of_moments_eq (a : Fin N → K) (ha : Function.Injective a)
    (w z : Fin N → K) (h : ∀ r : Fin N, moment a w r.val = moment a z r.val) :
    w = z := by
  have hr : record a w = record a z := funext h
  calc
    w = recover a (record a w) := (recover_record a ha w).symm
    _ = recover a (record a z) := congrArg (recover a) hr
    _ = z := recover_record a ha z

/-- The retained moment record is injective as a function of arbitrary weights. -/
theorem record_injective (a : Fin N → K) (ha : Function.Injective a) :
    Function.Injective (record a) := by
  intro w z h
  exact weights_eq_of_moments_eq a ha w z (congrFun h)

/-- Therefore equality of the finite records entails equality of every higher moment. -/
theorem all_moments_eq_of_record_eq (a : Fin N → K) (ha : Function.Injective a)
    (w z : Fin N → K) (h : record a w = record a z) :
    ∀ r : ℕ, moment a w r = moment a z r := by
  have hw := record_injective a ha h
  subst z
  exact fun _ => rfl

/-- Every scalar observable on known support is a fixed linear function of the record. -/
theorem observable_reconstruction (a : Fin N → K) (ha : Function.Injective a)
    (w f : Fin N → K) :
    ∑ j, w j * f j =
      ∑ r : Fin N, moment a w r.val * (∑ j, recoveryCoefficient a j r * f j) := by
  conv_lhs => arg 2; ext j; rw [weight_eq_sum_moments a ha w j]
  simp_rw [Finset.sum_mul, mul_assoc]
  rw [Finset.sum_comm]
  simp_rw [Finset.mul_sum]

/-- In particular, all higher scalar moments have explicit support-dependent coefficients. -/
theorem higher_moment_reconstruction (a : Fin N → K) (ha : Function.Injective a)
    (w : Fin N → K) (k : ℕ) :
    moment a w k =
      ∑ r : Fin N, moment a w r.val *
        (∑ j, recoveryCoefficient a j r * a j ^ k) := by
  exact observable_reconstruction a ha w (fun j => a j ^ k)

/-- Vector-valued observables, including any chosen tensor powers, obey the same formula.
No tensor/ODE infrastructure or analytic inference is asserted by this algebraic theorem. -/
theorem vector_observable_reconstruction {V : Type*} [AddCommGroup V] [Module K V]
    (a : Fin N → K) (ha : Function.Injective a) (w : Fin N → K) (f : Fin N → V) :
    ∑ j, w j • f j =
      ∑ r : Fin N, moment a w r.val • (∑ j, recoveryCoefficient a j r • f j) := by
  conv_lhs => arg 2; ext j; rw [weight_eq_sum_moments a ha w j]
  simp_rw [Finset.sum_smul, MulAction.mul_smul]
  rw [Finset.sum_comm]
  simp_rw [Finset.smul_sum]

end FiniteMoment
import Lake
open Lake DSL
package p01Attempt3
require mathlib from git
  "https://github.com/leanprover-community/mathlib4" @ "c44e0c8ee63ca166450922a373c7409c5d26b00b"
lean_lib P01Attempt3 where
  roots := #[`P01TypeAssertions]
import GenericFoldTransport
import GraphBridgeAssembly

namespace SourceFoldContract
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair
open P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly
open P01AC.ExtensionalRepair.CompilerBodyControl
open P01AC.Intensional.Plus (PolyConvPlus)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

def squareType (B : Ty) (f g h : Poly) : Ty :=
  .identity (wk B)
    (.app (pren Nat.succ h) (.app (pren Nat.succ f) (.var 0)))
    (.app (pren Nat.succ g) (.app (pren Nat.succ h) (.var 0)))

def foldType (B : Ty) (n f g h a : Poly) : Ty :=
  .identity B (.app h (.app (.app n f) a))
    (.app (.app n g) (.app h a))

/-- The conclusion endpoints are formed in the unchanged source. -/
theorem fold_has {Γ : Tel} {X : Ty} {n f a : Poly}
    (hc : Ctx Γ) (hX : Form Γ X) (hn : Has Γ n N)
    (hf : Has Γ f (arr X X)) (ha : Has Γ a X) :
    Has Γ (.app (.app n f) a) X := by
  have he := form_arr hX hX
  have hn' : Has Γ n (arr (arr X X) (arr X X)) := by
    rw [← church_instantiate]
    exact .allElim (N_form hc) hX (by rw [church_instantiate]; exact form_arr he he) hn
  exact app_has he hX (app_has (form_arr he he) he hn' hf) ha

theorem fold_type_formed {Γ : Tel} {X Y : Ty} {n f g h a : Poly}
    (hc : Ctx Γ) (hX : Form Γ X) (hY : Form Γ Y)
    (hn : Has Γ n N) (hf : Has Γ f (arr X X)) (hg : Has Γ g (arr Y Y))
    (hh : Has Γ h (arr X Y)) (ha : Has Γ a X) :
    Form Γ (foldType Y n f g h a) :=
  .identity hY
    (app_has (form_arr hX hY) hY hh (fold_has hc hX hn hf ha))
    (fold_has hc hY hn hg (app_has (form_arr hX hY) hY hh ha))

/-- A proposed, reusable SOURCE-PROOF contract, not a new judgement or rule.
    Its antecedents and conclusion refer only to the actual unchanged syntax.
    All endpoint terms are already typed by the inherited Has fragment;
    the commuting square may have arbitrary HasE evidence. -/
def SourceNaturality : Prop :=
  ∀ {Γ : Tel} {X Y : Ty} {n f g h a square : Poly},
    Ctx Γ → Form Γ X → Form Γ Y →
    Has Γ n N → Has Γ f (arr X X) → Has Γ g (arr Y Y) →
    Has Γ h (arr X Y) → Has Γ a X →
    HasE (X :: Γ) square (squareType Y f g h) →
    ∃ e, HasE Γ e (foldType Y n f g h a)

/-- The proposed contract's conclusion has a uniform semantic I realizer in
    the inherited certified full-PER model, under its exact source premises.
    This is NOT a HasE proof and does not assert SourceNaturality. -/
theorem contract_semantically_valid {Γ : Tel} {X Y : Ty} {n f g h a square : Poly}
    (hc : Ctx Γ) (hX : Form Γ X) (hY : Form Γ Y)
    (hn : Has Γ n N) (hf : Has Γ f (arr X X)) (hg : Has Γ g (arr Y Y))
    (hh : Has Γ h (arr X Y)) (ha : Has Γ a X)
    (hsquare : HasE (X :: Γ) square (squareType Y f g h)) :
    FullPER.Fundamental Γ (.atom .i) (foldType Y n f g h a) := by
  intro ρ η ξ r e
  have c := FullPER.context_sound (ctx_inclusion hc)
  have d := (c.ends r e).1
  have ee := c.refl r d
  let XP := (FullPER.formation_per (form_inclusion hX) r d).object
  let YP := (FullPER.formation_per (form_inclusion hY) r d).object
  have nn := FullPER.fundamental (has_inclusion hn) ρ η η r ee
  have ff := FullPER.fundamental (has_inclusion hf) ρ η η r ee
  have gg := FullPER.fundamental (has_inclusion hg) ρ η η r ee
  have hhm := FullPER.fundamental (has_inclusion hh) ρ η η r ee
  have aa := FullPER.fundamental (has_inclusion ha) ρ η η r ee
  rw [FullPER.F_arr] at ff gg hhm
  have sq : GenericFoldTransport.Commutes XP YP
      (ImportedOpenTermTransport.interp f η) (ImportedOpenTermTransport.interp g η)
      (ImportedOpenTermTransport.interp h η) := by
    intro x xx
    have ex : FullPER.E (X :: Γ) ρ (FullPER.cons x η) (FullPER.cons x η) := ⟨ee,xx⟩
    have v := FullPER.fundamental hsquare ρ _ _ r ex
    change FullPER.F (wk Y) ρ (FullPER.cons x η)
      (ImportedOpenTermTransport.interp _ (FullPER.cons x η))
      (ImportedOpenTermTransport.interp _ (FullPER.cons x η)) ∧ _ at v
    simpa only [FullPER.F_wk, FullPER.interp_app, FullPER.interp_ren,
      FullPER.interp_var, FullPER.cons] using v.1
  exact ⟨GenericFoldTransport.fold_transport XP YP nn ff gg hhm aa sq,
    .refl _, .refl _⟩

/-- The ordinary encoded state observer. No graph carrier is introduced. -/
def imageMap (f a : Poly) : Poly :=
  abstract (image (pren Nat.succ f) (pren Nat.succ a) (.var 0))

theorem imageMap_beta (f a s : Poly) :
    P01DF.PolyConv (.app (imageMap f a) s) (image f a s) := by
  have v := poly_beta (image (pren Nat.succ f) (pren Nat.succ a) (.var 0)) s
  simpa [imageMap, image, sndPoly, psub, pren, psub_comp, cons] using v

theorem imageMap_has {Γ : Tel} (hc : Ctx Γ) {f a : Poly}
    (hf : Has Γ f End) (ha : Has Γ a A) : Has Γ (imageMap f a) (arr S A) := by
  have hS := S_form hc
  have c1 := Ctx.ext hc hS
  have hf1 : Has (S :: Γ) (pren Nat.succ f) End := has_wk hf hc hS
  have ha1 : Has (S :: Γ) (pren Nat.succ a) A := has_wk ha hc hS
  have hs1 : Has (S :: Γ) (.var 0) S := .var (S_form c1) .zero
  have hb := image_has c1 hf1 ha1 hs1
  exact .piIntro (form_arr hS (.param hc)) hb (scoped_abstract (has_scoped hb))

theorem imageMap_square (f a s : Poly) : P01DF.PolyConv
    (.app (imageMap f a) (.app diagonalStep s))
    (.app f (.app (imageMap f a) s)) :=
  (imageMap_beta f a _).trans ((image_delta f a s).trans
    (.app (.refl f) (imageMap_beta f a s).symm))

theorem imageMap_seed (f a : Poly) :
    P01DF.PolyConv (.app (imageMap f a) diagonalZero) a :=
  (imageMap_beta f a _).trans (image_zero f a)

/-- Every premise of the proposed square is proved in the old source. -/
theorem actual_square_has {Γ : Tel} (hc : Ctx Γ) {f a : Poly}
    (hf : Has Γ f End) (ha : Has Γ a A) :
    HasE (S :: Γ) (.atom .i) (squareType A diagonalStep f (imageMap f a)) := by
  have hS := S_form hc
  have c1 := Ctx.ext hc hS
  have hf1 : Has (S :: Γ) (pren Nat.succ f) End := has_wk hf hc hS
  have hm1 : Has (S :: Γ) (pren Nat.succ (imageMap f a)) (arr S A) :=
    has_wk (imageMap_has hc hf ha) hc hS
  have hd1 : Has (S :: Γ) (pren Nat.succ diagonalStep) (arr S S) :=
    has_wk (delta_has hc) hc hS
  have hs1 : Has (S :: Γ) (.var 0) S := .var (S_form c1) .zero
  have hd := app_has (form_arr (S_form c1) (S_form c1)) (S_form c1) hd1 hs1
  have hl := app_has (form_arr (S_form c1) (.param c1)) (.param c1) hm1 hd
  have him := app_has (form_arr (S_form c1) (.param c1)) (.param c1) hm1 hs1
  have hr := app_has (form_arr (.param c1) (.param c1)) (.param c1) hf1 him
  have hconv := imageMap_square (pren Nat.succ f) (pren Nat.succ a) (.var 0)
  have delta_closed : pren Nat.succ diagonalStep = diagonalStep :=
    ExactScalarFusion.pren_closed (has_scoped (delta_has Ctx.nil)) _
  have map_ren : pren Nat.succ (imageMap f a) =
      imageMap (pren Nat.succ f) (pren Nat.succ a) := by
    simp [imageMap, image, sndPoly, pren, ← abstraction_naturality, psub, pup, psub_comp]
  apply has_inclusion
  apply Has.identityIntro (Form.identity (.param c1) hl hr) hl hr
  simpa only [delta_closed, map_ren] using hconv

#print axioms contract_semantically_valid
#print axioms imageMap_has
#print axioms actual_square_has
#print axioms imageMap_seed
end SourceFoldContract
import CertificateGrammar
namespace CertificateCodeValidity
open Encodable SourceFamilyComputability CodedScope ExactSyntaxValidity AuxiliaryCodeComputability
open OrthemologyV2 P01D P01AC AuxiliaryCertificates JointCertificates TelescopeCodeValidity
set_option maxRecDepth 16384
set_option maxHeartbeats 1000000
attribute [local irreducible] Nat.pair

theorem PolyCert_rule (c : Nat) : (∃ a : AuxiliaryCertificates.PolyCert, encode a = c) ↔
    localShape polyCertDescription c = true ∧ ∀ d ∈ localChildren polyCertDescription c, CertCanonical d := by
  constructor
  · rintro ⟨a, rfl⟩
    cases a <;> simp [polyCertDescription, localShape, localChildren, dependencies, rebuild, rebuildField, fieldCode, List.range_succ, CertCanonical]
  · rintro ⟨hs, hc⟩
    unfold localShape at hs
    split_ifs at hs with htag
    have hlt : tag c < 8 := by simpa [polyCertDescription] using htag
    have heq : tag c = 0 ∨ tag c = 1 ∨ tag c = 2 ∨ tag c = 3 ∨ tag c = 4 ∨ tag c = 5 ∨ tag c = 6 ∨ tag c = 7 := by simpa [List.range_succ, or_assoc, eq_comm] using (List.mem_range.mpr hlt)
    rcases heq with heq | heq | heq | heq | heq | heq | heq | heq
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨a0, h0⟩
      refine ⟨AuxiliaryCertificates.PolyCert.refl a0, ?_⟩
      simpa [h0] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.symm a0 a1 a2, ?_⟩
      simpa [h0, h1, h2] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩, ⟨a3, h3⟩, ⟨a4, h4⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.trans a0 a1 a2 a3 a4, ?_⟩
      simpa [h0, h1, h2, h3, h4] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩, ⟨a3, h3⟩, ⟨a4, h4⟩, ⟨a5, h5⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.app a0 a1 a2 a3 a4 a5, ?_⟩
      simpa [h0, h1, h2, h3, h4, h5] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨a0, h0⟩
      refine ⟨AuxiliaryCertificates.PolyCert.i a0, ?_⟩
      simpa [h0] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.k a0 a1, ?_⟩
      simpa [h0, h1] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩, ⟨a2, h2⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.s a0 a1 a2, ?_⟩
      simpa [h0, h1, h2] using hs.symm
    · simp [polyCertDescription, heq, rebuild, rebuildField, fieldCode, List.range_succ] at hs
      simp [localChildren, polyCertDescription, heq, dependencies, fieldCode, List.range_succ, CertCanonical] at hc
      rcases hc with ⟨⟨a0, h0⟩, ⟨a1, h1⟩⟩
      refine ⟨AuxiliaryCertificates.PolyCert.bridge a0 a1, ?_⟩
      simpa [h0, h1] using hs.symm

end CertificateCodeValidity
