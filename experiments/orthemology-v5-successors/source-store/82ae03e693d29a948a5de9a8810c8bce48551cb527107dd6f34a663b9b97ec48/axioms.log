def ModalUnion.ForcedEqual.{u, w} : {V : Type u} → {W : Type w} → ModalUnion.Frame V W → V → V → Prop :=
fun {V} {W} F x y => ∀ (S' : Type u) (a : V → S'), ModalUnion.EdgeLaw F a → a x = a y
structure ModalUnion.FaithfulInterpretation.{u, w} {V : Type u} {W : Type w} (F : ModalUnion.Frame V W) :
  Type (max (u + 1) w)
number of parameters: 3
fields:
  ModalUnion.FaithfulInterpretation.Source : Type u
  ModalUnion.FaithfulInterpretation.anchor : V → self.Source
  ModalUnion.FaithfulInterpretation.Local : W → Type u
  ModalUnion.FaithfulInterpretation.transport : (z : W) → self.Source → self.Local z
  ModalUnion.FaithfulInterpretation.localSource : (z : W) → V → self.Local z
  ModalUnion.FaithfulInterpretation.reflects : ∀ (z : W) (s t : self.Source),
      self.transport z s = self.transport z t → s = t
  ModalUnion.FaithfulInterpretation.retains : ∀ (z : W) (x y : V),
      F.admissible z →
        F.crossing z x y →
          self.localSource z x = self.transport z (self.anchor x) ∧
            self.localSource z y = self.transport z (self.anchor y)
  ModalUnion.FaithfulInterpretation.unity : ∀ (z : W) (x y : V),
      F.admissible z → F.crossing z x y → self.localSource z x = self.localSource z y
constructor:
  ModalUnion.FaithfulInterpretation.mk.{u, w} {V : Type u} {W : Type w} {F : ModalUnion.Frame V W} (Source : Type u)
    (anchor : V → Source) (Local : W → Type u) (transport : (z : W) → Source → Local z)
    (localSource : (z : W) → V → Local z) (reflects : ∀ (z : W) (s t : Source), transport z s = transport z t → s = t)
    (retains :
      ∀ (z : W) (x y : V),
        F.admissible z →
          F.crossing z x y → localSource z x = transport z (anchor x) ∧ localSource z y = transport z (anchor y))
    (unity : ∀ (z : W) (x y : V), F.admissible z → F.crossing z x y → localSource z x = localSource z y) :
    ModalUnion.FaithfulInterpretation F
inductive ModalUnion.Connected.{u, w} : {V : Type u} → {W : Type w} → ModalUnion.Frame V W → V → V → Prop
number of parameters: 3
constructors:
ModalUnion.Connected.refl : ∀ {V : Type u} {W : Type w} {F : ModalUnion.Frame V W} (x : V), ModalUnion.Connected F x x
ModalUnion.Connected.edge : ∀ {V : Type u} {W : Type w} {F : ModalUnion.Frame V W} {x y : V},
  ModalUnion.UnionEdge F x y → ModalUnion.Connected F x y
ModalUnion.Connected.symm : ∀ {V : Type u} {W : Type w} {F : ModalUnion.Frame V W} {x y : V},
  ModalUnion.Connected F x y → ModalUnion.Connected F y x
ModalUnion.Connected.trans : ∀ {V : Type u} {W : Type w} {F : ModalUnion.Frame V W} {x y z : V},
  ModalUnion.Connected F x y → ModalUnion.Connected F y z → ModalUnion.Connected F x z
