/- Additive Joint port of the credited actual-E total-space proof. -/
import JointInductionSupport
namespace JointCompletion.InductionComputation
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open SourceRigidity RigidityInitiality
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem transport_source {Γ : Tel} {X P : Ty} {x y e d : Poly}
    (hc : CtxJ Γ) (hX : FormJ Γ X) (hP : FormJ (X :: Γ) P)
    (hx : HasJ Γ x X) (hy : HasJ Γ y X)
    (he : HasJ Γ e (.identity X x y)) (hd : HasJ Γ d (inst P x)) :
    HasJ Γ (jPoly d y e) (inst P y) := by
  have hM : FormJ (theta Γ X x) (wk P) :=
    form_wk hP (.ext hc hX) (form_theta_head hc hX hx)
  have at_eq (v r : Poly) : motiveAt (wk P) v r = inst P v := by
    exact subst_wk_cancel P r (cons v Poly.var)
  have h := HasJ.j (hX) (hM)
    ((.identity hX hx hy))
    ((at_eq x (.atom .i) ▸ form_inst_source hc hP hx))
    ((at_eq y e ▸ form_inst_source hc hP hy))
    (hx) (hy) he
    (show HasJ Γ d (motiveAt (wk P) x (.atom .i)) from (at_eq x (.atom .i)).symm ▸ hd)
  simpa only [at_eq] using h

theorem rigidity_elim {Γ : Tel} {r u z s : Poly} (hc : CtxJ Γ)
    (hu : HasJ Γ u NT) (hr : HasJ Γ r Rigidity)
    (hz : HasJ Γ z (ZeroAt u)) (hs : HasJ Γ s (StepAt u)) :
    HasJ Γ (.app (.app (.app r u) z) s) (ResultAt u) := by
  have hZ := zeroAt_formed hc hu
  have hS := stepAt_formed hc hu
  have hR := resultAt_formed hc hu
  have first : HasJ Γ (.app r u) (arr (ZeroAt u) (arr (StepAt u) (ResultAt u))) := by
    have h := HasJ.piElim ((rigidity_formed hc))
      ((show FormJ Γ (inst _ u) from
        (rigidity_inst u).symm ▸ form_arr hZ (form_arr hS hR))) hr (hu)
    simpa only [rigidity_inst] using h
  have second : HasJ Γ (.app (.app r u) z) (arr (StepAt u) (ResultAt u)) := by
    have h := HasJ.piElim ((form_arr hZ (form_arr hS hR)))
      ((show FormJ Γ (inst (wk (arr (StepAt u) (ResultAt u))) z) from
        by simpa only [inst_wk] using form_arr hS hR)) first hz
    simpa only [inst_wk] using h
  have h := HasJ.piElim ((form_arr hS hR))
    ((show FormJ Γ (inst (wk (ResultAt u)) s) from
      by simpa only [inst_wk] using hR)) second hs
  simpa only [inst_wk] using h

theorem rigidity_pointwise {Γ : Tel} {u n e : Poly} (hc : CtxJ Γ)
    (hu : HasJ Γ u NT) (hn : HasJ Γ n N) (he : HasJ Γ e (ResultAt u)) :
    HasJ Γ (jPoly ident u e) (.identity N (.app u n) n) := by
  let M : Ty := .identity N (.app (.var 1) (pren (fun k => k+2) n))
    (pren (fun k => k+2) n)
  have hNT := form_arr (N_form hc) (N_form hc)
  have hi : HasJ Γ ident NT := i_T hc
  have c1 := CtxJ.ext hc hNT
  have hP := form_theta_head hc hNT hi
  have ct := ctx_theta hc hNT hi
  have hn2 : HasJ (theta Γ NT ident) (pren (fun k => k+2) n) N := by
    simpa only [wk, N_subst, pren, psub_comp, psub] using
      has_wk (has_wk hn hc hNT) c1 hP
  have hv : HasJ (theta Γ NT ident) (.var 1) NT :=
    .var (form_arr (N_form ct) (N_form ct)) (.succ .zero)
  have hM : FormJ (theta Γ NT ident) M := .identity (N_form ct)
    (app_has (form_arr (N_form ct) (N_form ct)) (N_form ct) hv hn2) hn2
  have at_eq (v r : Poly) : motiveAt M v r = .identity N (.app v n) n := by
    simp [M, motiveAt, N, NBody, arr, subst, wk, psub, pren, psub_comp, cons]
  have hin := app_has hNT (N_form hc) hi hn
  have hun := app_has hNT (N_form hc) hu hn
  have hb : FormJ Γ (.identity N (.app ident n) n) := .identity (N_form hc) hin hn
  have ht : FormJ Γ (.identity N (.app u n) n) := .identity (N_form hc) hun hn
  have hd : HasJ Γ ident (.identity N (.app ident n) n) := identityIntro_raw hb hin hn (.i n)
  have h := HasJ.j (hNT) (hM)
    ((resultAt_formed hc hu))
    (((at_eq ident ident).symm ▸ hb))
    (((at_eq u e).symm ▸ ht))
    (hi) (hu) he
    (show HasJ Γ ident (motiveAt M ident ident) from (at_eq ident ident).symm ▸ hd)
  simpa only [at_eq] using h


theorem sigma_body_form {Γ : Tel} {X P : Ty} (h : FormJ Γ (.sigma X P)) :
    FormJ (X :: Γ) P := (JointCompletion.DependentExtraction.form_sigma_inv h).2


theorem total_step_has {Γ : Tel} {P : Ty} {d : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hd : HasJ (total P :: Γ) d (totalStepType P)) :
    HasJ Γ (totalStep d) (arr (total P) (total P)) := by
  have hE : FormJ Γ (total P) := .sigma (N_form hc) hP
  have cE := CtxJ.ext hc hE
  have hEw : FormJ (total P :: Γ) (wk (total P)) := form_wk hE hc hE
  have hEw' : FormJ (total P :: Γ) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hEw
  have hv : HasJ (total P :: Γ) (.var 0) (wk (total P)) := .var hEw .zero
  have hv' : HasJ (total P :: Γ) (.var 0) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hv
  have hfst := HasJ.sigmaFst (N_form cE) hEw' hv'
  have hnext : HasJ (total P :: Γ) nextIndex N :=
    app_has (form_arr (N_form cE) (N_form cE)) (N_form cE) (succ_has_NT cE) hfst
  have hleaf := form_inst_source cE (sigma_body_form hEw') hnext
  have hb := HasJ.sigmaIntro hEw' hleaf hnext hd
  apply HasJ.piIntro (form_arr hE hE)
  · simpa only [total, wk, subst, N_subst] using hb
  · exact scoped_abstract (has_scoped hb)


theorem total_seed_has {Γ : Tel} {P : Ty} {p : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hp : HasJ Γ p (inst P zero)) :
    HasJ Γ (totalSeed p) (total P) :=
  .sigmaIntro (.sigma (N_form hc) hP) (form_inst_source hc hP (zero_has_N hc))
    (zero_has_N hc) hp


theorem projectedFold_has {Γ : Tel} {P : Ty} {D a : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hD : HasJ Γ D (arr (total P) (total P)))
    (ha : HasJ Γ a (total P)) : HasJ Γ (projectedFold D a) NT := by
  have hE : FormJ Γ (total P) := .sigma (N_form hc) hP
  have cN := CtxJ.ext hc (N_form hc)
  have hEw := form_wk hE hc (N_form hc)
  have hD1 : HasJ (N :: Γ) (pren Nat.succ D) (arr (wk (total P)) (wk (total P))) := by
    simpa only [wk, subst_arr] using has_wk hD hc (N_form hc)
  have ha1 := has_wk ha hc (N_form hc)
  have hn : HasJ (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  have run := fold_has cN hEw hn hD1 ha1
  have hEw' : FormJ (N :: Γ) (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using hEw
  have run' : HasJ (N :: Γ) (.app (.app (.var 0) (pren Nat.succ D)) (pren Nat.succ a))
      (.sigma N (subst (pup (fun k => .var (k+1))) P)) := by
    simpa only [total, wk, subst, N_subst] using run
  have hb := HasJ.sigmaFst (N_form cN) hEw' run'
  exact .piIntro (form_arr (N_form hc) (N_form hc)) hb (scoped_abstract (has_scoped hb))


theorem projected_zero_evidence {Γ : Tel} {P : Ty} {d p : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hp : HasJ Γ p (inst P zero))
    (hd : HasJ (total P :: Γ) d (totalStepType P)) :
    HasJ Γ ident (ZeroAt (projectedFold (totalStep d) (totalSeed p))) := by
  have hu := projectedFold_has hc hP (total_step_has hc hP hd) (total_seed_has hc hP hp)
  have hz := zero_has_N hc
  have huz := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) hu hz
  exact identityIntro_raw (zeroAt_formed hc hu) huz hz (projected_zero d p)


theorem projected_step_evidence {Γ : Tel} {P : Ty} {d p : Poly} (hc : CtxJ Γ)
    (hP : FormJ (N :: Γ) P) (hp : HasJ Γ p (inst P zero))
    (hd : HasJ (total P :: Γ) d (totalStepType P)) :
    HasJ Γ (abstract ident) (StepAt (projectedFold (totalStep d) (totalSeed p))) := by
  let u := projectedFold (totalStep d) (totalSeed p)
  have hu := projectedFold_has hc hP (total_step_has hc hP hd) (total_seed_has hc hP hp)
  have c1 := CtxJ.ext hc (N_form hc)
  have hu1 : HasJ (N :: Γ) (pren Nat.succ u) NT := has_wk hu hc (N_form hc)
  have hn : HasJ (N :: Γ) (.var 0) N := .var (N_form c1) .zero
  have hs := succ_has_NT c1
  have sn := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hs hn
  have un := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hu1 hn
  have left := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hu1 sn
  have right := app_has (form_arr (N_form c1) (N_form c1)) (N_form c1) hs un
  apply HasJ.piIntro (stepAt_formed hc hu)
  · apply identityIntro_raw (.identity (N_form c1) left right) left right
    simp only [u, projected_ren]
    exact projected_succ _ _ _
  · exact scoped_abstract trivial


theorem nat_identity_trans {Γ : Tel} {x y z e d : Poly} (hc : CtxJ Γ)
    (hx : HasJ Γ x N) (hy : HasJ Γ y N) (hz : HasJ Γ z N)
    (he : HasJ Γ e (.identity N x y)) (hd : HasJ Γ d (.identity N y z)) :
    HasJ Γ (jPoly e z d) (.identity N x z) := by
  let P : Ty := .identity N (pren Nat.succ x) (.var 0)
  have cN := CtxJ.ext hc (N_form hc)
  have hx1 : HasJ (N :: Γ) (pren Nat.succ x) N := has_wk hx hc (N_form hc)
  have hP : FormJ (N :: Γ) P := .identity (N_form cN) hx1 (.var (N_form cN) .zero)
  have at_eq (v : Poly) : inst P v = .identity N x v := by
    simp [P, inst, subst, N, NBody, arr, wk, pren, psub, psub_comp, cons]
  have h := transport_source hc (N_form hc) hP hy hz hd
    (show HasJ Γ e (inst P y) from (at_eq y).symm ▸ he)
  simpa only [at_eq] using h

theorem dependent_section_from_rigidity {Γ : Tel} {P : Ty} {p d r n : Poly}
    (hc : CtxJ Γ) (hP : FormJ (N :: Γ) P)
    (hp : HasJ Γ p (inst P zero))
    (hd : HasJ (total P :: Γ) d (totalStepType P))
    (hr : HasJ Γ r Rigidity) (hn : HasJ Γ n N) :
    ∃ e, HasJ Γ e (inst P n) := by
  let D := totalStep d
  let a := totalSeed p
  let u := projectedFold D a
  let run : Poly := .app (.app n D) a
  have hD := total_step_has hc hP hd
  have ha := total_seed_has hc hP hp
  have hu : HasJ Γ u NT := projectedFold_has hc hP hD ha
  have hE : FormJ Γ (total P) := .sigma (N_form hc) hP
  have hrun : HasJ Γ run (total P) := fold_has hc hE hn hD ha
  have hfst : HasJ Γ (fstPoly run) N := .sigmaFst (N_form hc) hE hrun
  have hsnd : HasJ Γ (sndPoly run) (inst P (fstPoly run)) :=
    .sigmaSnd hE (form_inst_source hc hP hfst) hrun
  have huN := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) hu hn
  have rid := rigidity_elim hc hu hr
    ((projected_zero_evidence hc hP hp hd))
    ((projected_step_evidence hc hP hp hd))
  have point := rigidity_pointwise hc hu hn rid
  have link : HasJ Γ ident (.identity N (fstPoly run) (.app u n)) :=
    identityIntro_raw (.identity (N_form hc) hfst huN) hfst huN (projectedFold_beta D a n).symm
  have back := nat_identity_trans hc hfst huN hn (link) point
  exact ⟨_, transport_source hc (N_form hc) hP hfst hn back (hsnd)⟩


end JointCompletion.InductionComputation
import Lean
import ExtensionInputControls
open Lean Elab Command

private partial def countConstant (target : Name) : Expr → Nat
  | .const n _ => if n == target then 1 else 0
  | .app f a => countConstant target f + countConstant target a
  | .lam _ t b _ => countConstant target t + countConstant target b
  | .forallE _ t b _ => countConstant target t + countConstant target b
  | .letE _ t v b _ => countConstant target t + countConstant target v + countConstant target b
  | .mdata _ b => countConstant target b
  | .proj _ _ b => countConstant target b
  | _ => 0

run_cmd do
  let env ← getEnv
  let some (.inductInfo hasInfo) := env.find? ``P01AC.ExtensionalRepair.HasE
    | throwError "Actual HasE is not an inductive"
  unless hasInfo.ctors.length == 20 do throwError "Changed HasE grammar"
  let some (.inductInfo formInfo) := env.find? ``P01AC.ExtensionalRepair.FormE
    | throwError "Actual FormE is not an inductive"
  unless formInfo.ctors.length == 7 do throwError "Changed FormE grammar"
  logInfo m!"Actual grammar: {hasInfo.ctors.length} HasE constructors, {formInfo.ctors.length} FormE constructors"
  for target in [``P01AC.ExtensionalRepair.Structural.form_trename,
      ``P01AC.ExtensionalRepair.Structural.form_rename,
      ``P01AC.ExtensionalRepair.Structural.has_closed,
      ``ClosedChurchIdentity.identity_of_observation,
      ``ClosedChurchIdentity.canonicity_at_count,
      ``ClosedChurchIdentity.closed_canonicity,
      ``ClosedChurchIdentity.identity_implies_count_eq,
      ``ClosedChurchIdentity.identity_exists_iff_count_eq,
      ``EffectiveChurchIdentity.identity_iff_original_semantics,
      ``EffectiveChurchIdentity.decideTypedIdentity,
      ``EffectiveChurchIdentity.decideTypedIdentityExists] do
    let (_, state) := ((Lean.CollectAxioms.collect target).run env).run {}
    for ax in state.axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Unexpected axiom {ax} in {target}"
    logInfo m!"PASS allowed axioms for {target}: {state.axioms}"
  let (_, structural) := ((Lean.CollectAxioms.collect ``P01AC.ExtensionalRepair.Structural.has_closed).run env).run {}
  for forbidden in [``P01AC.has_rename, ``P01AC.form_rename,
      ``P01AC.BooleanPrimitive.closed_has, ``P01AC.ExtensionalRepair.unary_fundamental,
      ``FullPER.fundamental, ``ClosedScalarInstances.source_uniform_iteration] do
    if structural.visited.contains forbidden then throwError "Structural proof relies on {forbidden}"
  for needed in [``P01AC.ExtensionalRepair.Structural.form_rename,
      ``P01AC.ExtensionalRepair.Structural.form_trename,
      ``P01AC.ExtensionalRepair.FormE.rec, ``P01AC.ExtensionalRepair.HasE.piExt,
      ``P01AC.ExtensionalRepair.HasE.allExt] do
    unless structural.visited.contains needed do throwError "Structural proof omitted {needed}"
  let some (.thmInfo construct) := env.find? ``ClosedChurchIdentity.identity_of_observation
    | throwError "Identity construction is not a theorem"
  unless countConstant ``P01AC.ExtensionalRepair.HasE.piExt construct.value == 2 do
    throwError "Expected exactly two direct piExt uses"
  unless countConstant ``P01AC.ExtensionalRepair.HasE.allExt construct.value == 1 do
    throwError "Expected exactly one direct allExt use"
  let (_, canonical) := ((Lean.CollectAxioms.collect ``ClosedChurchIdentity.canonicity_at_count).run env).run {}
  unless canonical.visited.contains ``P01AC.ExtensionalRepair.Structural.closed_church_weaken do
    throwError "Canonicity omitted actual source weakening"
  let (_, negative) := ((Lean.CollectAxioms.collect ``ClosedChurchIdentity.identity_implies_count_eq).run env).run {}
  for needed in [``P01AC.ExtensionalRepair.unary_fundamental, ``P01AC.IdentityComplexity.related_same_index] do
    unless negative.visited.contains needed do throwError "Negative direction omitted {needed}"
  for forbidden in [``ClosedChurchIdentity.identity_of_observation,
      ``P01AC.ExtensionalRepair.Structural.has_closed, ``OpenDevelopments.extractIteration] do
    if negative.visited.contains forbidden then throwError "Negative direction unexpectedly relies on {forbidden}"
  for target in [``EffectiveChurchIdentity.decideTypedIdentity, ``EffectiveChurchIdentity.decideTypedIdentityExists] do
    let (_, decision) := ((Lean.CollectAxioms.collect target).run env).run {}
    for needed in [``OpenDevelopments.extractIteration, ``Nat.find, ``OpenDevelopments.readIteration] do
      unless decision.visited.contains needed do throwError "Decision omitted executable dependency {needed}"
  let some (.thmInfo transported) := env.find? ``ClosedChurchReview.transported_has
    | throwError "J-built input is not a theorem"
  unless countConstant ``P01AC.ExtensionalRepair.HasE.j transported.value == 1 do
    throwError "Expected actual J constructor in transported input"
  let (_, transportedDeps) := ((Lean.CollectAxioms.collect ``ClosedChurchReview.transported_has).run env).run {}
  for needed in [``ClosedChurchIdentity.identity_of_observation,
      ``P01AC.ExtensionalRepair.HasE.piExt, ``P01AC.ExtensionalRepair.HasE.allExt] do
    unless transportedDeps.visited.contains needed do throwError "J input omitted actual extensional proof {needed}"
  logInfo "PASS: exact mutual grammar, source-only actual weakening, two piExt/one allExt, negative semantic separation, executable extraction dependencies."
import UniquenessConverse
namespace ConverseIndependentReview
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open SourceRigidity RigidityInitiality InternalRecursorPrinciple

-- Two actual closed source implications between the exact unchanged formulas.
example : HasE [] (abstract uniqueUniformProof) (arr Rigidity Uniqueness) ∧
    HasE [] (abstract (abstract (abstract (abstract ident)))) (arr Uniqueness Rigidity) :=
  ⟨rigidity_implies_internal_uniqueness, internal_uniqueness_implies_rigidity⟩
example : Scoped 0 (abstract (abstract (abstract (abstract ident)))) :=
  hasE_scoped internal_uniqueness_implies_rigidity

-- Arbitrary source evidence has scope; no weakening or substitution rule is claimed.
example {Γ : Tel} {p : Poly} {X : Ty} (h : HasE Γ p X) : Scoped Γ.length p := hasE_scoped h

-- Actual All elimination at N preserves both exact recursor endpoints.
example {Γ : Tel} {w u z s : Poly} (hc : Ctx Γ)
    (hw : HasE Γ w Uniqueness) (hu : Has Γ u NT)
    (hz : Has Γ z (ZeroAt u)) (hs : Has Γ s (StepAt u)) :
    ∃ e, HasE Γ e (.pi N (.identity N
      (.app (pren Nat.succ u) (.var 0))
      (.app (.app (.var 0) P01AC.BooleanPrimitive.succPoly) zero))) :=
  uniqueness_nat_instance hc hw hu hz hs

-- Source piExt returns the exact Rigidity direction I=u, not its reverse.
example {Γ : Tel} {w u z s : Poly} (hc : Ctx Γ)
    (hw : Has Γ w Uniqueness) (hu : Has Γ u NT)
    (hz : Has Γ z (ZeroAt u)) (hs : Has Γ s (StepAt u)) :
    HasE Γ ident (.identity (arr N N) ident u) := uniqueness_endomorphism hc hw hu hz hs
#print axioms internal_uniqueness_implies_rigidity
end ConverseIndependentReview
import GraphBridgeAssembly
import Lean

namespace P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.Controls
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01AC.EffectiveCompleteness
open P01AC.Intensional.Plus (PolyConvPlus)
open FullPER.Application (originalQ)
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

-- The initial assembly retains the graph-invariant witness under erasure.
-- No claim that it raw-converts to I is needed or made.
theorem assembly_erases_to_graph (stateEvidence scalarEvidence : Poly) :
    PolyConvPlus (assembledProof stateEvidence scalarEvidence)
      (sndPoly (sndPoly (graphRun (.var 2) (.var 1) (.var 0)))) :=
  (ExactScalarFusion.j_conversion _ _ _).trans
    ((ExactScalarFusion.j_conversion _ _ _).trans (ExactScalarFusion.j_conversion _ _ _))

-- The additional, typed J reset is what creates an I-convertible witness.
def resetProof (stateEvidence scalarEvidence : Poly) : Poly :=
  jPoly (.atom .i) (ExactScalarFusion.scalarR originalQ)
    (assembledProof stateEvidence scalarEvidence)

theorem reset_proof_hasE {stateEvidence scalarEvidence : Poly}
    (hs : HasE scalarContext stateEvidence stateTransport)
    (hx : HasE scalarContext scalarEvidence scalarTransport) :
    HasE scalarContext (resetProof stateEvidence scalarEvidence)
      (ExactScalarFusion.Leaf originalQ) := by
  have hc := scalar_context_formed
  have hl := ExactScalarFusion.scalar_n_has hc n_has f_has a_has
  have hq := ExactScalarFusion.closed_has_T original_q_has hc
  have hqn := app_has (ExactScalarFusion.T_form hc) (N_form hc) hq n_has
  have hqr := ExactScalarFusion.scalar_n_has hc hqn f_has a_has
  have hrefl : Has scalarContext (.atom .i)
      (.identity A ExactScalarFusion.scalarL ExactScalarFusion.scalarL) :=
    .identityIntro (.identity (.param hc) hl hl) hl hl (.refl _)
  exact trans_hasE hc hl hl hqr (has_inclusion hrefl) (scalar_leaf_from_bridges hs hx)

theorem reset_proof_erases (stateEvidence scalarEvidence : Poly) :
    PolyConvPlus (resetProof stateEvidence scalarEvidence) (.atom .i) :=
  ExactScalarFusion.j_conversion _ _ _

-- Literal identity of all three retained target objects.
example : originalQ = P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed := rfl
example : ExactScalarFusion.c3 =
    abstract (abstract (abstract (.atom OrthemologyV2.Term.i))) := rfl
example : ExactScalarFusion.W originalQ =
    Ty.pi N (.all (.pi End (.pi A (ExactScalarFusion.Leaf originalQ)))) := rfl

-- No stronger, older Has premise is needed for either bridge.
example (p q : Poly) (hp : HasE scalarContext p stateTransport)
    (hq : HasE scalarContext q scalarTransport) :
    HasE [] ExactScalarFusion.c3 (ExactScalarFusion.W originalQ) :=
  scalar_fusion_from_bridges hp hq

#check @image_congr_hasE
#check @trans_hasE
#check @replace_left_hasE
#check @identity_i_hasE
#check @scalar_leaf_from_bridges
#check @scalar_leaf_i_from_bridges
#check @scalar_fusion_from_bridges
#print axioms reset_proof_hasE
#print axioms reset_proof_erases
end P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.Controls

open Lean Elab Command
run_cmd do
  let env ← getEnv
  let blocked := [``P01AC.F, ``P01AC.G, ``P01AC.predicates,
    ``P01R.finite_fundamental, ``P01AC.form_sound, ``P01AC.has_sound,
    ``P01AC.fundamental, ``P01AC.ExtensionalRepair.form_sound,
    ``P01AC.ExtensionalRepair.has_sound, ``P01AC.ExtensionalRepair.fundamental,
    ``P01AC.ExtensionalRepair.unary_fundamental,
    ``P01AC.EffectiveCompleteness.semantic_church_standardness,
    ``P01AC.EffectiveCompleteness.graph_application,
    ``FullPER.F, ``FullPER.fundamental,
    ``FullPER.Application.scalar_target_valid, ``FullPER.Application.scalar_target_fundamental]
  let targets := [``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.image_congr_hasE,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.trans_hasE,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.replace_left_hasE,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.identity_i_hasE,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.scalar_leaf_from_bridges,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.scalar_leaf_i_from_bridges,
    ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.scalar_fusion_from_bridges]
  for target in targets do
    let (_, state) := ((Lean.CollectAxioms.collect target).run env).run {}
    for old in blocked do
      if state.visited.contains old then
        throwError "Forbidden semantic dependency {old} in source construction {target}"
    for ax in state.axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Unexpected axiom {ax} in {target}"
    logInfo m!"PASS source-only: {target}; axioms {state.axioms}"
  let target := ``P01AC.ExtensionalRepair.InternalGraph.BridgeAssembly.scalar_fusion_from_bridges
  let (_, state) := ((Lean.CollectAxioms.collect target).run env).run {}
  for required in [``P01AC.ExtensionalRepair.HasE.j, ``P01AC.ExtensionalRepair.HasE.conv,
      ``P01AC.ExtensionalRepair.HasE.piIntro, ``P01AC.ExtensionalRepair.HasE.allIntro,
      ``P01AC.ExtensionalRepair.InternalGraph.literal_graph_invariant,
      ``P01AC.ExtensionalRepair.InternalGraph.original_scalar_computation] do
    unless state.visited.contains required do
      throwError "Missing required actual source dependency {required}"
    logInfo m!"PASS required actual dependency: {required}"
import TelescopeValidityControls
open TelescopeCodeValidity Encodable OrthemologyV2 P01AC
example : validTel (Nat.pair (encode Ty.raw) 1 + 1) = true := by decide
import RobustBinaryRepair
import Mathlib.MeasureTheory.Measure.MeasureSpaceDef

open MeasureTheory Set

namespace Orthemology.Tranche3

/-- One pathwise simultaneous interval coverage event. -/
def IntervalCoverage {Ω : Type*} (a : ℝ) (lower upper : Ω → ℕ → ℝ) : Set Ω :=
  {w | ∀ n, lower w n ≤ a ∧ a ≤ upper w n}

/-- Every certificate that is issued on this path is sound. Uncertified
opportunities are not silently counted as successful repair. -/
def AllCertificatesSound {Ω : Type*} (a : ℝ)
    (lower upper disturbance tolerance : Ω → ℕ → ℝ) : Set Ω :=
  {w | ∀ n, robustValue (lower w n) (upper w n) (disturbance w n) ≤ tolerance w n →
    let q := robustReport (lower w n) (upper w n) (disturbance w n)
    0 ≤ q ∧ q ≤ 1 ∧ excessZero a (disturbance w n) q ≤ tolerance w n ∧
      excessOne a (disturbance w n) q ≤ tolerance w n}

/-- Pathwise safety requires only coverage on this path. There is no sampling,
independence, optional-stopping or termination assumption in this implication. -/
theorem coverage_subset_sound {Ω : Type*} (a : ℝ)
    (lower upper disturbance tolerance : Ω → ℕ → ℝ)
    (valid : ∀ w n, 0 ≤ lower w n ∧ upper w n ≤ 1 ∧
      0 ≤ disturbance w n ∧ disturbance w n ≤ 1/4) :
    AllCertificatesSound a lower upper disturbance tolerance ⊆ IntervalCoverage a lower upper := by
  intro w hw n hn
  exact covered_certificate_sound a
    (fun (_ : Unit) n => lower w n) (fun (_ : Unit) n => upper w n)
    (fun (_ : Unit) n => disturbance w n) (fun (_ : Unit) n => tolerance w n)
    (fun _ n => hw n) (fun _ n => valid w n) () n hn

/-- Any established simultaneous coverage error bound transfers unchanged to
all certified repairs, including data-dependent selection among them.
This is a measure bound (valid even as an outer-measure bound); it does not
establish the statistical coverage premise. -/
theorem certificate_failure_measure_le {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (a : ℝ) (lower upper disturbance tolerance : Ω → ℕ → ℝ)
    (valid : ∀ w n, 0 ≤ lower w n ∧ upper w n ≤ 1 ∧
      0 ≤ disturbance w n ∧ disturbance w n ≤ 1/4) :
    μ (AllCertificatesSound a lower upper disturbance tolerance)ᶜ ≤
      μ (IntervalCoverage a lower upper)ᶜ := by
  apply measure_mono
  exact compl_subset_compl.mpr (coverage_subset_sound a lower upper disturbance tolerance valid)

end Orthemology.Tranche3

#print axioms Orthemology.Tranche3.coverage_subset_sound
#print axioms Orthemology.Tranche3.certificate_failure_measure_le
import MomentRecovery
-- The distinct-support premise cannot be silently discarded.
example {K : Type*} [Field K] {N : ℕ} (a w : Fin N → K) :
    FiniteMoment.recover a (FiniteMoment.record a w) = w := by
  exact FiniteMoment.recover_record a w
