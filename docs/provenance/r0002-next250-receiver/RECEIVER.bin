def main : IO Unit := do
  for (c,i) in HiddenParity.NormalizedOracle.cases.zipIdx do
    IO.println s!"{i},{HiddenParity.NormalizedOracle.solve c}"
import NativeCheckerBridge
set_option maxRecDepth 200000
set_option maxHeartbeats 0
