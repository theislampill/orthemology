import IndependentSourceEquations
import IndependentCodeEquations
open Lean in
run_cmd do
  let env ← getEnv
  let names := #[
    `CodedMixedTransformations.primrec_renImage,
    `CodedMixedTransformations.primrec_liftRenCode,
    `CodedMixedTransformations.finiteRen_lift,
    `CodedMixedTransformations.primrec_paramCode,
    `CodedMixedTransformations.primrec_renameTyChildren,
    `CodedMixedTransformations.primrec_renameTyStep,
    `CodedMixedTransformations.primrec_renameTyCode,
    `CodedMixedTransformations.renameTyCode_eq,
    `CodedMixedTransformations.fold_eq_renameTyCode,
    `CodedMixedTransformations.renameTyCode_exact,
    `CodedMixedTransformations.primrec_twkCode,
    `CodedMixedTransformations.twkCode_exact,
    `CodedMixedTransformations.primrec_liftTCEnv,
    `CodedMixedTransformations.tcImage_exact,
    `CodedMixedTransformations.finiteTCEnv_lift,
    `CodedMixedTransformations.liftTCEnv_exact,
    `CodedMixedTransformations.primrec_tcSubChildren,
    `CodedMixedTransformations.primrec_tcSubStep,
    `CodedMixedTransformations.primrec_substituteTypeCode,
    `CodedMixedTransformations.substituteTypeCode_eq,
    `CodedMixedTransformations.fold_eq_substituteTypeCode,
    `CodedMixedTransformations.substituteTypeCode_exact,
    `CodedMixedTransformations.primrec_instantiateTypeCode,
    `CodedMixedTransformations.finiteTCEnv_single,
    `CodedMixedTransformations.instantiateTypeCode_exact,
    `CodedMixedTransformations.primrec_typeImageCode,
    `CodedMixedTransformations.primrec_termLift,
    `CodedMixedTransformations.primrec_typeLift,
    `CodedMixedTransformations.typeImageCode_exact,
    `CodedMixedTransformations.finiteTyEnv_term,
    `CodedMixedTransformations.finiteTyEnv_type,
    `CodedMixedTransformations.termLift_exact,
    `CodedMixedTransformations.typeLift_exact,
    `CodedMixedTransformations.finiteEnv_identity,
    `CodedMixedTransformations.finiteTyEnv_typeImages,
    `CodedMixedTransformations.finiteTyEnv_single,
    `CodedMixedTransformations.primrec_tinstCode,
    `CodedMixedTransformations.tinstCode_exact,
    `CodedMixedTransformations.primrec_tsubstImagesCode,
    `CodedMixedTransformations.tsubstImagesCode_exact,
    `CodedMixedTransformations.primrec_twkListCode,
    `CodedMixedTransformations.twkListCode_exact,
    `CodedMixedTransformations.primrec_tcPlainChildren,
    `CodedMixedTransformations.primrec_supportStep,
    `CodedMixedTransformations.primrec_finStep,
    `CodedMixedTransformations.primrec_finSupportCode,
    `CodedMixedTransformations.primrec_finCode,
    `CodedMixedTransformations.supportFold_exact,
    `CodedMixedTransformations.finFold_exact,
    `CodedMixedTransformations.finSupportCode_exact,
