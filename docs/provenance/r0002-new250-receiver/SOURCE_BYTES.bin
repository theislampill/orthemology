theorem poly_app_children (a b x y z w c d : Nat) :
    AuxiliaryCodeComputability.polyChildren (Nat.pair a b,pack 3 [leaf x, leaf y, leaf z, leaf w, c, d]) = ([(Nat.pair x y,c),(Nat.pair z w,d)]) := by
  simp only [AuxiliaryCodeComputability.polyChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_i_shape (a b x : Nat) :
    AuxiliaryCodeComputability.polyShape (Nat.pair a b,pack 4 [leaf x]) = (decide (a = polyApp (polyAtom (encode Term.i)) x) && decide (b = x)) := by
  simp only [AuxiliaryCodeComputability.polyShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_i_children (a b x : Nat) :
    AuxiliaryCodeComputability.polyChildren (Nat.pair a b,pack 4 [leaf x]) = ([]) := by
  simp only [AuxiliaryCodeComputability.polyChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_k_shape (a b x y : Nat) :
    AuxiliaryCodeComputability.polyShape (Nat.pair a b,pack 5 [leaf x, leaf y]) = (decide (a = polyApp (polyApp (polyAtom (encode Term.k)) x) y) && decide (b = x)) := by
  simp only [AuxiliaryCodeComputability.polyShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_k_children (a b x y : Nat) :
    AuxiliaryCodeComputability.polyChildren (Nat.pair a b,pack 5 [leaf x, leaf y]) = ([]) := by
  simp only [AuxiliaryCodeComputability.polyChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_s_shape (a b x y z : Nat) :
    AuxiliaryCodeComputability.polyShape (Nat.pair a b,pack 6 [leaf x, leaf y, leaf z]) = (decide (a = polyApp (polyApp (polyApp (polyAtom (encode Term.s)) x) y) z) && decide (b = polyApp (polyApp x z) (polyApp y z))) := by
  simp only [AuxiliaryCodeComputability.polyShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_s_children (a b x y z : Nat) :
    AuxiliaryCodeComputability.polyChildren (Nat.pair a b,pack 6 [leaf x, leaf y, leaf z]) = ([]) := by
  simp only [AuxiliaryCodeComputability.polyChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_bridge_shape (a b x y : Nat) :
    AuxiliaryCodeComputability.polyShape (Nat.pair a b,pack 7 [leaf x, leaf y]) = (decide (a = polyAtom (tmApp x y)) && decide (b = polyApp (polyAtom x) (polyAtom y))) := by
  simp only [AuxiliaryCodeComputability.polyShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem poly_bridge_children (a b x y : Nat) :
    AuxiliaryCodeComputability.polyChildren (Nat.pair a b,pack 7 [leaf x, leaf y]) = ([]) := by
  simp only [AuxiliaryCodeComputability.polyChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem lookup_zero_shape (a b n x y : Nat) :
    AuxiliaryCodeComputability.lookupShape (Nat.pair a (Nat.pair n b),pack 0 [leaf x, leaf y]) = ((decide (a = telCons y x) && decide (n = 0)) && decide (b = wkTyCode y)) := by
  simp only [AuxiliaryCodeComputability.lookupShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem lookup_zero_children (a b n x y : Nat) :
    AuxiliaryCodeComputability.lookupChildren (Nat.pair a (Nat.pair n b),pack 0 [leaf x, leaf y]) = ([]) := by
  simp only [AuxiliaryCodeComputability.lookupChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem lookup_succ_shape (a b n x y z w c : Nat) :
    AuxiliaryCodeComputability.lookupShape (Nat.pair a (Nat.pair n b),pack 1 [leaf x, leaf y, leaf z, leaf w, c]) = ((decide (a = telCons w x) && decide (n = y+1)) && decide (b = wkTyCode z)) := by
  simp only [AuxiliaryCodeComputability.lookupShape,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

theorem lookup_succ_children (a b n x y z w c : Nat) :
    AuxiliaryCodeComputability.lookupChildren (Nat.pair a (Nat.pair n b),pack 1 [leaf x, leaf y, leaf z, leaf w, c]) = ([(Nat.pair x (Nat.pair y z),c)]) := by
  simp only [AuxiliaryCodeComputability.lookupChildren,pack,List.foldr_cons,List.foldr_nil,a1,a2,a3,a4,a5,a6,v1,v2,v3,v4,v5,v6,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,unpair_leaf,lhs_pair,rhs_pair,lookupIndex_pair,lookupType_pair]
  simp

-- Complete evaluator reductions, rather than only local shape checks.
theorem step_i_full (x : Nat) : checkStepCode (pack 0 [leaf x]) (tmApp (encode Term.i) x) x = true := by
  rw [checkStepCode,evaluate]
  simp [step_i_shape,step_i_children]
theorem red_refl_full (x : Nat) : checkRedCode (pack 0 [leaf x]) x x = true := by
  rw [checkRedCode,evaluate]
  simp [red_refl_shape,red_refl_children]
theorem finite_i_full (x : Nat) : checkFiniteCode (pack 0 [leaf x]) (encode Term.i) (tyArrow x x) = true := by
  rw [checkFiniteCode,evaluate]
  simp [finite_i_shape,finite_i_children]
theorem poly_bridge_full (x y : Nat) : checkPolyCode (pack 7 [leaf x,leaf y]) (polyAtom (tmApp x y)) (polyApp (polyAtom x) (polyAtom y)) = true := by
  rw [checkPolyCode,evaluate]
  simp [poly_bridge_shape,poly_bridge_children]
theorem lookup_zero_full (g a : Nat) : checkLookupCode (pack 0 [leaf g,leaf a]) (telCons a g) 0 (wkTyCode a) = true := by
  rw [checkLookupCode,evaluate]
  simp [lookup_zero_shape,lookup_zero_children]

theorem lookup_successor_recurrence (g n a b c : Nat) :
    checkLookupCode (pack 1 [leaf g,leaf n,leaf a,leaf b,c]) (telCons b g) (n+1) (wkTyCode a) =
    checkLookupCode c g n a := by
  have hc : c < pack 1 [leaf g,leaf n,leaf a,leaf b,c] := field_lt_pack _ _ (by simp)
  rw [checkLookupCode,evaluate]
  simp [lookup_succ_shape,lookup_succ_children,hc,eval_lookup]

-- Two successors enforce three actual weakenings from the initial stored type.
theorem lookup_three_weakenings (a b d : Nat) :
  let c0 := pack 0 [leaf 0,leaf a]
  let g1 := telCons a 0
  let c1 := pack 1 [leaf g1,leaf 0,leaf (wkTyCode a),leaf b,c0]
  let g2 := telCons b g1
  let c2 := pack 1 [leaf g2,leaf 1,leaf (wkTyCode (wkTyCode a)),leaf d,c1]
  checkLookupCode c2 (telCons d g2) 2 (wkTyCode (wkTyCode (wkTyCode a))) = true := by
  dsimp only
  rw [lookup_successor_recurrence,lookup_successor_recurrence,lookup_zero_full]
end IndependentAuxiliaryCodeReview
import TypeSubstitutionApplications
namespace HasEMixedReview
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.ExtensionalRepair
open P01AC.ExtensionalRepair.Structural
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

def endTy (k : Nat) : Ty := arr (.param k) (.param k)
theorem end_form {Γ : Tel} (hc : CtxE Γ) (k : Nat) : FormE Γ (endTy k) :=
  .pi (.param hc) (.param (.ext hc (.param hc)))
theorem end_i {Γ : Tel} (hc : CtxE Γ) (k : Nat) : HasE Γ (.atom .i) (endTy k) :=
  .i (.param hc) (end_form hc k)

-- Real piExt input at an open type parameter, not just an assumed derivation.
theorem pi_ext_input (k : Nat) : HasE [] (.atom .i)
    (.identity (endTy k) (.atom .i) (.atom .i)) := by
  have ha : FormE [] (.param k) := .param .nil
  have hc : CtxE [Ty.param k] := .ext .nil ha
  have hb : FormE [Ty.param k] (.param k) := .param hc
  have hi := end_i (Γ := []) .nil k
  have hv : HasE [Ty.param k] (.var 0) (.param k) := .var hb .zero
  have happ : HasE [Ty.param k] (.app (.atom .i) (.var 0)) (.param k) :=
    .piElim (end_form hc k) hb (end_i hc k) hv
  have hbody := FormE.identity hb happ happ
  have hfam := FormE.pi ha hbody
  have he := HasE.identityIntro hbody happ happ (Intensional.Plus.PolyConvPlus.refl _)
  have hh := HasE.piIntro hfam he (scoped_abstract (by trivial))
  exact .piExt ha hb (end_form .nil k) hi hi hbody hfam hh
    (.identity (end_form .nil k) hi hi) (by trivial) (by trivial)
    (scoped_abstract (by trivial)) (by trivial) (by trivial)

-- The allExt input contains the actual piExt input under the type binder.
theorem all_ext_input : HasE [] (.atom .i)
    (.identity (.all (endTy 1)) (.atom .i) (.atom .i)) := by
  have hb := end_form (Γ := []) .nil 1
  have hf : FormE [] (.all (endTy 1)) := .all .nil hb
  have hi : HasE [] (.atom .i) (.all (endTy 1)) := .allIntro hf (end_i .nil 1)
  exact .allExt hb hf hi hi (.identity hb (end_i .nil 1) (end_i .nil 1))
    (pi_ext_input 1) (.identity hf hi hi) (by trivial) (by trivial) (by trivial)
    (by trivial)

def depImage : Ty := .identity .raw (.var 0) (.var 0)
def rawCtx : Tel := [.raw]
theorem raw_ctx : CtxE rawCtx := .ext .nil (.raw .nil)
theorem dep_image_formed : FormE rawCtx depImage :=
  .identity (.raw raw_ctx) (.var (.raw raw_ctx) .zero) (.var (.raw raw_ctx) .zero)

-- Both binders protect the image; the free target term index becomes 1 under Pi.
theorem transport_actual_ext : HasE rawCtx (.atom .i)
    (.identity (.all (.pi depImage (.identity .raw (.var 1) (.var 1))))
      (.atom .i) (.atom .i)) := by
  exact has_closed_tsubst all_ext_input raw_ctx (τ := fun _ => depImage)
    (fun _ => dep_image_formed)

-- Same type image then follows actual dependent term substitution to closed endpoints.
theorem transport_actual_ext_then_term : HasE [] (.atom .i)
    (.identity (.all (.pi (.identity .raw (.atom .i) (.atom .i))
      (.identity .raw (.atom .i) (.atom .i)))) (.atom .i) (.atom .i)) := by
  exact has_subst transport_actual_ext .nil
    (TypedSubstitution.single .nil (HasE.rawAtom (t := .i) (.raw .nil)))

-- Finite type images have genuine target formation; scope alone is insufficient.
theorem no_out_of_scope_type : ¬ FormE rawCtx (.identity .raw (.var 1) (.var 1)) := by
  intro hf
  have hs := form_scoped hf
  change True ∧ 1 < 1 ∧ 1 < 1 at hs
  exact Nat.lt_irrefl 1 hs.2.1

-- The literal two-sort calculation discriminates capture of either sort.
theorem protects_both_indices :
    tsubst (cons (.identity (.param 0) (.var 0) (.var 0)) Ty.param)
      (.all (.pi .raw (.param 1))) =
      .all (.pi .raw (.identity (.param 1) (.var 1) (.var 1))) := rfl

theorem rejects_term_capture :
    tsubst (cons (.identity (.param 0) (.var 0) (.var 0)) Ty.param)
      (.all (.pi .raw (.param 1))) ≠
      .all (.pi .raw (.identity (.param 1) (.var 0) (.var 0))) := by decide

theorem rejects_type_capture :
    tsubst (cons (.identity (.param 0) (.var 0) (.var 0)) Ty.param)
      (.all (.pi .raw (.param 1))) ≠
      .all (.pi .raw (.identity (.param 0) (.var 1) (.var 1))) := by decide

#print axioms transport_actual_ext
#print axioms transport_actual_ext_then_term
#print axioms no_out_of_scope_type
end HasEMixedReview
import LocalRigidity
import SmoothScalar

noncomputable section
open scoped Topology BigOperators
open Filter Set Asymptotics

namespace SmoothRigidity

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- First-order expansion along a convergent varying direction, rather than
only a fixed directional ray. -/
lemma varying_direction_limit (f : E → ℝ) (L : E →L[ℝ] ℝ) (p z : E)
    (hf : HasFDerivAt f L p) (e : ℕ → ℝ) (r : ℕ → E)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (hr : Tendsto r atTop (𝓝 z)) :
    Tendsto (fun n => (f (p + e n • r n) - f p) / e n) atTop (𝓝 (L z)) := by
  have hpert : Tendsto (fun n => e n • r n) atTop (𝓝 (0 : E)) := by
    simpa using he.smul hr
  have hrem := (hasFDerivAt_iff_isLittleO_nhds_zero.mp hf).comp_tendsto hpert
  have hscale : (fun n => e n • r n) =O[atTop] e := by
    simpa using (isBigO_refl e atTop).smul (hr.isBigO_one ℝ)
  have hsmall := hrem.trans_isBigO hscale
  have hremdiv := hsmall.tendsto_div_nhds_zero
  have hlinear : Tendsto (fun n => L (r n)) atTop (𝓝 (L z)) := L.continuous.tendsto z |>.comp hr
  have hsum := hremdiv.add hlinear
  have hid : ∀ n, (f (p + e n • r n) - f p) / e n =
      (f (p + e n • r n) - f p - L (e n • r n)) / e n + L (r n) := by
    intro n
    rw [map_smul]
    simp only [smul_eq_mul]
    field_simp [ne_of_gt (hepos n)]
    ring
  simpa only [Function.comp_apply, ← hid, zero_add] using hsum

lemma smooth_first_order_nonnegative (f : E → ℝ) (L : E →L[ℝ] ℝ) (p h z : E)
    (hf : HasFDerivAt f L p) (e : ℕ → ℝ) (r : ℕ → E)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (hr : Tendsto r atTop (𝓝 z))
    (hgain : ∀ n, f (p + e n • r n) ≤ f (p + e n • h)) :
    0 ≤ L (h - z) := by
  have hbase := varying_direction_limit f L p h hf e (fun _ => h) hepos he tendsto_const_nhds
  have hrepair := varying_direction_limit f L p z hf e r hepos he hr
  have hlim := hbase.sub hrepair
  have hnonneg : ∀ᶠ n in atTop,
      0 ≤ (f (p + e n • h) - f p) / e n -
        (f (p + e n • r n) - f p) / e n := by
    apply Filter.Eventually.of_forall
    intro n
    exact sub_nonneg.mpr ((div_le_div_iff_of_pos_right (hepos n)).mpr (by linarith [hgain n]))
  have h := ge_of_tendsto hlim hnonneg
  simpa only [map_sub] using h



def bregman (F : E → ℝ) (G : E → E →L[ℝ] ℝ) (v b : E) : ℝ :=
  F b - F v - G v (b - v)

lemma bregman_gain (F : E → ℝ) (G : E → E →L[ℝ] ℝ) (p v b c : E) :
    bregman F G v b - bregman F G v c =
      bregman F G p b - bregman F G p c + (G c - G b) (v - p) := by
  simp only [bregman, map_sub, ContinuousLinearMap.sub_apply]
  ring

lemma weighted_bregman_gain {ι : Type*} [Fintype ι]
    (F : E → ℝ) (G : E → E →L[ℝ] ℝ)
    (v : ι → E) (w : ι → ℝ) (p b c : E)
    (hsum : ∑ i, w i = 1) (hcenter : ∑ i, w i • v i = p) :
    (∑ i, w i * (bregman F G (v i) b - bregman F G (v i) c)) =
      bregman F G p b - bregman F G p c := by
  have hvzero := LocalRigidity.barycenter_sub_sum v w p hsum hcenter
  have hlin : (∑ i, w i * (G c - G b) (v i - p)) = 0 := by
    have hzero : ∑ i, w i • (v i - p) = 0 := by
      have heq : (∑ i, w i • (v i - p)) = -(∑ i, w i • (p - v i)) := by
        simp only [← Finset.sum_neg_distrib, ← smul_neg, neg_sub]
      rw [heq, hvzero, neg_zero]
    have happly : (G c - G b) (∑ i, w i • (v i - p)) = 0 := by rw [hzero]; simp
    simpa only [map_sum, map_smul, smul_eq_mul] using happly
  rw [show (∑ i, w i * (bregman F G (v i) b - bregman F G (v i) c)) =
      ∑ i, w i * (bregman F G p b - bregman F G p c + (G c - G b) (v i - p)) by
    apply Finset.sum_congr rfl
    intro i _
    rw [bregman_gain F G p]]
  simp only [mul_add, Finset.sum_add_distrib, ← Finset.sum_mul]
  rw [hlin, hsum]
  ring

lemma bregman_regret_bound {ι : Type*} [Fintype ι]
    (F : E → ℝ) (G : E → E →L[ℝ] ℝ)
    (v : ι → E) (w : ι → ℝ) (p b c : E)
    (hw : ∀ i, 0 ≤ w i) (hsum : ∑ i, w i = 1) (hcenter : ∑ i, w i • v i = p)
    (hgain : ∀ i, bregman F G (v i) c ≤ bregman F G (v i) b) :
    bregman F G p c ≤ bregman F G p b := by
  have hnonneg : 0 ≤ ∑ i, w i * (bregman F G (v i) b - bregman F G (v i) c) := by
    exact Finset.sum_nonneg (fun i _ => mul_nonneg (hw i) (sub_nonneg.mpr (hgain i)))
  rw [weighted_bregman_gain F G v w p b c hsum hcenter] at hnonneg
  linarith

section FiniteScores
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

abbrev Vec (ι : Type*) := ι → ℝ

def potential (s : ι → SmoothScalar.Score) (x : Vec ι) : ℝ := ∑ i, (s i).f (x i)

def gradient (s : ι → SmoothScalar.Score) (x : Vec ι) : Vec ι →L[ℝ] ℝ :=
  ∑ i, (s i).df (x i) • (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ)

def hessian (s : ι → SmoothScalar.Score) (p : Vec ι) : LocalRigidity.Form (Vec ι) :=
  ∑ i, (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ).smulRight
    ((s i).ddf (p i) • (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ))

abbrev totalDiv (s : ι → SmoothScalar.Score) := bregman (potential s) (gradient s)

def vertex (i : ι) : Vec ι := Pi.single i 1

lemma hessian_apply (s : ι → SmoothScalar.Score) (p x y : Vec ι) :
    hessian s p x y = ∑ i, (s i).ddf (p i) * x i * y i := by
  simp only [hessian, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smulRight_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.proj_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma totalDiv_eq_sum (s : ι → SmoothScalar.Score) (v b : Vec ι) :
    totalDiv s v b = ∑ i, SmoothScalar.divergence (s i) (v i) (b i) := by
  simp only [totalDiv, bregman, potential, gradient, ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.proj_apply, Pi.sub_apply, smul_eq_mul,
    SmoothScalar.divergence, Finset.sum_sub_distrib]

lemma score_hasFDerivAt (s : ι → SmoothScalar.Score) (v p : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) :
    HasFDerivAt (totalDiv s v) (hessian s p (p - v)) p := by
  have hj : ∀ i, HasFDerivAt (fun x : Vec ι => SmoothScalar.divergence (s i) (v i) (x i))
      (((s i).ddf (p i) * (p i - v i)) • (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ)) p := by
    intro i
    exact (SmoothScalar.divergence_deriv (s i) (v i) (p i) (hp i)).comp_hasFDerivAt p
      (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ).hasFDerivAt
  have hh := HasFDerivAt.sum (u := Finset.univ) (fun i _ => hj i)
  have heq : (∑ i, ((s i).ddf (p i) * (p i - v i)) •
      (ContinuousLinearMap.proj i : Vec ι →L[ℝ] ℝ)) = hessian s p (p - v) := by
    ext x
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.proj_apply, smul_eq_mul, hessian_apply, Pi.sub_apply]
  rw [heq] at hh
  simpa only [← totalDiv_eq_sum] using hh

lemma vertex_barycenter (p : Vec ι) : ∑ i, p i • vertex i = p := by
  ext j
  simp [vertex, Pi.single_apply]

lemma totalDiv_nonneg (s : ι → SmoothScalar.Score) (p c : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hc : ∀ i, c i ∈ Ioo 0 1) : 0 ≤ totalDiv s p c := by
  rw [totalDiv_eq_sum]
  exact Finset.sum_nonneg (fun i _ => SmoothScalar.divergence_nonneg (s i) (p i) (c i) (hp i) (hc i))



lemma vertex_regret_bound (s : ι → SmoothScalar.Score) (p b c : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hsum : ∑ i, p i = 1)
    (hgain : ∀ i, totalDiv s (vertex i) c ≤ totalDiv s (vertex i) b) :
    totalDiv s p c ≤ totalDiv s p b :=
  bregman_regret_bound (potential s) (gradient s) vertex p p b c
    (fun i => (hp i).1.le) hsum (vertex_barycenter p) hgain

lemma scalar_divergence_le_total (s : ι → SmoothScalar.Score) (p c : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hc : ∀ i, c i ∈ Ioo 0 1) (i : ι) :
    SmoothScalar.divergence (s i) (p i) (c i) ≤ totalDiv s p c := by
  rw [totalDiv_eq_sum]
  exact Finset.single_le_sum
    (fun j _ => SmoothScalar.divergence_nonneg (s j) (p j) (c j) (hp j) (hc j)) (Finset.mem_univ i)

/-- Successful coherent repairs localize without any assumed bound on endpoint derivatives. -/
lemma repairs_tendsto (s : ι → SmoothScalar.Score) (p : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hsum : ∑ i, p i = 1)
    (b c : ℕ → Vec ι) (hb : Tendsto b atTop (𝓝 p))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hgain : ∀ n i, totalDiv s (vertex i) (c n) ≤ totalDiv s (vertex i) (b n)) :
    Tendsto c atTop (𝓝 p) := by
  have hregret : ∀ n, totalDiv s p (c n) ≤ totalDiv s p (b n) :=
    fun n => vertex_regret_bound s p (b n) (c n) hp hsum (hgain n)
  have hlim : Tendsto (fun n => totalDiv s p (b n)) atTop (𝓝 0) := by
    have h := (score_hasFDerivAt s p p hp).continuousAt.tendsto.comp hb
    simpa [totalDiv, bregman, Function.comp_def] using h
  apply tendsto_pi_nhds.mpr
  intro i
  apply SmoothScalar.tendsto_of_divergence_tendsto_zero (s i) (p i) (hp i) (fun n => c n i)
    (fun n => hc n i)
  exact squeeze_zero
    (fun n => SmoothScalar.divergence_nonneg (s i) (p i) (c n i) (hp i) (hc n i))
    (fun n => (scalar_divergence_le_total s p (c n) hp (hc n) i).trans (hregret n)) hlim

/-- Local lower and upper Hessian bounds prove bounded normalized repairs.
This estimate is derived from actual Bregman score inequalities. -/
lemma normalized_repairs_bounded (s : ι → SmoothScalar.Score) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hsum : ∑ i, p i = 1)
    (e : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hgain : ∀ n i, totalDiv s (vertex i) (c n) ≤ totalDiv s (vertex i) (p + e n • h)) :
    ∃ R : ℝ, ∀ᶠ n in atTop, ‖(e n)⁻¹ • (c n - p)‖ ≤ R := by
  let base : ℕ → Vec ι := fun n => p + e n • h
  have hbase : Tendsto base atTop (𝓝 p) := by
    simpa [base] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => p) atTop (𝓝 p)).add
        (he.smul (tendsto_const_nhds : Tendsto (fun _ : ℕ => h) atTop (𝓝 h)))
  have hct := repairs_tendsto s p hp hsum base c hbase hc hgain
  choose a ha b hb hcurv using fun i => SmoothScalar.local_curvature_sandwich (s i) (p i) (hp i)
  let K : ℝ := ∑ i, b i * (h i) ^ 2
  have hK : 0 ≤ K := Finset.sum_nonneg (fun i _ => mul_nonneg (hb i).le (sq_nonneg (h i)))
  let R : ℝ := ∑ i, (K / a i + 1)
  have hterm : ∀ i, 0 ≤ K / a i + 1 := by
    intro i
    exact add_nonneg (div_nonneg hK (ha i).le) (by norm_num)
  have hR : 0 ≤ R := Finset.sum_nonneg (fun i _ => hterm i)
  have hlow : ∀ᶠ n in atTop, ∀ i,
      a i * (c n i - p i) ^ 2 ≤ SmoothScalar.divergence (s i) (p i) (c n i) := by
    apply Filter.eventually_all.mpr
    intro i
    exact ((tendsto_pi_nhds.mp hct) i).eventually ((hcurv i).mono (fun x hx => hx.1))
  have hupp : ∀ᶠ n in atTop, ∀ i,
      SmoothScalar.divergence (s i) (p i) (base n i) ≤ b i * (base n i - p i) ^ 2 := by
    apply Filter.eventually_all.mpr
    intro i
    exact ((tendsto_pi_nhds.mp hbase) i).eventually ((hcurv i).mono (fun x hx => hx.2))
  refine ⟨R, ?_⟩
  filter_upwards [hlow, hupp] with n hnlow hnupp
  have hregret := vertex_regret_bound s p (base n) (c n) hp hsum (hgain n)
  have htotal : totalDiv s p (base n) ≤ (e n) ^ 2 * K := by
    rw [totalDiv_eq_sum]
    calc
      (∑ i, SmoothScalar.divergence (s i) (p i) (base n i)) ≤
          ∑ i, b i * (base n i - p i) ^ 2 := Finset.sum_le_sum (fun i _ => hnupp i)
      _ = (e n) ^ 2 * K := by
        dsimp [base, K]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring
  apply (pi_norm_le_iff_of_nonneg hR).mpr
  intro i
  have hcoord : a i * (c n i - p i) ^ 2 ≤ (e n) ^ 2 * K :=
    (hnlow i).trans ((scalar_divergence_le_total s p (c n) hp (hc n) i).trans (hregret.trans htotal))
  let r : ℝ := ((e n)⁻¹ • (c n - p)) i
  have hid : c n i - p i = e n * r := by
    dsimp [r]
    field_simp [ne_of_gt (hepos n)]
  rw [hid] at hcoord
  have hnormalized : a i * r ^ 2 ≤ K := by
    have hmul : (e n) ^ 2 * (a i * r ^ 2) ≤ (e n) ^ 2 * K := by nlinarith
    exact (mul_le_mul_left (sq_pos_of_pos (hepos n))).mp hmul
  have hsq : |r| ^ 2 ≤ K / a i := by
    apply (le_div_iff₀ (ha i)).mpr
    rw [sq_abs]
    nlinarith
  have habs : |r| ≤ K / a i + 1 := by
    nlinarith [sq_nonneg (|r| - (1 : ℝ) / 2)]
  have hsumterm : K / a i + 1 ≤ R := Finset.single_le_sum (fun j _ => hterm j) (Finset.mem_univ i)
  change ‖r‖ ≤ R
  rw [Real.norm_eq_abs]
  exact habs.trans hsumterm



lemma hessian_symmetric (s : ι → SmoothScalar.Score) (p x y : Vec ι) :
    hessian s p x y = hessian s p y x := by
  rw [hessian_apply, hessian_apply]
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma hessian_positive (s : ι → SmoothScalar.Score) (p x : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hx : x ≠ 0) : 0 < hessian s p x x := by
  rw [hessian_apply]
  have hex : ∃ i, x i ≠ 0 := by
    by_contra! hn
    apply hx
    funext i
    exact hn i
  obtain ⟨j, hj⟩ := hex
  apply Finset.sum_pos'
  · intro i _
    simpa only [pow_two, mul_assoc] using
      mul_nonneg ((s i).positive (p i) (hp i)).le (sq_nonneg (x i))
  · refine ⟨j, Finset.mem_univ j, ?_⟩
    simpa only [pow_two, mul_assoc] using
      mul_pos ((s j).positive (p j) (hp j)) (sq_pos_of_ne_zero hj)

/-- Smooth S1: common small-error repairs force one tangent direction normal
under all positive Hessians. Localization, bounded scaling, compactness and
varying-direction differentiation are proved, not assumed. -/
theorem smooth_common_repair_hessian_necessary {K : Type*}
    (s : K → ι → SmoothScalar.Score) (k0 : K) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hsum : ∑ i, p i = 1)
    (e : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0 < e n) (he : Tendsto e atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1) (hcsum : ∀ n, ∑ i, c n i = 1)
    (hgain : ∀ n k i, totalDiv (s k) (vertex i) (c n) ≤
      totalDiv (s k) (vertex i) (p + e n • h)) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun i => p - vertex i)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun i => p - vertex i)) →
        hessian (s k) p (h - z) u = 0 := by
  let r : ℕ → Vec ι := fun n => (e n)⁻¹ • (c n - p)
  obtain ⟨R, hR⟩ := normalized_repairs_bounded (s k0) p h hp hsum e c hepos he hc
    (fun n i => hgain n k0 i)
  have hrball : ∀ᶠ n in atTop, r n ∈ Metric.closedBall (0 : Vec ι) R := by
    simpa only [Metric.mem_closedBall, dist_zero_right] using hR
  obtain ⟨z, hzball, phi, hphi, hzlim⟩ :=
    (isCompact_closedBall (0 : Vec ι) R).tendsto_subseq' hrball.frequently
  let T : Submodule ℝ (Vec ι) := Submodule.span ℝ (Set.range (fun i => p - vertex i))
  have hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range (vertex : ι → Vec ι)) := by
    intro n
    exact mem_convexHull_of_exists_fintype (c n) vertex (fun i => (hc n i).1.le)
      (hcsum n) (fun i => Set.mem_range_self i) (vertex_barycenter (c n))
  have hrmem : ∀ n, r n ∈ T := by
    intro n
    exact T.smul_mem ((e n)⁻¹) (LocalRigidity.convexHull_sub_mem vertex p (c n) (hcmem n))
  have hzmem : z ∈ T := (Submodule.closed_of_finiteDimensional T).mem_of_tendsto hzlim
    (Filter.Eventually.of_forall (fun n => hrmem (phi n)))
  have hrepr : ∀ n, p + e n • r n = c n := by
    intro n
    dsimp [r]
    rw [smul_smul, mul_inv_cancel₀ (ne_of_gt (hepos n)), one_smul]
    abel
  refine ⟨z, hzmem, ?_⟩
  intro k u hu
  have hn : ∀ i, 0 ≤ hessian (s k) p (p - vertex i) (h - z) := by
    intro i
    apply smooth_first_order_nonnegative (totalDiv (s k) (vertex i))
      (hessian (s k) p (p - vertex i)) p h z (score_hasFDerivAt (s k) (vertex i) p hp)
      (e ∘ phi) (r ∘ phi) (fun n => hepos (phi n))
      (he.comp hphi.tendsto_atTop) hzlim
    intro n
    simp only [Function.comp_apply]
    rw [hrepr]
    exact hgain (phi n) k i
  have hzall := LocalRigidity.barycenter_nonnegative_vanish (hessian (s k) p) vertex p p (h - z)
    (fun i => (hp i).1) hsum (vertex_barycenter p) hn
  rw [hessian_symmetric]
  exact LocalRigidity.orthogonal_span (hessian (s k) p) vertex p (h - z) hzall u hu

end FiniteScores
#print axioms smooth_common_repair_hessian_necessary
#check smooth_common_repair_hessian_necessary
end SmoothRigidity
import Mathlib

noncomputable section
open scoped Topology
open Set Filter

namespace SmoothScalar

/-- Exact one-coordinate assumptions of the smooth-score report. -/
structure Score where
  f : ℝ → ℝ
  df : ℝ → ℝ
  ddf : ℝ → ℝ
  cont : ContinuousOn f (Icc 0 1)
  deriv : ∀ x ∈ Ioo 0 1, HasDerivAt f (df x) x
  second : ∀ x ∈ Ioo 0 1, HasDerivAt df (ddf x) x
  cont_second : ContinuousOn ddf (Ioo 0 1)
  positive : ∀ x ∈ Ioo 0 1, 0 ≤ ddf x

def divergence (s : Score) (p x : ℝ) : ℝ :=
  s.f p - s.f x - s.df x * (p - x)

@[simp] lemma divergence_self (s : Score) (p : ℝ) : divergence s p p = 0 := by
  simp [divergence]

lemma divergence_deriv (s : Score) (p x : ℝ) (hx : x ∈ Ioo 0 1) :
    HasDerivAt (divergence s p) (s.ddf x * (x - p)) x := by
  have h := ((hasDerivAt_const x (s.f p)).sub (s.deriv x hx)).sub
    ((s.second x hx).mul ((hasDerivAt_const x p).sub (hasDerivAt_id x)))
  convert h using 1
  dsimp [divergence]
  ring

lemma divergence_strictMono_right (s : Score) (p : ℝ) (hp : p ∈ Ioo 0 1) :
    StrictMonoOn (divergence s p) (Ico p 1) := by
  apply strictMonoOn_of_deriv_pos (convex_Ico p 1)
  · intro x hx
    exact (divergence_deriv s p x ⟨hp.1.trans_le hx.1, hx.2⟩).continuousAt.continuousWithinAt
  · intro x hx
    have hx' : p < x ∧ x < 1 := by simpa only [interior_Ico] using hx
    rw [(divergence_deriv s p x ⟨hp.1.trans hx'.1, hx'.2⟩).deriv]
    exact mul_pos (s.positive x ⟨hp.1.trans hx'.1, hx'.2⟩) (sub_pos.mpr hx'.1)

lemma divergence_strictAnti_left (s : Score) (p : ℝ) (hp : p ∈ Ioo 0 1) :
    StrictAntiOn (divergence s p) (Ioc 0 p) := by
  apply strictAntiOn_of_deriv_neg (convex_Ioc 0 p)
  · intro x hx
    exact (divergence_deriv s p x ⟨hx.1, hx.2.trans_lt hp.2⟩).continuousAt.continuousWithinAt
  · intro x hx
    have hx' : 0 < x ∧ x < p := by simpa only [interior_Ioc] using hx
    rw [(divergence_deriv s p x ⟨hx'.1, hx'.2.trans hp.2⟩).deriv]
    exact mul_neg_of_pos_of_neg (s.positive x ⟨hx'.1, hx'.2.trans hp.2⟩) (sub_neg.mpr hx'.2)

lemma divergence_pos (s : Score) (p x : ℝ) (hp : p ∈ Ioo 0 1)
    (hx : x ∈ Ioo 0 1) (hne : x ≠ p) : 0 < divergence s p x := by
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hh := divergence_strictAnti_left s p hp ⟨hx.1, hlt.le⟩ ⟨hp.1, le_rfl⟩ hlt
    simpa using hh
  · have hh := divergence_strictMono_right s p hp ⟨le_rfl, hp.2⟩ ⟨hgt.le, hx.2⟩ hgt
    simpa using hh

lemma divergence_nonneg (s : Score) (p x : ℝ) (hp : p ∈ Ioo 0 1)
    (hx : x ∈ Ioo 0 1) : 0 ≤ divergence s p x := by
  by_cases h : x = p
  · simp [h]
  · exact (divergence_pos s p x hp hx h).le



/-- Vanishing Bregman regret localizes interior reports even when endpoint
score derivatives are unbounded. No compact extension of the derivative is assumed. -/
theorem tendsto_of_divergence_tendsto_zero (s : Score) (p : ℝ)
    (hp : p ∈ Ioo 0 1) (c : ℕ → ℝ) (hc : ∀ n, c n ∈ Ioo 0 1)
    (hD : Tendsto (fun n => divergence s p (c n)) atTop (𝓝 0)) :
    Tendsto c atTop (𝓝 p) := by
  apply Metric.tendsto_nhds.mpr
  intro eps heps
  let d := min (eps / 2) (min (p / 2) ((1 - p) / 2))
  have hdpos : 0 < d := lt_min (half_pos heps)
    (lt_min (half_pos hp.1) (half_pos (sub_pos.mpr hp.2)))
  have hde : d ≤ eps / 2 := min_le_left _ _
  have hdp : d ≤ p / 2 := (min_le_right _ _).trans (min_le_left _ _)
  have hdq : d ≤ (1 - p) / 2 := (min_le_right _ _).trans (min_le_right _ _)
  have hlmem : p - d ∈ Ioo 0 1 := by constructor <;> linarith [hp.1, hp.2]
  have hrmem : p + d ∈ Ioo 0 1 := by constructor <;> linarith [hp.1, hp.2]
  have hlp : p - d < p := by linarith
  have hpr : p < p + d := by linarith
  have hL := divergence_pos s p (p - d) hp hlmem (ne_of_lt hlp)
  have hR := divergence_pos s p (p + d) hp hrmem (ne_of_gt hpr)
  have hmin : 0 < min (divergence s p (p - d)) (divergence s p (p + d)) := lt_min hL hR
  have hsmall : ∀ᶠ n in atTop, divergence s p (c n) <
      min (divergence s p (p - d)) (divergence s p (p + d)) :=
    hD.eventually (eventually_lt_nhds hmin)
  filter_upwards [hsmall] with n hn
  have hl : p - d < c n := by
    by_contra! hnot
    have hle : c n ≤ p - d := hnot
    have hm := (divergence_strictAnti_left s p hp).antitoneOn
      ⟨(hc n).1, hle.trans hlp.le⟩ ⟨hlmem.1, hlp.le⟩ hle
    have hb := min_le_left (divergence s p (p - d)) (divergence s p (p + d))
    linarith
  have hr : c n < p + d := by
    by_contra! hnot
    have hle : p + d ≤ c n := hnot
    have hm := (divergence_strictMono_right s p hp).monotoneOn
      ⟨hpr.le, hrmem.2⟩ ⟨hpr.le.trans hle, (hc n).2⟩ hle
    have hb := min_le_right (divergence s p (p - d)) (divergence s p (p + d))
    linarith
  rw [Real.dist_eq]
  apply abs_lt.mpr
  constructor <;> linarith



lemma radial_local_min (f k : ℝ → ℝ) (p : ℝ)
    (hp : HasDerivAt f 0 p)
    (hd : ∀ᶠ x in 𝓝 p, HasDerivAt f (k x * (x - p)) x)
    (hk : ∀ᶠ x in 𝓝 p, 0 ≤ k x) : IsLocalMin f p := by
  have hdiff : ∀ᶠ x in 𝓝 p, DifferentiableAt ℝ f x := hd.mono (fun _ h => h.differentiableAt)
  apply isLocalMin_of_deriv' hp.continuousAt
    (hdiff.filter_mono nhdsWithin_le_nhds) (hdiff.filter_mono nhdsWithin_le_nhds)
  · filter_upwards [hd.filter_mono nhdsWithin_le_nhds,
      hk.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with x hx hkx hxp
    rw [hx.deriv]
    exact mul_nonpos_of_nonneg_of_nonpos hkx (sub_nonpos.mpr (le_of_lt hxp))
  · filter_upwards [hd.filter_mono nhdsWithin_le_nhds,
      hk.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with x hx hkx hxp
    rw [hx.deriv]
    exact mul_nonneg hkx (sub_nonneg.mpr (le_of_lt hxp))

lemma adjusted_divergence_deriv (s : Score) (p m x : ℝ) (hx : x ∈ Ioo 0 1) :
    HasDerivAt (fun y => divergence s p y - (m / 2) * (y - p) ^ 2)
      ((s.ddf x - m) * (x - p)) x := by
  have h := (divergence_deriv s p x hx).sub
    ((((hasDerivAt_id x).sub_const p).pow 2).const_mul (m / 2))
  convert h using 1
  simp only [id_eq]
  ring

lemma local_curvature_sandwich (s : Score) (p : ℝ) (hp : p ∈ Ioo 0 1) :
    ∃ a > 0, ∃ b > 0, ∀ᶠ x in 𝓝 p,
      a * (x - p) ^ 2 ≤ divergence s p x ∧
      divergence s p x ≤ b * (x - p) ^ 2 := by
  let d := s.ddf p
  have hd : 0 < d := s.positive p hp
  have hcont : ContinuousAt s.ddf p := s.cont_second.continuousAt (Ioo_mem_nhds hp.1 hp.2)
  have hlo : ∀ᶠ x in 𝓝 p, d / 2 < s.ddf x :=
    hcont.eventually (eventually_gt_nhds (by dsimp [d] at *; linarith))
  have hhi : ∀ᶠ x in 𝓝 p, s.ddf x < 2 * d :=
    hcont.eventually (eventually_lt_nhds (by dsimp [d] at *; linarith))
  have hdom : ∀ᶠ x in 𝓝 p, x ∈ Ioo 0 1 := Ioo_mem_nhds hp.1 hp.2
  have hlowmin : IsLocalMin (fun x => divergence s p x - ((d / 2) / 2) * (x - p) ^ 2) p := by
    apply radial_local_min _ (fun x => s.ddf x - d / 2) p
    · simpa using adjusted_divergence_deriv s p (d / 2) p hp
    · exact hdom.mono (fun x hx => adjusted_divergence_deriv s p (d / 2) x hx)
    · filter_upwards [hlo] with x hx
      linarith
  have hhighmin : IsLocalMin (fun x => -(divergence s p x - ((2 * d) / 2) * (x - p) ^ 2)) p := by
    apply radial_local_min _ (fun x => 2 * d - s.ddf x) p
    · simpa using (adjusted_divergence_deriv s p (2 * d) p hp).neg
    · filter_upwards [hdom] with x hx
      convert (adjusted_divergence_deriv s p (2 * d) x hx).neg using 1
      ring
    · filter_upwards [hhi] with x hx
      linarith
  refine ⟨d / 4, by positivity, d, hd, ?_⟩
  filter_upwards [hlowmin, hhighmin] with x hxlow hxhigh
  simp only [divergence_self, sub_self, zero_pow, mul_zero, sub_zero, neg_zero] at hxlow hxhigh
  constructor <;> nlinarith

#print axioms local_curvature_sandwich
end SmoothScalar
import ClosedScalarInstances

namespace ClosedScalarReview
open OrthemologyV2 P01D P01AC
open P01AC.ExtensionalRepair
open P01AC.ExtensionalRepair.ExactScalarFusion (A End W Leaf c3 i)
open P01AC.EffectiveCompleteness (N inputNumeral inputNumeral_has)
open P01AC.Intensional.Plus (PolyConvPlus)
open ImportedOpenTermTransport (interp)
open ClosedScalarInstances
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

theorem generic_reflection_exact (p q : Poly) :
    PolyConvPlus p q ↔ OpenTermStandardness.Conv
      (interp p OpenTermStandardness.T.var) (interp q OpenTermStandardness.T.var) :=
  ⟨fun h => ImportedOpenTermTransport.source_plus_sound h _, generic_conversion_reflect⟩

theorem every_variable_survives (j : Nat) :
    reify (interp (.var j) OpenTermStandardness.T.var) = .var j := rfl

theorem packed_atom_control (f a : Term) :
    PolyConvPlus (.atom (.app f a)) (.app (.atom f) (.atom a)) := by
  apply generic_conversion_reflect
  exact .refl _

theorem exact_q_binding :
    FullPER.Application.originalQ =
      P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed := rfl

theorem exact_endpoint_syntax (n : Poly) :
    scalarLeft n = .app (.app n (.var 1)) (.var 0) ∧
    scalarRight n = .app (.app (.app
      P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed n) (.var 1)) (.var 0) :=
  ⟨rfl,rfl⟩

def frozenBody : Ty := match W FullPER.Application.originalQ with
  | .pi _ B => B
  | _ => .bottom

theorem exact_W_shape : W FullPER.Application.originalQ = .pi N frozenBody := rfl

theorem independently_checked_instantiation {n : Poly} (h : Scoped 0 n) :
    inst frozenBody n = scalarInstance n := by
  have hq := has_scoped P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed_has
  simp [frozenBody,W,Leaf,ExactScalarFusion.scalarL,ExactScalarFusion.scalarR,
    scalarInstance,scalarLeft,scalarRight,A,End,arr,inst,wk,subst,psub,pup,
    P01F.cons,pren,ExactScalarFusion.psub_closed h,ExactScalarFusion.psub_closed hq,
    FullPER.Application.originalQ]

theorem exact_c2_syntax : c2 = .app (.atom .k) (.app (.atom .k) (.atom .i)) := by
  simp [c2,i,abstract,freeZero,drop,pren,psub]
theorem exact_c3_syntax : c3 = .app (.atom .k) c2 := by
  simp [c3,c2,i,abstract,freeZero,drop,pren,psub]

theorem original_witness_contracts (n : Poly) : PolyConvPlus (.app c3 n) c2 := by
  rw [exact_c3_syntax]
  exact .k c2 n

/-- This test is a theorem for every actual closed HasE derivation, not a numeral list. -/
theorem all_closed_source_inputs {n : Poly} (hn : HasE [] n N) :
    HasE [] (.app c3 n) (inst frozenBody n) := closed_scalar_instance_exact hn

/-- Universal input quantification here is in Lean, and the conclusion remains
    a family of separately closed source instances. -/
theorem external_closed_family : ∀ n, HasE [] n N →
    HasE [] c2 (.all (.pi End (.pi A
      (.identity A (.app (.app n (.var 1)) (.var 0))
        (.app (.app (.app FullPER.Application.originalQ n) (.var 1)) (.var 0)))))) :=
  fun _ hn => closed_scalar_instance hn

theorem variable_is_typable_open : HasE [N] (.var 0) N := by
  apply has_inclusion
  exact .var (EffectiveCompleteness.N_form (.ext .nil (EffectiveCompleteness.N_form .nil))) .zero

theorem variable_is_not_closed (j : Nat) : ¬ HasE [] (.var j) N := by
  intro h
  exact Nat.not_lt_zero j (ClosedProofCanonicalisation.has_scope h)

def wrappedNumeral (k : Nat) : Poly := .app (.atom .i) (inputNumeral k)

theorem wrapped_numeral_has (k : Nat) : HasE [] (wrappedNumeral k) N := by
  have hn := has_inclusion (inputNumeral_has k)
  exact .conv (ClosedProofCanonicalisation.formed hn) hn
    (PolyConvPlus.i (inputNumeral k)).symm ⟨trivial,has_scoped (inputNumeral_has k)⟩

theorem nonliteral_input_control (k : Nat) :
    HasE [] (.app c3 (wrappedNumeral k)) (inst frozenBody (wrappedNumeral k)) :=
  all_closed_source_inputs (wrapped_numeral_has k)

theorem no_closed_bottom (p : Poly) : ¬ HasE [] p .bottom :=
  FullPER.Application.no_closed_bottom p

theorem original_raw_separation : ¬ PolyConvPlus
    FullPER.Application.originalP FullPER.Application.originalQ := by
  intro h
  exact FullPER.Application.original_raw_distinct OpenTermStandardness.T.var
    (ImportedOpenTermTransport.source_plus_sound h _)

#print axioms generic_reflection_exact
#print axioms packed_atom_control
#print axioms independently_checked_instantiation
#print axioms original_witness_contracts
#print axioms all_closed_source_inputs
#print axioms external_closed_family
#print axioms variable_is_typable_open
#print axioms variable_is_not_closed
#print axioms nonliteral_input_control
#print axioms no_closed_bottom
#print axioms original_raw_separation
end ClosedScalarReview
import FullEUniformSection
import Constructive
import RigidityDiscriminator

namespace JointCompletion
open P01AC P01D FullPER
open P01AC.EffectiveCompleteness (N)
open P01AC.BooleanPrimitive (succPoly)
open SourceRigidity (zero)
open RigidityInitiality
open ImportedOpenTermTransport (interp)
open OpenTermStandardness (T Conv Arrow SatPER churchPER iter successorNumeral zeroTerm succTerm)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

@[simp] theorem eval_pair (a b : Poly) (η : FullPER.Env) :
    interp (pairPoly a b) η = pair (interp a η) (interp b η) := rfl
@[simp] theorem eval_fst (z : Poly) (η : FullPER.Env) :
    interp (fstPoly z) η = first (interp z η) := rfl
@[simp] theorem eval_snd (z : Poly) (η : FullPER.Env) :
    interp (sndPoly z) η = second (interp z η) := rfl

theorem nat_laws (Γ : Tel) : FullPER.TypeLaws Γ N where
  per := fun _ _ => per_laws churchPER
  transport := fun _ _ => rfl

theorem sigma_eta {Γ A B z} (hc : FullPER.ContextLaws Γ) (ha : FullPER.TypeLaws Γ A)
    (hb : FullPER.TypeLaws (A :: Γ) B) (hz : FullPER.Fundamental Γ z (.sigma A B)) :
    FullPER.Fundamental Γ (.atom .i) (.identity (.sigma A B) z (SigmaCompletion.reconstruct z)) := by
  intro ρ η ξ r e
  have d := (hc.ends r e).1
  have zz := hz ρ η η r (hc.refl r d)
  exact ⟨⟨(ha.per r d).raw (.refl _) (OpenTermStandardness.fst_pair _ _).symm zz.1,
    (hb.per (η := cons (first (interp z η)) η) r ⟨d,(ha.per r d).left zz.1⟩).raw
      (.refl _) (OpenTermStandardness.snd_pair _ _).symm zz.2⟩,.refl _,.refl _⟩

theorem sigma_elimination {Γ A B P d z} (hc : FullPER.ContextLaws Γ)
    (ha : FullPER.TypeLaws Γ A) (hb : FullPER.TypeLaws (A :: Γ) B)
    (hP : FullPER.TypeLaws (.sigma A B :: Γ) P)
    (hd : FullPER.Fundamental (B :: A :: Γ) d (SigmaCompletion.branchType P))
    (hz : FullPER.Fundamental Γ z (.sigma A B)) :
    FullPER.Fundamental Γ (SigmaCompletion.branchAt d (fstPoly z) (sndPoly z)) (inst P z) := by
  intro ρ η ξ r e
  have zz := hz ρ η ξ r e
  have branches : FullPER.E (B :: A :: Γ) ρ
      (cons (second (interp z η)) (cons (first (interp z η)) η))
      (cons (second (interp z ξ)) (cons (first (interp z ξ)) ξ)) := ⟨⟨e,zz.1⟩,zz.2⟩
  have v := hd ρ _ _ r branches
  have pairEnv : (fun n => interp (SigmaCompletion.pairSub n)
      (cons (second (interp z η)) (cons (first (interp z η)) η))) =
      cons (pair (first (interp z η)) (second (interp z η))) η := by
    funext n; cases n <;> rfl
  rw [SigmaCompletion.branchType, FullPER.F_subst, pairEnv] at v
  have eta := (sigma_eta hc ha hb hz) ρ η ξ r e
  have tr := hP.transport r (show FullPER.E (.sigma A B :: Γ) ρ
    (cons (interp (SigmaCompletion.reconstruct z) η) η) (cons (interp z η) η) from
    ⟨hc.refl r (hc.ends r e).1,
      (type_sigma hc ha hb).per r (hc.ends r e).1 |>.sym eta.1⟩)
  rw [FullPER.F_inst]
  simpa only [SigmaCompletion.branchAt, interp_sub, interp_cons, interp_var] using tr ▸ v

theorem step_eval (s : Poly) (η : FullPER.Env) (z : T) :
    Conv (interp (totalStep (uncurriedStep s)) η ⬝ z)
      (pair (succTerm ⬝ first z) (interp s η ⬝ first z ⬝ second z)) := by
  have h := ImportedOpenTermTransport.interp_abstraction_beta
    (pairPoly nextIndex (uncurriedStep s)) η z
  simpa only [totalStep, nextIndex, uncurriedStep, interp_app, interp_ren, interp_var,
    RigidityDiscriminator.succ_eval, eval_pair, eval_fst, eval_snd,
    OpenTermStandardness.cons] using h

theorem seed_eval (p : Poly) (η : FullPER.Env) :
    interp (totalSeed p) η = pair zeroTerm (interp p η) := by
  change pair (interp zero η) (interp p η) = _
  rw [RigidityDiscriminator.zero_eval]

theorem successor_family_eval (P : Ty) (ρ : REnv) (η : FullPER.Env) (n : T) :
    FullPER.F (successorFamily P) ρ (cons n η) = FullPER.F P ρ (cons (succTerm ⬝ n) η) := by
  rw [successorFamily,FullPER.F_subst]
  apply congrArg (fun η => FullPER.F P ρ η)
  funext k; cases k with
  | zero => simp only [P01F.cons,interp_app,RigidityDiscriminator.succ_eval,interp_var,cons]
  | succ k => rfl

theorem step_related {Γ P s} (hc : FullPER.ContextLaws Γ) (hP : FullPER.TypeLaws (N :: Γ) P)
    (hs : FullPER.Fundamental Γ s (dependentStepType P)) {ρ η ξ}
    (r : admissible ρ) (e : FullPER.E Γ ρ η ξ) :
    Arrow (FullPER.F (total P) ρ η) (FullPER.F (total P) ρ η)
      (interp (totalStep (uncurriedStep s)) η) (interp (totalStep (uncurriedStep s)) ξ) := by
  intro z w zw
  have d := (hc.ends r e).1
  have ss := hs ρ η ξ r e (first z) (first w) zw.1
  rw [FullPER.F_arr,successor_family_eval] at ss
  have succs : churchPER.rel (succTerm ⬝ first z) (succTerm ⬝ first w) := by
    intro Q f g fg a b ab
    exact Q.saturated (OpenTermStandardness.succ_application _ _ _).symm
      (OpenTermStandardness.succ_application _ _ _).symm
      (fg _ _ (zw.1 Q f g fg a b ab))
  have out := FullPER.F_pair hc (nat_laws Γ) hP r d succs (ss _ _ zw.2)
  exact ((type_sigma hc (nat_laws Γ) hP).per r d).raw
    (step_eval s η z).symm (step_eval s ξ w).symm out

theorem seed_related {Γ P p} (hc : FullPER.ContextLaws Γ) (hP : FullPER.TypeLaws (N :: Γ) P)
    (hp : FullPER.Fundamental Γ p (inst P zero)) {ρ η ξ}
    (r : admissible ρ) (e : FullPER.E Γ ρ η ξ) :
    FullPER.F (total P) ρ η (interp (totalSeed p) η) (interp (totalSeed p) ξ) := by
  rw [seed_eval,seed_eval]
  have pp := hp ρ η ξ r e
  rw [FullPER.F_inst,RigidityDiscriminator.zero_eval] at pp
  exact FullPER.F_pair hc (nat_laws Γ) hP r (hc.ends r e).1
    (OpenTermStandardness.successorNumeral_church 0) pp

theorem iter_first (p s : Poly) (η : FullPER.Env) (k : Nat) :
    Conv (first (iter (interp (totalStep (uncurriedStep s)) η)
      (interp (totalSeed p) η) k)) (successorNumeral k) := by
  induction k with
  | zero => rw [OpenTermStandardness.iter,seed_eval]; exact OpenTermStandardness.fst_pair _ _
  | succ k ih =>
      exact ((OpenTermStandardness.fst_congr (step_eval s η _)).trans
        (OpenTermStandardness.fst_pair _ _)).trans (.app (.refl _) ih)

theorem run_index (p s : Poly) (η : FullPER.Env) {n : T} (nn : churchPER.rel n n) :
    churchPER.rel
      (first (n ⬝ interp (totalStep (uncurriedStep s)) η ⬝ interp (totalSeed p) η)) n := by
  obtain ⟨k,hk⟩ := OpenTermStandardness.church_standard n nn
  have cv := (OpenTermStandardness.fst_congr (hk _ _)).trans (iter_first p s η k)
  have nk : churchPER.rel n (successorNumeral k) := by
    intro Q f g fg a b ab
    exact Q.saturated (hk f a).symm
      (OpenTermStandardness.successorNumeral_application k g b).symm
      (OpenTermStandardness.iter_related Q fg ab k)
  exact churchPER.saturated cv.symm (.refl _) (churchPER.symm nk)

theorem step_shift (s : Poly) :
    pren Nat.succ (totalStep (uncurriedStep s)) =
      totalStep (uncurriedStep (pren Nat.succ s)) := by
  simp [totalStep,uncurriedStep,nextIndex,fstPoly,sndPoly,pairPoly,pren,
    ← P01D.abstraction_naturality, psub_comp,pup,P01F.cons,psub,
    P01AC.BooleanPrimitive.psub_closed (P01AC.has_scoped P01AC.BooleanPrimitive.succ_has)]

theorem section_eval (p s : Poly) (η : FullPER.Env) (n : T) :
    Conv (interp (sectionPoly p s) η ⬝ n)
      (second (n ⬝ interp (totalStep (uncurriedStep s)) η ⬝ interp (totalSeed p) η)) := by
  have h := ImportedOpenTermTransport.interp_abstraction_beta
    (sectionBody (pren Nat.succ p) (pren Nat.succ s) (.var 0)) η n
  simpa only [sectionPoly,sectionBody,eval_snd,interp_app,interp_var,
    ← step_shift,interp_ren,OpenTermStandardness.cons,seed_eval] using h

/-- Full external induction at arbitrary lawful source-syntax motives, with the
literal retained uniform section polynomial. No old FormE premise is imposed. -/
theorem dependent_induction {Γ P p s} (hc : FullPER.ContextLaws Γ)
    (hP : FullPER.TypeLaws (N :: Γ) P)
    (hp : FullPER.Fundamental Γ p (inst P zero))
    (hs : FullPER.Fundamental Γ s (dependentStepType P)) :
    FullPER.Fundamental Γ (sectionPoly p s) (.pi N P) := by
  intro ρ η ξ r e n m nm
  have d := (hc.ends r e).1
  let R := ((type_sigma hc (nat_laws Γ) hP).per r d).object
  have run := nm R _ _ (step_related hc hP hs r e) _ _ (seed_related hc hP hp r e)
  have nn := churchPER.trans nm (churchPER.symm nm)
  have tr := hP.transport r (show FullPER.E (N :: Γ) ρ
    (cons (first (n ⬝ interp (totalStep (uncurriedStep s)) η ⬝ interp (totalSeed p) η)) η)
    (cons n η) from ⟨hc.refl r d,run_index p s η nn⟩)
  have body := tr ▸ run.2
  exact (hP.per (η := cons n η) r ⟨d,nn⟩).raw
    (section_eval p s η n).symm (section_eval p s ξ m).symm body

#print axioms sigma_eta
#print axioms sigma_elimination
#print axioms dependent_induction
end JointCompletion
import OriginalIdentityNoninhabitation
import ReviewControls

namespace ReviewHenkinIdentity
open P01AC P01D
open P01AC.ExtensionalRepair (HasE FormE)
open P01AC.EffectiveCompleteness (N)
open P01AC.UnaryIdentity.IntensionalBoundary (variableExpr redundantExpr)

def literalIdentity : Ty := .identity (arr N N) variableExpr.closed redundantExpr.closed

theorem same_identity : HomogeneousOriginalIdentity.originalIdentity =
    FullPER.Application.originalIdentity := rfl

theorem literal_identity_formed : FormE [] literalIdentity :=
  .identity
    (P01AC.ExtensionalRepair.form_inclusion
      (P01AC.ExtensionalRepair.ExactScalarFusion.T_form P01AC.Ctx.nil))
    (P01AC.ExtensionalRepair.has_inclusion variableExpr.closed_has)
    (P01AC.ExtensionalRepair.has_inclusion redundantExpr.closed_has)

/-- Independent complementary model argument for the exact identity target. -/
theorem no_internal_identity_negation (p : Poly) :
    ¬ HasE [] p (arr literalIdentity .bottom) := by
  intro h
  have hp := FullPER.fundamental h FullPER.Application.emptyEnv
    FullPER.zeroEnv FullPER.zeroEnv FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩
  rw [FullPER.F_arr] at hp
  exact hp _ _ (FullPER.Application.original_identity_inhabited
    FullPER.Application.emptyEnv FullPER.zeroEnv)

theorem literal_original_identity_independent :
    (∀ p : Poly, ¬ HasE [] p
      (.identity (arr N N) variableExpr.closed redundantExpr.closed)) ∧
    (∀ p : Poly, ¬ HasE [] p
      (arr (.identity (arr N N) variableExpr.closed redundantExpr.closed) .bottom)) :=
  ⟨HomogeneousOriginalIdentity.literal_original_identity_uninhabited,
    no_internal_identity_negation⟩

#print axioms same_identity
#print axioms literal_identity_formed
#print axioms no_internal_identity_negation
#print axioms literal_original_identity_independent
end ReviewHenkinIdentity
