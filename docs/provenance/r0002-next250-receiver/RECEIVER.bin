import MicroQueue

noncomputable section
open MeasureTheory ProbabilityTheory Filter Finset
open scoped BigOperators

namespace Orthemology.Tranche2.MicroPolicy
open PolicyEmbedding
variable {A Y Ω : Type*}

/-- Likelihood of precisely the acquired transcript; newest-first storage is harmless
because the score multiplication is commutative. -/
def historyScore (p : A → Y → ℝ) (h : History A Y) : ℝ :=
  (h.map (fun ay => p ay.1 ay.2)).prod

@[simp] lemma historyScore_nil (p : A → Y → ℝ) : historyScore p [] = 1 := rfl

@[simp] lemma historyScore_cons (p : A → Y → ℝ) (a : A) (y : Y)
    (h : History A Y) : historyScore p ((a,y) :: h) = p a y * historyScore p h := rfl

variable [DecidableEq A]

@[simp] lemma actionCount_nil (a : A) : actionCount a ([] : History A Y) = 0 := rfl

lemma actionCount_cons (a b : A) (y : Y) (h : History A Y) :
    actionCount a ((b,y) :: h) = actionCount a h + if a = b then 1 else 0 := by
  by_cases hab : a = b
  · subst b; simp [actionCount]
  · simp [actionCount,hab,Ne.symm hab]

/-- Feeding a list performs exactly its action multiplicities. -/
theorem feed_count (X : A → ℕ → Y) (h : History A Y) (as : List A) (a : A) :
    actionCount a (feed X h as) = actionCount a h + if a ∈ as then 1 else 0 := by
  induction as generalizing h with
  | nil => simp [feed]
  | cons b as ih =>
    rw [feed,ih,actionCount_cons]
    by_cases hab : a = b
    · subst b; simp [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]
    · simp [hab,Ne.symm hab]

/-- A nonduplicating support block adds one observation exactly on its support. -/
theorem feed_count_nodup (X : A → ℕ → Y) (h : History A Y) (as : List A)
    (hn : as.Nodup) (a : A) :
    actionCount a (feed X h as) = actionCount a h + if a ∈ as then 1 else 0 := by
  rw [feed_count,List.count_eq_of_nodup hn]

/-- This applies to arbitrary finite supports, including multi-action blocks. -/
theorem feed_count_finset (X : A → ℕ → Y) (h : History A Y) (s : Finset A) (a : A) :
    actionCount a (feed X h s.toList) = actionCount a h + if a ∈ s then 1 else 0 := by
  simpa using feed_count_nodup X h s.toList s.nodup_toList a

section Likelihood
variable [Fintype A]

/-- Appending one fresh stack observation multiplies the prefix likelihood by
exactly that observation's score. No positivity or probability assumptions occur. -/
theorem prefixLikelihood_update (p : A → Y → ℝ) (X : A → ℕ → Ω → Y)
    (N : A → ℕ) (ω : Ω) (a : A) :
    prefixLikelihood p X (Function.update N a (N a + 1)) ω =
      p a (X a (N a) ω) * prefixLikelihood p X N ω := by
  let f : A → ℝ := fun b => ∏ i ∈ Finset.range (N b), p b (X b i ω)
  have hf : (fun b => ∏ i ∈ Finset.range (Function.update N a (N a + 1) b),
      p b (X b i ω)) = Function.update f a (f a * p a (X a (N a) ω)) := by
    funext b
    by_cases hba : b = a
    · subst b; simp [f,Finset.prod_range_succ]
    · simp [Function.update_of_ne hba,f]
  unfold prefixLikelihood
  rw [hf,Finset.prod_update_of_mem (Finset.mem_univ a)]
  change (f a * p a (X a (N a) ω)) * _ = p a (X a (N a) ω) * ∏ b, f b
  rw [Finset.prod_eq_mul_prod_diff_singleton (Finset.mem_univ a) f]
  ring

omit [Fintype A] in
/-- Counts after a fresh transcript step are a single-coordinate update. -/
lemma actionCount_fresh_eq_update (X : A → ℕ → Y) (h : History A Y) (a : A) :
    (fun b => actionCount b ((a, X a (actionCount a h)) :: h)) =
      Function.update (fun b => actionCount b h) a (actionCount a h + 1) := by
  funext b
  rw [actionCount_cons]
  by_cases hba : b = a
  · subst b; simp
  · simp [hba,Function.update_of_ne hba]

/-- The acquired-transcript likelihood invariant is preserved by a fresh action. -/
theorem historyScore_fresh (p : A → Y → ℝ) (X : A → ℕ → Ω → Y)
    (h : History A Y) (ω : Ω) (a : A)
    (hh : historyScore p h = prefixLikelihood p X (fun b => actionCount b h) ω) :
    historyScore p ((a,X a (actionCount a h) ω) :: h) =
      prefixLikelihood p X
        (fun b => actionCount b ((a,X a (actionCount a h) ω) :: h)) ω := by
  rw [historyScore_cons,hh,actionCount_fresh_eq_update (fun b i => X b i ω),
    prefixLikelihood_update]

/-- Replay preserves the exact acquired-history / stack-prefix likelihood bridge. -/
theorem historyScore_feed (p : A → Y → ℝ) (X : A → ℕ → Ω → Y)
    (h : History A Y) (ω : Ω) (as : List A)
    (hh : historyScore p h = prefixLikelihood p X (fun b => actionCount b h) ω) :
    historyScore p (feed (fun b i => X b i ω) h as) =
      prefixLikelihood p X
        (fun b => actionCount b (feed (fun b i => X b i ω) h as)) ω := by
  induction as generalizing h with
  | nil => exact hh
  | cons a as ih =>
    apply ih ((a,X a (actionCount a h) ω)::h)
    exact historyScore_fresh p X h ω a hh

/-- Every finite history generated from the empty history has exactly the usual
per-action stack-prefix likelihood. -/
theorem historyScore_feed_nil (p : A → Y → ℝ) (X : A → ℕ → Ω → Y)
    (ω : Ω) (as : List A) :
    historyScore p (feed (fun b i => X b i ω) [] as) =
      prefixLikelihood p X
        (fun b => actionCount b (feed (fun b i => X b i ω) [] as)) ω := by
  apply historyScore_feed
  simp [prefixLikelihood]

/-- The same bridge with the action counts read directly from the execution list. -/
theorem historyScore_feed_nil_counts (p : A → Y → ℝ) (X : A → ℕ → Ω → Y)
    (ω : Ω) (as : List A) :
    historyScore p (feed (fun b i => X b i ω) [] as) =
      prefixLikelihood p X (fun b => as.count b) ω := by
  simpa only [feed_count, actionCount_nil, Nat.zero_add] using
    historyScore_feed_nil p X ω as

end Likelihood
end Orthemology.Tranche2.MicroPolicy
import JointSigmaFidelity

namespace JointCompletion.ExtractionFidelity
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness (N inputNumeral)
open P01AC.Intensional.Plus (PolyConvPlus)
open RigidityInitiality (shiftedFamily shifted_inst)
open JointCompletion.DependentExtraction (form_sigma_inv transport_source transport_erased extractSigma)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Dependent pair congruence at arbitrary Joint families. The second component
is transported using the actual identity hypothesis and existing J erasure;
no equality or uniqueness of proof terms is assumed. -/
theorem dependent_pair_congr {Γ : Tel} {X P : Ty} {x y b e : Poly}
    (hc : CtxJ Γ) (hX : FormJ Γ X) (hP : FormJ (X :: Γ) P)
    (hx : HasJ Γ x X) (hy : HasJ Γ y X)
    (he : HasJ Γ e (.identity X x y)) (hb : HasJ Γ b (inst P x)) :
    HasJ Γ (.atom .i) (.identity (.sigma X P) (pairPoly x b) (pairPoly y b)) := by
  let S : Ty := .sigma X P
  let H : Ty := .identity (wk X) (pren Nat.succ x) (.var 0)
  let P2 := shiftedFamily (shiftedFamily P)
  let x2 := pren Nat.succ (pren Nat.succ x)
  let b2 := pren Nat.succ (pren Nat.succ b)
  have hS : FormJ Γ S := .sigma hX hP
  have c1 : CtxJ (X :: Γ) := .ext hc hX
  have hH : FormJ (X :: Γ) H := Structural.form_theta_head hc hX hx
  have ct : CtxJ (theta Γ X x) := Structural.ctx_theta hc hX hx
  have hX2 : FormJ (theta Γ X x) (wk (wk X)) :=
    Structural.form_wk (Structural.form_wk hX hc hX) c1 hH
  have hx2 : HasJ (theta Γ X x) x2 (wk (wk X)) :=
    Structural.has_wk (Structural.has_wk hx hc hX) c1 hH
  have hv : HasJ (theta Γ X x) (.var 1) (wk (wk X)) := .var hX2 (.succ .zero)
  have hep : HasJ (theta Γ X x) (.var 0) (.identity (wk (wk X)) x2 (.var 1)) := by
    have h : HasJ (theta Γ X x) (.var 0) (wk H) :=
      .var (Structural.form_wk hH c1 hH) .zero
    simpa only [H, wk, subst, psub, pren, x2] using h
  have hS2 : FormJ (theta Γ X x) (wk (wk S)) :=
    Structural.form_wk (Structural.form_wk hS hc hX) c1 hH
  have shape : wk (wk S) = .sigma (wk (wk X)) P2 := by
    simp only [S, P2, shiftedFamily, wk, subst]
  have hP2 : FormJ (wk (wk X) :: theta Γ X x) P2 :=
    (form_sigma_inv (shape ▸ hS2)).2
  have hb2 : HasJ (theta Γ X x) b2 (inst P2 x2) := by
    simpa only [P2, x2, b2, shifted_inst] using
      Structural.has_wk (Structural.has_wk hb hc hX) c1 hH
  have hbv := transport_erased ct hX2 hP2 hx2 hv hep hb2
  have left : HasJ (theta Γ X x) (pairPoly x2 b2) (wk (wk S)) :=
    shape.symm ▸ HasJ.sigmaIntro (shape ▸ hS2) (Structural.form_inst ct hP2 hx2) hx2 hb2
  have right : HasJ (theta Γ X x) (pairPoly (.var 1) b2) (wk (wk S)) :=
    shape.symm ▸ HasJ.sigmaIntro (shape ▸ hS2) (Structural.form_inst ct hP2 hv) hv hbv
  let M : Ty := .identity (wk (wk S)) (pairPoly x2 b2) (pairPoly (.var 1) b2)
  have hM : FormJ (theta Γ X x) M := .identity hS2 left right
  have at_eq (v r : Poly) : motiveAt M v r =
      .identity S (pairPoly x b) (pairPoly v b) := by
    simp only [M, motiveAt, subst, subst_wk_cancel, subst_id,
      x2, b2, pairPoly, pren, psub_comp, psub, cons, psub_id]
  have left0 : HasJ Γ (pairPoly x b) S :=
    .sigmaIntro hS (Structural.form_inst hc hP hx) hx hb
  have hby := transport_erased hc hX hP hx hy he hb
  have right0 : HasJ Γ (pairPoly y b) S :=
    .sigmaIntro hS (Structural.form_inst hc hP hy) hy hby
  have base := HasJ.identityIntro (.identity hS left0 left0) left0 left0 (.refl _)
  have h := HasJ.j hX hM (.identity hX hx hy)
    ((at_eq x (.atom .i)).symm ▸ FormJ.identity hS left0 left0)
    ((at_eq y e).symm ▸ FormJ.identity hS left0 right0) hx hy he
    ((at_eq x (.atom .i)).symm ▸ base)
  have target : HasJ Γ (jPoly (.atom .i) y e)
      (.identity S (pairPoly x b) (pairPoly y b)) := by simpa only [at_eq] using h
  exact .conv (.identity hS left0 right0) target
    ((PolyConvPlus.app (.k _ _) (.refl _)).trans (.k _ _)) trivial

/-- Any supplied source identity of first projections gives fidelity of the
whole dependent package, with the same erased second component. -/
theorem repack_identity {Γ X P z y e} (hc : CtxJ Γ) (hX : FormJ Γ X)
    (hP : FormJ (X :: Γ) P) (hz : HasJ Γ z (.sigma X P))
    (hy : HasJ Γ y X) (he : HasJ Γ e (.identity X (fstPoly z) y)) :
    HasJ Γ (.atom .i) (.identity (.sigma X P) z (pairPoly y (sndPoly z))) := by
  have hS := FormJ.sigma hX hP
  have hx := HasJ.sigmaFst hX hS hz
  have hb := HasJ.sigmaSnd hS (Structural.form_inst hc hP hx) hz
  have hr := reconstruction_has hc hX hP hz
  have hby := transport_erased hc hX hP hx hy he hb
  have hnew := HasJ.sigmaIntro hS (Structural.form_inst hc hP hy) hy hby
  exact identity_trans hc hS hz hr hnew (sigma_eta hc hX hP hz)
    (dependent_pair_congr hc hX hP hx hy he hb)

/-- The extracted numeral package is source-identical to the original
package at its actual dependent Sigma type, rather than merely observing
the same numeric first component. -/
theorem extracted_package_identity {P : Ty} {z : Poly} (hz : HasJ [] z (.sigma N P)) :
    HasJ [] (.atom .i) (.identity (.sigma N P) z
      (pairPoly (inputNumeral (extractSigma P z hz).count) (sndPoly z))) :=
  repack_identity .nil (Structural.form_nat .nil)
    (form_sigma_inv (Structural.has_form hz)).2 hz
    (.hasBase (EffectiveNumerals.old_numeral_has _)) (extractSigma P z hz).index_identity

/-- Every formed dependent consumer of the original package keeps its exact
original target. The branch polynomial is unchanged by the final J transport. -/
theorem extracted_continuation_original {P R : Ty} {z d : Poly}
    (hz : HasJ [] z (.sigma N P)) (hR : FormJ [.sigma N P] R)
    (hd : HasJ [P, N] d (SigmaCompletion.branchType R)) :
    HasJ []
      (SigmaCompletion.branchAt d (inputNumeral (extractSigma P z hz).count) (sndPoly z))
      (inst R z) := by
  have hS := Structural.has_form hz
  have hrep := (extractSigma P z hz).representative_has
  have back := identity_sym .nil hS hz hrep (extracted_package_identity hz)
  exact transport_erased .nil hS hR hrep hz back
    (DependentExtraction.extracted_continuation hz hd)

#print axioms repack_identity
#print axioms extracted_package_identity
#print axioms extracted_continuation_original
#print axioms dependent_pair_congr
end JointCompletion.ExtractionFidelity
import IndependentTemplateControls
namespace IndependentRuleMapReview
open Encodable CodedRuleTemplates P01D P01AC JointCertificates AuxiliaryCertificates OrthemologyV2
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000
example : premisesCode (encode (Rule.HasE_finite (.arrow .bottom .bottom) [] .i [.raw,.bottom,.raw] (.i .bottom))) = ([Claim.formE [] .bottom, .formE [] .raw, .formE [] .raw, .formE [] (Ty.pi .bottom .bottom)] : List Claim).map encode := by
  rw [premisesCode_exact]; apply congrArg (List.map encode); decide
end IndependentRuleMapReview
import ClosedChurchIdentity
import OpenDevelopments

/- Effective source-identity decision on the promised domain of supplied actual
   closed HasE Church derivations. This never decides HasE membership. -/
namespace EffectiveChurchIdentity
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness (N inputNumeral)
open P01AC.ExtensionalRepair.ExactScalarFusion (i)
open OpenDevelopments (extractIteration)

/-- The original source term is typed-identical to its computably extracted
    numeral; the equality is source Id_N, not raw polynomial conversion. -/
theorem extracted_canonicity {n : Poly} (hn : HasE [] n N) :
    HasE [] i (.identity N n (inputNumeral (extractIteration n hn).val)) :=
  ClosedChurchIdentity.canonicity_at_count hn (extractIteration n hn).property

theorem identity_iff_extracted_counts {p q : Poly}
    (hp : HasE [] p N) (hq : HasE [] q N) :
    HasE [] i (.identity N p q) ↔
      (extractIteration p hp).val = (extractIteration q hq).val :=
  ClosedChurchIdentity.identity_iff_count_eq hp hq
    (extractIteration p hp).property (extractIteration q hq).property

theorem identity_exists_iff_extracted_counts {p q : Poly}
    (hp : HasE [] p N) (hq : HasE [] q N) :
    (∃ r, HasE [] r (.identity N p q)) ↔
      (extractIteration p hp).val = (extractIteration q hq).val :=
  ClosedChurchIdentity.identity_exists_iff_count_eq hp hq
    (extractIteration p hp).property (extractIteration q hq).property

/-- Exact semantic/source identity completeness at this one closed input type.
    The interpretation is the original inherited F, at any type environment. -/
theorem identity_iff_original_semantics {p q : Poly}
    (hp : HasE [] p N) (hq : HasE [] q N) (ρ : OEnv) :
    HasE [] i (.identity N p q) ↔ F N ρ zeroEnv (eval p zeroEnv) (eval q zeroEnv) := by
  constructor
  · intro h
    exact (ExtensionalRepair.unary_fundamental h (ρ := ρ) ⟨rfl,rfl⟩).1
  · intro h
    apply (identity_iff_extracted_counts hp hq).mpr
    exact IdentityComplexity.related_same_index h
      (ClosedChurchIdentity.observation_uniform (ClosedProofCanonicalisation.has_scope hp)
        (extractIteration p hp).property)
      (ClosedChurchIdentity.observation_uniform (ClosedProofCanonicalisation.has_scope hq)
        (extractIteration q hq).property)

/-- Executable decision procedure on already-supplied closed Church typings.
    Both source terms are retained unchanged. -/
def decideTypedIdentity {p q : Poly} (hp : HasE [] p N) (hq : HasE [] q N) :
    Decidable (HasE [] i (.identity N p q)) :=
  if h : (extractIteration p hp).val = (extractIteration q hq).val then
    .isTrue ((identity_iff_extracted_counts hp hq).mpr h)
  else .isFalse (fun hi => h ((identity_iff_extracted_counts hp hq).mp hi))

def decideTypedIdentityExists {p q : Poly} (hp : HasE [] p N) (hq : HasE [] q N) :
    Decidable (∃ r, HasE [] r (.identity N p q)) :=
  if h : (extractIteration p hp).val = (extractIteration q hq).val then
    .isTrue ((identity_exists_iff_extracted_counts hp hq).mpr h)
  else .isFalse (fun hi => h ((identity_exists_iff_extracted_counts hp hq).mp hi))

#print axioms identity_iff_original_semantics
#print axioms extracted_canonicity
#print axioms identity_iff_extracted_counts
#print axioms identity_exists_iff_extracted_counts
#print axioms decideTypedIdentity
#print axioms decideTypedIdentityExists
end EffectiveChurchIdentity
import NativeCheckerBridge
set_option maxRecDepth 200000
set_option maxHeartbeats 0
open P03Source OrthemologyV2 OrthemologyV3
theorem case180_matches : nativeCheck 0 (WireValue.text "proof") = none := by
  simp only [nativeCheck, decodeNativeProof, wireShape, wireNodes, wireHeight, wireIntegersFit,
    List.map, List.foldl, List.all]
  decide
