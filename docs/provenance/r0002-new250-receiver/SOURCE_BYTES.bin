def main : IO Unit := do
  for (c,i) in IndependentMECOracle.cases.zipIdx do
    let (d,s) := IndependentMECOracle.solve c
    IO.println s!"{i},{d},{s}"
import FiniteHullSmoothRigidity
import GeometryControls
open Set Filter
open scoped Topology BigOperators
noncomputable section
namespace HullAudit
open SmoothRigidity GeometryAudit FiniteHullSmoothRigidity

def truths (j : Bool) (i : Fin 3) : ℝ :=
  if i=2 then 1/2 else if i=0 then (if j then 1 else 0) else (if j then 0 else 1)
def center : Fin 3 → ℝ := fun _ => 1/2

lemma center_interior : ∀ i, center i ∈ Ioo 0 1 := by intro i; norm_num [center]
lemma positive_barycenter : ∑ j : Bool, (1/2:ℝ) • truths j = center := by
  ext i; fin_cases i <;> norm_num [Fintype.sum_bool,truths,center] <;> norm_num [Fin.ext_iff]

lemma center_mem_hull : center ∈ convexHull ℝ (Set.range truths) :=
  mem_convexHull_of_exists_fintype (fun _ : Bool => (1/2:ℝ)) truths
    (fun _ => by norm_num) (by norm_num [Fintype.sum_bool])
    (fun j => Set.mem_range_self j) positive_barycenter

lemma center_not_categorical_simplex : center ∉ stdSimplex ℝ (Fin 3) := by
  intro h
  have hh := h.2
  norm_num [center,Fin.sum_univ_three] at hh

lemma hull_affine_constraints (x : Fin 3 → ℝ) (hx : x ∈ convexHull ℝ (Set.range truths)) :
    x 0+x 1=1 ∧ x 2=1/2 := by
  have hv : Set.range truths ⊆ {x : Fin 3 → ℝ | x 0+x 1=1 ∧ x 2=1/2} := by
    rintro x ⟨j,rfl⟩
    cases j <;> norm_num [truths] <;> norm_num [Fin.ext_iff]
  have hc : Convex ℝ {x : Fin 3 → ℝ | x 0+x 1=1 ∧ x 2=1/2} := by
    intro x hx y hy a b ha hb hab
    constructor <;> dsimp at * <;> nlinarith [hx.1,hx.2,hy.1,hy.2]
  exact convexHull_min hv hc hx

def weights (i : Fin 3) : ℝ := if i=2 then 2 else 1
lemma weights_positive (i : Fin 3) : 0 < weights i := by unfold weights; split_ifs <;> norm_num
noncomputable def weighted (i : Fin 3) := quadratic (weights i) (weights_positive i)

lemma weights_not_global_affine : ¬ BregmanProjection.PositiveAffineEquivalent weighted unitFamily := by
  rintro ⟨a,ha,b,d,h⟩
  have h00 := h 0 0 (by norm_num)
  have h01 := h 0 1 (by norm_num)
  have h0m := h 0 (1/2) (by norm_num)
  have h20 := h 2 0 (by norm_num)
  have h21 := h 2 1 (by norm_num)
  have h2m := h 2 (1/2) (by norm_num)
  norm_num [weighted,unitFamily,quadratic,weights] at h00 h01 h0m h20 h21 h2m
  norm_num [Fin.ext_iff] at h00 h01 h0m h20 h21 h2m
  nlinarith

lemma different_metrics_share_all_tangent_projections (h : Fin 3 → ℝ) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun j => center-truths j)),
      (∀ u ∈ Submodule.span ℝ (Set.range (fun j => center-truths j)),
        hessian unitFamily center (h-z) u=0) ∧
      (∀ u ∈ Submodule.span ℝ (Set.range (fun j => center-truths j)),
        hessian weighted center (h-z) u=0) := by
  let z := (h 0-h 1) • (center-truths false)
  have hz : z ∈ Submodule.span ℝ (Set.range (fun j => center-truths j)) :=
    Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self false))
  refine ⟨z,hz,?_,?_⟩
  · intro u hu
    rw [hessian_symmetric]
    apply LocalRigidity.orthogonal_span (hessian unitFamily center) truths center (h-z) ?_ u hu
    intro j; cases j <;>
      norm_num [hessian_apply,Fin.sum_univ_three,z,unitFamily,quadratic,center,truths] <;>
      norm_num [Fin.ext_iff] <;> ring
  · intro u hu
    rw [hessian_symmetric]
    apply LocalRigidity.orthogonal_span (hessian weighted center) truths center (h-z) ?_ u hu
    intro j; cases j <;>
      norm_num [hessian_apply,Fin.sum_univ_three,z,weighted,weights,quadratic,center,truths] <;>
      norm_num [Fin.ext_iff] <;> ring

lemma duplicate_truth_rows_do_not_change_tangent {ι J : Type*} [Nonempty J]
    (v : J → (ι → ℝ)) (p : ι → ℝ) :
    Submodule.span ℝ (Set.range (fun j : J × Bool => p-v j.1)) =
      Submodule.span ℝ (Set.range (fun j => p-v j)) := by
  congr 1
  ext x
  constructor
  · rintro ⟨j,rfl⟩; exact ⟨j.1,rfl⟩
  · rintro ⟨j,rfl⟩; exact ⟨(j,false),rfl⟩

lemma singleton_truth_tangent_trivial {ι : Type*} (p : ι → ℝ) :
    Submodule.span ℝ (Set.range (fun _ : Unit => p-p)) = ⊥ := by simp

-- Literal general-hull statement: truth indices J and coordinates ι are separate.
example {ι J K : Type*} [Fintype ι] [DecidableEq ι] [Fintype J]
    (s : K → ι → SmoothScalar.Score) (k0 : K)
    (v : J → Vec ι) (w : J → ℝ) (p h : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hw : ∀ j, 0 < w j)
    (hsum : ∑ j, w j=1) (hcenter : ∑ j, w j • v j=p)
    (e eta : ℕ → ℝ) (c : ℕ → Vec ι)
    (hepos : ∀ n, 0<e n) (he : Tendsto e atTop (𝓝 0))
    (heta0 : ∀ n, 0≤eta n) (heta : Tendsto (fun n => eta n/e n) atTop (𝓝 0))
    (hc : ∀ n i, c n i ∈ Ioo 0 1)
    (hcmem : ∀ n, c n ∈ convexHull ℝ (Set.range v))
    (hgain : ∀ n k j, totalDiv (s k) (v j) (c n) ≤ totalDiv (s k) (v j) (p+e n • h)+eta n) :
    ∃ z ∈ Submodule.span ℝ (Set.range (fun j => p-v j)),
      ∀ k u, u ∈ Submodule.span ℝ (Set.range (fun j => p-v j)) →
        hessian (s k) p (h-z) u=0 :=
  finite_hull_approximate_hessian_necessary s k0 v w p h hp hw hsum hcenter e eta c hepos he heta0 heta hc hcmem hgain
end HullAudit
import EndpointChecks
open P02.Codec P02.Codec.UniformComputability P02A2.ObserverCore
example : decodeBytes (magic ++ [2,0,17,0,999]) = some ⟨2,0,.skip⟩ := by
  rw [UniformIndependentAudit.decode_trailing_rejected]
import IndependentTemplateControls
namespace IndependentRuleMapReview
open Encodable CodedRuleTemplates P01D P01AC JointCertificates AuxiliaryCertificates OrthemologyV2
set_option maxRecDepth 32768
set_option maxHeartbeats 4000000
example : branchAtCode (encode (Poly.var 0)) (encode (Poly.atom .i)) (encode (Poly.atom .k)) = encode (Poly.atom .i) := by
  rw [branchAtCode_exact]; apply congrArg encode; decide
end IndependentRuleMapReview
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Computability.Primrec
import Mathlib.Tactic

open Finset Filter Topology
open scoped ENNReal

namespace RationalBinaryWeights

def quotient (a b n : ℕ) : ℕ := a * 2^n / b

def digit (a b n : ℕ) : Bool := decide (quotient a b (n+1) % 2 = 1)

noncomputable def weight (n : ℕ) : ℝ := (1/2 : ℝ)^(n+1)


theorem quotient_step (a b n : ℕ) :
    quotient a b (n+1) / 2 = quotient a b n := by
  unfold quotient
  rw [Nat.div_div_eq_div_mul, pow_succ]
  rw [← Nat.mul_assoc, Nat.mul_div_mul_right _ _ (by decide)]

theorem digit_step (a b n : ℕ) :
    quotient a b (n+1) = 2 * quotient a b n + (if digit a b n then 1 else 0) := by
  have hm := Nat.mod_lt (quotient a b (n+1)) (by decide : 0 < 2)
  have he := Nat.mod_add_div (quotient a b (n+1)) 2
  rw [quotient_step] at he
  unfold digit
  split_ifs with h
  · simp_all
    omega
  · simp_all

theorem digit_primrec (a b : ℕ) : Primrec (digit a b) := by
  have hp := (Primrec₂.unpaired'.mp Nat.Primrec.pow).comp (Primrec.const 2)
    (Primrec.succ : Primrec Nat.succ)
  exact Primrec.eq.comp
    (Primrec.nat_mod.comp
      (Primrec.nat_div.comp (Primrec.nat_mul.comp (Primrec.const a) hp) (Primrec.const b))
      (Primrec.const 2)) (Primrec.const 1)


theorem prefix_sum (a b : ℕ) (hab : a < b) (n : ℕ) :
    ∑ i ∈ range n, (if digit a b i then weight i else 0) =
      (quotient a b n : ℝ) * (1/2 : ℝ)^n := by
  induction n with
  | zero => simp [quotient, Nat.div_eq_of_lt hab]
  | succ n ih =>
    rw [sum_range_succ, ih]
    have hs := digit_step a b n
    have hc : (quotient a b (n+1) : ℝ) =
        2 * (quotient a b n : ℝ) + (if digit a b n then 1 else 0) := by
      exact_mod_cast hs
    rw [hc]
    simp only [weight, pow_succ]
    split_ifs <;> ring

theorem prefix_bounds (a b n : ℕ) (hb : 0 < b) :
    (quotient a b n : ℝ) * (1/2 : ℝ)^n ≤ (a : ℝ) / b ∧
    (a : ℝ) / b ≤ (quotient a b n : ℝ) * (1/2 : ℝ)^n + (1/2 : ℝ)^n := by
  have hbR : (0 : ℝ) < b := by exact_mod_cast hb
  have hp : (0 : ℝ) < 2^n := by positivity
  have hq : b * quotient a b n ≤ a * 2^n := Nat.mul_div_le _ _
  have hu : a * 2^n < b * (quotient a b n + 1) := Nat.lt_mul_div_succ _ hb
  have hqR : (b : ℝ) * (quotient a b n : ℝ) ≤ (a : ℝ) * 2^n := by exact_mod_cast hq
  have huR : (a : ℝ) * 2^n < (b : ℝ) * ((quotient a b n : ℝ) + 1) := by exact_mod_cast hu
  rw [div_pow, one_pow]
  constructor
  · apply (le_div_iff₀ hbR).mpr
    apply (mul_le_mul_right hp).mp
    field_simp
    nlinarith
  · apply (div_le_iff₀ hbR).mpr
    apply (mul_le_mul_right hp).mp
    field_simp
    nlinarith

theorem binary_hasSum (a b : ℕ) (hab : a < b) :
    HasSum (fun i => if digit a b i then weight i else 0) ((a : ℝ) / b) := by
  apply (hasSum_iff_tendsto_nat_of_nonneg (fun i => by
    split_ifs <;> simp [weight]) _).mpr
  simp_rw [prefix_sum a b hab]
  have hz : Tendsto (fun n : ℕ => (1/2 : ℝ)^n) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have hl : Tendsto (fun n : ℕ => (a : ℝ)/b - (1/2 : ℝ)^n) atTop (𝓝 ((a : ℝ)/b)) := by
    simpa using tendsto_const_nhds.sub hz
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le hl tendsto_const_nhds
  · intro n
    have := (prefix_bounds a b n (by omega)).2
    linarith
  · intro n
    exact (prefix_bounds a b n (by omega)).1

theorem binary_tsum (a b : ℕ) (hab : a < b) :
    (∑' i, if digit a b i then weight i else 0) = (a : ℝ) / b :=
  (binary_hasSum a b hab).tsum_eq

@[simp] theorem digit_zero (b i : ℕ) : digit 0 b i = false := by
  simp [digit, quotient]

theorem weight_hasSum : HasSum weight 1 := by
  have h := (hasSum_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 1/2)
    (by norm_num : (1/2 : ℝ) < 1)).mul_left (1/2 : ℝ)
  norm_num at h
  change HasSum (fun i : ℕ => (1/2 : ℝ)^(i+1)) 1
  simpa [pow_succ, mul_comm] using h

/-- Includes the endpoint one by using all digits. -/
def closedDigit (a b i : ℕ) : Bool := if a = b then true else digit a b i

theorem closedDigit_primrec (a b : ℕ) : Primrec (closedDigit a b) := by
  unfold closedDigit
  split_ifs
  · exact Primrec.const true
  · exact digit_primrec a b

theorem closed_binary_hasSum (a b : ℕ) (hb : 0 < b) (hab : a ≤ b) :
    HasSum (fun i => if closedDigit a b i then weight i else 0) ((a : ℝ) / b) := by
  by_cases h : a = b
  · subst a
    simpa [closedDigit, ne_of_gt (show (0 : ℝ) < b by exact_mod_cast hb)] using weight_hasSum
  · simpa [closedDigit, h] using binary_hasSum a b (by omega)

theorem closed_binary_tsum (a b : ℕ) (hb : 0 < b) (hab : a ≤ b) :
    (∑' i, if closedDigit a b i then weight i else 0) = (a : ℝ) / b :=
  (closed_binary_hasSum a b hb hab).tsum_eq

theorem digit_uniform_primrec :
    Primrec (fun p : (ℕ × ℕ) × ℕ => digit p.1.1 p.1.2 p.2) := by
  have ha : Primrec (fun p : (ℕ × ℕ) × ℕ => p.1.1) := Primrec.fst.comp Primrec.fst
  have hb : Primrec (fun p : (ℕ × ℕ) × ℕ => p.1.2) := Primrec.snd.comp Primrec.fst
  have hp := (Primrec₂.unpaired'.mp Nat.Primrec.pow).comp (Primrec.const 2)
    (Primrec.succ.comp (Primrec.snd : Primrec (fun p : (ℕ × ℕ) × ℕ => p.2)))
  exact Primrec.eq.comp
    (Primrec.nat_mod.comp (Primrec.nat_div.comp (Primrec.nat_mul.comp ha hp) hb)
      (Primrec.const 2)) (Primrec.const 1)

theorem closedDigit_uniform_primrec :
    Primrec (fun p : (ℕ × ℕ) × ℕ => closedDigit p.1.1 p.1.2 p.2) := by
  have ha : Primrec (fun p : (ℕ × ℕ) × ℕ => p.1.1) := Primrec.fst.comp Primrec.fst
  have hb : Primrec (fun p : (ℕ × ℕ) × ℕ => p.1.2) := Primrec.snd.comp Primrec.fst
  exact Primrec.ite (Primrec.eq.comp ha hb) (Primrec.const true) digit_uniform_primrec

/-- A concrete primitive-recursive selector for any nonnegative rational at most one. -/
def rationalDigit (q : ℚ≥0) : ℕ → Bool := closedDigit q.num q.den

theorem rationalDigit_primrec (q : ℚ≥0) : Primrec (rationalDigit q) :=
  closedDigit_primrec q.num q.den

theorem rational_binary_tsum (q : ℚ≥0) (hq : q ≤ 1) :
    (∑' i, if rationalDigit q i then weight i else 0) = (q : ℝ) := by
  have hnd : q.num ≤ q.den := by simpa using (NNRat.le_def.mp hq)
  simpa [rationalDigit, NNRat.cast_def] using closed_binary_tsum q.num q.den q.den_pos hnd

theorem closed_binary_tsum_ennreal (a b : ℕ) (hb : 0 < b) (hab : a ≤ b) :
    (∑' i, if closedDigit a b i then (1/2 : ℝ≥0∞)^(i+1) else 0) =
      (a : ℝ≥0∞) / b := by
  have h := ENNReal.ofReal_tsum_of_nonneg (f := fun i => if closedDigit a b i then weight i else 0)
    (fun i => by dsimp; split_ifs <;> simp [weight]) (closed_binary_hasSum a b hb hab).summable
  rw [closed_binary_tsum a b hb hab] at h
  rw [ENNReal.ofReal_div_of_pos (by exact_mod_cast hb), ENNReal.ofReal_natCast,
    ENNReal.ofReal_natCast] at h
  rw [h]
  apply tsum_congr
  intro i
  by_cases hi : closedDigit a b i = true <;>
    simp [hi, weight, ENNReal.ofReal_pow, ENNReal.ofReal_div_of_pos, ENNReal.ofReal_inv_of_pos, ENNReal.inv_pow]

end RationalBinaryWeights

#print axioms RationalBinaryWeights.digit_primrec
#print axioms RationalBinaryWeights.binary_hasSum
#print axioms RationalBinaryWeights.closed_binary_tsum
#print axioms RationalBinaryWeights.closedDigit_uniform_primrec
#print axioms RationalBinaryWeights.rational_binary_tsum
#print axioms RationalBinaryWeights.closed_binary_tsum_ennreal

#print axioms RationalBinaryWeights.rationalDigit_primrec
import RegionControls
import ReviewerAdaptiveControls

noncomputable section
namespace HiddenParity.IndependentGlobal
open MeasureTheory ProbabilityTheory Filter
open Orthemology.Tranche2.PolicyEmbedding
open HiddenParity.Necessity HiddenParity.Stage HiddenParity.Adaptive HiddenParity.Stochastic
open HiddenParity.IndependentAdaptive
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
local instance : MeasurableSpace Two := ⊤
local instance : MeasurableSingletonClass Two := by infer_instance
local instance : MeasurableSpace Unit := ⊤
local instance : MeasurableSingletonClass Unit := by infer_instance

def allMenu (_ : Finset Two) (_ : Two) : Finset Two := Finset.univ

theorem revealing_initial_target_empty (m : Two) :
    markovTargetStates revealKernel Prod.fst Finset.univ revealPriority m Finset.univ = ∅ :=
  reveal_computed_target_empty m

theorem revealing_exit (m : Two) :
    ReachableExit revealKernel Finset.univ m Finset.univ (0 : Two) := by
  fin_cases m <;> decide

theorem revealing_lawful :
    Lawful revealKernel allMenu Finset.univ 0 revealPolicy (Measure.dirac ()) := by
  intro h hh
  exact ae_of_all _ (fun r hc => Finset.mem_univ _)

def revealingWinning : WinningPolicy (R := Unit)
    revealKernel allMenu revealPriority (0,0) Finset.univ 0 where
  nonempty := Finset.univ_nonempty
  seedLaw := Measure.dirac ()
  probability := inferInstance
  policy := revealPolicy
  measurable := reveal_policy_measurable
  lawful := revealing_lawful
  parity := by
    intro m hm
    exact (ae_map_iff (historyAction_measurable (0,0)).aemeasurable
      (paritySuccess_measurable (revealPriority m))).mp (reveal_policy_almost_sure_parity m)

theorem revealing_actual_global_necessity :
    (0 : Two) ∈ winningRegion revealKernel allMenu revealPriority Finset.univ :=
  winning_policy_mem_winningRegion _ _ _ _ _ _ revealingWinning

/-- A two-state, one-action revealing fixture isolates the support-fuel boundary. -/
def fuelPriority (_ : Fin 2) (_ : Fin 2 × Fin 1) : Nat := 2

theorem revealing_fuel_one_insufficient :
    computedRegion Controls.branchKernel Controls.allMenu fuelPriority 1 Finset.univ = ({1} : Finset (Fin 2)) := by decide

theorem revealing_fuel_two_sufficient :
    computedRegion Controls.branchKernel Controls.allMenu fuelPriority 2 Finset.univ = Finset.univ := by decide

theorem revealing_excess_fuel (n : Nat) :
    computedRegion Controls.branchKernel Controls.allMenu fuelPriority (n+2) Finset.univ = Finset.univ := by
  rw [computedRegion_fuel_irrelevant Controls.branchKernel Controls.allMenu fuelPriority Finset.univ (n+2) 2
    (by simp) (by simp)]
  exact revealing_fuel_two_sufficient

def constantSeedPolicy (r : Two) (_ : History Two Two) : Two := r

def zeroMenu (_ : Finset Two) (_ : Two) : Finset Two := {0}

/-- A null private seed may violate the hard menu without violating actual lawfulness. -/
theorem null_seed_lawful :
    Lawful revealKernel zeroMenu Finset.univ 0 constantSeedPolicy (Measure.dirac (0 : Two)) := by
  intro h hh
  apply (ae_dirac_iff (Set.toFinite _).measurableSet).mpr
  intro hc
  simp [pairPolicy, constantSeedPolicy, zeroMenu]

theorem null_seed_pointwise_illegal :
    (pairPolicy 0 constantSeedPolicy (1 : Two) []).2 ∉ zeroMenu Finset.univ 0 := by decide

/-- A null seed is still compatible with the empty history. -/
theorem null_seed_empty_history_compatible :
    ActionCompatible (pairPolicy 0 constantSeedPolicy) (1 : Two) [] := True.intro

/-- An illegal initial action is already illegal before its next receipt. -/
theorem illegal_initial_probability_one :
    HiddenParity.ResidualSeed.CanonicalInput (Measure.dirac (1 : Two))
      (realRows revealKernel (0 : Two)) (realRows_nonnegative revealKernel 0)
      (realRows_normalized revealKernel 0)
      (IllegalPrefixEvent revealKernel zeroMenu Finset.univ 0 constantSeedPolicy []) = 1 := by
  rw [illegal_prefix_factorization]
  simp [pairPolicy, constantSeedPolicy, zeroMenu, ActionCompatible,
    HiddenParity.ResidualSeed.RowLikelihood]

end HiddenParity.IndependentGlobal
import HenkinSoundness

#check HenkinSoundness.F
#check HenkinSoundness.finite_sound
#check HenkinSoundness.form_sound
#check HenkinSoundness.has_sound
#check HenkinSoundness.fundamental
#check HenkinSoundness.formation_eligible
#check HenkinSoundness.formation_coherent

#print axioms HenkinSourceTransport.interp_abstraction_beta
#print axioms HenkinSourceTransport.source_plus_sound
#print axioms HenkinSoundness.fundamental
#print axioms HenkinSoundness.formation_eligible
#print axioms HenkinSoundness.formation_coherent

-- Semantic noninhabitation can be applied directly to any actual source proof.
namespace HenkinSoundness

theorem closed_not_derivable_of_empty {A : P01AC.Ty}
    (ρ : REnv) (hρ : admissible ρ)
    (empty : ∀ t, ¬ F A ρ zeroEnv t t) :
    ∀ p, ¬ P01AC.ExtensionalRepair.HasE [] p A := by
  intro p hp
  exact empty (HenkinSourceTransport.interp p zeroEnv)
    (fundamental hp ρ zeroEnv zeroEnv hρ ⟨rfl,rfl⟩)

#print axioms closed_not_derivable_of_empty
end HenkinSoundness
import OriginalWNoninhabitation
import NoInternalNegation
import MixedPERControl
import GuardControls

/- Independent reviewer controls. The two models are deliberately kept in
   distinct namespaces; both conclusions use the same original source objects. -/
namespace ReviewHenkinSourceModel
open P01AC P01D
open P01AC.ExtensionalRepair (HasE FormE)
open P01AC.ExtensionalRepair.ExactScalarFusion (W c3)
open CaseOperational (T Conv)

abbrev literalQ : Poly := P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed

theorem same_literal_q : HomogeneousOriginalW.originalQ = FullPER.Application.originalQ := rfl

theorem original_q_typed : HasE [] literalQ (arr P01AC.EffectiveCompleteness.N P01AC.EffectiveCompleteness.N) :=
  P01AC.ExtensionalRepair.has_inclusion P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed_has

theorem original_W_formed : FormE [] (W literalQ) :=
  P01AC.ExtensionalRepair.form_inclusion
    (P01AC.ExtensionalRepair.ExactScalarFusion.W_form
      P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed_has P01AC.Ctx.nil)

theorem literal_syntactic_independence :
    (∀ p : Poly, ¬ HasE [] p (W literalQ)) ∧
    (∀ p : Poly, ¬ HasE [] p (arr (W literalQ) .bottom)) :=
  ⟨HomogeneousOriginalW.original_W_uninhabited,
   T20SourceIndependence.no_internal_negation⟩

theorem literal_fixed_c3_failure : ¬ HasE [] c3 (W literalQ) :=
  literal_syntactic_independence.1 c3

theorem empty_context_and_church_nonvacuous :
    ∃ (ρ : HenkinSoundness.REnv) (η : HenkinSoundness.Env),
      HenkinSoundness.admissible ρ ∧ HenkinSoundness.D [] ρ η ∧
      HenkinSoundness.F P01AC.EffectiveCompleteness.N ρ η T.nu T.nu :=
  ⟨HomogeneousOriginalW.emptyTypes,HenkinSoundness.zeroEnv,
    HomogeneousOriginalW.emptyTypes_admissible,rfl,HomogeneousOriginalW.nu_N _ _⟩

theorem rejected_target_is_eligible :
    ConcreteUniverse.U (HenkinSoundness.F (W literalQ)
      HomogeneousOriginalW.emptyTypes HenkinSoundness.zeroEnv) :=
  HenkinSoundness.formation_eligible original_W_formed
    HomogeneousOriginalW.emptyTypes_admissible rfl

theorem identity_compiler_positive_source_control :
    HasE [] c3 (W P01AC.ExtensionalRepair.ExactScalarFusion.i) :=
  P01AC.ExtensionalRepair.has_inclusion P01AC.ExtensionalRepair.ExactScalarFusion.W_base

theorem identity_compiler_positive_model_control :
    HenkinSoundness.F (W P01AC.ExtensionalRepair.ExactScalarFusion.i)
      HomogeneousOriginalW.emptyTypes HenkinSoundness.zeroEnv
      (HenkinSourceTransport.interp c3 HenkinSoundness.zeroEnv)
      (HenkinSourceTransport.interp c3 HenkinSoundness.zeroEnv) :=
  HenkinSoundness.fundamental identity_compiler_positive_source_control
    HomogeneousOriginalW.emptyTypes HenkinSoundness.zeroEnv HenkinSoundness.zeroEnv
    HomogeneousOriginalW.emptyTypes_admissible ⟨rfl,rfl⟩

theorem literal_positive_full_PER_control (ρ : FullPER.REnv) (η : FullPER.Env) :
    FullPER.F (W literalQ) ρ η (ImportedOpenTermTransport.interp c3 η)
      (ImportedOpenTermTransport.interp c3 η) := FullPER.Application.scalar_target_valid ρ η

theorem all_ranges_over_every_eligible_relation (B : Ty)
    (ρ : HenkinSoundness.REnv) (η : HenkinSoundness.Env) (u v : T) :
    HenkinSoundness.F (.all B) ρ η u v ↔
      ∀ (R : T → T → Prop), ConcreteUniverse.U R →
        HenkinSoundness.F B (HenkinSoundness.cons R ρ) η u v := by
  constructor
  · intro h R hr; exact h ⟨R,hr⟩
  · intro h R; exact h R.val R.property

theorem mixed_PER_saturated : HomogeneousPER.IsPER ConcreteUniverse.S MixedPERControl.R :=
  ⟨MixedPERControl.R_sym,MixedPERControl.R_trans,MixedPERControl.R_saturated⟩

theorem mixed_PER_excluded : ¬ConcreteUniverse.U MixedPERControl.R := by
  intro h
  have all := MixedPERControl.raw_support_forces_universal h.2
    MixedPERControl.support_mixes_tags.1 MixedPERControl.support_mixes_tags.2.1
  exact MixedPERControl.a0_not_related_j (all _ _)

theorem conversion_excluded : ¬ConcreteUniverse.U Conv :=
  fun h => MixedPERControl.conversion_not_admissible h.2

theorem Raw_is_strictly_coarser (ρ : HenkinSoundness.REnv) (η : HenkinSoundness.Env) :
    HenkinSoundness.F .raw ρ η T.a0 T.a1 ∧ ¬Conv T.a0 T.a1 :=
  ⟨True.intro,CaseOperational.atom_distinct⟩

def noNu : T → Prop
  | .nu => False
  | .app f a => noNu f ∧ noNu a
  | _ => True

theorem original_term_embedding_has_no_nu (t : OrthemologyV2.Term) :
    noNu (HenkinSourceTransport.embed t) := by
  induction t with
  | i | k | s | zero | one => trivial
  | app f a hf ha => exact ⟨hf,ha⟩

theorem nu_is_not_a_source_constant_image :
    ¬∃ t : OrthemologyV2.Term, HenkinSourceTransport.embed t = T.nu := by
  rintro ⟨t,ht⟩
  have h := original_term_embedding_has_no_nu t
  rw [ht] at h
  exact h

theorem original_poly_default_interpretation_has_no_nu (p : Poly) :
    noNu (HenkinSourceTransport.interp p HenkinSoundness.zeroEnv) := by
  induction p with
  | var n => trivial
  | atom t => exact original_term_embedding_has_no_nu t
  | app f a hf ha => exact ⟨hf,ha⟩

theorem nu_is_not_default_interpretation_of_any_original_poly :
    ¬∃ p : Poly, HenkinSourceTransport.interp p HenkinSoundness.zeroEnv = T.nu := by
  rintro ⟨p,hp⟩
  have h := original_poly_default_interpretation_has_no_nu p
  rw [hp] at h
  exact h

#print axioms nu_is_not_default_interpretation_of_any_original_poly
