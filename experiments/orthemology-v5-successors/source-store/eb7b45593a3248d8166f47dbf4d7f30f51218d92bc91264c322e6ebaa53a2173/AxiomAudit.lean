import IntensionalIdentityTheorems
import Lean.Util.CollectAxioms
import Lean.Elab.Command
open Lean Elab Command

/- Independently enumerate every public theorem in the frozen six modules,
   inspect actual transitive kernel axioms, and reject anything outside the
   three standard Lean foundations. -/
run_cmd do
  let checks : Array Name := #[
    `P01AC.Intensional.Plus.polyConv_inclusion,
    `P01AC.Intensional.Plus.polyConvPlus_sound,
    `P01AC.Intensional.Plus.atom_app_congr,
    `P01AC.Intensional.Plus.raw_step_atom,
    `P01AC.Intensional.Plus.raw_conv_atom,
    `P01AC.Intensional.Plus.closed_pack,
    `P01AC.Intensional.Plus.closed_conversion_iff,
    `P01AC.Intensional.Plus.has_inclusion,
    `P01AC.Intensional.Plus.form_inclusion,
    `P01AC.Intensional.Plus.ctx_inclusion,
    `P01AC.Intensional.sat_saturated,
    `P01AC.Intensional.saturated_iff_code,
    `P01AC.Intensional.code_ext,
    `P01AC.Intensional.interp_saturated,
    `P01AC.Intensional.envConv_cons,
    `P01AC.Intensional.eval_coherent,
    `P01AC.Intensional.interp_coherent,
    `P01AC.Intensional.eval_pup,
    `P01AC.Intensional.interp_subst,
    `P01AC.Intensional.interp_wk,
    `P01AC.Intensional.interp_inst,
    `P01AC.Intensional.interp_motiveAt,
    `P01AC.Intensional.interp_arr,
    `P01AC.Intensional.interp_trename,
    `P01AC.Intensional.interp_twk,
    `P01AC.Intensional.interp_mixed,
    `P01AC.Intensional.interp_tsubst,
    `P01AC.Intensional.interp_tinst,
    `P01AC.Intensional.interp_fin,
    `P01AC.Intensional.finite_code_sound,
    `P01AC.Intensional.finite_mem,
    `P01AC.Intensional.R_refines,
    `P01AC.Intensional.R_symm,
    `P01AC.Intensional.R_trans,
    `P01AC.Intensional.R_domain,
    `P01AC.Intensional.R_saturated,
    `P01AC.Intensional.R_coherent,
    `P01AC.Intensional.E_characterisation,
    `P01AC.Intensional.E_refl,
    `P01AC.Intensional.E_symm,
    `P01AC.Intensional.E_trans,
    `P01AC.Intensional.E_twk,
    `P01AC.Intensional.V_theta,
    `P01AC.Intensional.V_theta_base,
    `P01AC.Intensional.E_theta,
    `P01AC.Intensional.semantic_relational,
    `P01AC.Intensional.relational_fundamental,
    `P01AC.Intensional.relational_fundamental_plus,
    `P01AC.Intensional.V_nil,
    `P01AC.Intensional.V_cons,
    `P01AC.Intensional.lookup_member,
    `P01AC.Intensional.V_twk,
    `P01AC.Intensional.fundamental_var,
    `P01AC.Intensional.fundamental_i,
    `P01AC.Intensional.fundamental_k,
    `P01AC.Intensional.fundamental_s,
    `P01AC.Intensional.fundamental_finite,
    `P01AC.Intensional.fundamental_all_intro,
    `P01AC.Intensional.fundamental_all_elim,
    `P01AC.Intensional.fundamental_raw_atom,
    `P01AC.Intensional.fundamental_raw_app,
    `P01AC.Intensional.fundamental_pi_intro,
    `P01AC.Intensional.fundamental_pi_elim,
    `P01AC.Intensional.fundamental_sigma_intro,
    `P01AC.Intensional.fundamental_sigma_fst,
    `P01AC.Intensional.fundamental_sigma_snd,
    `P01AC.Intensional.fundamental_identity_intro,
    `P01AC.Intensional.fundamental_proof_erase,
    `P01AC.Intensional.fundamental_j,
    `P01AC.Intensional.fundamental_conv,
    `P01AC.Intensional.has_sound,
    `P01AC.Intensional.closed_identity_conversion,
    `P01AC.Intensional.hasPlus_sound,
    `P01AC.Intensional.plus_closed_identity_conversion,
    `P01AC.Intensional.separation_no_has,
    `P01AC.Intensional.separation_no_hasPlus,
    `P01AC.Intensional.separationA_formPlus,
    `P01AC.Intensional.separationP_hasPlus,
    `P01AC.Intensional.separationQ_hasPlus,
    `P01AC.Intensional.separationB_formPlus,
    `P01AC.Intensional.intensional_identity_separation,
    `P01AC.Intensional.closed_identity_intro_iff,
    `P01AC.Intensional.closed_typed_identity_iff,
    `P01AC.Intensional.closed_typed_identity_characterisation,
    `P01AC.Intensional.separationA_form,
    `P01AC.Intensional.separationP_has,
    `P01AC.Intensional.separationQ_has,
    `P01AC.Intensional.separationB_form,
    `P01AC.Intensional.separationP_scoped,
    `P01AC.Intensional.separationQ_scoped,
    `P01AC.Intensional.separationE_scoped,
    `P01AC.Intensional.separationA_scoped,
    `P01AC.Intensional.separationB_scoped,
    `P01AC.Intensional.separationA_type_scoped,
    `P01AC.Intensional.separationB_type_scoped,
    `P01AC.Intensional.separation_endpoints_F,
    `P01AC.Intensional.separation_F,
    `P01AC.Intensional.separation_G,
    `P01AC.Intensional.separation_closed_positive,
    `P01AC.Intensional.separation_endpoints_not_convertible,
    `P01AC.Intensional.separation_contradiction]
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  for n in checks do
    let info ← getConstInfo n
    unless info.isTheorem do
      throwError "Expected checked theorem: {n}"
    let axs ← Lean.collectAxioms n
    logInfo m!"{n}: {axs}"
    for a in axs do
      unless allowed.contains a do
        throwError "Unapproved transitive axiom {a} in {n}"
  logInfo m!"AXIOM_AUDIT_PASS: {checks.size} checked theorem closures contain no extra assumptions."
