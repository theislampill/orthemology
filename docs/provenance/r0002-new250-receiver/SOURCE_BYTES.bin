namespace RigidityDiscriminator
open P01AC P01D
open P01AC.ExtensionalRepair (HasE has_inclusion)
open SourceRigidity
open OpenTermStandardness (T SatPER Conv Arrow arrowPER churchPER zeroTerm succTerm successorNumeral)
open ImportedOpenTermTransport (interp)

set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem zero_eval (η : FullPER.Env) : interp zero η = zeroTerm  := by
  simp [zero, P01AC.EffectiveCompleteness.inputNumeral,
    P01AC.EffectiveCompleteness.iterationPoly,
    P01AC.BooleanPrimitive.succPoly, P01AC.BooleanPrimitive.succBody,
    P01D.abstract, P01D.freeZero, P01D.drop, P01D.pren, P01D.psub,
    interp, ImportedOpenTermTransport.poly, ImportedOpenTermTransport.embed,
    OpenTermStandardness.zeroTerm, OpenTermStandardness.succTerm,
    OpenTermStandardness.inputNumeral, OpenTermStandardness.iterationPoly,
    OpenTermStandardness.succPoly, OpenTermStandardness.succBody,
    OpenTermStandardness.abstract, OpenTermStandardness.freeZero,
    OpenTermStandardness.drop, OpenTermStandardness.pren,
    OpenTermStandardness.psub, OpenTermStandardness.eval]

theorem succ_eval (η : FullPER.Env) :
    interp P01AC.BooleanPrimitive.succPoly η = succTerm  := by
  simp [zero, P01AC.EffectiveCompleteness.inputNumeral,
    P01AC.EffectiveCompleteness.iterationPoly,
    P01AC.BooleanPrimitive.succPoly, P01AC.BooleanPrimitive.succBody,
    P01D.abstract, P01D.freeZero, P01D.drop, P01D.pren, P01D.psub,
    interp, ImportedOpenTermTransport.poly, ImportedOpenTermTransport.embed,
    OpenTermStandardness.zeroTerm, OpenTermStandardness.succTerm,
    OpenTermStandardness.inputNumeral, OpenTermStandardness.iterationPoly,
    OpenTermStandardness.succPoly, OpenTermStandardness.succBody,
    OpenTermStandardness.abstract, OpenTermStandardness.freeZero,
    OpenTermStandardness.drop, OpenTermStandardness.pren,
    OpenTermStandardness.psub, OpenTermStandardness.eval]

-- The generic algebra argument uses standardness, not the special compiler.
theorem peano_rigidity {u : T}
    (uu : Arrow churchPER.rel churchPER.rel u u)
    (uz : churchPER.rel (u ⬝ zeroTerm) zeroTerm)
    (us : ∀ n, churchPER.rel n n → churchPER.rel
      (u ⬝ (succTerm ⬝ n)) (succTerm ⬝ (u ⬝ n))) :
    Arrow churchPER.rel churchPER.rel T.i u := by
  have ss : Arrow churchPER.rel churchPER.rel succTerm succTerm := by
    have h := FullPER.fundamental (has_inclusion P01AC.BooleanPrimitive.succ_has)
      FullPER.Application.emptyEnv FullPER.zeroEnv FullPER.zeroEnv
      FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩
    simpa only [FullPER.Application.function_exact, succ_eval] using h
  have numeral : ∀ k, churchPER.rel (u ⬝ successorNumeral k) (successorNumeral k) := by
    intro k
    induction k with
    | zero => exact uz
    | succ k ih =>
      exact churchPER.trans (us _ (OpenTermStandardness.successorNumeral_church k)) (ss _ _ ih)
  intro n m nm
  have mm := churchPER.trans (churchPER.symm nm) nm
  obtain ⟨k, mk⟩ := GenericFoldTransport.church_related_numeral mm
  have um := churchPER.trans (uu _ _ mk) (numeral k)
  have nu := churchPER.trans (churchPER.trans nm mk) (churchPER.symm um)
  exact churchPER.saturated (Conv.i n).symm (.refl _) nu

/-- Exact whole-type validity, for a fixed source polynomial, at arbitrary environments. -/
theorem rigidity_valid (ρ : FullPER.REnv) (η : FullPER.Env) :
    FullPER.F Rigidity ρ η
      (interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 η)
      (interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 η) := by
  simp only [Rigidity, FullPER.F, FullPER.F_arr]
  intro u v uv z z' zz e e' ss
  refine ⟨?_, FullPER.Application.c3_application η u z e,
    FullPER.Application.c3_application η v z' e'⟩
  have uu := (arrowPER churchPER churchPER).trans uv ((arrowPER churchPER churchPER).symm uv)
  apply peano_rigidity uu
  · simpa only [FullPER.Application.church_exact, FullPER.interp_app, FullPER.interp_var, FullPER.cons, zero_eval] using zz.1
  · intro n nn
    simpa only [FullPER.Application.church_exact, FullPER.interp_app, FullPER.interp_var, FullPER.cons, pren, psub, succ_eval] using (ss n n nn).1

/-- Validity also covers two arbitrary related outer environments. -/
theorem rigidity_fundamental (Γ : Tel) : FullPER.Fundamental Γ
    P01AC.ExtensionalRepair.ExactScalarFusion.c3 Rigidity := by
  intro ρ η ξ _ _
  have hc : interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 ξ =
      interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 η :=
    (FullPER.Application.c3_eval ξ).trans (FullPER.Application.c3_eval η).symm
  rw [hc]
  exact rigidity_valid ρ η

theorem rigidity_uninhabited (r : Poly) : ¬ HasE [] r Rigidity := by
  intro h
  have hi := identity_from_rigidityE Ctx.nil h
  rw [result_exact] at hi
  exact HomogeneousOriginalIdentity.original_identity_uninhabited _ hi

theorem no_internal_negation (r : Poly) :
    ¬ HasE [] r (arr Rigidity .bottom) := by
  intro h
  have hr := FullPER.fundamental h FullPER.Application.emptyEnv
    FullPER.zeroEnv FullPER.zeroEnv FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩
  rw [FullPER.F_arr] at hr
  exact hr _ _ (rigidity_valid FullPER.Application.emptyEnv FullPER.zeroEnv)

/-- Both failures quantify over every proof polynomial in the unchanged HasE calculus. -/
theorem source_independence :
    (¬ ∃ r, HasE [] r Rigidity) ∧
    (¬ ∃ r, HasE [] r (arr Rigidity .bottom)) :=
  ⟨fun ⟨r, hr⟩ => rigidity_uninhabited r hr,
   fun ⟨r, hr⟩ => no_internal_negation r hr⟩

/-- The smaller original Has calculus inherits both exclusions by inclusion. -/
theorem source_independence_Has :
    (¬ ∃ r, Has [] r Rigidity) ∧
    (¬ ∃ r, Has [] r (arr Rigidity .bottom)) :=
  ⟨fun ⟨r, hr⟩ => rigidity_uninhabited r (has_inclusion hr),
   fun ⟨r, hr⟩ => no_internal_negation r (has_inclusion hr)⟩

#print axioms rigidity_fundamental
#print axioms source_independence
#print axioms source_independence_Has
#print axioms peano_rigidity
#print axioms rigidity_valid
#print axioms rigidity_uninhabited
#print axioms no_internal_negation
end RigidityDiscriminator
import Mathlib

/-!
P02 separate research candidate. NOT EXECUTED.
Target: Lean 4.19.0, mathlib c44e0c8ee63ca166450922a373c7409c5d26b00b.
These are only the small genuine-measure prerequisites named below.
No claim that the full U05, CV-R or CV-C obligation is formalised here.
-/
namespace P02
open Set MeasureTheory

variable {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]

/-- Positive singleton mass; not the topological support or general measure atoms. -/
def positiveSingletons (μ : Measure α) : Set α := {x | 0 < μ {x}}

noncomputable def pointMass (μ : Measure α) : ℝ≥0∞ := μ (positiveSingletons μ)
noncomputable def singletonDefect (μ : Measure α) : ℝ≥0∞ := 1 - pointMass μ

theorem positiveSingletons_countable (μ : Measure α) [IsFiniteMeasure μ] :
    (positiveSingletons μ).Countable := by
  simpa only [positiveSingletons] using
    (Measure.countable_meas_pos_of_disjoint_iUnion (μ := μ)
      (As := fun x : α => ({x} : Set α))
      (fun x => measurableSet_singleton x)
      (fun x y hxy => disjoint_singleton.mpr hxy))

theorem positiveSingletons_measurable (μ : Measure α) [IsFiniteMeasure μ] :
    MeasurableSet (positiveSingletons μ) :=
  (positiveSingletons_countable μ).measurableSet

theorem positiveSingleton_mem_of_null_compl (μ : Measure α) {x : α} {A : Set α}
    (hx : x ∈ positiveSingletons μ) (hA : μ Aᶜ = 0) : x ∈ A := by
  by_contra hnot
  have hs : ({x} : Set α) ⊆ Aᶜ := by
    intro y hy
    have hyx : y = x := by simpa only [mem_singleton_iff] using hy
    subst y
    exact hnot
  have hz : μ ({x} : Set α) = 0 := measure_mono_null hs hA
  exact (ne_of_gt hx) hz

theorem positiveSingletons_subset_conull_intersection (μ : Measure α)
    {ι : Type*} (A : ι → Set α) (hA : ∀ i, μ (A i)ᶜ = 0) :
    positiveSingletons μ ⊆ ⋂ i, A i := by
  intro x hx
  exact mem_iInter.mpr (fun i => positiveSingleton_mem_of_null_compl μ hx (hA i))

end P02
import TypedFamilyContract

/- Independent controls. No author or predecessor declaration is changed. -/
namespace TypedObserverReview
open OrthemologyV2 OrthemologyV3 P01D P01AC P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness (N inputNumeral)
open TypedStructuredObserver TypedObserverFamilyContract TypeIndexedFamilyObstructions
set_option maxRecDepth 8192

-- B depends genuinely on both an outer type parameter and an outer term.
def DepΓ : Tel := [.param 0]
def DepB : Ty := .identity (.param 0) (.var 0) (.var 0)

theorem dep_context : Ctx DepΓ := .ext .nil (.param .nil)
theorem dep_value : Has DepΓ (.var 0) (.param 0) :=
  .var (.param dep_context) .zero
theorem dep_formed : Form DepΓ DepB :=
  .identity (.param dep_context) dep_value dep_value
theorem dep_inhabitant : Has DepΓ (.atom .i) DepB :=
  .identityIntro dep_formed dep_value dep_value (.refl _)
theorem dep_update : Has DepΓ (.atom .i) (arr DepB DepB) :=
  .i dep_formed (form_arr dep_formed dep_formed)

theorem dep_term_weakened :
    wk DepB = .identity (.param 0) (.var 1) (.var 1) := rfl
theorem dep_type_weakened :
    twk DepB = .identity (.param 1) (.var 0) (.var 0) := rfl
theorem dep_telescope_weakened : twkTel DepΓ ≠ DepΓ := by decide
theorem dep_type_not_fixed : twk DepB ≠ DepB := by decide
theorem dep_term_not_fixed : wk DepB ≠ DepB := by decide

-- The body must shift B's term dependency beneath its state binder.
theorem dependent_body :
    Has (Carrier DepB :: DepΓ) (body (.atom .i))
      (Carrier (.identity (.param 0) (.var 1) (.var 1))) := body_has dep_update

theorem dependent_fresh :
    Has (twkTel DepΓ) (observe (inputNumeral 0) (.atom .i) (.atom .i))
      (.identity (.param 1) (.var 0) (.var 0)) :=
  observe_fresh_has
    (P01AC.BooleanPrimitive.closed_has (EffectiveCompleteness.inputNumeral_has 0)
      P01AC.BooleanPrimitive.N_subst dep_context) dep_update dep_inhabitant

theorem dependent_all :
    Has DepΓ (observe (inputNumeral 0) (.atom .i) (.atom .i))
      (.all (.identity (.param 1) (.var 0) (.var 0))) :=
  observe_all_has
    (P01AC.BooleanPrimitive.closed_has (EffectiveCompleteness.inputNumeral_has 0)
      P01AC.BooleanPrimitive.N_subst dep_context) dep_update dep_inhabitant

theorem dependent_specialize_any {T : Ty} (hT : Form DepΓ T) :
    Has DepΓ (observe (inputNumeral 0) (.atom .i) (.atom .i)) DepB :=
  observe_specialized_has
    (P01AC.BooleanPrimitive.closed_has (EffectiveCompleteness.inputNumeral_has 0)
      P01AC.BooleanPrimitive.N_subst dep_context) dep_update dep_inhabitant hT

theorem dependent_zero_identity : HasE DepΓ (.atom .i)
    (.identity DepB (observe (inputNumeral 0) (.atom .i) (.atom .i)) (.atom .i)) :=
  zero_source_identity dep_update dep_inhabitant

theorem dependent_constant_one_identity : HasE DepΓ (.atom .i)
    (.identity DepB (observe (inputNumeral 1) (constUpdate (.atom .i)) (.atom .i))
      (.atom .i)) := one_constant_source_identity dep_inhabitant dep_inhabitant

-- Dropping erased-cycle coherence allows varying family values despite
-- perfectly compositional constant-body reintroduction.
def freeDecode (x : Bool → Bool) (i : Bool) : Bool := x i
def freeReintro (r : Bool) (x : Bool → Bool) : Bool → Bool := fun _ => x r

theorem free_assembly : ∀ r x i, freeDecode (freeReintro r x) i = freeDecode x r :=
  fun _ _ _ => rfl

theorem free_cycle_fails : ¬ (∀ r x, freeReintro r x = x) := by
  intro h
  have e := congrFun (h false id) true
  have bad : false = true := e
  cases bad

theorem free_varying_assembly : ∃ result : Bool → Bool, ∀ i,
    freeDecode result i = structuredObservation testX varying (fun _ => true) false i := by
  refine ⟨id, ?_⟩
  intro i
  cases i <;> rfl

-- Dropping compositional reintroduction allows the erased-cycle equation.
def badReintro (_ : Bool) (x : Bool → Bool) : Bool → Bool := x

theorem bad_cycle : ∀ r x, badReintro r x = x := fun _ _ => rfl

theorem bad_assembly_fails :
    ¬ (∀ r x i, freeDecode (badReintro r x) i = freeDecode x r) := by
  intro h
  have bad : true = false := h false id true
  cases bad

-- A coherent contract alone is consistent; the rejected candidate needs
-- the separate structured-observer body assembly obligation.
theorem coherent_without_varying_body :
    (∃ _c : FixedAllContract Bool Bool Bool, True) ∧
      ¬ ∃ result : Bool, ∀ i,
        (constant_contract Bool Bool).decode result i =
          structuredObservation testX varying (fun _ => true) false i := by
  exact ⟨⟨constant_contract Bool Bool, trivial⟩,
    collapsed_raw_does_not_remove_this_test.2⟩

-- This particular observation alone does not impose generic naturality.
-- The same varying candidate is invisible to an identity update even in Bool.
theorem varying_invisible_to_identity_update : ∃ result : Bool, ∀ i,
    (constant_contract Bool Bool).decode result i =
      structuredObservation testX varying id false i := by
  refine ⟨false, ?_⟩
  intro i
  cases i <;> rfl

-- Without a discriminator a != b, varying zero/one coordinates do assemble.
def singletonVary (i : Bool) (step : (Unit × (testX i → testX i)) →
    (Unit × (testX i → testX i))) (seed : Unit × (testX i → testX i)) :=
  if i then step seed else seed

theorem singleton_discriminator_survives : ∃ result : Unit, ∀ i,
    (constant_contract Bool Unit).decode result i =
      structuredObservation testX singletonVary (fun _ => ()) () i := by
  refine ⟨(), ?_⟩
  intro i
  exact Subsingleton.elim _ _

-- Constant numeral coordinates satisfy the observer assembly obligation.
def constantZero (i : Bool) (_step : (Bool × (testX i → testX i)) →
    (Bool × (testX i → testX i))) (seed : Bool × (testX i → testX i)) := seed

def constantOne (i : Bool) (step : (Bool × (testX i → testX i)) →
    (Bool × (testX i → testX i))) (seed : Bool × (testX i → testX i)) := step seed

theorem coherent_zero_assembles : ∃ result : Bool, ∀ i,
    (constant_contract Bool Bool).decode result i =
      structuredObservation testX constantZero (fun _ => true) false i :=
  ⟨false, fun _ => rfl⟩

theorem coherent_one_assembles : ∃ result : Bool, ∀ i,
    (constant_contract Bool Bool).decode result i =
      structuredObservation testX constantOne (fun _ => true) false i :=
  ⟨true, fun _ => rfl⟩

#print axioms dependent_body
#print axioms dependent_fresh
#print axioms dependent_all
#print axioms dependent_specialize_any
#print axioms dependent_constant_one_identity
#print axioms free_cycle_fails
#print axioms bad_assembly_fails
#print axioms singleton_discriminator_survives
#print axioms coherent_zero_assembles
#print axioms coherent_one_assembles
end TypedObserverReview
import BoundaryControls
open Orthemology.Tranche2.PolicyEmbedding
open Orthemology.Tranche2.PolicyEmbeddingAudit

-- Deliberately false: policy observations can agree while retained seed fields differ.
example : (policyRun goodU alwaysFalse zeroOracle () Xzero 0).1.2.1 true 0 =
    (policyRun goodU alwaysFalse zeroOracle () Xoutside 0).1.2.1 true 0 := by decide
/- A genuinely new Joint, syntactically index-dependent family. This is an input-
   scope discriminator, not an instance in which rigidity is necessary. -/
import JointInductionLaws
import JointControls
namespace JointCompletion.InductionComputation.Controls
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl SourceRigidity
open JointCompletion.Controls (newMotive newMotive_subst)
open RigidityInitiality
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

def iterateAt (n : Poly) : Poly := .app (.app n ident) ident
def family : Ty := .identity newMotive (iterateAt (.var 0)) (iterateAt (.var 0))
def step : Poly := abstract (abstract ident)

theorem family_at (n : Poly) : inst family n = .identity newMotive (iterateAt n) (iterateAt n) := by
  simp only [family, inst, subst, newMotive_subst, iterateAt, psub, cons]

theorem iterate_typed {Γ : Tel} {n : Poly} (hc : CtxJ Γ) (hn : HasJ Γ n N) :
    HasJ Γ (iterateAt n) newMotive := by
  have hi := JointCompletion.DependentExtraction.closed_has (JointCompletion.Controls.new_motive_reentry) hc
  have hE := has_form hi
  exact fold_has hc hE hn (.i hE (form_arr hE hE)) hi

/-- The family varies with n in its actual identity endpoints. -/
theorem family_reflexive {Γ : Tel} {n : Poly} (hc : CtxJ Γ) (hn : HasJ Γ n N) :
    HasJ Γ ident (inst family n) := by
  rw [family_at]
  have hi := iterate_typed hc hn
  exact identityIntro_raw (.identity (has_form hi) hi hi) hi hi (.refl _)

theorem family_formed : FormJ [N] family := by
  have hc := CtxJ.ext CtxJ.nil (N_form .nil)
  have hn : HasJ [N] (.var 0) N := .var (N_form hc) .zero
  exact .identity (has_form (iterate_typed hc hn)) (iterate_typed hc hn) (iterate_typed hc hn)

/-- Literal variation, not only dependence in a displayed comment. -/
theorem family_distinct_instances : inst family zero ≠ inst family (.app succPoly zero) := by
  rw [family_at, family_at]
  intro h
  have e : zero = .app succPoly zero := by
    have hp := (Ty.identity.inj h).2.1
    exact (Poly.app.inj (Poly.app.inj hp).1).1
  have hsize := congrArg sizeOf e
  have hlt : sizeOf zero < sizeOf (Poly.app succPoly zero) := by simp
  omega

theorem family_seed : HasJ [] ident (inst family zero) := family_reflexive .nil (zero_has_N .nil)

theorem family_step : HasJ [] step (dependentStepType family) := by
  have hc := CtxJ.ext CtxJ.nil (N_form .nil)
  have hn : HasJ [N] (.var 0) N := .var (N_form hc) .zero
  have hsn := app_has (form_arr (N_form hc) (N_form hc)) (N_form hc) (succ_has_NT hc) hn
  have hq := successorFamily_form CtxJ.nil family_formed
  have hi : HasJ [N] ident (successorFamily family) := by
    have h := family_reflexive hc hsn
    simpa only [family_at, successorFamily, family, inst, subst, newMotive_subst, iterateAt, psub, cons] using h
  have hbody := has_wk hi hc family_formed
  apply HasJ.piIntro (.pi (N_form .nil) (form_arr family_formed hq))
  · exact .piIntro (form_arr family_formed hq) hbody (scoped_abstract trivial)
  · exact scoped_abstract (scoped_abstract trivial)

/-- The family has no old-E formation, because that would form its newly
completed carrier in the empty context. -/
theorem family_not_old : ¬ P01AC.ExtensionalRepair.FormE [N] family := by
  intro hP
  have h := P01AC.ExtensionalRepair.Structural.form_inst CtxE.nil hP
    (RigidityInitiality.FullE.zero_has_N CtxE.nil)
  rw [family_at] at h
  cases h with
  | identity hA _ _ => exact JointCompletion.Controls.new_motive_not_old hA

theorem seed_not_old (p : Poly) :
    ¬ P01AC.ExtensionalRepair.HasE [] p (inst family zero) := by
  intro hp
  have hf := P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed hp
  rw [family_at] at hf
  cases hf with
  | identity hA _ _ => exact JointCompletion.Controls.new_motive_not_old hA

theorem step_not_old (s : Poly) :
    ¬ P01AC.ExtensionalRepair.HasE [] s (dependentStepType family) := by
  intro hs
  have hf := P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed hs
  cases hf with
  | pi _ hbody => cases hbody with
    | pi hP _ => exact family_not_old hP

theorem new_family_section : HasJ [] (sectionPoly ident step) (.pi N family) :=
  induction_section .nil family_formed family_seed family_step

theorem new_family_zero : HasJ [] ident
    (.identity (inst family zero) (.app (sectionPoly ident step) zero) ident) :=
  induction_zero .nil family_formed family_seed family_step

theorem new_family_successor : ∃ e, HasJ [] e
    (.identity (inst family (.app succPoly zero))
      (.app (sectionPoly ident step) (.app succPoly zero))
      (.app (.app step zero) (.app (sectionPoly ident step) zero))) :=
  induction_successor .nil family_formed family_seed family_step (zero_has_N .nil)

/-- This reflexive family also admits a direct section. The control is a scope
discriminator, not a minimality claim for the induction rule. -/
theorem direct_section : HasJ [] (abstract ident) (.pi N family) := by
  have hc := CtxJ.ext CtxJ.nil (N_form .nil)
  have hi := family_reflexive hc (HasJ.var (N_form hc) Lookup.zero)
  apply HasJ.piIntro (.pi (N_form .nil) family_formed) ?_
    (scoped_abstract (show Scoped 1 ident from trivial))
  simpa only [family_at] using hi

