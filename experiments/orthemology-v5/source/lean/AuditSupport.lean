/-
Mandatory transitive-assumption gate. UNCOMPILED candidate, not an audit receipt.
Uses Lean 4.19.0's actual Lean.collectAxioms API, which traverses declaration
values/types in the checked environment. RequiredAudit is generated by verify.py.
It must compile after all required modules; missing constants and any unapproved
assumptions abort elaboration, in addition to the external exact readback gate.
-/
import Lean

namespace OrthemologyAudit
open Lean Elab Command

def allowedAxiom (n : Name) : Bool :=
  n == `propext || n == `Classical.choice || n == `Quot.sound

def auditConstant (n : Name) : CommandElabM Unit := do
  let env ← getEnv
  unless (env.checked.get.find? n).isSome do
    throwError "required declaration is absent from the checked environment: {n}"
  let assumptions ← Lean.collectAxioms n
  for a in assumptions do
    unless allowedAxiom a do
      throwError "unapproved transitive assumption {a} in {n}"

elab "#ortho_audit " n:ident : command => auditConstant n.getId
end OrthemologyAudit
