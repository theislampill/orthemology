end OrthemologyV4Exports
import FullPER
import EffectivePrimitiveRecursion

namespace FullPERTests
open P01AC P01D
open P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness
open P01AC.IdentityComplexity
open P01AC.BooleanIdentity
open P01AC.BooleanPrimitive
open ImportedOpenTermTransport (interp embed)
open OpenTermStandardness (T Conv churchPER iter)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Actual source syntax: test the boolean output at the bound variable by Raw observation. -/
def testBody (p : Poly) : Poly := .app (.app (.app p (.var 0)) (.atom .zero)) (.atom .one)
def testType (p : Poly) : Ty := .pi N (.identity .raw (testBody p) (.atom .zero))

theorem testBody_has {p : Poly} (hp : Has [] p CB) : Has [N] (testBody p) .raw := by
  have hc : Ctx [N] := .ext .nil (N_form .nil)
  have hr : Form [N] .raw := .raw hc
  have hB : Form [N] B := B_form hc
  have hCB : Form [N] CB := form_arr (N_form hc) hB
  have pp : Has [N] p CB := closed_has hp (fun _ => rfl) hc
  have nn : Has [N] (.var 0) N := .var (N_form hc) .zero
  have pn : Has [N] (.app p (.var 0)) B := app_has hCB hB pp nn
  have br : Has [N] (.app p (.var 0)) (arr .raw (arr .raw .raw)) :=
    .allElim hB hr (form_arr hr (form_arr hr hr)) pn
  exact app_has (form_arr hr hr) hr
    (app_has (form_arr hr (form_arr hr hr)) (form_arr hr hr) br (.rawAtom hr)) (.rawAtom hr)

theorem testType_form {p : Poly} (hp : Has [] p CB) : Form [] (testType p) :=
  .pi (N_form .nil) (.identity (.raw (.ext .nil (N_form .nil)))
    (testBody_has hp) (.rawAtom (.raw (.ext .nil (N_form .nil)))))

theorem testType_formE {p : Poly} (hp : Has [] p CB) : FormE [] (testType p) :=
  form_inclusion (testType_form hp)

theorem interp_closed {p : Poly} (hp : Scoped 0 p) (η ξ : FullPER.Env) : interp p η = interp p ξ := by
  induction p with
  | var n => exact False.elim (Nat.not_lt_zero n hp)
  | atom a => rfl
  | app f a ihf iha => exact congrArg₂ T.app (ihf hp.1) (iha hp.2)

theorem interp_canonical (n : Nat) :
    interp (inputNumeral n) FullPER.zeroEnv = embed (canonical n) :=
  ImportedOpenTermTransport.map_eval (inputNumeral n) P01AC.zeroEnv

theorem inputNumeral_open_applied (n : Nat) (f a : T) (η : FullPER.Env) :
    Conv (interp (inputNumeral n) η ⬝ f ⬝ a) (iter f a n) := by
  have h1 := Conv.app (ImportedOpenTermTransport.interp_abstraction_beta
    (abstract (iterationPoly n)) η f) (.refl a)
  have h2 := ImportedOpenTermTransport.interp_abstraction_beta
    (iterationPoly n) (OpenTermStandardness.cons f η) a
  have he : interp (iterationPoly n) (OpenTermStandardness.cons a (OpenTermStandardness.cons f η)) =
      iter f a n := by
    clear h1 h2
    induction n with
    | zero => rfl
    | succ n ih => exact congrArg (T.app f) ih
  exact h1.trans (he ▸ h2)

theorem canonical_church (k : Nat) : churchPER.rel (embed (canonical k)) (embed (canonical k)) := by
  intro R f g fg a b ab
  have hf := inputNumeral_open_applied k f a FullPER.zeroEnv
  have hg := inputNumeral_open_applied k g b FullPER.zeroEnv
  rw [interp_canonical] at hf hg
  exact R.saturated hf.symm hg.symm (OpenTermStandardness.iter_related R fg ab k)

theorem church_canonical {n : T} (hn : churchPER.rel n n) :
    ∃ k, churchPER.rel n (embed (canonical k)) := by
  obtain ⟨k, hk⟩ := OpenTermStandardness.church_standard n hn
  refine ⟨k, ?_⟩
  intro R f g fg a b ab
  have hg := inputNumeral_open_applied k g b FullPER.zeroEnv
  rw [interp_canonical] at hg
  exact R.saturated (hk f a).symm hg.symm (OpenTermStandardness.iter_related R fg ab k)

/-- Raw observation is faithful conversion, through the actual full-PER Boolean type. -/
theorem boolean_observation {ρ : FullPER.REnv} {η : FullPER.Env} {u v : T}
    (h : FullPER.F B ρ η u v) : Conv (u ⬝ .zero ⬝ .one) (v ⬝ .zero ⬝ .one) := by
  let Q : OpenTermStandardness.SatPER :=
    ⟨Conv, Conv.symm, Conv.trans, fun ha hb h => ha.symm.trans (h.trans hb)⟩
  exact h Q .zero .zero (.refl _) .one .one (.refl _)

def Holds (A : Ty) : Prop :=
  ∀ ρ, FullPER.admissible ρ → ∃ t : T, FullPER.F A ρ FullPER.zeroEnv t t

def uniformWitness : T := .k ⬝ .i

theorem observations_imply_uniform {p : Poly} (hp : Has [] p CB)
    (tests : ∀ k, OrthemologyV3.Conv (observationAt p k) .zero)
    (ρ : FullPER.REnv) (r : FullPER.admissible ρ) :
    FullPER.F (testType p) ρ FullPER.zeroEnv uniformWitness uniformWitness := by
  intro n m nm
  have nn := churchPER.trans nm (churchPER.symm nm)
  obtain ⟨k, nk⟩ := church_canonical nn
  have pp := FullPER.fundamental (has_inclusion hp) ρ FullPER.zeroEnv FullPER.zeroEnv r ⟨rfl,rfl⟩
  rw [CB, FullPER.F_arr] at pp
  have obs := boolean_observation (pp n (embed (canonical k)) nk)
  have test := ImportedOpenTermTransport.source_conv_sound (tests k)
  have ep : interp p FullPER.zeroEnv = embed (P01D.eval p P01AC.zeroEnv) :=
    ImportedOpenTermTransport.map_eval p P01AC.zeroEnv
  have result : Conv (interp p FullPER.zeroEnv ⬝ n ⬝ .zero ⬝ .one) .zero := by
    apply obs.trans
    simpa only [observationAt, observe, embed, ← ep] using test
  refine ⟨?_, .k .i n, .k .i m⟩
  simpa only [testBody, FullPER.interp_app, FullPER.interp_atom, FullPER.interp_var,
    interp_closed (has_scoped hp) (FullPER.cons n FullPER.zeroEnv) FullPER.zeroEnv,
    FullPER.cons, embed] using result

theorem inhabited_iff_observations {p : Poly} (hp : Has [] p CB)
    (ρ : FullPER.REnv) (r : FullPER.admissible ρ) :
    (∃ t, FullPER.F (testType p) ρ FullPER.zeroEnv t t) ↔
      ∀ k, OrthemologyV3.Conv (observationAt p k) .zero := by
  constructor
  · rintro ⟨t, ht⟩ k
    have v := (ht (embed (canonical k)) (embed (canonical k)) (canonical_church k)).1
    have ep : interp p FullPER.zeroEnv = embed (P01D.eval p P01AC.zeroEnv) :=
      ImportedOpenTermTransport.map_eval p P01AC.zeroEnv
    have obs : Conv (embed (observationAt p k)) (embed .zero) := by
      simpa only [testBody, FullPER.interp_app, FullPER.interp_atom, FullPER.interp_var,
        interp_closed (has_scoped hp) (FullPER.cons (embed (canonical k)) FullPER.zeroEnv) FullPER.zeroEnv,
        FullPER.cons, observationAt, observe, ep, embed] using v
    exact (ImportedOpenTermTransport.embed_conversion_iff _ _).mp obs
  · intro tests
    exact ⟨uniformWitness, observations_imply_uniform hp tests ρ r⟩

#print axioms testType_formE
#print axioms inhabited_iff_observations
end FullPERTests
import TaggedMass

open Set MeasureTheory
open scoped NNReal ENNReal
namespace OrthemologyRationalShift
open P02A2 P02A2.Q8Measure OrthemologyTagged

/-- An alternative to the Python stopping-cell compiler: preserve a unary tag,
then either copy its fresh tail or apply the base observer to that fresh tail. -/
def mixedRows (digits : ℕ → Bool) (base : Cantor → Cantor) (i : ℕ) : Cantor → Cantor :=
  if digits i then base else id

noncomputable def unaryShift (digits : ℕ → Bool) (base : Cantor → Cantor) :=
  tagged (mixedRows digits base)

theorem mixedRows_measurable (digits : ℕ → Bool) {base : Cantor → Cantor}
    (hb : Measurable base) (i : ℕ) : Measurable (mixedRows digits base i) := by
  unfold mixedRows
  split
  · exact measurable_id
  · exact hb

theorem fair_mass_zero : mass fairCantor = 0 := by
  have hp : positive fairCantor = ∅ := by
    ext x
    change (0 < fairCantor {x}) ↔ False
    rw [OrthemologyMeasure.fairCantor_singleton_zero]
    simp
  simp [mass, hp]

noncomputable def diffuseWeight (digits : ℕ → Bool) : ℝ≥0∞ :=
  ∑' i, if digits i then (weight i : ℝ≥0∞) else 0
noncomputable def baseWeight (digits : ℕ → Bool) : ℝ≥0∞ :=
  ∑' i, if digits i then 0 else (weight i : ℝ≥0∞)

theorem weight_partition (digits : ℕ → Bool) : diffuseWeight digits + baseWeight digits = 1 := by
  rw [diffuseWeight, baseWeight, ← ENNReal.tsum_add]
  convert weights_sum using 1
  apply tsum_congr
  intro i
  cases digits i <;> simp

theorem baseWeight_eq (digits : ℕ → Bool) : baseWeight digits = 1 - diffuseWeight digits := by
  exact ENNReal.eq_sub_of_add_eq (by
    have h := weight_partition digits
    exact ne_top_of_le_ne_top ENNReal.one_ne_top (by calc
      diffuseWeight digits ≤ diffuseWeight digits + baseWeight digits := le_self_add
      _ = 1 := h)) (by simpa [add_comm] using weight_partition digits)

/-- Exact actual output-law atomic mass, with all tags and the null exceptional
input handled by the original tagged_mixture_law. -/
theorem unaryShift_mass (digits : ℕ → Bool) {base : Cantor → Cantor}
    (hb : Measurable base) :
    mass (fairCantor.map (unaryShift digits base)) =
      baseWeight digits * mass (fairCantor.map base) := by
  rw [unaryShift, tagged_mass (mixedRows_measurable digits hb)]
  rw [baseWeight, ← ENNReal.tsum_mul_right]
  apply tsum_congr
  intro i
  cases hd : digits i <;> simp [mixedRows, hd, Measure.map_id, fair_mass_zero]

/-- The affine formula is proved at the actual fair-source law, rather than
postulated as an abstract operation on a real number. -/
theorem unaryShift_defect (digits : ℕ → Bool) {base : Cantor → Cantor}
    (hb : Measurable base) :
    defect (fairCantor.map (unaryShift digits base)) =
      (diffuseWeight digits).toReal + (1 - (diffuseWeight digits).toReal) *
        defect (fairCantor.map base) := by
  have hd : diffuseWeight digits ≠ ∞ := ne_top_of_le_ne_top ENNReal.one_ne_top (by
    calc
      diffuseWeight digits ≤ diffuseWeight digits + baseWeight digits := le_self_add
      _ = 1 := weight_partition digits)
  have hl : diffuseWeight digits ≤ 1 := by
    calc
      diffuseWeight digits ≤ diffuseWeight digits + baseWeight digits := le_self_add
      _ = 1 := weight_partition digits
  unfold defect
  rw [unaryShift_mass digits hb, baseWeight_eq, ENNReal.toReal_mul,
    ENNReal.toReal_sub_of_le hl (by simp)]
  simp only [ENNReal.toReal_one]
  ring

theorem diffuseWeight_toReal (digits : ℕ → Bool) :
    (diffuseWeight digits).toReal =
      ∑' i, if digits i then (1/2 : ℝ)^(i+1) else 0 := by
  unfold diffuseWeight
  rw [ENNReal.tsum_toReal_eq (fun i => by split <;> simp)]
  apply tsum_congr
  intro i
  cases hd : digits i <;> simp [hd, weight]

theorem unaryShift_defect_of_weight (digits : ℕ → Bool) {base : Cantor → Cantor}
    (hb : Measurable base) (q : ℝ)
    (hq : (∑' i, if digits i then (1/2 : ℝ)^(i+1) else 0) = q) :
    defect (fairCantor.map (unaryShift digits base)) =
      q + (1-q) * defect (fairCantor.map base) := by
  rw [unaryShift_defect digits hb, diffuseWeight_toReal, hq]

theorem unaryShift_all_diffuse {base : Cantor → Cantor} (hb : Measurable base) :
    defect (fairCantor.map (unaryShift (fun _ => true) base)) = 1 := by
  have hw : diffuseWeight (fun _ => true) = 1 := by
    simpa [diffuseWeight] using weights_sum
  rw [unaryShift_defect _ hb, hw]
  norm_num

theorem unaryShift_no_diffuse {base : Cantor → Cantor} (hb : Measurable base) :
    defect (fairCantor.map (unaryShift (fun _ => false) base)) =
      defect (fairCantor.map base) := by
  rw [unaryShift_defect _ hb]
  simp [diffuseWeight]

end OrthemologyRationalShift
#print axioms OrthemologyRationalShift.unaryShift_defect
import AuditedBitControlLaw
import RecursiveCanonicalEquivalence

noncomputable section
set_option linter.unusedSectionVars false
attribute [local instance] Classical.propDecidable
open MeasureTheory ProbabilityTheory Filter Finset
open scoped BigOperators ENNReal
namespace Orthemology.Tranche3.FiniteAuditRepair
open Orthemology.Tranche2 Orthemology.Tranche2.PolicyEmbedding
open AuditControlBridge CanonicalMicro

/-- The hidden source/score weight has exactly two declared possibilities. -/
def weight (θ : Bool) : ℝ := if θ then 3/4 else 1/4
/-- The two finite control actions are literal coherent repair reports. -/
def report (a : Bool) : ℝ := if a then 11/16 else 11/16

def kernels (θ : Bool) : Bool → Bool → ℝ := actionBlindKernel (weight θ)

def literalGood (θ : Bool) : Finset Bool :=
  Finset.univ.filter (fun a => LiteralRepairGood (weight θ) (1/4) (report a))

def publicMenu (_ : Finset Bool) : Finset Bool := Finset.univ

lemma weight_nonneg (θ : Bool) : 0 ≤ weight θ := by cases θ <;> norm_num [weight]
lemma weight_le_one (θ : Bool) : weight θ ≤ 1 := by cases θ <;> norm_num [weight]
lemma kernels_pos : ∀ θ a y, 0 < kernels θ a y := by
  intro θ a y
  cases θ <;> cases y <;> norm_num [kernels,actionBlindKernel,coinMass,weight]
lemma kernels_nonneg : ∀ θ a y, 0 ≤ kernels θ a y := fun θ a y => (kernels_pos θ a y).le
lemma kernels_normalized : ∀ θ a, ∑ y, kernels θ a y = 1 := fun θ => actionBlindKernel_normalized (weight θ)

/-- Both target sets are computed from literal squared-loss inequalities; they
are not assumed model labels. Each opposite report fails one true-state score. -/
theorem literalGood_exact (θ : Bool) : literalGood θ = {θ} := by
  ext a
  cases θ <;> cases a <;> norm_num [literalGood,LiteralRepairGood,weight,report,excessZero,excessOne]

/-- The matching finite action has strictly negative loss excess at BOTH truth
vertices, in the original fixed score units. -/
theorem matching_report_losses (θ : Bool) :
    0 ≤ report θ ∧ report θ ≤ 1 ∧
      excessZero (weight θ) (1/4) (report θ) = -(3/256) ∧
      excessOne (weight θ) (1/4) (report θ) = -(3/256) := by
  cases θ <;> norm_num [weight,report,excessZero,excessOne]

/-- The wrong finite reports fail actual loss inequalities by fixed positive
amounts; hidden-model labels are not substituted for the score test. -/
theorem crossed_report_losses :
    excessZero (weight false) (1/4) (report true) = 37/256 ∧
      excessOne (weight true) (1/4) (report false) = 21/256 := by
  norm_num [weight,report,excessZero,excessOne]

/-- No single real coherent report weakly repairs both declared standards.
The later adaptive success therefore uses information in a load-bearing way. -/
theorem no_static_common_literal_repair :
    ¬ ∃ q : ℝ, LiteralRepairGood (weight false) (1/4) q ∧
      LiteralRepairGood (weight true) (1/4) q := by
  rintro ⟨q,h0,h1⟩
  have hh := robustValue_le_max (1/4) (3/4) (1/4) q (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) h0.1 h0.2.1
  have hm : max (excessZero (1/4) (1/4) q) (excessOne (3/4) (1/4) q) ≤ 0 :=
    max_le h0.2.2.1 h1.2.2.2
  have hv : robustValue (1/4) (3/4) (1/4) = 177/4096 := by
    norm_num [robustValue,robustReport,excessZero]
  rw [hv] at hh
  linarith

lemma all_reports_coherent (a : Bool) : 0 ≤ report a ∧ report a ≤ 1 := by
  cases a <;> norm_num [report]

lemma kernels_identify (θ η a : Bool) (h : kernels θ a = kernels η a) : θ = η := by
  have hh := congrFun h true
  cases θ <;> cases η <;> norm_num [kernels,actionBlindKernel,coinMass,weight] at hh ⊢

lemma support_stays (B : Finset Bool) (a y : Bool) : supportUpdate kernels B a y = B := by
  ext θ
  simp only [mem_supportUpdate]
  exact ⟨fun h => h.1,fun h => ⟨h,kernels_pos θ a y⟩⟩

/-- A concrete recursive certificate: singleton target-action plans identify
every rival while all admissible observations retain the full support. -/
theorem full_family_winning : RecursiveWinning kernels literalGood publicMenu Finset.univ := by
  apply RecursiveWinning.intro Finset.univ (by simp) (fun θ => [θ])
  · intro θ hθ; simp
  · intro θ hθ a ha; exact Finset.mem_univ a
  · intro θ hθ a ha y hy hn
    exact (hn (support_stays Finset.univ a y)).elim
  · intro θ hθ
    right
    constructor
    · simp [literalGood_exact]
    · intro η hη heq
      have he : θ = η := kernels_identify θ η θ (heq θ (by simp))
      simp [← he,literalGood_exact]

def initialPhase : WinningPhase kernels literalGood publicMenu := ⟨Finset.univ,full_family_winning⟩

/-- The one shared causal control policy from the checked finite criterion. -/
def policy (h : History Bool Bool) : Bool :=
  recursiveHistoryPolicy (R := Unit) kernels literalGood publicMenu initialPhase () h

def reports (ω : ℕ → Bool) (n : ℕ) : ℝ := report (auditActions policy ω n)

def budget (θ : Bool) : ℝ := recursiveChainBudget kernels literalGood publicMenu kernels_nonneg θ initialPhase

/-- Exact canonical/action-blind audit-source law binding for this instance. -/
theorem actual_audit_control_law (θ : Bool) :
    (auditSourceLaw (weight θ) (weight_nonneg θ) (weight_le_one θ)).map (auditActions policy) =
      actionLaw (recursiveHistoryPolicy (R := Unit) kernels literalGood publicMenu initialPhase)
        (Measure.dirac ()) (kernels θ) (kernels_nonneg θ) (kernels_normalized θ) false := by
  exact auditActions_law_eq_canonical policy (weight θ) (weight_nonneg θ) (weight_le_one θ)
    (Measure.dirac ()) false

/-- Literal empirical-source output reports are coherent at every opportunity,
including the uninformative initial report before any receipt is observed. -/
theorem reports_always_coherent (ω : ℕ → Bool) (n : ℕ) :
    0 ≤ reports ω n ∧ reports ω n ≤ 1 := all_reports_coherent _

/-- For each of the two hidden source weights, this ONE policy eventually
strictly improves both truth-state squared losses under the actual audit law. -/
theorem reports_eventually_strict (θ : Bool) :
    ∀ᵐ ω ∂auditSourceLaw (weight θ) (weight_nonneg θ) (weight_le_one θ), ∀ᶠ n in atTop,
      (reports ω n)^2 < weight θ*(1/2+(1/4))^2+(1-weight θ)*(1/2)^2 ∧
      (1-reports ω n)^2 < weight θ*(1/2-(1/4))^2+(1-weight θ)*(1/2)^2 := by
  have hg := recursiveHistoryPolicy_actionLaw_eventually_good kernels literalGood publicMenu
    kernels_nonneg kernels_normalized θ initialPhase (Finset.mem_univ θ) (Measure.dirac ()) false
  rw [← actual_audit_control_law θ] at hg
  have ha := ae_of_ae_map (auditActions_measurable policy).aemeasurable hg
  filter_upwards [ha] with ω hω
  filter_upwards [hω] with n hn
  have he : auditActions policy ω n = θ := by simpa only [literalGood_exact,Finset.mem_singleton] using hn
  have hl := matching_report_losses θ
  unfold reports
  rw [he]
  unfold excessZero excessOne at hl
  constructor <;> linarith [hl.2.2.1,hl.2.2.2]

/-- Literal failure is equivalent to a bad finite action, proved from the target
set's score definition rather than silently relabeling controller success. -/
lemma literal_failure_cost (θ a : Bool) :
    (if LiteralRepairGood (weight θ) (1/4) (report a) then (0 : ℝ≥0∞) else 1) =
      badActionCost (literalGood θ) a := by
  simp [badActionCost,literalGood]

/-- Expected TOTAL number of literally incorrect repair reports is finite in
the actual Bernoulli audit experiment and bounded by the verified chain budget. -/
theorem reports_expected_literal_failures (θ : Bool) :
    (∫⁻ ω, ∑' n, (if LiteralRepairGood (weight θ) (1/4) (reports ω n)
      then (0 : ℝ≥0∞) else 1)
      ∂auditSourceLaw (weight θ) (weight_nonneg θ) (weight_le_one θ)) ≤ ENNReal.ofReal (budget θ) := by
  have hb := recursiveHistoryPolicy_actionLaw_total_bad_budget kernels literalGood publicMenu
    kernels_nonneg kernels_normalized θ initialPhase (Finset.mem_univ θ) (Measure.dirac ()) false
  rw [← actual_audit_control_law θ,lintegral_map (total_bad_measurable (literalGood θ))
    (auditActions_measurable policy)] at hb
  simpa only [reports,literal_failure_cost,budget] using hb

theorem reports_expected_literal_failures_finite (θ : Bool) :
    (∫⁻ ω, ∑' n, (if LiteralRepairGood (weight θ) (1/4) (reports ω n)
      then (0 : ℝ≥0∞) else 1)
      ∂auditSourceLaw (weight θ) (weight_nonneg θ) (weight_le_one θ)) < ⊤ :=
  lt_of_le_of_lt (reports_expected_literal_failures θ) ENNReal.ofReal_lt_top
end Orthemology.Tranche3.FiniteAuditRepair
import JointTypedSubstitution

namespace JointCompletion.Structural
open P01AC P01D OrthemologyV2 OrthemologyV3 P01R
open P01F (cons)
open P01AC.ExtensionalRepair.Structural
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Context inversion includes the retained old-E inclusion constructor. -/
theorem ctx_tail {Γ A} (h : CtxJ (A :: Γ)) : CtxJ Γ := by
  cases h with
  | ctxBase h => cases h with | ext hΓ _ => exact .ctxBase hΓ
  | ext hΓ _ => exact hΓ

theorem ctx_head {Γ A} (h : CtxJ (A :: Γ)) : FormJ Γ A := by
  cases h with
  | ctxBase h => cases h with | ext _ hA => exact .formBase hA
  | ext _ hA => exact hA

/-- The actual Joint telescope supplies formation for every dependent lookup. -/
theorem lookup_form {Γ n A} (hΓ : CtxJ Γ) (hn : Lookup Γ n A) : FormJ Γ A := by
  revert hΓ
  induction hn with
  | zero =>
      intro hΓ
      exact form_wk (ctx_head hΓ) (ctx_tail hΓ) (ctx_head hΓ)
  | succ hn ih =>
      intro hΓ
      exact form_wk (ih (ctx_tail hΓ)) (ctx_tail hΓ) (ctx_head hΓ)

/-- Images can have arbitrary Joint derivations, including newly completed ones. -/
theorem TypedSubstitution.instantiate {Γ A a} (hΓ : CtxJ Γ) (ha : HasJ Γ a A) :
    TypedSubstitution (A :: Γ) Γ (cons a Poly.var) := by
  constructor
  intro n B hn
  cases hn with
  | zero => simpa only [subst_wk_cancel, subst_id, cons] using ha
  | succ hn =>
      simpa only [subst_wk_cancel, subst_id, cons] using
        HasJ.var (lookup_form hΓ hn) hn

theorem form_inst {Γ A B a} (hΓ : CtxJ Γ) (hB : FormJ (A :: Γ) B)
    (ha : HasJ Γ a A) : FormJ Γ (inst B a) :=
  form_subst hB hΓ (TypedSubstitution.instantiate hΓ ha)

theorem has_inst {Γ A B a b} (hΓ : CtxJ Γ) (hb : HasJ (A :: Γ) b B)
    (ha : HasJ Γ a A) : HasJ Γ (psub (cons a Poly.var) b) (inst B a) :=
  has_subst hb hΓ (TypedSubstitution.instantiate hΓ ha)

/-- Syntactic regularity for the frozen Joint grammar. No semantic reflection is used. -/
theorem has_form {Γ p A} (h : HasJ Γ p A) : FormJ Γ A := by
  cases h with
  | hasBase h => exact .formBase (P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed h)
  | sigmaElim hΓ hA hB hP hd hz => exact form_inst hΓ hP hz
  | natInduction hΓ hP hp hs => exact .pi (form_nat hΓ) hP
  | _ => assumption

theorem has_ctx {Γ p A} (h : HasJ Γ p A) : CtxJ Γ := form_ctx (has_form h)

theorem has_type_scoped {Γ p A} (h : HasJ Γ p A) : TyScoped Γ.length A :=
  form_scoped (has_form h)

/-- The exact Sigma-elimination result type is formed for every recursive Joint motive
and Joint-typed input, without assuming an old-HasE preimage. -/
theorem sigma_result_formed {Γ A B P z} (hΓ : CtxJ Γ)
    (hP : FormJ (.sigma A B :: Γ) P) (hz : HasJ Γ z (.sigma A B)) :
    FormJ Γ (inst P z) := form_inst hΓ hP hz

/-- The induction result's syntactic formation is independent of semantics. -/
theorem induction_result_formed {Γ P} (hΓ : CtxJ Γ)
    (hP : FormJ (P01AC.EffectiveCompleteness.N :: Γ) P) :
    FormJ Γ (.pi P01AC.EffectiveCompleteness.N P) := .pi (form_nat hΓ) hP

#print axioms lookup_form
#print axioms TypedSubstitution.instantiate
#print axioms form_inst
#print axioms has_inst
#print axioms has_form
#print axioms has_ctx
#print axioms has_type_scoped
#print axioms sigma_result_formed
#print axioms induction_result_formed
end JointCompletion.Structural
