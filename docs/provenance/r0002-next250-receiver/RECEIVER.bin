import TaggedInduction
namespace TaggedInduction
open P01AC P01D TaggedPER
open ImportedOpenTermTransport (interp)

/-- A semantic substitution preserves both supported and related environments. -/
structure SemSub (Γ Δ : Tel) (σ : Nat → Poly) : Prop where
  domain : ∀ {ρ η}, admissible ρ → TaggedPER.D Δ ρ η →
    TaggedPER.D Γ ρ (fun n => interp (σ n) η)
  related : ∀ {ρ η ξ}, admissible ρ → TaggedPER.E Δ ρ η ξ →
    TaggedPER.E Γ ρ (fun n => interp (σ n) η) (fun n => interp (σ n) ξ)

theorem type_sub {Γ Δ A σ} (h : TaggedPER.TypeLaws Γ A) (s : SemSub Γ Δ σ) :
    TaggedPER.TypeLaws Δ (subst σ A) where
  per := by intro ρ η r d; rw [TaggedPER.F_subst]; exact h.per r (s.domain r d)
  transport := by
    intro ρ η ξ r e
    simp only [TaggedPER.F_subst]
    exact h.transport r (s.related r e)

theorem SemSub.lift {Γ Δ σ} (s : SemSub Γ Δ σ) (A : Ty) :
    SemSub (A :: Γ) (subst σ A :: Δ) (pup σ) where
  domain := by
    intro ρ η r d
    rw [← cons_head_tail η,interp_pup]
    exact ⟨s.domain r d.1, (TaggedPER.F_subst A σ ρ (tail η)) ▸ d.2⟩
  related := by
    intro ρ η ξ r e
    rw [← cons_head_tail η, ← cons_head_tail ξ,interp_pup,interp_pup]
    exact ⟨s.related r e.1,(TaggedPER.F_subst A σ ρ (tail η)) ▸ e.2⟩

theorem SemSub.type_lift {Γ Δ σ} (s : SemSub Γ Δ σ) :
    SemSub (twkTel Γ) (twkTel Δ) σ where
  domain := by
    intro ρ η r d
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.D_twk] at d ⊢
    exact s.domain hr d
  related := by
    intro ρ η ξ r e
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.E_twk] at e ⊢
    exact s.related hr e

/-- Substitution retains every component law required by the original soundness
proof, including beneath term and impredicative type binders. -/
theorem hereditary_sub {Γ A} (h : TaggedPER.Hereditary Γ A) {Δ σ} (s : SemSub Γ Δ σ) :
    TaggedPER.Hereditary Δ (subst σ A) := by
  induction A generalizing Γ Δ σ with
  | param n | bottom | raw => exact ⟨type_sub h.1 s,trivial⟩
  | pi A B ia ib | sigma A B ia ib =>
    exact ⟨type_sub h.1 s,ia h.2.1 s,ib h.2.2 (s.lift A)⟩
  | identity A p q ia => exact ⟨type_sub h.1 s,ia h.2 s⟩
  | all B ib => exact ⟨type_sub h.1 s,ib h.2 s.type_lift⟩

theorem SemSub.instantiate {Γ A a} (hc : TaggedPER.ContextLaws Γ)
    (ha : TaggedPER.Fundamental Γ a A) : SemSub (A :: Γ) Γ (P01F.cons a Poly.var) where
  domain := by
    intro ρ η r d
    rw [interp_cons]
    exact ⟨d,ha ρ η η r (hc.refl r d)⟩
  related := by
    intro ρ η ξ r e
    rw [interp_cons,interp_cons]
    exact ⟨e,ha ρ η ξ r e⟩

theorem hereditary_inst {Γ A B a} (hc : TaggedPER.ContextLaws Γ)
    (hB : TaggedPER.Hereditary (A :: Γ) B) (ha : TaggedPER.Fundamental Γ a A) :
    TaggedPER.Hereditary Γ (inst B a) := hereditary_sub hB (SemSub.instantiate hc ha)

theorem context_typewk {Γ} (h : TaggedPER.ContextLaws Γ) : TaggedPER.ContextLaws (twkTel Γ) where
  refl := by
    intro ρ η r d
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.D_twk] at d
    rw [eqρ,TaggedPER.E_twk]
    exact h.refl hr d
  ends := by
    intro ρ η ξ r e
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.E_twk] at e
    rw [eqρ,TaggedPER.D_twk,TaggedPER.D_twk]
    exact h.ends hr e
  sym := by
    intro ρ η ξ r e
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.E_twk] at e ⊢
    exact h.sym hr e
  trans := by
    intro ρ η ξ ζ r e f
    let ρ' : REnv := fun n => ρ (n+1)
    have hr : admissible ρ' := fun n => r (n+1)
    have eqρ : ρ = cons (ρ 0) ρ' := by funext n; cases n <;> rfl
    rw [eqρ,TaggedPER.E_twk] at e f ⊢
    exact h.trans hr e f

theorem hereditary_arr {Γ A B} (hc : TaggedPER.ContextLaws Γ)
    (ha : TaggedPER.Hereditary Γ A) (hb : TaggedPER.Hereditary Γ B) :
    TaggedPER.Hereditary Γ (arr A B) := by
  have sub : SemSub Γ (A :: Γ) (fun n => .var (n+1)) := {
    domain := fun _ d => d.1
    related := fun _ e => e.1 }
  have hw := hereditary_sub hb sub
  exact ⟨type_pi hc ha.laws hw.laws,ha,hw⟩

theorem hereditary_nat {Γ} (hc : TaggedPER.ContextLaws Γ) :
    TaggedPER.Hereditary Γ P01AC.EffectiveCompleteness.N := by
  have c := context_typewk hc
  have hparam : TaggedPER.Hereditary (twkTel Γ) (.param 0) := ⟨type_param _ _,trivial⟩
  have a := hereditary_arr c hparam hparam
  have b := hereditary_arr c a a
  exact ⟨type_all b.laws,b⟩

/-- The exact semantic package consumed by a recursive full-induction rule.
    Motive laws are obtained from its recursive formation proof by the caller. -/
theorem dependent_induction_sound {Γ P p s} (hc : TaggedPER.ContextLaws Γ)
    (hP : TaggedPER.Hereditary (P01AC.EffectiveCompleteness.N :: Γ) P)
    (hp : TaggedPER.Fundamental Γ p (inst P SourceRigidity.zero))
    (hs : TaggedPER.Fundamental Γ s (RigidityInitiality.dependentStepType P)) :
    TaggedPER.TermSound Γ (RigidityInitiality.sectionPoly p s)
      (.pi P01AC.EffectiveCompleteness.N P) :=
  ⟨⟨hc,type_pi hc (nat_laws Γ) hP.laws,hereditary_nat hc,hP⟩,
    dependent_induction hc hP.laws hp hs⟩

#print axioms dependent_induction_sound
#print axioms hereditary_nat
#print hereditary_nat
#print axioms hereditary_sub
#print axioms hereditary_inst
end TaggedInduction
import SeededPolicyEquivalence

noncomputable section
open MeasureTheory ProbabilityTheory Filter Finset
open scoped BigOperators
namespace Orthemology.Tranche2.MicroPolicy
open PolicyEmbedding
universe u v w
variable {R : Type v} {A Y : Type u} {Θ : Type w}
    [Fintype Θ] [Fintype A] [Fintype Y] [DecidableEq A] [Inhabited Y]
    [MeasurableSpace R] [MeasurableSpace A] [MeasurableSingletonClass A]
    [MeasurableSpace Y] [MeasurableSingletonClass Y]

omit [Fintype Θ] [Fintype A] [Fintype Y] [Inhabited Y] [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
lemma queue_mem_menu (plan : Θ → List A) (choose : History A Y → Θ) (Γ : Finset A)
    (hplan : ∀ σ a, a ∈ plan σ → a ∈ Γ) (h : History A Y) :
    ∀ a ∈ queue plan choose h, a ∈ Γ := by
  induction h with
  | nil => exact hplan _
  | cons z h ih =>
    simp only [queue]
    split_ifs with he
    · exact hplan _
    · intro a ha
      exact ih a (List.mem_of_mem_tail ha)

omit [Fintype A] [MeasurableSpace R] [Inhabited Y] [Fintype Y] [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
/-- Every action issued on every history is licensed. This concerns the common
static menu, separately from eventual true-target acceptance. -/
theorem sharedPolicy_mem_menu (P : Θ → A → Y → ℝ) (support : Θ → Finset A)
    (initial : Θ) (d : A) (Γ : Finset A)
    (hne : ∀ σ, (support σ).Nonempty) (hmenu : ∀ σ, support σ ⊆ Γ)
    (r : R) (h : History A Y) : sharedPolicy P support initial d r h ∈ Γ := by
  apply queue_mem_menu (supportPlan support) (chooseMLE P initial) Γ
    (fun σ a ha => hmenu σ (by simpa [supportPlan] using ha)) h
  exact headD_mem_of_nonempty _ d
    (queue_nonempty _ _ (supportPlan_nonempty support hne) h)

omit [Fintype A] [DecidableEq A] in
lemma measurableSet_always_mem (Γ : Finset A) :
    MeasurableSet {x : ℕ → A | ∀ n, x n ∈ Γ} := by
  have he : {x : ℕ → A | ∀ n, x n ∈ Γ} = ⋂ n : ℕ, {x : ℕ → A | x n ∈ Γ} := by
    ext x
    simp
  rw [he]
  exact MeasurableSet.iInter (fun n => Γ.measurableSet.preimage (measurable_pi_apply n))

/-- A pointwise licensed history policy produces only licensed actions under
its actual canonical experiment. -/
theorem actionLaw_always_licensed (π : R → History A Y → A)
    (hπ : Measurable (fun z : R × History A Y => π z.1 z.2))
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (P : A → Y → ℝ) (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (d : A) (Γ : Finset A) (hlegal : ∀ r h, π r h ∈ Γ) :
    ∀ᵐ x ∂actionLaw π ρ P hP hN d, ∀ n, x n ∈ Γ := by
  apply actionLaw_ae_of_stack π hπ ρ P hP hN d _ (measurableSet_always_mem Γ)
  exact Filter.Eventually.of_forall (fun z n => hlegal _ _)

/-- Explicit common-static-menu version of the exact same-runner theorem.
All issued actions are licensed, including the finitely many target errors. -/
theorem licensed_seeded_policy_exists_iff_kernel_nonempty
    (P : Θ → A → Y → ℝ) (good : Θ → Finset A) (Γ : Finset A) (initial : Θ) (d : A)
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (hP : ∀ σ a y, 0 < P σ a y) (hN : ∀ σ a, ∑ y, P σ a y = 1) :
    (∃ π : R → History A Y → A,
      Measurable (fun z : R × History A Y => π z.1 z.2) ∧
      (∀ r h, π r h ∈ Γ) ∧
      ∀ θ, ∀ᵐ x ∂actionLaw π ρ (P θ) (fun a y => (hP θ a y).le) (hN θ) d,
        ∀ᶠ t in atTop, x t ∈ good θ) ↔
      ∀ θ, (supportKernel (fun θ => good θ)
        (fun η ζ a => P η a = P ζ a) θ).Nonempty := by
  constructor
  · rintro ⟨π,hπ,hlegal,hgood⟩ θ
    apply seeded_policy_kernel_nonempty P (fun θ => good θ) hP hN π hπ ρ d
    intro η
    have hall := actionLaw_always_licensed π hπ ρ (P η) (fun a y => (hP η a y).le) (hN η) d Γ hlegal
    filter_upwards [hgood η,hall] with x hx hl
    filter_upwards [hx] with t ht
    exact Finset.mem_inter.mpr ⟨ht,hl t⟩
  · intro hk
    let target := fun θ => good θ
    let support := fun θ => supportKernel target (fun η ζ a => P η a = P ζ a) θ
    have hsv : ∀ θ, SelfVerifying target (fun η ζ a => P η a = P ζ a) θ (support θ) :=
      fun θ => supportKernel_selfVerifying target _ θ
    refine ⟨sharedPolicy P support initial d, sharedPolicy_measurable P support initial d, ?_, ?_⟩
    · exact sharedPolicy_mem_menu P support initial d Γ hk
        (fun θ a ha => (Finset.mem_inter.mp ((hsv θ).1 ha)).2)
    · intro θ
      have hs := shared_policy_actionLaw_eventually_good P target support θ initial d ρ hP hN hk hsv
      filter_upwards [hs] with x hx
      filter_upwards [hx] with t ht
      exact (Finset.mem_inter.mp ht).1

end Orthemology.Tranche2.MicroPolicy
import CheckedTargetOperation

noncomputable section
open MeasureTheory ProbabilityTheory Filter
open Orthemology.Tranche2 Orthemology.Tranche2.RecurrentSupport
open scoped BigOperators ENNReal

namespace HiddenParity.Recurrence.Controls

abbrev Two := Fin 2

def flipChain : FiniteChain Two where
  prob s t := if s = t then 0 else 1
  nonnegative s t := by split_ifs <;> norm_num
  normalized s := by fin_cases s <;> norm_num [Fin.sum_univ_two]

def absorbingChain : FiniteChain Two where
  prob s t := if s = t then 1 else 0
  nonnegative s t := by split_ifs <;> norm_num
  normalized s := by simp

/-- This strongly connected chain is periodic, so no aperiodicity is smuggled in. -/
theorem flip_strong : ∀ s t, Relation.ReflTransGen (fun s t => 0 < flipChain.prob s t) s t := by
  intro s t
  by_cases h : s = t
  · subst t
    exact Relation.ReflTransGen.refl
  · exact Relation.ReflTransGen.single (by simp [flipChain, h])

theorem flip_two_step_hit : ∀ s : Two, avoid flipChain 1 2 s = 0 := by
  intro s
  fin_cases s <;> norm_num [avoid, flipChain, Fin.sum_univ_two]

/-- Two steps give a uniform avoidance factor zero in the deterministic cycle. -/
theorem flip_avoidance_bound (k : ℕ) (s : Two) : avoid flipChain 1 (k*2) s ≤ (0 : ℝ)^k :=
  avoid_blocks_bound flipChain 1 2 0 (le_refl _) (fun t => le_of_eq (flip_two_step_hit t)) k s

theorem flip_visits_both :
    ∀ᵐ x ∂markovTrajectory (transitionKernel flipChain) 0, ∀ t, ∃ᶠ n in atTop, x n = t :=
  all_states_recur_almost_surely flipChain 0 flip_strong

def priority23 (s : Two) : ℕ := if s = 0 then 2 else 3

theorem cycle_minimum_even : ∃ k, IsMinimum priority23 (Finset.univ : Finset Two) k ∧ k % 2 = 0 :=
  ⟨2, by decide, rfl⟩

/-- Actual parity success coexists with infinitely many odd-priority visits. -/
theorem actual_cycle_wins_with_infinite_odd_visits :
    ∀ᵐ x ∂markovTrajectory (transitionKernel flipChain) 0,
      PairParitySuccess priority23 x ∧ ∃ᶠ n in atTop, priority23 (x n) = 3 := by
  filter_upwards [flip_visits_both] with x hx
  have hRec : recurrentSet x = Finset.univ := by
    apply Finset.ext
    intro t
    simp only [mem_recurrentSet, Finset.mem_univ, iff_true]
    exact hx t
  refine ⟨by simpa only [PairParitySuccess, hRec] using cycle_minimum_even, ?_⟩
  exact (hx 1).mono (fun n hn => by simp [hn, priority23])

/-- Mere finite nonemptiness/closure is insufficient without connectivity. -/
theorem absorbing_avoids_other (n : ℕ) : avoid absorbingChain 1 n 0 = 1 := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [avoid, absorbingChain, Fin.sum_univ_two] using ih

theorem disconnected_has_no_strict_hitting_bound :
    ¬ ∃ N : ℕ, ∃ r : ℝ, r < 1 ∧ ∀ s, avoid absorbingChain 1 N s ≤ r := by
  rintro ⟨N, r, hr, h⟩
  have h0 := h 0
  rw [absorbing_avoids_other] at h0
  linarith

/-- A stationary scheduler that gives a retained action zero probability can miss
that action forever. Positive retained-action probabilities are essential. -/
def unfairPairChain : FiniteChain Two where
  prob _ t := if t = 1 then 1 else 0
  nonnegative _ t := by split_ifs <;> norm_num
  normalized _ := by simp

theorem unfair_avoids_good_pair (n : ℕ) : avoid unfairPairChain 0 n 1 = 1 := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [avoid, unfairPairChain, Fin.sum_univ_two] using ih

end HiddenParity.Recurrence.Controls
/- Isolated finite structural port for the actual 20-rule HasE grammar. -/
import AllStructuralRename
import ClosedProofCanonicalisation
namespace P01AC.ExtensionalRepair.Structural
open OrthemologyV2 OrthemologyV3 P01D P01R
open P01F (cons)
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000

theorem form_ctx {Γ : Tel} {A : Ty} (h : FormE Γ A) : CtxE Γ := by
  induction h using FormE.rec
    (motive_1 := fun _ _ => True) (motive_3 := fun _ _ _ _ => True) with
  | param h _ => exact h
  | bottom h _ => exact h
  | raw h _ => exact h
  | all h _ _ _ => exact h
  | pi _ _ ih _ => exact ih
  | sigma _ _ ih _ => exact ih
  | identity _ _ _ ih _ _ => exact ih
  | _ => trivial

theorem form_trename {Γ : Tel} {A : Ty} (h : FormE Γ A) :
    ∀ r : Nat → Nat, FormE (trenameTel r Γ) (trename r A) := by
  induction h using FormE.rec
    (motive_1 := fun Γ _ => ∀ r, CtxE (trenameTel r Γ))
    (motive_3 := fun Γ p A _ => ∀ r, HasE (trenameTel r Γ) p (trename r A)) with
  | nil => (first | intro r | rename_i r); exact .nil
  | ext hΓ hA iΓ iA => (first | intro r | rename_i r); exact .ext (iΓ r) (iA r)
  | param hΓ iΓ => intro r; exact .param (iΓ r)
  | bottom hΓ iΓ => intro r; exact .bottom (iΓ r)
  | raw hΓ iΓ => intro r; exact .raw (iΓ r)
  | all hΓ hB iΓ iB =>
      intro r
      exact .all (iΓ r) (by simpa only [trenameTel_twk] using iB (liftRen r))
  | pi hA hB iA iB => intro r; exact .pi (iA r) (iB r)
  | sigma hA hB iA iB => intro r; exact .sigma (iA r) (iB r)
  | identity hA hp hq iA ip iq => intro r; exact .identity (iA r) (ip r) (iq r)
  | var hA hn iA => (first | intro r | rename_i r); exact .var (iA r) (lookup_trename hn r)
  | i hA hF iA iF =>
      first | intro r | rename_i r
      simpa only [trename_arr] using HasE.i (iA r) (by simpa only [trename_arr] using iF r)
  | k hA hB hF iA iB iF =>
      first | intro r | rename_i r
      simpa only [trename_arr] using HasE.k (iA r) (iB r) (by simpa only [trename_arr] using iF r)
  | s hA hB hC hF iA iB iC iF =>
      first | intro r | rename_i r
      simpa only [trename_arr] using HasE.s (iA r) (iB r) (iC r) (by simpa only [trename_arr] using iF r)
  | @finite C Γ t υ hlen hυ hF ht iυ iF =>
      first | intro r | rename_i r
      simpa only [trename_finite_instance] using
        HasE.finite (υ.map (trename r)) (by simpa only [List.length_map] using hlen)
          (fun n hn => by simpa only [typeImages_trename] using iυ n (by simpa only [List.length_map] using hn) r)
          (by simpa only [trename_finite_instance] using iF r) ht
  | allIntro hF hp iF ip =>
      first | intro r | rename_i r
      exact .allIntro (iF r) (by simpa only [trenameTel_twk] using ip (liftRen r))
  | allElim hF hA hI hp iF iA iI ip =>
      first | intro r | rename_i r
      simpa only [trename_tinst] using HasE.allElim (iF r) (iA r)
        (by simpa only [trename_tinst] using iI r) (ip r)
  | rawAtom hF iF => (first | intro r | rename_i r); exact .rawAtom (iF r)
  | rawApp hF hf ha iF iff ia => (first | intro r | rename_i r); exact .rawApp (iF r) (iff r) (ia r)
  | piIntro hF hb hs iF ib =>
      first | intro r | rename_i r
      exact .piIntro (iF r) (ib r) (by simpa only [trenameTel, List.length_map] using hs)
  | piElim hF hI hf ha iF iI iff ia =>
      first | intro r | rename_i r
      simpa only [trename_inst] using HasE.piElim (iF r)
        (by simpa only [trename_inst] using iI r) (iff r) (ia r)
  | sigmaIntro hF hI ha hb iF iI ia ib =>
      first | intro r | rename_i r
      simpa only [trename_inst] using HasE.sigmaIntro (iF r)
        (by simpa only [trename_inst] using iI r) (ia r)
        (by simpa only [trename_inst] using ib r)
  | sigmaFst hA hF hz iA iF iz => (first | intro r | rename_i r); exact .sigmaFst (iA r) (iF r) (iz r)
  | sigmaSnd hF hI hz iF iI iz =>
      first | intro r | rename_i r
      simpa only [trename_inst] using HasE.sigmaSnd (iF r)
        (by simpa only [trename_inst] using iI r) (iz r)
  | identityIntro hF hp hq hc iF ip iq => (first | intro r | rename_i r); exact .identityIntro (iF r) (ip r) (iq r) hc
  | proofErase hR hI hp iR iI ip => (first | intro r | rename_i r); exact .proofErase (iR r) (iI r) (ip r)
  | j hA hB hI hD hE hx hy he hd iA iB iI iD iE ix iy ie id =>
      first | intro r | rename_i r
      simpa only [trename_motiveAt] using HasE.j (iA r)
        (by simpa only [trenameTel_theta] using iB r)
        (iI r) (by simpa only [trename_motiveAt] using iD r)
        (by simpa only [trename_motiveAt] using iE r)
        (ix r) (iy r) (ie r) (by simpa only [trename_motiveAt] using id r)
  | conv hA hp hc hs iA ip =>
      first | intro r | rename_i r
      exact .conv (iA r) (ip r) hc (by simpa only [trenameTel, List.length_map] using hs)

  | piExt hA hB hPi hp hq hBody hFam hh hId sp sq sh sa sb iA iB iPi ip iq iBody iFam ih iId =>
      first | intro r | rename_i r
      exact .piExt (iA r) (iB r) (iPi r) (ip r) (iq r)
        (iBody r) (iFam r) (ih r) (iId r)
        (by simpa only [trenameTel, List.length_map] using sp)
        (by simpa only [trenameTel, List.length_map] using sq)
        (by simpa only [trenameTel, List.length_map] using sh)
        (by simpa only [trenameTel, List.length_map] using tyScoped_trename sa r)
        (by simpa only [trenameTel, List.length_map] using tyScoped_trename sb r)
  | allExt hB hAll hp hq hBody hh hId sp sq sh sb iB iAll ip iq iBody ih iId =>
      first | intro r | rename_i r
      exact .allExt
        (by simpa only [trenameTel_twk] using iB (liftRen r))
        (iAll r) (ip r) (iq r)
        (by simpa only [trenameTel_twk] using iBody (liftRen r))
        (by simpa only [trenameTel_twk] using ih (liftRen r)) (iId r)
        (by simpa only [trenameTel, List.length_map] using sp)
        (by simpa only [trenameTel, List.length_map] using sq)
        (by simpa only [trenameTel, List.length_map] using sh)
        (by simpa only [trenameTel, List.length_map] using tyScoped_trename sb (liftRen r))

theorem has_trename {Γ : Tel} {p : Poly} {A : Ty} (h : HasE Γ p A) (r : Nat → Nat) :
    HasE (trenameTel r Γ) p (trename r A) := by
  have hi := form_trename (FormE.identity (ClosedProofCanonicalisation.formed h) h h) r
  cases hi with
  | identity _ hp _ => exact hp

theorem ctx_trename {Γ : Tel} (h : CtxE Γ) (r : Nat → Nat) : CtxE (trenameTel r Γ) := by
  exact form_ctx (form_trename (FormE.bottom h) r)

theorem ctx_twk {Γ : Tel} (h : CtxE Γ) : CtxE (twkTel Γ) := ctx_trename h Nat.succ

theorem form_twk {Γ : Tel} {A : Ty} (h : FormE Γ A) : FormE (twkTel Γ) (twk A) :=
  form_trename h Nat.succ

theorem has_twk {Γ : Tel} {p : Poly} {A : Ty} (h : HasE Γ p A) : HasE (twkTel Γ) p (twk A) :=
  has_trename h Nat.succ


#print axioms form_trename
#print axioms has_trename
#print axioms ctx_twk
end P01AC.ExtensionalRepair.Structural
