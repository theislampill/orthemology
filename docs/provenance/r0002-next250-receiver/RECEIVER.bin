open P02A2 P02A2.Sigma2RowLaw P02A2.Sigma2Witnesses
-- A permanent candidate gives defect zero, not defect one.
example : defect (rowLaw trueMatrix ()) = 1 := by rw [trueMatrix_defect_zero]; norm_num
import FrozenCompilerMirror

/- A precise reduct-level endpoint result. This is not a HasE soundness proof. -/
namespace OpenTermStandardness

def arrowPER (R S : SatPER) : SatPER where
  rel := Arrow R.rel S.rel
  symm := by
    intro f g h x y hxy
    exact S.symm (h y x (R.symm hxy))
  trans := by
    intro f g h hfg hgh x y hxy
    have hyy := R.trans (R.symm hxy) hxy
    exact S.trans (hfg x y hxy) (hgh y y hyy)
  saturated := by
    intro f g f' g' hf hg h x y hxy
    exact S.saturated (.app hf (.refl x)) (.app hg (.refl y)) (h x y hxy)

def churchPER : SatPER where
  rel n m := ∀ R : SatPER, (arrowPER (arrowPER R R) (arrowPER R R)).rel n m
  symm := by
    intro n m h R
    exact (arrowPER (arrowPER R R) (arrowPER R R)).symm (h R)
  trans := by
    intro n m l hnm hml R
    exact (arrowPER (arrowPER R R) (arrowPER R R)).trans (hnm R) (hml R)
  saturated := by
    intro n m n' m' hn hm h R
    exact (arrowPER (arrowPER R R) (arrowPER R R)).saturated hn hm (h R)

theorem churchPER_dom (n : T) : churchPER.rel n n ↔ Church n := Iff.rfl

theorem iter_related (R : SatPER) {f g a b : T}
    (hfg : Arrow R.rel R.rel f g) (hab : R.rel a b) (k : Nat) :
    R.rel (iter f a k) (iter g b k) := by
  induction k with
  | zero => exact hab
  | succ k ih => exact hfg _ _ ih

/-- Converse direction: no global parametricity axiom is needed here either. -/
theorem uniformIter_church (n : T) (hn : UniformIter n) : Church n := by
  obtain ⟨k, hk⟩ := hn
  intro R f g hfg a b hab
  exact R.saturated (hk f a).symm (hk g b).symm (iter_related R hfg hab k)

/-- Exact domain characterization for this full-PER open-term interpretation. -/
theorem church_iff_uniformIter (n : T) : Church n ↔ UniformIter n :=
  ⟨church_standard n, uniformIter_church n⟩

/-- The tested Church interpretation is inhabited by every finite successor numeral. -/
theorem successorNumeral_church (k : Nat) : Church (successorNumeral k) := by
  intro R f g hfg a b hab
  exact R.saturated (successorNumeral_application k f a).symm
    (successorNumeral_application k g b).symm (iter_related R hfg hab k)

/-- Typed endpoint equality in this reduct, including heterogeneous related
    Church inputs. This is stronger than pointwise agreement on identical n. -/
theorem identity_q_related : (arrowPER churchPER churchPER).rel .i q := by
  intro n m hnm
  have hm : Church m := churchPER.trans (churchPER.symm hnm) hnm
  intro R f g hfg a b hab
  have h := hnm R f g hfg a b hab
  exact R.saturated
    (Conv.app (Conv.app (.i n) (.refl f)) (.refl a)).symm
    (church_scalar_fusion m hm g b) h

/-- Consequently this full-PER reduct cannot separate I and the compiler mirror q. -/
theorem no_reduct_separator : ¬ ¬ (arrowPER churchPER churchPER).rel .i q :=
  fun h => h identity_q_related

#print axioms church_iff_uniformIter
#print axioms successorNumeral_church
#print axioms identity_q_related
#print axioms no_reduct_separator
end OpenTermStandardness
import LoopRenaming
import CodecStmt

/-! Literal lowering of prcodec.py lines 293-310. All variadic Python Seq
nodes use the inherited parser's sequenceList; the source's sorted compressed
register allocation is retained. No alternate selector or program is used. -/
namespace P02.LiteralShift
open P02A2.ObserverCore P02A2.LoopRenaming
open P02.Codec (sequenceList)

abbrev C := Expr.constant
abbrev V := Expr.reg

def initial (n w : ℕ) : Store := fun r => if r = 0 then n else if r = 1 then w else 0

def sourceRegisters (body : Stmt) (output : ℕ) : Finset ℕ :=
  insert 0 (insert 1 (insert output (stmtRegs body)))

def registerList (body : Stmt) (output : ℕ) : List ℕ :=
  (sourceRegisters body output).sort (· ≤ ·)

def registerMap (body : Stmt) (output r : ℕ) : ℕ :=
  12 + (registerList body output).idxOf r

def tailArgs : List (ℕ × Expr) := [(0, .sub (V 9) (C 1)), (1, V 10)]

/-- The exact variadic body emitted by Builder.inline at this call site. -/
def literalInline (body : Stmt) (output : ℕ) : Stmt :=
  let ρ := registerMap body output
  sequenceList ((registerList body output).map (fun r => .set (ρ r) (C 0)) ++
    tailArgs.map (fun a => .set (ρ a.1) a.2) ++
    [renameStmt ρ body, .set 11 (V (ρ output))])

def lengthExpr : Expr := .add (V 0) (C 1)
def depthExpr : Expr := .add (V 3) (C 1)

def scanBody (a b : ℕ) : Stmt :=
  .branch (.eq (V 4) (C 0))
    (sequenceList [
      .set 8 (.pow2 depthExpr),
      .set 7 (.mod (.div (V 1) (.pow2 (.sub lengthExpr depthExpr))) (V 8)),
      .branch (.le (.mul (C b) (.add (V 7) (C 1))) (.mul (C a) (V 8)))
        (sequenceList [.set 4 (C 1), .set 5 (C 0), .set 6 depthExpr])
        (.branch (.le (.mul (C a) (V 8)) (.mul (C b) (V 7)))
          (sequenceList [.set 4 (C 1), .set 5 (C 1), .set 6 depthExpr])
          .skip)]) .skip

def scan (a b : ℕ) : Stmt := .loop 3 lengthExpr (scanBody a b)

def initialise : Stmt := sequenceList [.set 4 (C 0), .set 5 (C 0), .set 6 (C 0)]

def replay (body : Stmt) (output : ℕ) : Stmt :=
  sequenceList [
    .set 9 (.sub lengthExpr (V 6)),
    .set 10 (.add (.pow2 (V 9)) (.mod (V 1) (.pow2 (V 9)))),
    literalInline body output,
    .set 2 (.mod (V 11) (C 2))]

def finish (body : Stmt) (output : ℕ) : Stmt :=
  sequenceList [
    .set 2 (.mod (V 1) (C 2)),
    .branch (V 4) (.branch (V 5)
      (.branch (.le (V 6) (V 0)) (replay body output) .skip) .skip) .skip]

def compileShift (body : Stmt) (output a b : ℕ) : Stmt :=
  sequenceList [
    .set 4 (C 0), .set 5 (C 0), .set 6 (C 0), scan a b,
    .set 2 (.mod (V 1) (C 2)),
    .branch (V 4) (.branch (V 5)
      (.branch (.le (V 6) (V 0)) (replay body output) .skip) .skip) .skip]

/-- Natural arithmetic cell value, before any sentinel restriction. -/
def prefixValue (n w k : ℕ) : ℕ := w / 2^(n+1-k) % 2^k

def classify (a b n w k : ℕ) : Option Bool :=
  let v := prefixValue n w k
  if b * (v+1) ≤ a * 2^k then some false
  else if a * 2^k ≤ b*v then some true else none

structure Cut where
  depth : ℕ
  above : Bool
  deriving DecidableEq, Repr

def scanChoice (a b n w : ℕ) : ℕ → Option Cut
  | 0 => none
  | k+1 => match scanChoice a b n w k with
    | some c => some c
    | none => (classify a b n w (k+1)).map (fun side => ⟨k+1,side⟩)

def foundValue : Option Cut → ℕ
  | none => 0
  | some _ => 1

def branchValue : Option Cut → ℕ
  | none => 0
  | some c => if c.above then 1 else 0

def stopValue : Option Cut → ℕ
  | none => 0
  | some c => c.depth

def ScanAgrees (σ : Store) (n w : ℕ) (choice : Option Cut) : Prop :=
  σ 0 = n ∧ σ 1 = w ∧ σ 4 = foundValue choice ∧
  σ 5 = branchValue choice ∧ σ 6 = stopValue choice

end P02.LiteralShift
