import JointTypeInstantiation
import JointControls

namespace JointCompletion.MixedControls
open P01AC P01D OrthemologyV2 OrthemologyV3 P01R
open P01F (cons)
open JointCompletion.Structural
open JointCompletion.Controls
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem arrow_formed {Γ A B} (hA : FormJ Γ A) (hB : FormJ Γ B) :
    FormJ Γ (arr A B) := .pi hA (Structural.form_wk hB (Structural.form_ctx hA) hA)

def sourceType : Ty := .all (arr (.param 1) (.param 1))
def sourcePoly : Poly := .atom .i

theorem source_typing : HasJ [] sourcePoly sourceType := by
  have hf : FormJ [] (arr (.param 1) (.param 1)) := arrow_formed (.param .nil) (.param .nil)
  exact .allIntro (.all .nil hf) (.i (.param .nil) hf)

/-- One replacement type is simultaneously beyond old E formation and dependent
on an actual free variable in the target term telescope. -/
def mixedImage : Ty := .pi newMotive (.identity .raw (.var 1) (.var 1))
def mixedTypes : Nat → Ty := cons mixedImage Ty.param

theorem raw_context : CtxJ [.raw] := .ext .nil (.raw .nil)

theorem mixed_image_formed : FormJ [.raw] mixedImage := by
  have hn : FormJ [.raw] newMotive := new_motive_form (.ext .nil (.raw .nil))
  have hc := CtxJ.ext raw_context hn
  have hx : HasJ [newMotive,.raw] (.var 1) .raw := .var (.raw hc) (.succ .zero)
  exact .pi hn (.identity (.raw hc) hx hx)

theorem mixed_images_formed : ∀ n, FormJ [.raw] (mixedTypes n) := by
  intro n
  cases n with
  | zero => exact mixed_image_formed
  | succ n => exact .param raw_context

/-- A single application of the new theorem crosses both All and term binders. -/
theorem dependent_new_type_instance : HasJ [.raw] sourcePoly (.all (arr mixedImage mixedImage)) :=
  has_closed_tsubst source_typing raw_context mixed_images_formed

private def codomainEndpoint : Ty → Nat
  | .all (.pi _ (.pi _ (.identity _ (.var n) _))) => n + 1
  | _ => 0

/-- Failure to lift a target-relative image under Pi would capture its endpoint. -/
theorem wrong_unlifted_codomain :
    tsubst mixedTypes sourceType ≠ .all (.pi mixedImage mixedImage) := by
  intro h
  have he := congrArg codomainEndpoint h
  change 3 = 2 at he
  contradiction

/-- The domain really requires the new completion rules; old E cannot form it. -/
theorem mixed_image_not_old : ¬ P01AC.ExtensionalRepair.FormE [.raw] mixedImage := by
  intro h
  cases h with
  | pi hM _ =>
      have hi : P01AC.ExtensionalRepair.HasE [] (.atom .i) .raw := .rawAtom (.raw .nil)
      have hs : P01AC.ExtensionalRepair.Structural.TypedSubstitution [.raw] []
          (cons (.atom .i) Poly.var) :=
        P01AC.ExtensionalRepair.Structural.TypedSubstitution.single .nil hi
      have hm := P01AC.ExtensionalRepair.Structural.form_subst hM .nil hs
      exact new_motive_not_old (by simpa only [newMotive_subst] using hm)

theorem mixed_result_not_old (p : Poly) :
    ¬ P01AC.ExtensionalRepair.HasE [.raw] p (.all (arr mixedImage mixedImage)) := by
  intro h
  have hf := P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed h
  cases hf with
  | all _ hB => cases hB with | pi hI _ => exact mixed_image_not_old hI

/-- Erased All instantiation now accepts a newly Joint-formed type without
requiring the conclusion's formation as a separate premise. -/
theorem all_eliminate_new_type : HasJ [] (.atom .i) (arr newMotive newMotive) := by
  have hf : FormJ [] (arr (.param 0) (.param 0)) := arrow_formed (.param .nil) (.param .nil)
  have hp : HasJ [] (.atom .i) (.all (arr (.param 0) (.param 0))) :=
    .allIntro (.all .nil hf) (.i (.param .nil) hf)
  exact allElim_formed hp (new_motive_form .nil)

def closeTerm : Nat → Poly := cons (.atom .i) Poly.var

theorem close_term_typed : TypedSubstitution [.raw] [] closeTerm :=
  TypedSubstitution.instantiate .nil (.rawAtom (.raw .nil))

theorem type_then_term_instance : HasJ [] (psub closeTerm sourcePoly)
    (mixed closeTerm (fun n => subst closeTerm (mixedTypes n)) sourceType) :=
  has_type_then_term source_typing raw_context (TypeSubstitution.empty mixed_images_formed)
    .nil close_term_typed

/-- Applying term substitution must act on the injected type images too. -/
theorem unchanged_type_images_wrong :
    mixed closeTerm mixedTypes sourceType ≠
      mixed closeTerm (fun n => subst closeTerm (mixedTypes n)) sourceType := by
  intro h
  have he := congrArg codomainEndpoint h
  change 3 = 0 at he
  contradiction

#print axioms dependent_new_type_instance
#print axioms wrong_unlifted_codomain
#print axioms mixed_image_not_old
#print axioms mixed_result_not_old
#print axioms all_eliminate_new_type
#print axioms type_then_term_instance
#print axioms unchanged_type_images_wrong
end JointCompletion.MixedControls
import PythonRunnerMachine

namespace P02.PythonRunner
open P02.PythonExpr

def Fits (trace : Bool) (c : Config) : Prop :=
  Room c.meter (remaining trace c).ticks ∧ Width c.meter (remaining trace c).bits

def commandExpr : Command → Option PyExpr
  | .set _ e | .loop _ e _ | .branch e _ _ => some e
  | .seq _ => none

theorem commandSummary_ticks_pos (trace : Bool) (s : Command) (d : Dictionary) :
    0 < (commandSummary trace s d).ticks := by
  cases s <;> simp [commandSummary, charge, Nat.add_assoc]

theorem repeatSummary_ticks_pos (body : Dictionary → Summary) (r k n : ℕ) (d : Dictionary) :
    0 < (repeatSummary body r k n d).ticks := by
  cases n <;> simp [repeatSummary, charge]

theorem taskSummary_ticks_pos (trace : Bool) (t : Task) (d : Dictionary) :
    0 < (taskSummary trace t d).ticks := by
  cases t with
  | stmt s => exact commandSummary_ticks_pos trace s d
  | «repeat» r count k body => exact repeatSummary_ticks_pos _ _ _ _ _

theorem command_expr_bounds (trace : Bool) (s : Command) (d : Dictionary) (e : PyExpr)
    (h : commandExpr s = some e) :
    1+cost e ≤ (commandSummary trace s d).ticks ∧
    neededBits d e ≤ (commandSummary trace s d).bits := by
  cases s with
  | set r e' =>
      simp only [commandExpr, Option.some.injEq] at h
      subst e
      simp [commandSummary]
  | seq ss => simp [commandExpr] at h
  | loop r e' body =>
      simp only [commandExpr, Option.some.injEq] at h
      subst e
      simp [commandSummary, charge]
  | branch e' s t =>
      simp only [commandExpr, Option.some.injEq] at h
      subst e
      simp [commandSummary, charge]

theorem initial_task_room (trace : Bool) (c : Config) (hne : c.work ≠ []) (hf : Fits trace c) :
    Room c.meter 1 := by
  have hp : 0 < (remaining trace c).ticks := by
    rcases c with ⟨work,d,m,events⟩
    cases work with
    | nil => exact (hne rfl).elim
    | cons t tail =>
        have ht := taskSummary_ticks_pos trace t d
        change 0 < (taskSummary trace t d).ticks +
          (tasksSummary trace tail (taskSummary trace t d).store).ticks
        omega
  intro bound hb
  have hs := hf.1 bound hb
  omega

theorem expression_fits (trace : Bool) (s : Command) (e : PyExpr) (tail : List Task)
    (d : Dictionary) (m : Meter) (events : List (ℕ × ℕ)) (he : commandExpr s = some e)
    (hf : Fits trace ⟨.stmt s::tail,d,m,events⟩) :
    Room {m with steps := m.steps+1} (cost e) ∧
    Width {m with steps := m.steps+1} (neededBits d e) := by
  have hh := command_expr_bounds trace s d e he
  constructor
  · intro bound hb
    have hs := hf.1 bound hb
    change m.steps + ((commandSummary trace s d).ticks +
      (tasksSummary trace tail (commandSummary trace s d).store).ticks) ≤ bound at hs
    change m.steps + 1 + cost e ≤ bound
    omega
  · intro bound hb
    have hs := hf.2 bound hb
    change max (commandSummary trace s d).bits
      (tasksSummary trace tail (commandSummary trace s d).store).bits ≤ bound at hs
    exact le_trans hh.2 (le_trans (Nat.le_max_left _ _) hs)

/-- With sufficient future check-site budgets, the exact source step cannot fail.
This does not impose a width bound on initial values or unchecked loop writes. -/
theorem step_exists_of_fits (trace : Bool) (c : Config) (hne : c.work ≠ [])
    (hf : Fits trace c) : ∃ out, step trace c = .ok out := by
  have ht := tick_of_room c.meter (initial_task_room trace c hne hf)
  rcases c with ⟨work,d,m,events⟩
  cases work with
  | nil => exact (hne rfl).elim
  | cons task tail =>
      cases task with
      | «repeat» r count k body =>
          by_cases hk : k < count
          · exact ⟨_,by simp [step, ht, hk]; rfl⟩
          · exact ⟨_,by simp [step, ht, hk]; rfl⟩
      | stmt s =>
          cases s with
          | seq ss => exact ⟨_,by simp [step, ht]; rfl⟩
          | set r e =>
              have he := expression_fits trace (.set r e) e tail d m events rfl hf
              have hx := expression_bounded d e {m with steps := m.steps+1} he.1 he.2
              exact ⟨_,by simp [step, ht, hx]; rfl⟩
          | loop r e body =>
              have he := expression_fits trace (.loop r e body) e tail d m events rfl hf
              have hx := expression_bounded d e {m with steps := m.steps+1} he.1 he.2
              exact ⟨_,by simp [step, ht, hx]; rfl⟩
          | branch e s t =>
              have he := expression_fits trace (.branch e s t) e tail d m events rfl hf
              have hx := expression_bounded d e {m with steps := m.steps+1} he.1 he.2
              exact ⟨_,by simp [step, ht, hx]; rfl⟩

theorem fits_after_step (trace : Bool) (c out : Config) (hne : c.work ≠ [])
    (hf : Fits trace c) (hs : step trace c = .ok out) : Fits trace out := by
  rcases step_accounting trace c out hne hs with ⟨_,_,ht,_,hb,hl,hmax⟩
  constructor
  · intro bound hbound
    have h := hf.1 bound (hl.symm.trans hbound)
    change out.meter.steps + (remaining trace out).ticks ≤ bound
    rw [← ht]
    exact h
  · intro bound hbound
    exact le_trans hb (hf.2 bound (hmax.symm.trans hbound))

/-- Finite mathematical task fuel equals the pure profile's task pops. The
meter budget counts task pops PLUS embedded expression work and is different. -/
theorem complete_at_pops (trace : Bool) (c : Config) (hf : Fits trace c) :
    ∃ out, runSteps trace (remaining trace c).pops c = .ok out ∧ out.work = [] := by
  by_cases hw : c.work = []
  · refine ⟨c,?_,hw⟩
    simp [remaining, hw, tasksSummary, unchanged, runSteps]
  · obtain ⟨next,hs⟩ := step_exists_of_fits trace c hw hf
    have hn := fits_after_step trace c next hw hf hs
    have hp := (step_accounting trace c next hw hs).2.2.2.1
    obtain ⟨out,hr,hout⟩ := complete_at_pops trace next hn
    refine ⟨out,?_,hout⟩
    rw [← hp, runSteps, hs, result_bind_ok, hr]
termination_by (remaining trace c).pops

def initial (s : Command) (d : Dictionary) (m : Meter) : Config := ⟨[.stmt s],d,m,[]⟩

@[simp] theorem remaining_initial (trace : Bool) (s : Command) (d : Dictionary) (m : Meter) :
    remaining trace (initial s d m) = commandSummary trace s d := by
  simp [remaining, initial, tasksSummary, taskSummary]

/-- Explicit finite source-meter budgets for each typed finite command/store.
No uniform all-input finite cap or physical execution guarantee is asserted. -/
theorem runner_complete_finite (trace : Bool) (s : Command) (d : Dictionary) :
    let p := commandSummary trace s d
    ∃ out, runFuel trace p.pops
      (initial s d ⟨some p.ticks,some p.bits,0⟩) = .ok (some out) := by
  let p := commandSummary trace s d
  let c := initial s d ⟨some p.ticks,some p.bits,0⟩
  have hf : Fits trace c := by
    constructor
    · intro bound hb
      have he := Option.some.inj hb
      simpa only [c, remaining_initial, Nat.zero_add] using le_of_eq he
    · intro bound hb
      have he := Option.some.inj hb
      simpa only [c, remaining_initial] using le_of_eq he
  obtain ⟨out,hr,hw⟩ := complete_at_pops trace c hf
  refine ⟨out,?_⟩
  have hp : (remaining trace c).pops = p.pops := by simp [c,p]
  rw [hp] at hr
  change runFuel trace p.pops c = .ok (some out)
  simp only [runFuel, hr, result_bind_ok, hw]

end P02.PythonRunner
import NudgeRigidity

/-! Coherent-endpoint-directed nudges, explicitly separate from the frozen
ambient-direction premise in NudgeRigidity. -/
noncomputable section
open scoped Topology BigOperators
open Filter Set SmoothRigidity GeneratorRigidity NudgeRigidity

namespace CoherentNudgeRigidity
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def CommonCoherentLocalNudges (s t : ι → SmoothScalar.Score) (i0 : ι) : Prop :=
  ∀ p : Vec ι, (∀ i, p i ∈ Ioo 0 1) → (∑ i, p i = 1) →
    ∃ (e : ℕ → ℝ) (c : ℕ → Vec ι),
      (∀ n, 0 < e n) ∧ Tendsto e atTop (𝓝 0) ∧
      (∀ n i, (p + e n • vertex i0) i ∈ Ioo 0 1) ∧
      (∀ n i, c n i ∈ Ioo 0 1) ∧ (∀ n, ∑ i, c n i = 1) ∧
      (∀ n i, hessian s (p + e n • vertex i0) (p + e n • vertex i0 - vertex i)
        (c n - (p + e n • vertex i0)) < 0) ∧
      (∀ n i, hessian t (p + e n • vertex i0) (p + e n • vertex i0 - vertex i)
        (c n - (p + e n • vertex i0)) < 0)

lemma coherent_nudges_are_ambient (s t : ι → SmoothScalar.Score) (i0 : ι)
    (hc : CommonCoherentLocalNudges s t i0) : CommonLocalNudges s t i0 := by
  intro p hp hsum
  obtain ⟨e, c, hep, hel, hbi, hci, hcs, hs, ht⟩ := hc p hp hsum
  exact ⟨e, (fun n => c n - (p + e n • vertex i0)), hep, hel, hbi, hs, ht⟩

lemma single_score_coherent_nudges (s : ι → SmoothScalar.Score) (i0 : ι) (p : Vec ι)
    (hp : ∀ i, p i ∈ Ioo 0 1) (hsum : ∑ i, p i = 1) :
    ∃ (e : ℕ → ℝ) (c : ℕ → Vec ι),
      (∀ n, 0 < e n) ∧ Tendsto e atTop (𝓝 0) ∧
      (∀ n i, (p + e n • vertex i0) i ∈ Ioo 0 1) ∧
      (∀ n i, c n i ∈ Ioo 0 1) ∧ (∀ n, ∑ i, c n i = 1) ∧
      (∀ n i, hessian s (p + e n • vertex i0) (p + e n • vertex i0 - vertex i)
        (c n - (p + e n • vertex i0)) < 0) := by
  obtain ⟨e, q, hepos, helim, hbint, hqint, hqsum, hqgain⟩ :=
    BregmanProjection.single_score_local_repairs s p (vertex i0) hp hsum
  let base : ℕ → Vec ι := fun n => p + e n • vertex i0
  let A : ℕ → ι → ℝ := fun n i => ((s i).ddf (base n i))⁻¹
  let S : ℕ → ℝ := fun n => ∑ i, A n i
  let Sp : ℝ := ∑ i, ((s i).ddf (p i))⁻¹
  have hApos : ∀ n i, 0 < A n i := fun n i => inv_pos.mpr ((s i).positive _ (hbint n i))
  have hSpos : ∀ n, 0 < S n := by
    intro n
    exact Finset.sum_pos' (fun i _ => (hApos n i).le) ⟨i0, Finset.mem_univ i0, hApos n i0⟩
  have hSppos : 0 < Sp := by
    exact Finset.sum_pos' (fun i _ => (inv_pos.mpr ((s i).positive _ (hp i))).le)
      ⟨i0, Finset.mem_univ i0, inv_pos.mpr ((s i0).positive _ (hp i0))⟩
  have hbase : Tendsto base atTop (𝓝 p) := by
    simpa [base] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => p) atTop (𝓝 p)).add
        (helim.smul (tendsto_const_nhds : Tendsto (fun _ : ℕ => vertex i0) atTop (𝓝 (vertex i0))))
  have hAt : ∀ i, Tendsto (fun n => A n i) atTop (𝓝 (((s i).ddf (p i))⁻¹)) := by
    intro i
    have ht := ((s i).cont_second.continuousAt (Ioo_mem_nhds (hp i).1 (hp i).2)).tendsto.comp
      ((tendsto_pi_nhds.mp hbase) i)
    exact ht.inv₀ (ne_of_gt ((s i).positive _ (hp i)))
  have hSt : Tendsto S atTop (𝓝 Sp) := tendsto_finset_sum _ (fun i _ => hAt i)
  let c : ℕ → Vec ι := fun n i => base n i - e n * A n i
  have hct : Tendsto c atTop (𝓝 p) := by
    apply tendsto_pi_nhds.mpr
    intro i
    have hh := ((tendsto_pi_nhds.mp hbase) i).sub
      ((helim.mul (hAt i)).div hSt (ne_of_gt hSppos))
    simpa [c] using hh
  have hcsum : ∀ n, ∑ i, c n i = 1 := by
    intro n
    have hbsum : ∑ i, base n i = 1 + e n := by
      simp only [base, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
        ← Finset.mul_sum, hsum, vertex_sum, mul_one]
    simp only [c, Finset.sum_sub_distrib, ← Finset.sum_div, ← Finset.mul_sum, hbsum]
    change 1 + e n - e n * S n / S n = 1
    field_simp [ne_of_gt (hSpos n)]
  have hdiff : ∀ n, c n - base n = (S n)⁻¹ •
      (fun i => (1 - ∑ k, base n k) / (s i).ddf (base n i)) := by
    intro n
    have hbsum : ∑ i, base n i = 1 + e n := by
      simp only [base, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
        ← Finset.mul_sum, hsum, vertex_sum, mul_one]
    ext i
    simp only [c, A, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hbsum]
    ring
  have hgain : ∀ n i, hessian s (base n) (base n - vertex i) (c n - base n) < 0 := by
    intro n i
    rw [hdiff, map_smul, smul_eq_mul, canonical_nudge_gain s (base n) (hbint n)]
    have hbsum : ∑ i, base n i = 1 + e n := by
      simp only [base, Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
        ← Finset.mul_sum, hsum, vertex_sum, mul_one]
    rw [hbsum]
    apply mul_neg_of_pos_of_neg (inv_pos.mpr (hSpos n))
    have hh := sq_pos_of_pos (hepos n)
    nlinarith
  have hcint : ∀ᶠ n in atTop, ∀ i, c n i ∈ Ioo 0 1 := by
    apply Filter.eventually_all.mpr
    intro i
    exact ((tendsto_pi_nhds.mp hct) i).eventually (Ioo_mem_nhds (hp i).1 (hp i).2)
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hcint
  refine ⟨(fun n => e (n+N)), (fun n => c (n+N)), (fun n => hepos (n+N)),
    (tendsto_add_atTop_iff_nat N).mpr helim, (fun n i => hbint (n+N) i),
    (fun n i => hN (n+N) (Nat.le_add_left N n) i), (fun n => hcsum (n+N)), ?_⟩
  intro n i
  exact hgain (n+N) i


theorem universal_coherent_nudge_iff_affine (hcard : 3 ≤ Fintype.card ι)
    (s t : ι → SmoothScalar.Score) (i0 : ι) :
    CommonCoherentLocalNudges s t i0 ↔ BregmanProjection.PositiveAffineEquivalent s t := by
  constructor
  · intro hn
    exact (universal_local_nudge_iff_affine hcard s t i0).mp (coherent_nudges_are_ambient s t i0 hn)
  · rintro ⟨a, ha, f, g, hfg⟩
    intro p hp hpsum
    obtain ⟨e, c, hepos, helim, hbint, hcint, hcsum, ht⟩ := single_score_coherent_nudges t i0 p hp hpsum
    refine ⟨e, c, hepos, helim, hbint, hcint, hcsum, ?_, ht⟩
    intro n i
    rw [affine_hessian_direction s t a f g hfg _ _ _ (hbint n)]
    exact mul_neg_of_pos_of_neg ha (ht n i)

/-- Endpoint-directed nudging and actual dominating endpoints have the same
universal fixed-generator class. No pointwise equivalence is claimed. -/
theorem universal_coherent_nudge_iff_common_repair (hcard : 3 ≤ Fintype.card ι)
    (s t : ι → SmoothScalar.Score) (i0 : ι) :
    CommonCoherentLocalNudges s t i0 ↔ BregmanProjection.CommonLocalRepairs s t i0 :=
  (universal_coherent_nudge_iff_affine hcard s t i0).trans
    (BregmanProjection.universal_common_repair_iff_affine hcard s t i0).symm

#print CommonCoherentLocalNudges
#print axioms single_score_coherent_nudges
#print axioms universal_coherent_nudge_iff_affine
#print axioms universal_coherent_nudge_iff_common_repair
#check universal_coherent_nudge_iff_affine
#check universal_coherent_nudge_iff_common_repair
end CoherentNudgeRigidity

import Mathlib

/-! UNEXECUTED. Small finite rational law layer and general pivot completion.
The fully permutation-invariant all-proper-marginal theorem is separately a
statement contract, not falsely counted among the proved declarations here. -/
namespace P02A2.FiniteLaw
open scoped BigOperators

structure Law (X : Type*) [Fintype X] where
  weight : X → ℚ
  nonneg : ∀ x, 0 ≤ weight x
  total : ∑ x, weight x = 1

variable {X Y : Type*} [Fintype X] [Fintype Y]

noncomputable def event (p : Law X) (A : X → Prop) : ℚ := by
  classical
  exact ∑ x, if A x then p.weight x else 0

noncomputable def mix (p q : Law X) (a : ℚ) (ha : 0 ≤ a) (ha1 : a ≤ 1) : Law X where
  weight x := (1-a)*p.weight x+a*q.weight x
  nonneg x := add_nonneg (mul_nonneg (by linarith) (p.nonneg x)) (mul_nonneg ha (q.nonneg x))
  total := by rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, p.total, q.total]; ring

theorem mix_event (p q : Law X) (a : ℚ) (ha : 0 ≤ a) (ha1 : a ≤ 1) (A : X → Prop) :
    event (mix p q a ha ha1) A = (1-a)*event p A+a*event q A := by
  classical
  unfold event
  simp only [mix]
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x hx
  split_ifs <;> ring

noncomputable def push (p : Law X) (f : X → Y) : Law Y := by
  classical
  refine ⟨fun y => ∑ x, if f x=y then p.weight x else 0, ?_, ?_⟩
  · intro y
    apply Finset.sum_nonneg
    intro x hx
    split_ifs
    · exact p.nonneg x
    · exact le_rfl
  · rw [Finset.sum_comm]
    simpa using p.total

theorem push_event (p : Law X) (f : X → Y) (A : Y → Prop) :
    event (push p f) A = event p (fun x => A (f x)) := by
  classical
  unfold event push
  simp only
  simp_rw [Finset.sum_ite_irrel]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x hx
  simp

-- General parity completion: a free word determines its unique pivot bit.
def parity : List Bool → Bool
  | [] => false
  | x::xs => Bool.xor x (parity xs)

def complete (b : Bool) (xs : List Bool) : List Bool := Bool.xor b (parity xs) :: xs

theorem complete_parity (b : Bool) (xs : List Bool) : parity (complete b xs)=b := by
  simp only [complete,parity]
  cases b <;> cases parity xs <;> rfl

theorem complete_length (b : Bool) (xs : List Bool) : (complete b xs).length=xs.length+1 := by
  simp [complete]

theorem complete_injective (b : Bool) : Function.Injective (complete b) := by
  intro x y h
  exact List.cons.inj h |>.2

theorem complete_unique (b a : Bool) (xs : List Bool) (h : parity (a::xs)=b) :
    a::xs=complete b xs := by
  cases a <;> cases hp : parity xs <;> cases b <;> simp_all [parity,complete]

noncomputable def completionEquiv (b : Bool) (n : ℕ) :
    {xs : List Bool // xs.length=n} ≃ {ys : List Bool // ys.length=n+1 ∧ parity ys=b} where
  toFun xs := ⟨complete b xs.val, by rw [complete_length,xs.property]; exact And.intro rfl (complete_parity b xs.val)⟩
  invFun ys := ⟨ys.val.tail, by cases h : ys.val with
    | nil => have hp := ys.property.1; simp [h] at hp
    | cons a xs => simpa [h] using ys.property.1⟩
  left_inv xs := by apply Subtype.ext; rfl
  right_inv ys := by
    apply Subtype.ext
    cases h : ys.val with
    | nil => have hp := ys.property.1; simp [h] at hp
    | cons a xs =>
      have hp : parity (a::xs)=b := by simpa [h] using ys.property.2
      simpa [h] using (complete_unique b a xs hp).symm

-- Exact all-n targets: these are definitions of propositions, NOT theorem proofs.
def cubeParity {n : ℕ} (x : Fin n → Bool) : Bool := parity (List.ofFn x)
noncomputable def parityWeight (n : ℕ) (b : Bool) (x : Fin n → Bool) : ℚ :=
  if cubeParity x=b then (2:ℚ)/(2:ℚ)^n else 0

noncomputable def properMarginalTarget : Prop :=
  ∀ n : ℕ, 1≤n → ∀ J : Finset (Fin n), J ≠ Finset.univ →
    ∀ u : Fin n → Bool, ∀ b : Bool,
      (∑ x : Fin n → Bool, if ∀ j∈J, x j=u j then parityWeight n b x else 0)
        = (1:ℚ)/(2:ℚ)^J.card
end P02A2.FiniteLaw
import Controls
open GuardedTree GuardedTree.Controls

/- Deliberately false: empty has the same judgement and smaller support than alpha,
   but the parent licence requires alpha's exact support in its first position. -/
example : Tree.Valid grammar (licensed empty beta) := by
  constructor
  · intro i
    fin_cases i <;>
      simp [licensed, pair, empty, beta, Tree.Valid, Tree.judgement, grammar, arity]
  · change (∅ : Finset Root) = {Root.alpha} ∧ {Root.beta} = {Root.beta}
    decide
import SeededPolicyEquivalence

noncomputable section
open MeasureTheory ProbabilityTheory Filter Finset
open scoped BigOperators
namespace Orthemology.Tranche2.MicroPolicy
open PolicyEmbedding
universe u v w
variable {R : Type v} {A Y : Type u} {Θ : Type w}
    [Fintype Θ] [Fintype A] [Fintype Y] [DecidableEq A] [Inhabited Y]
    [MeasurableSpace R] [MeasurableSpace A] [MeasurableSingletonClass A]
    [MeasurableSpace Y] [MeasurableSingletonClass Y]

omit [Fintype Θ] [Fintype A] [Fintype Y] [Inhabited Y] [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
lemma queue_mem_menu (plan : Θ → List A) (choose : History A Y → Θ) (Γ : Finset A)
    (hplan : ∀ σ a, a ∈ plan σ → a ∈ Γ) (h : History A Y) :
    ∀ a ∈ queue plan choose h, a ∈ Γ := by
  induction h with
  | nil => exact hplan _
  | cons z h ih =>
    simp only [queue]
    split_ifs with he
    · exact hplan _
    · intro a ha
      exact ih a (List.mem_of_mem_tail ha)

omit [Fintype A] [MeasurableSpace R] [Inhabited Y] [Fintype Y] [MeasurableSpace A] [MeasurableSingletonClass A] [MeasurableSpace Y] [MeasurableSingletonClass Y] in
/-- Every action issued on every history is licensed. This concerns the common
static menu, separately from eventual true-target acceptance. -/
theorem sharedPolicy_mem_menu (P : Θ → A → Y → ℝ) (support : Θ → Finset A)
    (initial : Θ) (d : A) (Γ : Finset A)
    (hne : ∀ σ, (support σ).Nonempty) (hmenu : True)
    (r : R) (h : History A Y) : sharedPolicy P support initial d r h ∈ Γ := by
  apply queue_mem_menu (supportPlan support) (chooseMLE P initial) Γ
    (fun σ a ha => hmenu σ (by simpa [supportPlan] using ha)) h
  exact headD_mem_of_nonempty _ d
    (queue_nonempty _ _ (supportPlan_nonempty support hne) h)

omit [Fintype A] [DecidableEq A] in
lemma measurableSet_always_mem (Γ : Finset A) :
    MeasurableSet {x : ℕ → A | ∀ n, x n ∈ Γ} := by
  have he : {x : ℕ → A | ∀ n, x n ∈ Γ} = ⋂ n : ℕ, {x : ℕ → A | x n ∈ Γ} := by
    ext x
    simp
  rw [he]
  exact MeasurableSet.iInter (fun n => Γ.measurableSet.preimage (measurable_pi_apply n))

/-- A pointwise licensed history policy produces only licensed actions under
its actual canonical experiment. -/
theorem actionLaw_always_licensed (π : R → History A Y → A)
    (hπ : Measurable (fun z : R × History A Y => π z.1 z.2))
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (P : A → Y → ℝ) (hP : ∀ a y, 0 ≤ P a y) (hN : ∀ a, ∑ y, P a y = 1)
    (d : A) (Γ : Finset A) (hlegal : ∀ r h, π r h ∈ Γ) :
    ∀ᵐ x ∂actionLaw π ρ P hP hN d, ∀ n, x n ∈ Γ := by
  apply actionLaw_ae_of_stack π hπ ρ P hP hN d _ (measurableSet_always_mem Γ)
  exact Filter.Eventually.of_forall (fun z n => hlegal _ _)

/-- Explicit common-static-menu version of the exact same-runner theorem.
All issued actions are licensed, including the finitely many target errors. -/
theorem licensed_seeded_policy_exists_iff_kernel_nonempty
    (P : Θ → A → Y → ℝ) (good : Θ → Finset A) (Γ : Finset A) (initial : Θ) (d : A)
    (ρ : Measure R) [IsProbabilityMeasure ρ]
    (hP : ∀ σ a y, 0 < P σ a y) (hN : ∀ σ a, ∑ y, P σ a y = 1) :
    (∃ π : R → History A Y → A,
      Measurable (fun z : R × History A Y => π z.1 z.2) ∧
      (∀ r h, π r h ∈ Γ) ∧
      ∀ θ, ∀ᵐ x ∂actionLaw π ρ (P θ) (fun a y => (hP θ a y).le) (hN θ) d,
        ∀ᶠ t in atTop, x t ∈ good θ) ↔
      ∀ θ, (supportKernel (fun θ => good θ ∩ Γ)
        (fun η ζ a => P η a = P ζ a) θ).Nonempty := by
  constructor
  · rintro ⟨π,hπ,hlegal,hgood⟩ θ
    apply seeded_policy_kernel_nonempty P (fun θ => good θ ∩ Γ) hP hN π hπ ρ d
    intro η
    have hall := actionLaw_always_licensed π hπ ρ (P η) (fun a y => (hP η a y).le) (hN η) d Γ hlegal
    filter_upwards [hgood η,hall] with x hx hl
    filter_upwards [hx] with t ht
    exact Finset.mem_inter.mpr ⟨ht,hl t⟩
  · intro hk
    let target := fun θ => good θ ∩ Γ
    let support := fun θ => supportKernel target (fun η ζ a => P η a = P ζ a) θ
    have hsv : ∀ θ, SelfVerifying target (fun η ζ a => P η a = P ζ a) θ (support θ) :=
      fun θ => supportKernel_selfVerifying target _ θ
    refine ⟨sharedPolicy P support initial d, sharedPolicy_measurable P support initial d, ?_, ?_⟩
    · exact sharedPolicy_mem_menu P support initial d Γ hk
        (fun θ a ha => (Finset.mem_inter.mp ((hsv θ).1 ha)).2)
    · intro θ
      have hs := shared_policy_actionLaw_eventually_good P target support θ initial d ρ hP hN hk hsv
      filter_upwards [hs] with x hx
      filter_upwards [hx] with t ht
      exact (Finset.mem_inter.mp ht).1

end Orthemology.Tranche2.MicroPolicy
import TruncatedMoment
import Mathlib.Algebra.MvPolynomial.Degrees
import Mathlib.Algebra.BigOperators.Fin

noncomputable section
namespace TruncatedMoment
open MvPolynomial

theorem exponent_coordinates (m : Fin 3 →₀ ℕ) :
    m = exponent (m 0) (m 1) (m 2) := by
  ext i
  fin_cases i <;> simp [exponent]

theorem exponent_sum (a b c : ℕ) :
    (exponent a b c).sum (fun _ n => n) = a+b+c := by
  rw [Finsupp.sum_fintype _ _ (by simp)]
  simp [Fin.sum_univ_succ, exponent]
  omega

theorem small_exponent_cases (a b c : ℕ) (h : a+b+c ≤ 2) :
    (a=0 ∧ b=0 ∧ c=0) ∨ (a=2 ∧ b=0 ∧ c=0) ∨ (a=0 ∧ b=2 ∧ c=0) ∨
    (a=0 ∧ b=0 ∧ c=2) ∨ (a=1 ∧ b=0 ∧ c=0) ∨ (a=0 ∧ b=1 ∧ c=1) ∨
    (a=0 ∧ b=1 ∧ c=0) ∨ (a=1 ∧ b=0 ∧ c=1) ∨ (a=0 ∧ b=0 ∧ c=1) ∨
    (a=1 ∧ b=1 ∧ c=0) := by omega

theorem coeff_large_exponent (p : Poly) (h : p.totalDegree ≤ 2)
    (a b c : ℕ) (habc : ¬ a+b+c ≤ 2) : p.coeff (exponent a b c) = 0 := by
  by_contra hc
  have hle := le_totalDegree (mem_support_iff.mpr hc)
  rw [exponent_sum] at hle
  omega

/-- Every actual polynomial of total degree at most two has the ten displayed coefficients. -/
theorem quadratic_parameterization (p : Poly) (h : p.totalDegree ≤ 2) :
    p = quadratic
      (p.coeff (exponent 0 0 0)) (p.coeff (exponent 2 0 0))
      (p.coeff (exponent 0 2 0)) (p.coeff (exponent 0 0 2))
      (p.coeff (exponent 1 0 0)) (p.coeff (exponent 0 1 1))
      (p.coeff (exponent 0 1 0)) (p.coeff (exponent 1 0 1))
      (p.coeff (exponent 0 0 1)) (p.coeff (exponent 1 1 0)) := by
  ext m
  obtain ⟨a,b,c,hm⟩ : ∃ a b c, m = exponent a b c := ⟨m 0,m 1,m 2,exponent_coordinates m⟩
  subst m
  by_cases habc : a+b+c ≤ 2
  · rcases small_exponent_cases a b c habc with hcase | hcase | hcase | hcase | hcase | hcase | hcase | hcase | hcase | hcase
    all_goals rcases hcase with ⟨rfl,rfl,rfl⟩
    all_goals norm_num [quadratic, term, coeff_monomial, exponent_eq_iff]
  · rw [coeff_large_exponent p h a b c habc]
    have hn : ¬ (a=0 ∧ b=0 ∧ c=0) ∧ ¬ (a=2 ∧ b=0 ∧ c=0) ∧ ¬ (a=0 ∧ b=2 ∧ c=0) ∧
      ¬ (a=0 ∧ b=0 ∧ c=2) ∧ ¬ (a=1 ∧ b=0 ∧ c=0) ∧ ¬ (a=0 ∧ b=1 ∧ c=1) ∧
      ¬ (a=0 ∧ b=1 ∧ c=0) ∧ ¬ (a=1 ∧ b=0 ∧ c=1) ∧ ¬ (a=0 ∧ b=0 ∧ c=1) ∧
      ¬ (a=1 ∧ b=1 ∧ c=0) := by omega
    rcases hn with ⟨h0,h1,h2,h3,h4,h5,h6,h7,h8,h9⟩
    simp [quadratic, term, coeff_monomial, exponent_eq_iff, eq_comm,
      h0,h1,h2,h3,h4,h5,h6,h7,h8,h9]

end TruncatedMoment
import CodecProgram

/-! A diagonal sharpness control for the exact numeric evaluator. It does not
assert a runtime bound or change the semantics of invalid indices. -/
namespace P02.Codec.NonPRBoundary
open P02.Codec P02A2.PRProgram

theorem evaluateIndex_lt_two (e n word : ℕ) : evaluateIndex e n word < 2 := by
  unfold evaluateIndex
  cases decodeIndex e with
  | none => simp
  | some p => simp only; split_ifs <;> omega

/-- The actual universal evaluator is computable, but cannot be uniformly
primitive recursive in all three natural inputs. -/
theorem evaluateIndex_not_primrec :
    ¬ Primrec (fun input : ℕ × ℕ × ℕ => evaluateIndex input.1 input.2.1 input.2.2) := by
  intro h
  have h0 : Primrec (fun args : Fin 2 → ℕ => args 0) :=
    Primrec.fin_app.comp Primrec.id (Primrec.const 0)
  have h1 : Primrec (fun args : Fin 2 → ℕ => args 1) :=
    Primrec.fin_app.comp Primrec.id (Primrec.const 1)
  have hd : Primrec (fun args : Fin 2 → ℕ => evaluateIndex (args 0) (args 0) (args 1) + 1) :=
    Primrec.nat_add.comp (Primrec.comp h (h0.pair (h0.pair h1))) (Primrec.const 1)
  obtain ⟨p,hp⟩ := P02A2.PRCoverage.exists_program_of_primrec _ hd
  let e := programIndex (pack p)
  have he := evaluateIndex_programIndex p e 0
  rw [hp] at he
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at he
  have hb := evaluateIndex_lt_two e e 0
  change evaluateIndex e e 0 = (evaluateIndex e e 0 + 1) % 2 at he
  omega

end P02.Codec.NonPRBoundary
#print axioms P02.Codec.NonPRBoundary.evaluateIndex_lt_two
#print axioms P02.Codec.NonPRBoundary.evaluateIndex_not_primrec
import StepCode
import AuxiliaryExactViews
namespace AuxiliaryCodeComputability
open Encodable SourceFamilyComputability CodedScope ExactSyntaxValidity
open AuxiliaryCertificates OrthemologyV2 P01D
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000
attribute [local irreducible] Nat.pair

theorem checkStepCode_exact (c : StepCert) (t u : Term) :
    checkStepCode (encode c) (encode t) (encode u) = checkStep c t u := by
  induction c generalizing t u with
  | i x =>
    rw [checkStepCode,evaluate]
    simp only [encode_step_i,stepShape,stepChildren,pack,List.foldr_cons,List.foldr_nil,
      a1,a2,a3,a4,v1,v2,v3,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,
      unpair_leaf,lhs_pair,rhs_pair,tmApp_exact,encode_injective.eq_iff,checkStep]
    simp
  | k x y =>
    rw [checkStepCode,evaluate]
    simp only [encode_step_k,stepShape,stepChildren,pack,List.foldr_cons,List.foldr_nil,
      a1,a2,a3,a4,v1,v2,v3,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,
      unpair_leaf,lhs_pair,rhs_pair,tmApp_exact,encode_injective.eq_iff,checkStep]
    simp
  | s f g x =>
    rw [checkStepCode,evaluate]
    simp only [encode_step_s,stepShape,stepChildren,pack,List.foldr_cons,List.foldr_nil,
      a1,a2,a3,a4,v1,v2,v3,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,
      unpair_leaf,lhs_pair,rhs_pair,tmApp_exact,encode_injective.eq_iff,checkStep]
    simp
  | left f g x c ih =>
    have hc : encode c < encode (StepCert.left f g x c) := by
      rw [encode_step_left]; exact field_lt_pack _ _ (by simp)
    rw [checkStepCode,evaluate]
    simp only [encode_step_left,stepShape,stepChildren,pack,List.foldr_cons,List.foldr_nil,
      a1,a2,a3,a4,v1,v2,v3,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,
      unpair_leaf,lhs_pair,rhs_pair,tmApp_exact,encode_injective.eq_iff,checkStep]
    simp only [encode_step_left,pack,List.foldr_cons,List.foldr_nil] at hc
    simp [hc,eval_step,ih]
  | right f x y c ih =>
    have hc : encode c < encode (StepCert.right f x y c) := by
      rw [encode_step_right]; exact field_lt_pack _ _ (by simp)
    rw [checkStepCode,evaluate]
    simp only [encode_step_right,stepShape,stepChildren,pack,List.foldr_cons,List.foldr_nil,
      a1,a2,a3,a4,v1,v2,v3,tag,arg1,arg2,arg3,first_node,rest_node,rest_leaf,
      unpair_leaf,lhs_pair,rhs_pair,tmApp_exact,encode_injective.eq_iff,checkStep]
    simp only [encode_step_right,pack,List.foldr_cons,List.foldr_nil] at hc
    simp [hc,eval_step,ih]

#print axioms primrec_checkStepCode
#print axioms checkStepCode_exact
end AuxiliaryCodeComputability
import NativeInitialWitness
import NativePolicyInputs

namespace SharedAlias.Native.Entry
open ComposedExecution
open OperationalJoin.Typed (interface)

/-- Stored completion-acknowledger row. Presence and distinct-label shape
are executable checks; genuine completion requires accepted reachable history. -/
def completionRow {m} (D : Routing m) (C : FiniteState m) : Nat → Option (List (Fin m))
  | 0 => none
  | e + 1 => do
      let labels ← tableFind C.certificateRows e
      if labels.toFinset.card = D.r then some labels else none

/-- All finite samples remain explicit. This checker does not authenticate
policy content or validate a history. In particular a forged coherent input
can pass shape checks without satisfying the theorem's external premises. -/
def checkedPolicy {m} (D : Routing m) (C : FiniteState m) (actor : Actor)
    (samples : List (Nat × Policy)) (syncBits : List Bool) : Option Policy := do
  if C.pending then none else do
    if actor.policy.epoch = C.epoch ∧ actor.observedPlant = C.plant ∧ syncBits.length = m then
      let policy ← policySample samples actor.policy.epoch
      if policy = actor.policy then
        if C.epoch = 0 then some policy else do
          let _ ← completionRow D C C.epoch
          some policy
      else none
    else none

def syncReply {m} (bits : List Bool) (i : Fin m) : Bool := bits.getD i.val false

/-- One numerical legality test plus the prescribed service response. Good
slots complete; a bad label can withhold. No source function is queried. -/
def syncAllowed {m} (D : Routing m) (C : FiniteState m) (policy : Policy)
    (i : Fin m) (reply : Bool) : Bool :=
  decide (0 < policy.epoch ∧ policy.epoch ≤ C.epoch) && (!faulty D i || reply)

def syncSlot {m} (D : Routing m) (C : FiniteState m) (policy : Policy)
    (i : Fin m) (reply : Bool) : FiniteState m :=
  if syncAllowed D C policy i reply then deliverUpdate D C i policy else C

def syncEvent {m} (D : Routing m) (C : FiniteState m) (policy : Policy)
    (i : Fin m) (reply : Bool) : OperationalJoin.Event (interface m) :=
  if syncAllowed D C policy i reply then .deliver i policy.epoch else .hold

/-- An explicit public order, independent of aliases and faults. -/
def publicLabels (m : Nat) : List (Fin m) := List.finRange m

def publicPrelude (m : Nat) (actor : Actor) : List (Fin m × Nat) :=
  (publicLabels m).map (fun i => (i, actor.policy.epoch))

def syncRun {m} (D : Routing m) (C : FiniteState m) (policy : Policy)
    (bits : List Bool) : Outcome m :=
  serviceLoop (fun C i => (syncSlot D C policy i (syncReply bits i),
    syncEvent D C policy i (syncReply bits i))) C (publicLabels m)

/-- Entry into an existing finite state: never reset the plant or memories.
The public programme is compiled unchanged before environmental service. -/
def runRepresented {m} (D : Routing m) (C : FiniteState m) (actor : Actor)
    (action : Action) (paths : List (OrderedPath m)) (samples : List (Nat × Policy))
    (syncBits : List Bool) (annotations : List (Annotation m)) : Option (Outcome m) := do
  let specs ← compileOrdered actor action paths annotations
  let policy ← checkedPolicy D C actor samples syncBits
  let sync := syncRun D C policy syncBits
  let result := runNative D actor.identity sync.state specs
  pure ⟨result.state, sync.events ++ result.events⟩

end SharedAlias.Native.Entry
import Mathlib

/-!
P02 separate research candidate. NOT EXECUTED at any Lean version.
Finite n=3 bridge only. The ordinary all-n proof is in analysis/Q1c_FINITE_PROBABILITY.md.
These exact rational tables are not claimed to be an already checked PMF development.
-/
namespace P02.T300
open scoped BigOperators
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

def parity3 (x : Fin 8) : Nat := (x.val / 4 + x.val / 2 + x.val) % 2

def evenWeight (x : Fin 8) : ℚ := if parity3 x = 0 then 1/4 else 0
def oddWeight (x : Fin 8) : ℚ := if parity3 x = 1 then 1/4 else 0
def mixtureWeight (x : Fin 8) : ℚ := evenWeight x / 2 + if x.val = 0 then 1/2 else 0

def profile (w : Fin 8 → ℚ) (mask pattern : Nat) : ℚ :=
  ∑ x : Fin 8, if Nat.land x.val mask = pattern then w x else 0

def evenTarget (w : Fin 8 → ℚ) : ℚ :=
  ∑ x : Fin 8, if parity3 x = 0 then w x else 0

def flipLowBit (x : Fin 8) : Fin 8 :=
  ⟨(x.val / 2) * 2 + (1 - x.val % 2), by omega⟩

theorem normalised :
    (∑ x : Fin 8, evenWeight x) = 1 ∧
    (∑ x : Fin 8, oddWeight x) = 1 ∧
    (∑ x : Fin 8, mixtureWeight x) = 1 := by decide

theorem weights_nonnegative :
    ∀ x : Fin 8, 0 ≤ evenWeight x ∧ 0 ≤ oddWeight x ∧ 0 ≤ mixtureWeight x := by decide

theorem all_proper_marginals_equal :
    ∀ mask : Fin 7, ∀ pattern : Fin 8,
      profile evenWeight mask.val pattern.val = profile oddWeight mask.val pattern.val := by decide

theorem parity_target_changes : evenTarget oddWeight = 0 ∧ evenTarget evenWeight = 1 := by decide

theorem declared_flip :
    (∀ x : Fin 8, flipLowBit (flipLowBit x) = x) ∧
    (∀ x : Fin 8, oddWeight x = evenWeight (flipLowBit x)) := by decide

theorem mixture_target_retained : evenTarget evenWeight = 1 ∧ evenTarget mixtureWeight = 1 := by decide

theorem every_pair_profile_changes :
    ∀ mask : Fin 8, (mask.val = 3 ∨ mask.val = 5 ∨ mask.val = 6) →
      profile evenWeight mask.val 0 = 1/4 ∧ profile mixtureWeight mask.val 0 = 5/8 := by decide

end P02.T300
import Countermodel
example : FullPolynomialCountermodel.Λ FullPolynomialCountermodel.witness = 0 := by
  rw [FullPolynomialCountermodel.witness_negative]
  norm_num
import Lean
import OpenDevelopments
import ScalarCertificates
import NonstandardRejection
open Lean Elab Command
run_cmd do
  let env ← getEnv
  for target in [``OpenDevelopments.development_complete,
      ``OpenDevelopments.closed_HasE_development_terminates,
      ``OpenDevelopments.extractIteration,
      ``OpenDevelopments.extractIteration_uniform,
      ``ScalarCertificates.checkedScalar,
      ``ScalarCertificates.checkedIteration,
      ``ScalarCertificates.checkedSourceInstance,
      ``NonstandardRejection.checked_non_iteration_refutes] do
    let (_, state) := ((Lean.CollectAxioms.collect target).run env).run {}
    for ax in state.axioms do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Unexpected axiom {ax} in {target}"
    logInfo m!"PASS allowed axioms for {target}: {state.axioms}"
  let (_, strategy) := ((Lean.CollectAxioms.collect ``OpenDevelopments.development_complete).run env).run {}
  for forbidden in [``FullPER.fundamental, ``OpenTermStandardness.church_standard,
      ``P01Candidates.finite_SN, ``ClosedScalarInstances.closed_scalar_instance_exact] do
    if strategy.visited.contains forbidden then
      throwError "Open strategy unexpectedly depends on {forbidden}"
  for needed in [``OpenDevelopments.par_develop, ``OpenDevelopments.conv_chain] do
    unless strategy.visited.contains needed do throwError "Strategy omitted {needed}"
  let (_, extract) := ((Lean.CollectAxioms.collect ``OpenDevelopments.extractIteration).run env).run {}
  for needed in [``Nat.find, ``OpenDevelopments.readIteration, ``OpenDevelopments.run,
      ``OpenDevelopments.closed_HasE_readback_exists,
      ``ClosedScalarInstances.generic_conversion_reflect] do
    unless extract.visited.contains needed do throwError "Extractor omitted {needed}"
  let (_, certificate) := ((Lean.CollectAxioms.collect ``ScalarCertificates.checkedSourceInstance).run env).run {}
  for forbidden in [``FullPER.fundamental, ``OpenTermStandardness.church_standard,
      ``ClosedScalarInstances.source_uniform_iteration,
      ``ClosedScalarInstances.closed_scalar_conversion,
      ``ClosedScalarInstances.closed_scalar_instance,
      ``ClosedScalarInstances.closed_scalar_instance_exact,
      ``OpenDevelopments.extractIteration, ``Classical.choice] do
    if certificate.visited.contains forbidden then
      throwError "Finite certificate path unexpectedly depends on {forbidden}"
  for needed in [``ScalarCertificates.replayTo, ``ScalarCertificates.replay,
      ``ScalarCertificates.stepAt, ``ScalarCertificates.root,
      ``ClosedScalarInstances.generic_conversion_reflect,
      ``P01AC.ExtensionalRepair.HasE.conv,
      ``P01AC.ExtensionalRepair.HasE.identityIntro,
      ``P01AC.ExtensionalRepair.HasE.piIntro,
      ``P01AC.ExtensionalRepair.HasE.allIntro] do
    unless certificate.visited.contains needed do throwError "Certificate omitted {needed}"
  let (_, rejection) := ((Lean.CollectAxioms.collect ``NonstandardRejection.checked_non_iteration_refutes).run env).run {}
  for needed in [``ScalarCertificates.replayTo, ``NonstandardRejection.normalB_sound,
      ``OpenDevelopments.normal_unique, ``ClosedScalarInstances.source_uniform_iteration] do
    unless rejection.visited.contains needed do throwError "Negative certificate omitted {needed}"
  logInfo "PASS: strategy is triangle/cofinality; executable search uses Nat.find; certificate source replay is independent of semantic standardness and the closed-instance theorem."
import Q8ObserverAbstraction
import UniformComputabilityMachine

/-! Generated-byte and explicit-stack-runtime crosswalk. This uses the exact
recovered P02 source parser and runtime, not a replacement language or assumed
source/Mealy law equality. It does not model Python metering or host failures. -/
namespace Orthemology.CertifiedObserver.ParsedQ8
open Orthemology.Frontier Orthemology.Frontier.MealyMeasure
open P02A2.Q8Machine P02.Codec P02.Codec.UniformComputability
open Set MeasureTheory
open scoped ENNReal

/-- Literal Q8 compiled source in the recovered binary program envelope. -/
def packed {n : ℕ} (M : Machine n) : PackedProgram :=
  ⟨2, 0, P02A2.Q8Compiler.compiled M⟩

def code {n : ℕ} (M : Machine n) : ℕ := programIndex (packed M)

theorem decoded_source_exact {n : ℕ} (M : Machine n) :
    decodeIndex (code M) = some (packed M) := decodeIndex_programIndex _

theorem generated_bytes_exact {n : ℕ} (M : Machine n) :
    decodeBytes (encodeBytes (packed M)) = some (packed M) := decodeBytes_encodeBytes _

def observer {n : ℕ} (M : Machine n) : Cantor → Cantor :=
  P02A2.ObserverCore.output (evaluateIndex (code M))

theorem parsed_output_compiled {n : ℕ} (M : Machine n) :
    observer M = P02A2.Q8Compiler.compiledObserver M := by
  funext x k
  unfold observer P02A2.Q8Compiler.compiledObserver P02A2.ObserverCore.output
  rw [evaluateIndex, decoded_source_exact]
  simp only [packed, ↓reduceIte, Nat.mod_mod]
  rfl

/-- Generated bytes, actual decoding, source execution, and Q8 Mealy ticks
are one exact complete-stream equation. -/
theorem parsed_output_mealy {n : ℕ} (M : Machine n) (hn : 0 < n) :
    observer M = output (Q8.observer M) (initial n hn) := by
  rw [parsed_output_compiled, Q8.compiled_output M hn]

noncomputable def law {n : ℕ} (M : Machine n) : Measure Cantor :=
  P02A2.Q8Measure.fairCantor.map (observer M)

theorem parsed_law_compiled {n : ℕ} (M : Machine n) :
    law M = P02A2.Q8Compiler.compiledLaw M := by
  unfold law P02A2.Q8Compiler.compiledLaw
  rw [parsed_output_compiled]

theorem parsed_finite_solver {n : ℕ} (M : Machine n) (hn : 0 < n)
    {T : Type*} [Fintype T] [DecidableEq T] [Nonempty T] (A : Mealy T)
    (R : Simulation (Q8.observer M) A) (t : T)
    (initial_rel : R.relates (initial n hn) t) :
    (solveDefect A t : ℝ) = P02A2.defect (law M) := by
  rw [parsed_law_compiled]
  exact Q8.compiled_finite_solver M hn A R t initial_rel

def inputWord (x : Cantor) (k : ℕ) : ℕ :=
  P02A2.ObserverCore.sentinel (List.ofFn (fun i : Fin (k+1) => x i.val))

/-- Fuel failure stays none. It is not converted to a zero bit. -/
def runtimeTick {n : ℕ} (fuel : ℕ) (M : Machine n) (x : Cantor) (k : ℕ) : Option Bool :=
  (evaluateIndexFuel fuel (code M) k (inputWord x k)).map (fun v => decide (v % 2 = 1))

theorem runtime_tick_sound {n : ℕ} (M : Machine n) (hn : 0 < n)
    (fuel : ℕ) (x : Cantor) (k : ℕ) (b : Bool)
    (h : runtimeTick fuel M x k = some b) :
    b = output (Q8.observer M) (initial n hn) x k := by
  obtain ⟨v,hv,hb⟩ := Option.map_eq_some_iff.mp h
  have he := evaluateIndexFuel_sound hv
  subst v
  rw [← parsed_output_mealy M hn]
  exact hb.symm

theorem runtime_tick_complete {n : ℕ} (M : Machine n) (hn : 0 < n)
    (x : Cantor) (k : ℕ) : ∃ fuel, ∀ more, fuel ≤ more →
      runtimeTick more M x k = some (output (Q8.observer M) (initial n hn) x k) := by
  obtain ⟨f,hf⟩ := evaluateIndexFuel_eventually (code M) k (inputWord x k)
  refine ⟨f, fun more hm => ?_⟩
  unfold runtimeTick
  rw [hf more hm, ← parsed_output_mealy M hn]
  rfl

/-- One finite budget suffices for a chosen finite trace. There is no claim
that one budget suffices for every stage of the infinite process. -/
theorem runtime_finite_trace {n : ℕ} (M : Machine n) (hn : 0 < n)
    (x : Cantor) (N : ℕ) : ∃ fuel, ∀ more, fuel ≤ more → ∀ k, k < N →
      runtimeTick more M x k = some (output (Q8.observer M) (initial n hn) x k) := by
  induction N with
  | zero => exact ⟨0, by intro more hm k hk; omega⟩
  | succ N ih =>
      obtain ⟨f,hf⟩ := ih
      obtain ⟨g,hg⟩ := runtime_tick_complete M hn x N
      refine ⟨max f g, fun more hm k hk => ?_⟩
      by_cases he : k = N
      · subst k
        exact hg more ((le_max_right f g).trans hm)
      · exact hf more ((le_max_left f g).trans hm) k (by omega)

namespace Fixtures
open Orthemology.Frontier.MealyMeasure.Fixtures Q8.Fixtures

theorem grow_parsed_solver :
    (solveDefect zeroMachine () : ℝ) = P02A2.defect (law grow) :=
  parsed_finite_solver grow (by decide) zeroMachine growSimulation () rfl

theorem halt_parsed_solver :
    (solveDefect copyMachine () : ℝ) = P02A2.defect (law haltNow) :=
  parsed_finite_solver haltNow (by decide) copyMachine haltSimulation () True.intro

/-- Zero fuel cannot issue a semantic bit for a valid generated program. -/
theorem zero_fuel_is_not_zero {n : ℕ} (M : Machine n) (x : Cantor) (k : ℕ) :
    runtimeTick 0 M x k = none := by
  unfold runtimeTick evaluateIndexFuel
  rw [decoded_source_exact]
  simp [packed, runFuel]

theorem timeout_defaulting_corrupts_halt :
    (runtimeTick 0 haltNow (fun _ => true) 0).getD false ≠
      output (Q8.observer haltNow) (initial 1 (by decide)) (fun _ => true) 0 := by
  rw [zero_fuel_is_not_zero]
  decide

#eval decodeIndex (code haltNow) == some (packed haltNow)
#eval runtimeTick 0 haltNow (fun _ => true) 0
#eval runtimeTick 100 haltNow (fun _ => true) 0
#eval runtimeTick 100 grow (fun _ => true) 0

end Fixtures
end Orthemology.CertifiedObserver.ParsedQ8
import Initiality
namespace SigmaCompletion
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.ExtensionalRepair
open RigidityInitiality
open P01AC.ExtensionalRepair.InternalGraph
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

def reconstruct (z : Poly) := pairPoly (fstPoly z) (sndPoly z)
def pairSub : Nat → Poly := cons (pairPoly (.var 1) (.var 0)) (fun n => .var (n+2))
def branchType (P : Ty) := subst pairSub P
def branchAt (d a b : Poly) := psub (cons b (cons a Poly.var)) d

theorem reconstruction_has {Γ A B z} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) (hz : Has Γ z (.sigma A B)) :
    Has Γ (reconstruct z) (.sigma A B) := by
  have hf := Has.sigmaFst hA (.sigma hA hB) hz
  have hb := form_inst_source hc hB hf
  exact .sigmaIntro (.sigma hA hB) hb hf (.sigmaSnd (.sigma hA hB) hb hz)

theorem identity_sym {Γ X x y e} (hc : Ctx Γ) (hX : Form Γ X)
    (hx : Has Γ x X) (hy : Has Γ y X) (he : HasE Γ e (.identity X x y)) :
    HasE Γ (jPoly (.atom .i) y e) (.identity X y x) := by
  let P : Ty := .identity (wk X) (.var 0) (pren Nat.succ x)
  have cx := Ctx.ext hc hX
  have hw := form_wk hX hc hX
  have hP : Form (X :: Γ) P := .identity hw (.var hw .zero) (has_wk hx hc hX)
  have at_eq (v : Poly) : inst P v = .identity X v x := by
    simp only [P, inst, subst, subst_wk_cancel, subst_id, psub, cons]
    congr 1
    simpa only [psub_id] using P01DF.Syntactic.polynomial_shift_cancel x v Poly.var
  have base := Has.identityIntro (.identity hX hx hx) hx hx (P01DF.PolyConv.refl x)
  have h := transport_source hc hX hP hx hy he ((at_eq x).symm ▸ has_inclusion base)
  simpa only [at_eq] using h

theorem pair_substitution {Γ A B a b} (hc : Ctx Γ)
    (ha : Has Γ a A) (hb : Has Γ b (inst B a)) :
    MixedSubstitution (B :: A :: Γ) Γ (cons b (cons a Poly.var)) Ty.param := by
  refine ⟨fun _ => .param hc, ?_⟩
  intro n C h
  cases h with
  | zero => simpa only [mixed_param, subst_wk_cancel, cons] using hb
  | succ h =>
    cases h with
    | zero => simpa only [mixed_param, subst_wk_cancel, subst_id, cons] using ha
    | succ h => simpa only [mixed_param, subst_wk_cancel, subst_id, cons] using
        (Has.var (lookup_form hc h) h)

theorem branch_type_at (P : Ty) (a b : Poly) :
    subst (cons b (cons a Poly.var)) (branchType P) = inst P (pairPoly a b) := by
  rw [branchType, subst_comp]
  congr 1
  funext n; cases n <;> rfl

theorem branch_has {Γ A B P d a b} (hc : Ctx Γ)
    (hd : Has (B :: A :: Γ) d (branchType P))
    (ha : Has Γ a A) (hb : Has Γ b (inst B a)) :
    Has Γ (branchAt d a b) (inst P (pairPoly a b)) := by
  have h := has_mixed hd hc (pair_substitution hc ha hb)
  simpa only [mixed_param, branch_type_at] using h

def elim (d z e : Poly) := jPoly (branchAt d (fstPoly z) (sndPoly z)) z
  (jPoly (.atom .i) (reconstruct z) e)

/-- An original-source dependent branch and motive acquire elimination at any
original-source Sigma input from an explicit HasE eta witness. -/
theorem elim_of_eta {Γ A B P d z e} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) (hP : Form (.sigma A B :: Γ) P)
    (hd : Has (B :: A :: Γ) d (branchType P)) (hz : Has Γ z (.sigma A B))
    (he : HasE Γ e (.identity (.sigma A B) z (reconstruct z))) :
    HasE Γ (elim d z e) (inst P z) := by
  have hf := Has.sigmaFst hA (.sigma hA hB) hz
  have hs := Has.sigmaSnd (.sigma hA hB) (form_inst_source hc hB hf) hz
  have hr := reconstruction_has hc hA hB hz
  exact transport_source hc (.sigma hA hB) hP hr hz
    (identity_sym hc (.sigma hA hB) hz hr he)
    (has_inclusion (branch_has hc hd hf hs))


theorem j_erases (d y e : Poly) : P01DF.PolyConv (jPoly d y e) d :=
  (P01DF.PolyConv.app (.k _ _) (.refl _)).trans (.k _ _)

theorem psub_rel (p : Poly) {σ τ : Nat → Poly}
    (h : ∀ n, P01DF.PolyConv (σ n) (τ n)) :
    P01DF.PolyConv (psub σ p) (psub τ p) := by
  induction p with
  | var n => exact h n
  | atom t => exact .refl _
  | app f x hf hx => exact .app hf hx

theorem elim_erases (d z e : Poly) :
    P01DF.PolyConv (elim d z e) (branchAt d (fstPoly z) (sndPoly z)) := j_erases _ _ _

/-- Canonical computation is raw source SKI conversion, regardless of the eta
proof supplied; no UIP or proof equality is used. -/
theorem elim_pair_computation (d a b e : Poly) :
    P01DF.PolyConv (elim d (pairPoly a b) e) (branchAt d a b) := by
  apply (elim_erases _ _ _).trans
  apply psub_rel
  intro n
  cases n with
  | zero => exact pair_second a b
  | succ n => cases n with
    | zero => exact pair_first a b
    | succ n => exact .refl _

def etaMotive (S : Ty) : Ty := .identity (wk S) (.var 0) (reconstruct (.var 0))

theorem eta_motive_formed {Γ A B} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) : Form (.sigma A B :: Γ) (etaMotive (.sigma A B)) := by
  have hS := Form.sigma hA hB
  have cw := Ctx.ext hc hS
  have hw := form_wk hS hc hS
  have hv : Has (.sigma A B :: Γ) (.var 0) (wk (.sigma A B)) := .var hw .zero
  have hAw : Form (.sigma A B :: Γ) (wk A) := form_wk hA hc hS
  have hBw := sigma_body_form hw
  exact .identity hw hv (reconstruction_has cw hAw hBw hv)

theorem eta_motive_at (S : Ty) (z : Poly) :
    inst (etaMotive S) z = .identity S z (reconstruct z) := by
  simp only [etaMotive, inst, subst, subst_wk_cancel, subst_id]
  rfl

theorem shifted_body_at (B : Ty) :
    inst (subst (pup (fun n => Poly.var (n+2))) B) (.var 1) = wk B := by
  rw [inst, subst_comp]
  congr 1
  funext n; cases n <;> rfl

theorem generic_pair_has {Γ A B} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) :
    Has (B :: A :: Γ) (pairPoly (.var 1) (.var 0)) (wk (wk (.sigma A B))) := by
  have ca := Ctx.ext hc hA
  have cb := Ctx.ext ca hB
  have hS := Form.sigma hA hB
  have hS2 := form_wk (form_wk hS hc hA) ca hB
  have hA2 := form_wk (form_wk hA hc hA) ca hB
  have ha : Has (B :: A :: Γ) (.var 1) (wk (wk A)) := .var hA2 (.succ .zero)
  have hb0 : Has (B :: A :: Γ) (.var 0) (wk B) := .var (form_wk hB ca hB) .zero
  have heq : wk (wk (.sigma A B)) = .sigma (wk (wk A))
      (subst (pup (fun n => Poly.var (n+2))) B) := by
    simp only [wk, subst, subst_comp]
    congr 1
    congr 1
    funext n; cases n <;> rfl
  rw [heq] at hS2 ⊢
  exact .sigmaIntro hS2 ((shifted_body_at B).symm ▸ form_wk hB ca hB)
    ha ((shifted_body_at B).symm ▸ hb0)

theorem pair_poly_congr {a a' b b'} (ha : P01DF.PolyConv a a')
    (hb : P01DF.PolyConv b b') : P01DF.PolyConv (pairPoly a b) (pairPoly a' b') :=
  .app (.app (.refl _) (.app (.refl _) (.app (.refl _) ha))) (.app (.refl _) hb)

theorem canonical_eta_branch {Γ A B} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) :
    Has (B :: A :: Γ) (.atom .i) (branchType (etaMotive (.sigma A B))) := by
  have ca := Ctx.ext hc hA
  have cb := Ctx.ext ca hB
  have hp := generic_pair_has hc hA hB
  have hS2 := has_form hp
  have ha2 := form_wk (form_wk hA hc hA) ca hB
  have hr := reconstruction_has cb ha2 (sigma_body_form hS2) hp
  have conv : P01DF.PolyConv (pairPoly (.var 1) (.var 0))
      (reconstruct (pairPoly (.var 1) (.var 0))) :=
    (pair_poly_congr (pair_first _ _) (pair_second _ _)).symm
  have h := Has.identityIntro (.identity hS2 hp hr) hp hr conv
  have eqt : branchType (etaMotive (.sigma A B)) =
      .identity (wk (wk (.sigma A B))) (pairPoly (.var 1) (.var 0))
        (reconstruct (pairPoly (.var 1) (.var 0))) := by
    have hs : subst pairSub (wk (.sigma A B)) = wk (wk (.sigma A B)) := by
      change subst (cons (pairPoly (.var 1) (.var 0)) (fun n => .var (n+2))) (wk (.sigma A B)) = _
      rw [subst_wk_cancel, wk, wk, subst_comp]
      rfl
    change Ty.identity (subst pairSub (wk (.sigma A B))) _ _ = _
    rw [hs]
    rfl
  exact eqt.symm ▸ h

/-- Uniform source schema: eta at every original-source typed Sigma term. -/
def EtaSchema : Prop := ∀ (Γ : Tel) (A B : Ty) (z : Poly),
  Ctx Γ → Form Γ A → Form (A :: Γ) B → Has Γ z (.sigma A B) →
  ∃ e, HasE Γ e (.identity (.sigma A B) z (reconstruct z))

/-- Genuine dependent elimination, with an arbitrary original-source motive
and branch. The conclusion includes raw erased computation. -/
def EliminationSchema : Prop := ∀ (Γ : Tel) (A B P : Ty) (d z : Poly),
  Ctx Γ → Form Γ A → Form (A :: Γ) B → Form (.sigma A B :: Γ) P →
  Has (B :: A :: Γ) d (branchType P) → Has Γ z (.sigma A B) →
  ∃ t, HasE Γ t (inst P z) ∧ P01DF.PolyConv t (branchAt d (fstPoly z) (sndPoly z))

theorem eta_implies_elimination (h : EtaSchema) : EliminationSchema := by
  intro Γ A B P d z hc hA hB hP hd hz
  obtain ⟨e,he⟩ := h Γ A B z hc hA hB hz
  exact ⟨elim d z e,elim_of_eta hc hA hB hP hd hz he,elim_erases d z e⟩

theorem elimination_implies_eta (h : EliminationSchema) : EtaSchema := by
  intro Γ A B z hc hA hB hz
  obtain ⟨e,he,_⟩ := h Γ A B (etaMotive (.sigma A B)) (.atom .i) z hc hA hB
    (eta_motive_formed hc hA hB) (canonical_eta_branch hc hA hB) hz
  exact ⟨e,(eta_motive_at _ _) ▸ he⟩

theorem eta_iff_elimination : EtaSchema ↔ EliminationSchema :=
  ⟨eta_implies_elimination,elimination_implies_eta⟩


/-- Even elimination without a computation requirement suffices for eta. -/
def WeakEliminationSchema : Prop := ∀ (Γ : Tel) (A B P : Ty) (d z : Poly),
  Ctx Γ → Form Γ A → Form (A :: Γ) B → Form (.sigma A B :: Γ) P →
  Has (B :: A :: Γ) d (branchType P) → Has Γ z (.sigma A B) →
  ∃ t, HasE Γ t (inst P z)

theorem weak_elimination_implies_eta (h : WeakEliminationSchema) : EtaSchema := by
  intro Γ A B z hc hA hB hz
  obtain ⟨e,he⟩ := h Γ A B (etaMotive (.sigma A B)) (.atom .i) z hc hA hB
    (eta_motive_formed hc hA hB) (canonical_eta_branch hc hA hB) hz
  exact ⟨e,(eta_motive_at _ _) ▸ he⟩

theorem eta_iff_weak_elimination : EtaSchema ↔ WeakEliminationSchema := by
  refine ⟨?_,weak_elimination_implies_eta⟩
  intro h Γ A B P d z hc hA hB hP hd hz
  obtain ⟨t,ht,_⟩ := eta_implies_elimination h Γ A B P d z hc hA hB hP hd hz
  exact ⟨t,ht⟩

/-- Canonical computation also has a typed propositional witness. Both endpoints
are formed and typed independently; raw computation was proved separately. -/
theorem elim_pair_identity {Γ A B P d a b e} (hc : Ctx Γ) (hA : Form Γ A)
    (hB : Form (A :: Γ) B) (hP : Form (.sigma A B :: Γ) P)
    (hd : Has (B :: A :: Γ) d (branchType P))
    (ha : Has Γ a A) (hb : Has Γ b (inst B a))
    (he : HasE Γ e (.identity (.sigma A B) (pairPoly a b) (reconstruct (pairPoly a b)))) :
    HasE Γ (.atom .i) (.identity (inst P (pairPoly a b))
      (elim d (pairPoly a b) e) (branchAt d a b)) := by
  have hp := Has.sigmaIntro (Form.sigma hA hB) (form_inst_source hc hB ha) ha hb
  have ht := elim_of_eta hc hA hB hP hd hp he
  have hd' := has_inclusion (branch_has hc hd ha hb)
  have hf := form_inclusion (form_inst_source hc hP hp)
  exact .identityIntro (.identity hf ht hd') ht hd'
    (P01AC.Intensional.Plus.polyConv_inclusion (elim_pair_computation d a b e))

#print axioms elim_pair_identity
#print axioms eta_iff_weak_elimination
#print axioms canonical_eta_branch
#print axioms elim_pair_computation
#print axioms eta_iff_elimination
#print axioms elim_of_eta
end SigmaCompletion
import HeavyCylinders
open Set MeasureTheory
open scoped ENNReal NNReal
namespace AtomicMembership

theorem nnrat_le_cast (a b : ℚ≥0) : (a : ℝ≥0∞) ≤ b ↔ a ≤ b := by
  change ((a : ℝ≥0) : ℝ≥0∞) ≤ ((b : ℝ≥0) : ℝ≥0∞) ↔ _
  norm_cast

theorem nnrat_lt_cast (a b : ℚ≥0) : (a : ℝ≥0∞) < b ↔ a < b := by
  change ((a : ℝ≥0) : ℝ≥0∞) < ((b : ℝ≥0) : ℝ≥0∞) ↔ _
  norm_cast

theorem nnrat_cast_sum {ι : Type} (s : Finset ι) (f : ι → ℚ≥0) :
    ((∑ i ∈ s, f i : ℚ≥0) : ℝ≥0∞) = ∑ i ∈ s, (f i : ℝ≥0∞) := by
  have h : ((∑ i ∈ s, f i : ℚ≥0) : ℝ≥0) = ∑ i ∈ s, (f i : ℝ≥0) :=
    map_sum (NNRat.castHom ℝ≥0) f s
  change (((∑ i ∈ s, f i : ℚ≥0) : ℝ≥0) : ℝ≥0∞) = _
  rw [h, ENNReal.coe_finset_sum]
  rfl

theorem nnrat_threshold_cast (k : ℕ) :
    (↑((1/2 : ℚ≥0)^k) : ℝ≥0∞) = (2⁻¹ : ℝ≥0∞)^k := by
  simp only [← ENNReal.coe_nnratCast]
  push_cast
  norm_num

open P02A2 P02A2.Q8Measure

def rationalHeavyWords (p : (n : ℕ) → (Fin n → Bool) → ℚ≥0) (k n : ℕ) :
    Finset (Fin n → Bool) := Finset.univ.filter (fun w => (1/2 : ℚ≥0)^k < p n w)

def rationalHeavyMass (p : (n : ℕ) → (Fin n → Bool) → ℚ≥0) (k n : ℕ) : ℚ≥0 :=
  ∑ w ∈ rationalHeavyWords p k n, p n w

theorem rational_heavy_words (μ : Measure Cantor)
    (p : (n : ℕ) → (Fin n → Bool) → ℚ≥0)
    (hp : ∀ n w, (p n w : ℝ≥0∞) = μ (cylinder n w)) (k n : ℕ) :
    rationalHeavyWords p k n = heavyWords μ k n := by
  classical
  ext w
  simp only [rationalHeavyWords, heavyWords, Finset.mem_filter, Finset.mem_univ, true_and]
  rw [← hp n w, ← nnrat_threshold_cast]
  exact (nnrat_le_cast _ _).symm

theorem rational_heavy_mass (μ : Measure Cantor)
    (p : (n : ℕ) → (Fin n → Bool) → ℚ≥0)
    (hp : ∀ n w, (p n w : ℝ≥0∞) = μ (cylinder n w)) (k n : ℕ) :
    (rationalHeavyMass p k n : ℝ≥0∞) = μ (heavy μ k n) := by
  rw [rationalHeavyMass, nnrat_cast_sum, rational_heavy_words μ p hp, heavy_finite_sum]
  exact Finset.sum_congr rfl (fun w _ => hp n w)

theorem nnrat_cast_real (r : ℚ≥0) :
    (r : ℝ≥0∞) = (Real.toNNReal (r : ℚ) : ℝ≥0∞) := by
  rw [← ENNReal.coe_nnratCast]
  congr 1
  apply NNReal.eq
  change ((r : ℝ≥0) : ℝ) = max ((r : ℚ) : ℝ) 0
  have h0 : (0 : ℝ) ≤ ((r : ℚ) : ℝ) := by exact_mod_cast r.property
  rw [max_eq_left h0]
  rfl

theorem mass_one_nnrat_normal (μ : Measure Cantor) [IsProbabilityMeasure μ] :
    mass μ = 1 ↔ ∀ q : ℚ≥0, q < 1 → ∃ k, ∀ n, (q : ℝ≥0∞) ≤ μ (heavy μ k n) := by
  constructor
  · intro hm q hq
    have hl : (q : ℝ≥0∞) < ⨆ k, ⨅ n, μ (heavy μ k n) := by
      rw [← atomic_mass_formula, hm]
      simpa only [← ENNReal.coe_nnratCast, NNRat.cast_one, ENNReal.coe_one] using (nnrat_lt_cast q 1).mpr hq
    obtain ⟨k,hk⟩ := lt_iSup_iff.mp hl
    exact ⟨k,fun n => hk.le.trans (iInf_le _ n)⟩
  · intro h
    apply (mass_one_normal_form μ).mpr
    intro q hq hq1
    have hc : (q.toNNRat : ℝ≥0∞) = (Real.toNNReal q : ℝ≥0∞) := by
      simpa only [Rat.coe_toNNRat q hq] using nnrat_cast_real q.toNNRat
    have hsmall : q.toNNRat < 1 := by
      apply (nnrat_lt_cast _ 1).mp
      rw [hc]
      simpa only [← ENNReal.coe_nnratCast, NNRat.cast_one, ENNReal.coe_one] using hq1
    obtain ⟨k,hk⟩ := h q.toNNRat hsmall
    exact ⟨k,fun n => by simpa only [hc] using hk n⟩

theorem defect_zero_rational_normal (μ : Measure Cantor) [IsProbabilityMeasure μ]
    (p : (n : ℕ) → (Fin n → Bool) → ℚ≥0)
    (hp : ∀ n w, (p n w : ℝ≥0∞) = μ (cylinder n w)) :
    defect μ = 0 ↔ ∀ q : ℚ≥0, q < 1 → ∃ k, ∀ n, q ≤ rationalHeavyMass p k n := by
  have hd : defect μ = 0 ↔ mass μ = 1 := by
    change 1 - (mass μ).toReal = 0 ↔ mass μ = 1
    rw [sub_eq_zero, eq_comm, ENNReal.toReal_eq_one_iff]
  rw [hd, mass_one_nnrat_normal]
  apply forall_congr'
  intro q
  apply imp_congr_right
  intro _
  apply exists_congr
  intro k
  apply forall_congr'
  intro n
  rw [← rational_heavy_mass μ p hp, nnrat_le_cast]

end AtomicMembership
import RationalWinningCorrectness

noncomputable section
open scoped BigOperators
open Finset
open Orthemology.Tranche2
namespace Orthemology.Tranche4.RationalWinning
variable {m k l : ℕ}

/-- A displayed list satisfies the original recursive source-certificate
interface. This is not yet a compiled infinite restoring controller. -/
def PlanCertificate (T : Tables m k l) (B : Finset (Fin m)) (θ : Fin m)
    (acts : List (Fin k)) : Prop :=
  acts ≠ [] ∧ acts.toFinset ⊆ T.menu B ∧
    (∀ a ∈ acts, ∀ y, (supportUpdate (realKernel T) B a y).Nonempty →
      supportUpdate (realKernel T) B a y ≠ B →
        RecursiveWinning (realKernel T) T.good T.menu (supportUpdate (realKernel T) B a y)) ∧
    ((∃ a ∈ acts, ∃ y, supportStay (realKernel T) B a y = false ∧ 0 < realKernel T θ a y) ∨
      LiveSelfVerifying (realKernel T) T.good B θ acts)

@[simp] lemma mem_orderedActions (U : Finset (Fin k)) (a : Fin k) : a ∈ orderedActions U ↔ a ∈ U := by
  simp [orderedActions,List.mem_finRange]

lemma checked_support_certificate (T : Tables m k l) (B : Finset (Fin m))
    (θ : Fin m) (U : Finset (Fin k))
    (h : planCheck T (wins T (B.card-1)) B θ U = true) :
    PlanCertificate T B θ (orderedActions U) := by
  classical
  have hd : U.Nonempty ∧ (∀ a ∈ U, admissible T (wins T (B.card-1)) B a = true) ∧
      ((∃ a ∈ U, ∃ y, update T B a y ≠ B ∧ 0 < T.kernel θ a y) ∨ verifies T B θ U) := by
    simpa only [planCheck,decide_eq_true_eq,progresses_iff] using h
  refine ⟨orderedActions_ne_nil U hd.1,?_,?_,?_⟩
  · rw [orderedActions_toFinset]
    intro a ha
    exact ((admissible_iff T _ B a).mp (hd.2.1 a ha)).1
  · intro a ha y hy hne
    rw [supportUpdate_cast] at hy hne ⊢
    have hw := ((admissible_iff T _ B a).mp (hd.2.1 a ((mem_orderedActions U a).mp ha))).2 y hy hne
    have hc := update_card_lt T B a y hne
    exact (wins_correct_of_card_le T (B.card-1) _ (by omega)).mp hw
  · rcases hd.2.2 with hp | hv
    · left
      obtain ⟨a,ha,y,hne,hpos⟩ := hp
      refine ⟨a,(mem_orderedActions U a).mpr ha,y,?_,?_⟩
      · simpa only [supportStay_false,supportUpdate_cast] using hne
      · change (0:ℝ) < (T.kernel θ a y : ℝ)
        exact_mod_cast hpos
    · right
      refine ⟨?_,?_⟩
      · simpa only [orderedActions_toFinset] using hv.1
      · intro η hη heq
        rw [orderedActions_toFinset]
        apply hv.2 η hη
        intro a ha
        exact (realKernel_eq_iff T θ η a).mp (heq a ((mem_orderedActions U a).mpr ha))

/-- The public winning result yields a concrete deterministic list for every
live candidate, using one less fuel for proper support continuations. -/
theorem winningPlan_exists (T : Tables m k l) (B : Finset (Fin m))
    (hw : decideWinning T B = .winning) (θ : Fin m) (hθ : θ ∈ B) :
    ∃ acts, winningPlan T B θ = some acts := by
  have hr := (decideWinning_winning_iff T B).mp hw |>.2
  have hb := recursiveWinning_nonempty (realKernel T) T.good T.menu hr
  have he : B.card-1+1 = B.card := Nat.sub_add_cancel (card_pos.mpr hb)
  have hh : wins T (B.card-1+1) B = true := by
    rw [he]
    exact (wins_card_iff T B).mpr hr
  obtain ⟨U,hU⟩ := selectedSupport_exists T (B.card-1) B hh θ hθ
  exact ⟨orderedActions U,by simp [winningPlan,hw,selectedActions,hU]⟩

/-- Every returned list is valid; invalid/empty/losing inputs return no public
witness. No Classical.choose enters the executable selection definition. -/
theorem winningPlan_spec (T : Tables m k l) (B : Finset (Fin m)) (θ : Fin m)
    (acts : List (Fin k)) (h : winningPlan T B θ = some acts) :
    validTable T = true ∧ θ ∈ B ∧ PlanCertificate T B θ acts := by
  classical
  by_cases hw : decideWinning T B = .winning
  · have hv := ((decideWinning_winning_iff T B).mp hw).1
    cases hs : selectedSupport T (B.card-1) B θ with
    | none => simp [winningPlan,hw,selectedActions,hs] at h
    | some U =>
      have he : orderedActions U = acts := by simpa [winningPlan,hw,selectedActions,hs] using h
      rw [←he]
      have hu := selectedSupport_spec T (B.card-1) B θ U hs
      exact ⟨hv,hu.1,checked_support_certificate T B θ U hu.2⟩
  · simp [winningPlan,hw] at h

theorem winningPlan_none_of_not_live (T : Tables m k l) (B : Finset (Fin m)) (θ : Fin m)
    (hθ : θ ∉ B) : winningPlan T B θ = none := by
  simp [winningPlan,selectedActions,selectedSupport,hθ]

/-- Returned plans lead only to children that this same executable checker
classifies as winning, whenever an observation causes a live proper shrink. -/
theorem winningPlan_successors_win (T : Tables m k l) (B : Finset (Fin m)) (θ : Fin m)
    (acts : List (Fin k)) (h : winningPlan T B θ = some acts)
    (a : Fin k) (ha : a ∈ acts) (y : Fin l)
    (hy : (update T B a y).Nonempty) (hne : update T B a y ≠ B) :
    decideWinning T (update T B a y) = .winning := by
  have hs := winningPlan_spec T B θ acts h
  apply (decideWinning_winning_iff T _).mpr
  refine ⟨hs.1,?_⟩
  have hc := hs.2.2.2.2.1 a ha y
  simpa only [supportUpdate_cast] using hc (by simpa only [supportUpdate_cast] using hy)
    (by simpa only [supportUpdate_cast] using hne)

end Orthemology.Tranche4.RationalWinning
import StepCertImageRule
namespace CertificateCodeValidity
open Encodable SourceFamilyComputability CodedScope ExactSyntaxValidity AuxiliaryCodeComputability
open OrthemologyV2 P01D P01AC AuxiliaryCertificates JointCertificates TelescopeCodeValidity
set_option maxRecDepth 16384
set_option maxHeartbeats 1000000
attribute [local irreducible] Nat.pair

theorem StepCert_bounds (c : Nat) (h : ∃ a : AuxiliaryCertificates.StepCert, encode a = c) :
    ∀ d ∈ localChildren stepCertDescription c, d.2 < c := by
  obtain ⟨a, rfl⟩ := h
  cases a <;> simp [localChildren, stepCertDescription, dependencies, fieldCode, List.range_succ]
  all_goals repeat' apply And.intro
  all_goals first
    | exact field_lt_pack _ _ (by simp)
    | exact lt_of_le_of_lt (le_leaf _) (field_lt_pack _ _ (by simp))

end CertificateCodeValidity
import ExecutablePruning

/-!
# Full-row normalized Markov support adapter

This module fixes the relationship between numerical full rows, internal
same-support successors, zero-candidate-exit pairs, and the generic graph
pruning theorem. Allowed pairs are an explicit input: bottom-up licensing and
proper-support winning regions are not rederived here.
-/
namespace HiddenParity

variable {State Pair Model : Type*}
variable [Fintype State] [DecidableEq State] [DecidableEq Pair]

/-- Finite normalized rational transition rows, indexed by hidden model and pair. -/
structure RationalKernel (Model Pair State : Type*) [Fintype State] where
  row : Model → Pair → State → ℚ
  nonnegative : ∀ σ e y, 0 ≤ row σ e y
  normalized : ∀ σ e, ∑ y, row σ e y = 1

/-- Exact support preservation: every live model permits the successor. -/
def internalSuccessors (P : RationalKernel Model Pair State)
    (B : Finset Model) (e : Pair) : Finset State :=
  Finset.univ.filter (fun y => ∃ σ ∈ B, 0 < P.row σ e y)

omit [DecidableEq State] [DecidableEq Pair] in
@[simp] theorem mem_internalSuccessors (P : RationalKernel Model Pair State)
    (B : Finset Model) (e : Pair) (y : State) :
    y ∈ internalSuccessors P B e ↔ ∀ σ ∈ B, 0 < P.row σ e y := by
  simp [internalSuccessors]

/-- No positive candidate transition changes support. -/
def NoExit (P : RationalKernel Model Pair State) (B : Finset Model)
    (θ : Model) (e : Pair) : Prop :=
  ∀ y, 0 < P.row θ e y → y ∈ internalSuccessors P B e

instance noExitDecidable (P : RationalKernel Model Pair State) (B : Finset Model)
    (θ : Model) (e : Pair) : Decidable (NoExit P B θ e) := by
  unfold NoExit
  infer_instance

def zeroExitPairs (P : RationalKernel Model Pair State) (B : Finset Model)
    (θ : Model) (allowed : Finset Pair) : Finset Pair :=
  allowed.filter (NoExit P B θ)

omit [DecidableEq Pair] in
@[simp] theorem mem_zeroExitPairs (P : RationalKernel Model Pair State) (B : Finset Model)
    (θ : Model) (allowed : Finset Pair) (e : Pair) :
    e ∈ zeroExitPairs P B θ allowed ↔ e ∈ allowed ∧ NoExit P B θ e := by
  simp [zeroExitPairs]

omit [DecidableEq Pair] in
/-- Support-based no-exit is exactly internal mass one for normalized nonnegative rows. -/
theorem noExit_iff_internal_mass_one (P : RationalKernel Model Pair State)
    (B : Finset Model) (θ : Model) (e : Pair) :
    NoExit P B θ e ↔ ∑ y ∈ internalSuccessors P B e, P.row θ e y = 1 := by
  constructor
  · intro h
    rw [← P.normalized θ e]
    apply Finset.sum_subset (Finset.subset_univ _)
    intro y _ hNot
    have hNonpos : P.row θ e y ≤ 0 := le_of_not_gt (fun hp => hNot (h y hp))
    exact le_antisymm hNonpos (P.nonnegative θ e y)
  · intro h y hy
    by_contra hNot
    have hsum := Finset.sum_sdiff (f := P.row θ e)
      (Finset.subset_univ (internalSuccessors P B e))
    rw [P.normalized θ e, h] at hsum
    have hzero : ∑ z ∈ Finset.univ \ internalSuccessors P B e, P.row θ e z = 0 := by
      linarith
    have hall := (Finset.sum_eq_zero_iff_of_nonneg
      (fun z (_ : z ∈ Finset.univ \ internalSuccessors P B e) => P.nonnegative θ e z)).mp hzero
    have hyzero := hall y (Finset.mem_sdiff.mpr ⟨Finset.mem_univ y, hNot⟩)
    linarith

omit [DecidableEq State] [DecidableEq Pair] in
/-- A normalized zero-exit candidate has a nonempty internal successor set. -/
theorem noExit_internal_nonempty (P : RationalKernel Model Pair State)
    (B : Finset Model) (θ : Model) (e : Pair) (h : NoExit P B θ e) :
    (internalSuccessors P B e).Nonempty := by
  obtain ⟨y, _, hy⟩ := Finset.exists_ne_zero_of_sum_ne_zero
    (show (∑ y, P.row θ e y) ≠ 0 by rw [P.normalized]; norm_num)
  exact ⟨y, h y (lt_of_le_of_ne (P.nonnegative θ e y) (Ne.symm hy))⟩

omit [DecidableEq State] [DecidableEq Pair] in
/-- Full-row matching preserves zero exit without renormalization. -/
theorem matching_noExit (P : RationalKernel Model Pair State) (B : Finset Model)
    {θ σ : Model} {E : Finset Pair} (hm : Match P.row θ σ E)
    (hNo : ∀ e ∈ E, NoExit P B θ e) : ∀ e ∈ E, NoExit P B σ e := by
  intro e he y hy
  have hrow := congrFun (hm e he) y
  apply hNo e he y
  simpa only [hrow] using hy

omit [DecidableEq State] [DecidableEq Pair] in
/-- For a live candidate, zero exit identifies the internal graph with the
candidate's actual positive-support graph, rather than merely a supplied graph. -/
theorem noExit_internal_eq_candidate_support (P : RationalKernel Model Pair State)
    (B : Finset Model) (θ : Model) (hθ : θ ∈ B) (e : Pair)
    (h : NoExit P B θ e) :
    internalSuccessors P B e = Finset.univ.filter (fun y => 0 < P.row θ e y) := by
  ext y
  constructor
  · intro hy
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ y,
      (mem_internalSuccessors P B e y).mp hy θ hθ⟩
  · intro hy
    exact h y (Finset.mem_filter.mp hy).2

/-- The original qualifying target predicate for this normalized Markov input,
independent of pruning, explicitly includes allowed pairs and zero exit. -/
def MarkovQualifying (P : RationalKernel Model Pair State) (source : Pair → State)
    (B : Finset Model) (priority : Model → Pair → ℕ) (θ : Model)
    (allowed E : Finset Pair) : Prop :=
  E ⊆ allowed ∧ (∀ e ∈ E, NoExit P B θ e) ∧
    IsEndComponent source (internalSuccessors P B) E ∧
    ∀ σ ∈ B, Match P.row θ σ E → ∃ d, IsMinimum (priority σ) E d ∧ d % 2 = 0

theorem markovQualifying_iff (P : RationalKernel Model Pair State) (source : Pair → State)
    (B : Finset Model) (priority : Model → Pair → ℕ) (θ : Model)
    (allowed E : Finset Pair) :
    MarkovQualifying P source B priority θ allowed E ↔
      E ⊆ zeroExitPairs P B θ allowed ∧
        Valid (endComponentFamily source (internalSuccessors P B)) B P.row priority θ E := by
  constructor
  · rintro ⟨hA, hN, hEC, hP⟩
    exact ⟨fun e he => (mem_zeroExitPairs P B θ allowed e).mpr ⟨hA he, hN e he⟩,
      hEC, hP⟩
  · rintro ⟨hE, hEC, hP⟩
    refine ⟨?_, ?_, hEC, hP⟩
    · intro e he
      exact ((mem_zeroExitPairs P B θ allowed e).mp (hE he)).1
    · intro e he
      exact ((mem_zeroExitPairs P B θ allowed e).mp (hE he)).2

/-- Executable target-state solver on actual normalized full transition rows. -/
def markovTargetStates (P : RationalKernel Model Pair State) (source : Pair → State)
    (B : Finset Model) (priority : Model → Pair → ℕ) (θ : Model)
    (allowed : Finset Pair) : Finset State :=
  executableTargetStates source (internalSuccessors P B) B P.row priority θ
    (zeroExitPairs P B θ allowed)

/-- End-to-end normalized-row target equality. Licensing is the supplied allowed
pair set; neither MEC correctness nor row/support consistency is a hypothesis. -/
theorem markovTargetStates_exact (P : RationalKernel Model Pair State) (source : Pair → State)
    (B : Finset Model) (priority : Model → Pair → ℕ) (θ : Model)
    (allowed : Finset Pair) (s : State) :
    s ∈ markovTargetStates P source B priority θ allowed ↔
      ∃ E, MarkovQualifying P source B priority θ allowed E ∧ s ∈ usedStates source E := by
  rw [markovTargetStates, executable_targetStates_exact]
  constructor
  · rintro ⟨E, hEU, hV, hs⟩
    exact ⟨E, (markovQualifying_iff P source B priority θ allowed E).mpr ⟨hEU, hV⟩, hs⟩
  · rintro ⟨E, hE, hs⟩
    obtain ⟨hEU, hV⟩ := (markovQualifying_iff P source B priority θ allowed E).mp hE
    exact ⟨E, hEU, hV, hs⟩

end HiddenParity
import ClosedScalarInstances

namespace ClosedScalarInstances.Controls
open P01D P01AC P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness (N)
open P01AC.ExtensionalRepair.ExactScalarFusion (A End Leaf c3)
open P01AC.Intensional.Plus (PolyConvPlus)

/-- No inherited Has premise is present in the final theorem's interface. -/
theorem full_HasE_interface : ∀ n : Poly, HasE [] n N →
    HasE [] (.app c3 n)
      (inst (.all (.pi End (.pi A (Leaf FullPER.Application.originalQ)))) n) :=
  fun _ hn => closed_scalar_instance_exact hn

/-- Reification retains both open coordinates and packed source application. -/
theorem packing_open_control (t : OrthemologyV2.Term) (j : Nat) :
    PolyConvPlus (.app (.atom (.app .i t)) (.var j))
      (.app (.atom t) (.var j)) := by
  apply generic_conversion_reflect
  exact OpenTermStandardness.Conv.app (.i _) (.refl _)

/-- The claim includes independently derived closed numerals, without using
    numeral tests as the reason the general statement holds. -/
theorem numeral_instance (k : Nat) :
    HasE [] c2 (scalarInstance (EffectiveCompleteness.inputNumeral k)) :=
  closed_scalar_instance (has_inclusion (EffectiveCompleteness.inputNumeral_has k))

#print axioms full_HasE_interface
#print axioms packing_open_control
#print axioms numeral_instance
end ClosedScalarInstances.Controls
import SequentialAuditRepair
open Orthemology.Tranche3

def main (args : List String) : IO Unit := do
  let n := (args.headD "512").toNat!
  let steps := (args[1]?.getD "20").toNat!
  let beta : ℚ := (1/20)/(2*(n:ℚ)*(n+1))
  let l := sequentialReferenceLower n (n/2) beta steps
  let u := sequentialReferenceUpper n (n/2) beta steps
  let result := rationalCertificate l u (1/4) 0
  IO.println s!"samples={n}; successes={n/2}; bisections={steps}"
  IO.println s!"lower={l}; upper={u}; repair={result}"
  IO.println s!"regret={rationalValue l u (1/4)}"
import CodedScope
open P01D Encodable CodedScope
-- Intentionally false: the variable equal to the context length is out of scope.
example : checkScope 1 (encode (Poly.var 1)) = true := by rw [checkScope_exact]; decide
import SCCParity
namespace HiddenParity.NormalizedOracle
set_option maxRecDepth 100000
set_option maxHeartbeats 0
abbrev S := Fin 2
abbrev A := Fin 4
abbrev M := Fin 3
structure Case where
  rows : Nat
  priority : Nat
  live : Nat
  candidate : Nat
  allowed : Nat

def half : ℚ := ⟨1, 2, by decide, by decide⟩
theorem half_eq : half = (1 / 2 : ℚ) := by
  simpa [half] using (Rat.num_div_den half).symm
def digit (n b i : Nat) : Nat := (n / b^i) % b
def src (e : A) : S := ⟨e.val / 2, by omega⟩
def rowFor (c : Nat) (y : S) : ℚ :=
  if c % 3 = 0 then if y = 0 then 1 else 0
  else if c % 3 = 1 then if y = 1 then 1 else 0 else half

def kernel (c : Case) : RationalKernel M A S where
  row := fun m e y => rowFor (digit c.rows 3 (m.val*4+e.val)) y
  nonnegative := by
    intro m e y
    unfold rowFor
    split_ifs <;> norm_num [half_eq] at *
  normalized := by
    intro m e
    simp only [Fin.sum_univ_two, rowFor]
    split_ifs <;> norm_num [half_eq] at *

def pri (c : Case) (m : M) (e : A) : Nat := digit c.priority 6 (m.val*4+e.val)
def live (c : Case) : Finset M := Finset.univ.filter (fun m => digit c.live 2 m.val = 1)
def allowed (c : Case) : Finset A := Finset.univ.filter (fun e => digit c.allowed 2 e.val = 1)
def solve (c : Case) : Nat :=
  (SCCPruning.markovTarget (kernel c) src (live c) (pri c)
    ⟨c.candidate % 3, Nat.mod_lt _ (by decide)⟩ (allowed c)).sum (fun s => 2^s.val)
