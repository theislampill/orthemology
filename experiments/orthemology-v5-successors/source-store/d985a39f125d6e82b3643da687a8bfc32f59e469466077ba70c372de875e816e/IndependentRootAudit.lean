    `P01AC.UnaryIdentity.distinguishingInput_complete,
    `P01AC.UnaryIdentity.verifyNegative_sound,
    `P01AC.UnaryIdentity.negative_certificate_complete]
  for n in roots do
    let some info := env.checked.get.find? n | throwError "MISSING_AUTHORED_ROOT {n}"
    if info.isUnsafe || info.isPartial then throwError "UNSAFE_OR_PARTIAL_AUTHORED_ROOT {n}"
    if info.isAxiom then throwError "AUTHORED_AXIOM {n}"
    if Lean.isNoncomputable env n then throwError "AUTHORED_NONCOMPUTABLE {n}"
    if (Lean.Compiler.getImplementedBy? env n).isSome then throwError "AUTHORED_IMPLEMENTED_BY {n}"
    let axes ← Lean.collectAxioms n
    for a in axes do
      unless permittedAxioms.contains a do throwError "UNAPPROVED_AXIOM {a} in {n}"
    logInfo m!"AUTHORED_CHECKED_ROOT {n}; axioms={axes}"
  for n in proofs do
    let some info := env.checked.get.find? n | throwError "MISSING_AUTHORED_PROOF {n}"
    unless info.isTheorem do throwError "WRONG_AUTHORED_PROOF_KIND {n}"
  let (count, axes) ← auditClosure roots
  logInfo m!"INDEPENDENT_AUTHORED_CLOSURE_PASS roots={roots.size}; authoredTheorems={proofs.size}; closure={count}; axioms={axes}"
  let mut aux := 0
  for (n, info) in env.constants.toList do
    if `P01AC.UnaryIdentity |>.isPrefixOf n then
      if info.isUnsafe || info.isPartial then
        aux := aux + 1
        logInfo m!"EXCLUDED_NONPROOF_AUXILIARY {n}; theorem={info.isTheorem}; unsafe={info.isUnsafe}; partial={info.isPartial}"
        if info.isTheorem then throwError "EXCLUDED_THEOREM {n}"
  logInfo m!"INDEPENDENT_EXCLUDED_AUXILIARY_INVENTORY_PASS count={aux}"
