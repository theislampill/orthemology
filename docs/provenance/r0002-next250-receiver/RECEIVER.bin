import EmpiricalRepairCost
import EmpiricalFourthMoment
import EventualAuditSafety

open MeasureTheory Set
open scoped BigOperators ENNReal
open Orthemology.Tranche2
namespace Orthemology.Tranche3
noncomputable section

def repairRadius (a : ℝ) (e : ℚ) : ℝ := a*(1-a)*(e:ℝ)/4

lemma empirical_good_of_error (a : ℝ) (ha0 : 0<a) (ha1 : a<1)
    (e : ℚ) (he0 : 0<e) (he1 : e≤1/4) (n : ℕ) (w : Bits (n+1))
    (h : |(empiricalWeight n w:ℝ)-a|≤repairRadius a e) :
    LiteralRepairGood a e (empiricalRepair e n w) := by
  have he0' : (0:ℝ)<e := by exact_mod_cast he0
  have he1' : (e:ℝ)≤1/4 := by
    have hh : (e:ℝ)≤((1/4:ℚ):ℝ) := by exact_mod_cast he1
    norm_num at hh ⊢
    exact hh
  have hg := approximate_parameter_strict_repair a e (empiricalWeight n w)
    ha0 ha1 he0' he1' h
  have hq : (empiricalRepair e n w:ℝ)=1/2+(empiricalWeight n w:ℝ)*(e:ℝ) := by
    simp only [empiricalRepair]; push_cast; ring
  have hc := empiricalRepair_coherent e he0.le he1 n w
  refine ⟨by exact_mod_cast hc.1,by exact_mod_cast hc.2,?_,?_⟩
  all_goals rw [hq]; simp only [excessZero,excessOne]
  all_goals linarith [hg.1,hg.2]

lemma empirical_centered_identity (a : ℝ) (n : ℕ) (w : Bits (n+1)) :
    ((n:ℝ)+1)*((empiricalWeight n w:ℝ)-a)=centeredTotal (n+1) a w := by
  simp only [empiricalWeight,centeredTotal]
  push_cast
  have hn : (n:ℝ)+1 ≠ 0 := by positivity
  field_simp

lemma empirical_bad_fourth (a : ℝ) (ha0 : 0<a) (ha1 : a<1)
    (e : ℚ) (he0 : 0<e) (he1 : e≤1/4) (n : ℕ) (w : Bits (n+1))
    (h : ¬ LiteralRepairGood a e (empiricalRepair e n w)) :
    (((n:ℝ)+1)*repairRadius a e)^4≤centeredTotal (n+1) a w^4 := by
  have hr0 : 0≤repairRadius a e := by
    unfold repairRadius
    have : 0≤1-a := by linarith
    positivity
  have hh : repairRadius a e < |(empiricalWeight n w:ℝ)-a| :=
    lt_of_not_ge (fun he => h (empirical_good_of_error a ha0 ha1 e he0 he1 n w he))
  have hm := mul_le_mul_of_nonneg_left hh.le (by positivity : (0:ℝ)≤(n:ℝ)+1)
  have hm' : ((n:ℝ)+1)*repairRadius a e≤|centeredTotal (n+1) a w| := by
    rw [←empirical_centered_identity,abs_mul,abs_of_nonneg (by positivity : (0:ℝ)≤(n:ℝ)+1)]
    exact hm
  have hp := pow_le_pow_left₀ (by positivity : 0≤((n:ℝ)+1)*repairRadius a e) hm' 4
  simpa only [show 4=2*2 from rfl,pow_mul,sq_abs] using hp

/-- A source-derived summable upper bound for every interior parameter. -/
theorem empirical_failure_probability_upper (a : ℝ) (ha0 : 0<a) (ha1 : a<1)
    (e : ℚ) (he0 : 0<e) (he1 : e≤1/4) (n : ℕ) :
    auditSourceLaw a ha0.le ha1.le (EmpiricalFailure a e n) ≤
      ENNReal.ofReal (4/(((n:ℝ)+1)^2*(repairRadius a e)^4)) := by
  classical
  have hr : 0<repairRadius a e := by
    unfold repairRadius
    have : 0<1-a := by linarith
    have : (0:ℝ)<e := by exact_mod_cast he0
    positivity
  have hd : 0<(((n:ℝ)+1)*repairRadius a e)^4 := by positivity
  rw [EmpiricalFailure,auditSource_word_event a ha0.le ha1.le (n+1)
    (fun w => ¬LiteralRepairGood a e (empiricalRepair e n w))]
  apply ENNReal.ofReal_le_ofReal
  calc
    (∑ w, if ¬ LiteralRepairGood a e (empiricalRepair e n w) then bernoulliMass (n+1) a w else 0)
      ≤ ∑ w, (bernoulliMass (n+1) a w*centeredTotal (n+1) a w^4)/
        (((n:ℝ)+1)*repairRadius a e)^4 := by
      apply Finset.sum_le_sum
      intro w _
      have hm := bernoulliMass_nonneg (n+1) a ha0.le ha1.le w
      split_ifs with h
      · positivity
      · apply (le_div_iff₀ hd).mpr
        exact mul_le_mul_of_nonneg_left (empirical_bad_fourth a ha0 ha1 e he0 he1 n w h) hm
    _ = centeredMoment (n+1) 4 a / (((n:ℝ)+1)*repairRadius a e)^4 := by
      rw [←Finset.sum_div]
      rfl
    _ ≤ (4*((n:ℝ)+1)^2)/(((n:ℝ)+1)*repairRadius a e)^4 := by
      apply div_le_div_of_nonneg_right _ hd.le
      simpa only [Nat.cast_add,Nat.cast_one] using centered_fourth_le (n+1) (by omega) a ha0.le ha1.le
    _ = 4/(((n:ℝ)+1)^2*(repairRadius a e)^4) := by
      have hn : (n:ℝ)+1≠0 := by positivity
      field_simp
      ring

lemma empirical_probability_spending (a : ℝ) (ha0 : 0<a) (ha1 : a<1)
    (e : ℚ) (he0 : 0<e) (he1 : e≤1/4) (n : ℕ) :
    auditSourceLaw a ha0.le ha1.le (EmpiricalFailure a e n) ≤
      ENNReal.ofReal (2*tailSpending (8/(repairRadius a e)^4) n) := by
  apply (empirical_failure_probability_upper a ha0 ha1 e he0 he1 n).trans
  apply ENNReal.ofReal_le_ofReal
  have hr : 0<repairRadius a e := by
    unfold repairRadius
    have : 0<1-a := by linarith
    have : (0:ℝ)<e := by exact_mod_cast he0
    positivity
  rw [double_tailSpending]
  apply (div_le_div_iff₀ (by positivity : 0<((n:ℝ)+1)^2*(repairRadius a e)^4)
    (by positivity : 0<((n:ℝ)+1)*((n:ℝ)+2))).mpr
  have hr4 : (repairRadius a e)^4≠0 := by positivity
  have hc : 8/(repairRadius a e)^4 * (((n:ℝ)+1)^2*(repairRadius a e)^4)=8*((n:ℝ)+1)^2 := by
    field_simp
    ring
  rw [hc]
  nlinarith [sq_nonneg (n:ℝ),Nat.cast_nonneg (α := ℝ) n]

/-- This always-issued policy has finite expected total mistakes at every
fixed interior weight, with an explicit nonuniform bound. -/
theorem empirical_expected_failure_upper (a : ℝ) (ha0 : 0<a) (ha1 : a<1)
    (e : ℚ) (he0 : 0<e) (he1 : e≤1/4) :
    (∫⁻ ω, ∑' n, (EmpiricalFailure a e n).indicator (fun _ => ENNReal.ofReal (n+1)) ω
      ∂auditSourceLaw a ha0.le ha1.le) ≤ ENNReal.ofReal (8/(repairRadius a e)^4) := by
  rw [lintegral_tsum (f := fun n => (EmpiricalFailure a e n).indicator
      (1 : (ℕ → Bool) → ℝ≥0∞)) (fun n =>
    ((show Measurable (1 : (ℕ → Bool) → ℝ≥0∞) from measurable_const).indicator
      (empiricalFailure_measurable a e n)).aemeasurable)]
  simp_rw [lintegral_indicator_one (empiricalFailure_measurable a e _)]
  exact (ENNReal.tsum_le_tsum (fun n => empirical_probability_spending a ha0 ha1 e he0 he1 n)).trans
    (spending_total_le _ (by positivity))


end
end Orthemology.Tranche3
#print axioms Orthemology.Tranche3.empirical_failure_probability_upper

#print axioms Orthemology.Tranche3.empirical_expected_failure_upper
import LiteralShiftCorrect
import LiteralShiftWord

/-! Pointwise stream refinement of the literal `compile_shift` AST.  These
results derive the copied prefix, exact fresh-tail replay, and unresolved
stream directly from finite execution.  No probability law is assumed. -/
namespace P02.LiteralShift
open P02A2.ObserverCore

def programValue (body : Stmt) (output n w : ℕ) : ℕ :=
  exec body (initial n w) output

def compiledOutput (body : Stmt) (output a b : ℕ) : (ℕ → Bool) → (ℕ → Bool) :=
  P02A2.ObserverCore.output (programValue (compileShift body output a b) 2)

/-- A first resolvable source prefix, measured by its number of bits. -/
def FirstCut (a b : ℕ) (x : ℕ → Bool) (k : ℕ) (side : Bool) : Prop :=
  1 ≤ k ∧ streamClassify a b x k = some side ∧
    ∀ j, 1 ≤ j → j < k → streamClassify a b x j = none

/-- First-cut and indefinitely unresolved cases cover every input stream. -/
theorem firstCut_or_unresolved (a b : ℕ) (x : ℕ → Bool) :
    (∃ k side, FirstCut a b x k side) ∨
      (∀ k, 1 ≤ k → streamClassify a b x k = none) := by
  classical
  by_cases h : ∃ k, 1 ≤ k ∧ streamClassify a b x k ≠ none
  · left
    obtain ⟨hk,hne⟩ := Nat.find_spec h
    cases hc : streamClassify a b x (Nat.find h) with
    | none => exact (hne hc).elim
    | some side =>
        refine ⟨Nat.find h, side, hk, hc, ?_⟩
        intro j hj hjk
        by_contra hjc
        have hm := Nat.find_min' h ⟨hj,hjc⟩
        omega
  · right
    intro k hk
    by_contra hc
    exact h ⟨k,hk,hc⟩

theorem compiledOutput_unresolved_at (body : Stmt) (output a b n : ℕ)
    (x : ℕ → Bool)
    (h : ∀ j, 1 ≤ j → j ≤ n+1 → streamClassify a b x j = none) :
    compiledOutput body output a b x n = x n := by
  unfold compiledOutput P02A2.ObserverCore.output programValue
  change decide (exec (compileShift body output a b)
    (initial n (sentinel (streamPrefix x (n+1)))) 2 % 2 = 1) = _
  rw [compileShift_unresolved body output a b n _ (by
    intro j hj hjn
    rw [classify_stream a b n j x hjn]
    exact h j hj hjn), Nat.mod_mod, sentinel_stream_last]
  cases x n <;> rfl

/-- Every bit before and at the first stopping prefix is copied. -/
theorem compiledOutput_copied_prefix (body : Stmt) (output a b k n : ℕ)
    (x : ℕ → Bool) (side : Bool) (h : FirstCut a b x k side) (hn : n < k) :
    compiledOutput body output a b x n = x n := by
  rcases h with ⟨hk,hc,hearly⟩
  by_cases he : n+1 = k
  · unfold compiledOutput P02A2.ObserverCore.output programValue
    change decide (exec (compileShift body output a b)
      (initial n (sentinel (streamPrefix x (n+1)))) 2 % 2 = 1) = _
    rw [compileShift_stopping body output a b n _ side (by
      rw [classify_stream a b n (n+1) x (by omega), he]
      exact hc) (by
      intro j hj hjn
      rw [classify_stream a b n j x (by omega)]
      exact hearly j hj (by omega)), Nat.mod_mod, sentinel_stream_last]
    cases x n <;> rfl
  · apply compiledOutput_unresolved_at
    intro j hj hjn
    exact hearly j hj (by omega)

/-- A below-threshold first cut continues to copy the entire source stream. -/
theorem compiledOutput_below (body : Stmt) (output a b k : ℕ)
    (x : ℕ → Bool) (h : FirstCut a b x k false) :
    compiledOutput body output a b x = x := by
  funext n
  by_cases hn : n < k
  · exact compiledOutput_copied_prefix body output a b k n x false h hn
  · rcases h with ⟨hk,hc,hearly⟩
    unfold compiledOutput P02A2.ObserverCore.output programValue
    change decide (exec (compileShift body output a b)
      (initial n (sentinel (streamPrefix x (n+1)))) 2 % 2 = 1) = _
    rw [compileShift_below body output a b n _ k hk (by omega) (by
      rw [classify_stream a b n k x (by omega)]
      exact hc) (by
      intro j hj hjk
      rw [classify_stream a b n j x (by omega)]
      exact hearly j hj hjk), Nat.mod_mod, sentinel_stream_last]
    cases x n <;> rfl

/-- Above a first cut, the exact original inline body is run from a clean
store on the fresh tail, with stage reset to zero at its first bit. -/
theorem compiledOutput_above_tail (body : Stmt) (output a b k n : ℕ)
    (x : ℕ → Bool) (h : FirstCut a b x k true) (hkn : k ≤ n) :
    compiledOutput body output a b x n =
      P02A2.ObserverCore.output (programValue body output) (dropStream k x) (n-k) := by
  rcases h with ⟨hk,hc,hearly⟩
  unfold compiledOutput P02A2.ObserverCore.output programValue
  change decide (exec (compileShift body output a b)
    (initial n (sentinel (streamPrefix x (n+1)))) 2 % 2 = 1) = _
  rw [compileShift_above body output a b n _ k hk hkn (by
    rw [classify_stream a b n k x (by omega)]
    exact hc) (by
    intro j hj hjk
    rw [classify_stream a b n j x (by omega)]
    exact hearly j hj hjk), Nat.mod_mod, replayWord_stream]
  have hstage : n+1-k-1 = n-k := by omega
  have hlength : n+1-k = n-k+1 := by omega
  rw [hstage, hlength]
  rfl

/-- The complete pointwise splice statement for every first cut. -/
theorem compiledOutput_on_firstCut (body : Stmt) (output a b k : ℕ)
    (x : ℕ → Bool) (side : Bool) (h : FirstCut a b x k side) (n : ℕ) :
    compiledOutput body output a b x n =
      if n < k then x n
      else if side then
        P02A2.ObserverCore.output (programValue body output) (dropStream k x) (n-k)
      else x n := by
  by_cases hn : n < k
  · rw [if_pos hn]
    exact compiledOutput_copied_prefix body output a b k n x side h hn
  · rw [if_neg hn]
    cases side with
    | false => exact congrFun (compiledOutput_below body output a b k x h) n
    | true => exact compiledOutput_above_tail body output a b k n x h (by omega)

/-- An indefinitely unresolved input is copied pointwise, without a
termination assumption or an exceptional-set assumption. -/
theorem compiledOutput_unresolved (body : Stmt) (output a b : ℕ)
    (x : ℕ → Bool)
    (h : ∀ k, 1 ≤ k → streamClassify a b x k = none) :
    compiledOutput body output a b x = x := by
  funext n
  apply compiledOutput_unresolved_at
  intro j hj _
  exact h j hj

end P02.LiteralShift
import Pi3Law

namespace IndependentTaggedAudit
open Set MeasureTheory
open scoped ENNReal NNReal
open OrthemologyTagged P02A2.Q8Measure P02A2

/-- The selector events cover almost every input, but never all inputs. -/
theorem no_pointwise_selector_cover : ¬ ∀ x : Cantor, ∃ i, x ∈ tagEvent i := by
  intro h
  obtain ⟨i,hi⟩ := h allTrue
  exact allTrue_not_tag i hi

/-- Reusing the final prefix coordinate as the first tail bit conditions that bit. -/
theorem unshifted_prefix_coordinate_not_fair :
    fairCantor ({x : Cantor | x 0 = true} ∩ tagEvent 0) = 0 := by
  have he : ({x : Cantor | x 0 = true} ∩ tagEvent 0) = ∅ := by
    apply Set.eq_empty_iff_forall_not_mem.mpr
    intro x hx
    have hz := ((tagEvent_spec 0 x).mp hx.2).2
    simp_all
  rw [he, measure_empty]

/-- A zero-weight row can have deficient mass without affecting weighted full mass. -/
theorem zero_weight_hides_bad_row :
    (∑' i : ℕ, ((if i = 0 then 1 else 0 : ℝ≥0) : ℝ≥0∞) *
      (if i = 0 then 1 else 0 : ℝ≥0∞)) = 1 ∧
    ¬ ∀ i : ℕ, (if i = 0 then 1 else 0 : ℝ≥0∞) = 1 := by
  constructor
  · rw [tsum_eq_single 0]
    · norm_num
    · intro i hi
      simp [hi]
  · intro h
    have := h 1
    norm_num at this

def differentWitness (_ : Unit) (i s _t : ℕ) : Prop := s = i
instance differentWitness_decidable (a : Unit) (i s t : ℕ) : Decidable (differentWitness a i s t) :=
  inferInstanceAs (Decidable (s = i))

/-- Each row may need its own witness; moving exists s outside forall i is false. -/
theorem row_witnesses_need_not_be_uniform :
    defect (pi3Law differentWitness ()) = 0 ∧
    ¬ ∃ s, ∀ i t, differentWitness () i s t := by
  constructor
  · apply (pi3_zero_defect_iff differentWitness ()).mpr
    exact fun i => ⟨i,fun _ => rfl⟩
  · rintro ⟨s,hs⟩
    have h0 := hs 0 0
    have h1 := hs 1 0
    change s = 0 at h0
    change s = 1 at h1
    omega

def halfRows (i : ℕ) (x : Cantor) : Cantor := if i = 0 then (fun _ => false) else x

theorem halfRows_measurable (i : ℕ) : Measurable (halfRows i) := by
  unfold halfRows
  by_cases h : i = 0
  · simp only [h, if_true]
    exact measurable_const
  · simp only [h, if_false]
    exact measurable_id

theorem fair_atomic_mass_zero : mass fairCantor = 0 := by
  have he : positive fairCantor = ∅ := by
    ext x
    change (0 < fairCantor {x}) ↔ False
    rw [OrthemologyMeasure.fairCantor_singleton_zero]
    simp only [lt_self_iff_false]
  simp [mass, he]

theorem halfRows_mass (i : ℕ) : mass (fairCantor.map (halfRows i)) = if i = 0 then 1 else 0 := by
  classical
  by_cases h : i = 0
  · have hi : halfRows i = (fun _ : Cantor => fun _ : ℕ => false) := by
      funext x n
      simp [halfRows, h]
    have he : fairCantor.map (halfRows i) = Measure.dirac (fun _ : ℕ => false) := by
      rw [hi, Measure.map_const]
      simp
    rw [he, if_pos h]
    exact countable_carrier_mass_one _ (C := {fun _ : ℕ => false}) (Set.countable_singleton _) (by simp) (by simp)
  · have hi : halfRows i = id := by
      funext x n
      simp [halfRows, h]
    rw [hi, Measure.map_id, if_neg h]
    exact fair_atomic_mass_zero

/-- A non-endpoint actual tagged law has exactly the selector-zero mass. -/
theorem tagged_mixed_mass_half : mass (fairCantor.map (tagged halfRows)) = (1/2 : ℝ≥0∞) := by
  rw [tagged_mass halfRows_measurable]
  simp_rw [halfRows_mass]
  rw [tsum_eq_single 0]
  · norm_num [weight]
  · intro i hi
    simp [hi]

theorem tagged_mixed_defect_half : defect (fairCantor.map (tagged halfRows)) = (1/2 : ℝ) := by
  rw [defect, tagged_mixed_mass_half]
  norm_num

#print axioms no_pointwise_selector_cover
#print axioms unshifted_prefix_coordinate_not_fair
#print axioms zero_weight_hides_bad_row
#print axioms row_witnesses_need_not_be_uniform
#print axioms tagged_mixed_mass_half
#print axioms tagged_mixed_defect_half
end IndependentTaggedAudit
import PhysicalFlattening

open Filter MeasureTheory

namespace Orthemology.Tranche2.PhysicalFlattening
variable {A : Type*}

def prefixActions (blocks : ℕ → List A) (N : ℕ) : List A :=
  (List.range N).flatMap blocks

@[simp] lemma prefixActions_zero (blocks : ℕ → List A) : prefixActions blocks 0 = [] := rfl

@[simp] lemma prefixActions_succ (blocks : ℕ → List A) (N : ℕ) :
    prefixActions blocks (N+1) = prefixActions blocks N ++ blocks N := by
  simp [prefixActions,List.range_succ]

@[simp] lemma prefixActions_length (blocks : ℕ → List A) (N : ℕ) :
    (prefixActions blocks N).length = prefixLength blocks N := by
  induction N with
  | zero => simp
  | succ N ih => simp [ih]

/-- Any finite concatenation already containing position t gives exactly the
least-crossing action. Unexecuted later blocks are irrelevant. -/
theorem prefix_getD_eq_flatten (blocks : ℕ → List A) (hu : Unbounded blocks)
    (d : A) (N t : ℕ) (ht : t < prefixLength blocks N) :
    (prefixActions blocks N).getD t d = flatten blocks hu t := by
  induction N with
  | zero => simp at ht
  | succ N ih =>
    rw [prefixActions_succ]
    by_cases hlt : t < prefixLength blocks N
    · rw [List.getD_append _ _ _ _ (by simpa using hlt)]
      exact ih hlt
    · have hlo : prefixLength blocks N ≤ t := le_of_not_gt hlt
      have hi : blockIndex blocks hu t = N :=
        le_antisymm (Nat.find_min' (hu t) ht) (late_index blocks hu N t hlo)
      rw [List.getD_append_right _ _ _ _ (by simpa using hlo),prefixActions_length]
      simp only [flatten,hi,List.get_eq_getElem]
      exact List.getD_eq_getElem _ _ (by
        have h := offset_lt_length blocks hu t
        simpa [hi] using h)

/-- Total finite-prefix decoder. On invalid/too-short input it returns d. -/
def decode (d : A) (blocks : ℕ → List A) (t : ℕ) : A :=
  (prefixActions blocks t).getD t d

theorem decode_eq_flatten (d : A) (blocks : ℕ → List A)
    (hne : ∀ n, blocks n ≠ []) (t : ℕ) :
    decode d blocks t = flatten blocks (unbounded_of_nonempty blocks hne) t := by
  exact prefix_getD_eq_flatten blocks _ d (t+1) t
    (lt_of_lt_of_le (Nat.lt_succ_self t) (index_le_prefixLength blocks hne (t+1)))

lemma prefixActions_congr (blocks other : ℕ → List A) (N : ℕ)
    (h : ∀ k < N, blocks k = other k) : prefixActions blocks N = prefixActions other N := by
  induction N with
  | zero => rfl
  | succ N ih =>
    rw [prefixActions_succ,prefixActions_succ,
      ih (fun k hk => h k (by omega)),h N (Nat.lt_succ_self N)]

theorem decode_prefix_local (d : A) (blocks other : ℕ → List A) (t : ℕ)
    (h : ∀ k ≤ t, blocks k = other k) : decode d blocks t = decode d other t := by
  unfold decode
  rw [prefixActions_congr blocks other (t+1) (fun k hk => h k (by omega))]

section Measurable
variable {Ω : Type*} [MeasurableSpace Ω] [MeasurableSpace A]
variable [Countable A] [MeasurableSingletonClass A]
variable [MeasurableSpace (List A)] [MeasurableSingletonClass (List A)]

/-- Measurability is obtained from a finite countable prefix, including a total
fallback for invalid paths. No almost-sure nonempty witness enters the decoder. -/
theorem decode_measurable (d : A) (blocks : ℕ → Ω → List A)
    (hb : ∀ n, Measurable (blocks n)) (t : ℕ) :
    Measurable (fun ω => decode d (fun n => blocks n ω) t) := by
  let pref : Ω → (Fin (t+1) → List A) := fun ω k => blocks k ω
  have hp : Measurable pref := measurable_pi_lambda _ (fun k => hb k)
  let finiteDecode : (Fin (t+1) → List A) → A := fun v =>
    decode d (fun n => if h : n < t+1 then v ⟨n,h⟩ else []) t
  have hf : Measurable finiteDecode := measurable_of_countable _
  have heq : (fun ω => decode d (fun n => blocks n ω) t) = finiteDecode ∘ pref := by
    funext ω
    apply decode_prefix_local
    intro k hk
    simp [finiteDecode,pref,show k < t+1 by omega]
  rw [heq]
  exact hf.comp hp

end Measurable
end Orthemology.Tranche2.PhysicalFlattening

#print axioms Orthemology.Tranche2.PhysicalFlattening.prefix_getD_eq_flatten
#print axioms Orthemology.Tranche2.PhysicalFlattening.decode_measurable
