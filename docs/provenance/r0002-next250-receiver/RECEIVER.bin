import AllSyntax
open P01D P01AC OrthemologyV2 OrthemologyV3
example : instantiateType (TypeCode.all (.all (.var 2))) (TypeCode.var 0) = TypeCode.all (.all (.var 1)) := by rfl
import P01CanonicalCarrierProjection
open OrthemologyV2 OrthemologyV3 P01D P01R P01DF
example : carrierCode (PiPER totalPER (fun _ => rawPER) (fun _ => rfl)) = dependentPi (carrierCode totalPER) (carrierFamily (fun _ => rawPER) (fun _ => rfl)) := by
  exact raw_pi_carrier_square (fun _ => rawPER) (fun _ => rfl)
/- Additive actual-E support for the literal retained total-space construction. -/
import FullESectionCorollaries
namespace RigidityInitiality.FullE
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open P01AC.ExtensionalRepair P01AC.ExtensionalRepair.InternalGraph
open P01AC.ExtensionalRepair.CompilerBodyControl
open SourceRigidity
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem shifted_family_form {Γ : Tel} {P B : Ty} (hc : CtxE Γ)
    (hP : FormE (N :: Γ) P) (hB : FormE Γ B) : FormE (N :: B :: Γ) (shiftedFamily P) := by
  have hE : FormE Γ (total P) := .sigma (N_form hc) hP
  have hEw : FormE (B :: Γ) (.sigma N (shiftedFamily P)) := by
    simpa only [total, wk, subst, N_subst] using form_wk hE hc hB
  exact sigma_body_form hEw


theorem sectionBody_scoped {Γ : Tel} {P : Ty} {p s n : Poly}
    (hc : CtxE Γ) (hP : FormE (N :: Γ) P) (hp : HasE Γ p (inst P zero))
    (hs : HasE Γ s (dependentStepType P)) (hn : HasE Γ n N) :
    Scoped Γ.length (sectionBody p s n) := by
  have hE : FormE Γ (total P) := .sigma (N_form hc) hP
  have hd := total_step_has hc hP (uncurried_step_has hc hP hs)
  have ha := total_seed_has hc hP hp
  have run := fold_has hc hE hn hd ha
  have first := HasE.sigmaFst (N_form hc) hE run
  exact has_scoped (HasE.sigmaSnd hE (form_inst_source hc hP first) run)

theorem section_has {Γ : Tel} {P : Ty} {p s r : Poly}
    (hc : CtxE Γ) (hP : FormE (N :: Γ) P) (hp : HasE Γ p (inst P zero))
    (hs : HasE Γ s (dependentStepType P)) (hr : HasE Γ r Rigidity) :
    HasE Γ (sectionPoly p s) (.pi N P) := by
  have cN := CtxE.ext hc (N_form hc)
  have hP' := shifted_family_form hc hP (N_form hc)
  have hp' : HasE (N :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc (N_form hc)
  have hs' : HasE (N :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc (N_form hc)
  have hr' : HasE (N :: Γ) (pren Nat.succ r) Rigidity := by
    simpa only [wk, rigidity_subst] using has_wk hr hc (N_form hc)
  have hn : HasE (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  have body := dependent_section_curried cN hP' hp' hs' (hr') hn
  apply HasE.piIntro ((.pi (N_form hc) hP))
  · simpa only [shifted_at_var] using body
  · exact scoped_abstract (sectionBody_scoped cN hP' hp' hs' hn)



theorem sectionPoly_scoped {Γ : Tel} {P : Ty} {p s : Poly}
    (hc : CtxE Γ) (hP : FormE (N :: Γ) P) (hp : HasE Γ p (inst P zero))
    (hs : HasE Γ s (dependentStepType P)) : Scoped Γ.length (sectionPoly p s) := by
  have cN := CtxE.ext hc (N_form hc)
  have hP' := shifted_family_form hc hP (N_form hc)
  have hp' : HasE (N :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc (N_form hc)
  have hs' : HasE (N :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc (N_form hc)
  have hn : HasE (N :: Γ) (.var 0) N := .var (N_form cN) .zero
  exact scoped_abstract (sectionBody_scoped cN hP' hp' hs' hn)

theorem rigidity_implies_section {Γ : Tel} {P : Ty} {p s : Poly}
    (hc : CtxE Γ) (hP : FormE (N :: Γ) P) (hp : HasE Γ p (inst P zero))
    (hs : HasE Γ s (dependentStepType P)) :
    HasE Γ (abstract (sectionPoly (pren Nat.succ p) (pren Nat.succ s)))
      (arr Rigidity (.pi N P)) := by
  have hR := rigidity_formed hc
  have cR := CtxE.ext hc hR
  have hP' := shifted_family_form hc hP hR
  have hp' : HasE (Rigidity :: Γ) (pren Nat.succ p) (inst (shiftedFamily P) zero) :=
    shifted_zero P ▸ has_wk hp hc hR
  have hs' : HasE (Rigidity :: Γ) (pren Nat.succ s) (dependentStepType (shiftedFamily P)) :=
    shifted_step P ▸ has_wk hs hc hR
  have hr : HasE (Rigidity :: Γ) (.var 0) Rigidity := by
    have hv : HasE (Rigidity :: Γ) (.var 0) (wk Rigidity) := .var (form_wk hR hc hR) .zero
    simpa only [wk, rigidity_subst] using hv
  have body := section_has cR hP' hp' hs' hr
  apply HasE.piIntro ((form_arr hR (.pi (N_form hc) hP)))
  · simpa only [wk, subst, N_subst] using body
  · exact scoped_abstract (sectionPoly_scoped cR hP' hp' hs')


end RigidityInitiality.FullE
import JointRegularity

namespace JointCompletion.Structural
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.EffectiveCompleteness P01AC.BooleanPrimitive
open SigmaCompletion RigidityInitiality
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- Closed impredicative natural numbers are unchanged even by dependent type images. -/
theorem mixed_N (σ : Nat → Poly) (τ : Nat → Ty) : mixed σ τ N = N := rfl

/-- The old variables in the pair environment are exactly two slots deeper. -/
theorem pairSub_wk (A : Ty) : subst SigmaCompletion.pairSub (wk A) = wk (wk A) := by
  simp only [SigmaCompletion.pairSub, subst_wk_cancel, wk, subst_comp]
  rfl

/-- The branch-family square retains the two weakenings on every replacement type. -/
theorem branchType_mixed (P : Ty) (σ : Nat → Poly) (τ : Nat → Ty) :
    mixed (pup (pup σ)) (fun n => wk (wk (τ n))) (branchType P) =
      branchType (mixed (pup σ) (fun n => wk (τ n)) P) := by
  simp only [branchType, mixed_subst, subst_mixed, pairSub_wk]
  congr 1
  funext n
  cases n with
  | zero => rfl
  | succ n => simp only [pairSub, pup, cons, psub, pren, psub_comp]

/-- Successor substitution fixes the weakened ambient type images. -/
theorem successorFamily_mixed (P : Ty) (σ : Nat → Poly) (τ : Nat → Ty) :
    mixed (pup σ) (fun n => wk (τ n)) (successorFamily P) =
      successorFamily (mixed (pup σ) (fun n => wk (τ n)) P) := by
  simp only [successorFamily, mixed_subst, subst_mixed, subst_wk_cancel, subst_id]
  congr 1
  funext n
  cases n with
  | zero =>
    simp only [cons, pup, psub,
      P01AC.BooleanPrimitive.psub_closed (P01AC.has_scoped succ_has)]
  | succ n => simp only [cons, pup, psub, pren, psub_comp]

/-- Full dependent mixed naturality of the induction step type. -/
theorem dependentStepType_mixed (P : Ty) (σ : Nat → Poly) (τ : Nat → Ty) :
    mixed σ τ (dependentStepType P) =
      dependentStepType (mixed (pup σ) (fun n => wk (τ n)) P) := by
  simp only [dependentStepType, mixed, mixed_N, mixed_arr, successorFamily_mixed]

#print axioms mixed_N
#print axioms pairSub_wk
#print axioms branchType_mixed
#print axioms successorFamily_mixed
#print axioms dependentStepType_mixed
end JointCompletion.Structural
import TypeScope
open P01AC P01D Encodable CodedPolyTransformations
-- Intentionally false: all does not add a term variable.
example : checkTyScope 0 (encode (Ty.all (.identity .raw (.var 0) (.var 0)))) = true := by
  rw [checkTyScope_exact]; decide
import MatrixEndpointChecks
open P02.Codec P02.Codec.UniformComputability AtomicMembership MatrixIndependentAudit
example : ¬ membershipMatrix (programIndex echoProgram) (Nat.pair 7 0) 1 2 := by
  simp [membershipMatrix_integer_iff]
import EndpointChecks
open P02.Codec P02.Codec.UniformComputability P02A2.ObserverCore
example : uvRead [128,0] = some (0,[]) := by
  rw [UniformIndependentAudit.reject_overlong_zero]
import UniformComputabilityMachine
namespace OperationalInterpreterAudit
open P02.Codec P02.Codec.UniformComputability P02A2.ObserverCore

theorem latest_write_wins : readRegs [(3,8),(3,2)] 3 = 8 := by decide
theorem absent_register_zero : readRegs [(3,8),(3,2)] 4 = 0 := by decide

theorem terminal_zero_fuel (rs : RegFile) : runFuel 0 [] rs = some rs := by
  simp [runFuel]

theorem pending_skip_zero_fuel (rs : RegFile) : runFuel 0 [.stmt .skip] rs = none := by
  simp [runFuel]

theorem semantic_noop_still_needs_transition (rs : RegFile) :
    runFuel 1 [.stmt .skip] rs = some rs := by
  simp [runFuel, step]

-- One stack step does not mean one bounded-size arithmetic operation.
theorem one_transition_unbounded_value (n : Nat) :
    runFuel 1 [.stmt (.set 0 (.pow2 (.constant n)))] [] = some [(0,2^n)] := by
  simp [runFuel, step, writeRegs, evalRegs]

theorem division_zero_semantics : evalRegs (.div (.constant 7) (.constant 0)) [] = 0 := by decide
theorem modulo_zero_semantics : evalRegs (.mod (.constant 7) (.constant 0)) [] = 7 := by decide

-- If the bound register is also the loop index, the count is still captured.
def aliasBound : PackedProgram := ⟨2,2,
  .loop 0 (.reg 0) (.set 2 (.add (.reg 2) (.constant 1)))⟩
theorem captured_aliased_count : evaluateIndexFuel 16 (programIndex aliasBound) 3 0 = some 1 := by
  simp only [evaluateIndexFuel, decodeIndex_programIndex, aliasBound, ↓reduceIte]
  decide

theorem successful_fuel_agrees (e n word fuel value : Nat)
    (h : evaluateIndexFuel fuel e n word = some value) :
    value = evaluateIndex e n word := by
  exact evaluateIndexFuel_sound h

end OperationalInterpreterAudit

