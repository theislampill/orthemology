open CodedRuleTemplates Encodable
example : checkSideCode (encode ctrlBadConv) = true := by
  rw [checkSideCode_exact]
  decide
import SeparatingProjection

noncomputable section

open scoped BigOperators

namespace FiniteMoment.Checks

variable {K : Type*} [Field K]

/-- Empty support is admitted in every finite dimension. -/
theorem empty_support [Infinite K] (d : ℕ) (x : Fin 0 → Fin d → K) :
    ∃ v : Fin d → K, Function.Injective (fun i => projection v (x i)) :=
  exists_separating_projection x (Function.injective_of_subsingleton x)

/-- A single support point is admitted, including in dimension zero. -/
theorem singleton_support [Infinite K] (d : ℕ) (x : Fin 1 → Fin d → K) :
    ∃ v : Fin d → K, ∀ w : Fin 1 → K,
      recover (fun i => projection v (x i))
        (record (fun i => projection v (x i)) w) = w := by
  obtain ⟨v, _, hv⟩ := exists_projection_recovery x (Function.injective_of_subsingleton x)
  exact ⟨v, hv⟩

omit [Field K] in
/-- An injectively enumerated zero-dimensional support necessarily has at most
one point, so the general theorem has no impossible nontrivial zero-dimensional case. -/
theorem zero_dimension_card_le_one {N : ℕ} (x : Fin N → Fin 0 → K)
    (hx : Function.Injective x) : N ≤ 1 := by
  letI : Subsingleton (Fin N) := ⟨fun i j => hx (Subsingleton.elim _ _)⟩
  simpa using (Fintype.card_le_one_iff_subsingleton.mpr (inferInstance : Subsingleton (Fin N)))

/-- Empty, zero-dimensional support also has valid exact recovery. -/
theorem empty_zero_dimension [Infinite K] (x : Fin 0 → Fin 0 → K) :
    ∃ v : Fin 0 → K, ∀ w : Fin 0 → K,
      recover (fun i => projection v (x i))
        (record (fun i => projection v (x i)) w) = w := by
  obtain ⟨v, _, hv⟩ := exists_projection_recovery x (Function.injective_of_subsingleton x)
  exact ⟨v, hv⟩

/-- Over every finite field, the entire two-dimensional space is a finite
set of distinct vectors with no injective scalar projection. -/
theorem finite_field_counterexample [Fintype K] :
    ∃ (N : ℕ) (x : Fin N → Fin 2 → K),
      Function.Injective x ∧
      ∀ v : Fin 2 → K, ¬ Function.Injective (fun i => projection v (x i)) := by
  classical
  let e := Fintype.equivFin (Fin 2 → K)
  refine ⟨Fintype.card (Fin 2 → K), e.symm, e.symm.injective, ?_⟩
  intro v hv
  have hc := Fintype.card_le_of_injective (fun i => projection v (e.symm i)) hv
  have hcard : Fintype.card K * Fintype.card K ≤ Fintype.card K := by
    simpa only [Fintype.card_fin, Fintype.card_fun, pow_two] using hc
  exact (not_lt_of_ge hcard)
    (lt_mul_of_one_lt_right (Fintype.card_pos) (Fintype.one_lt_card))

end FiniteMoment.Checks
import FixedTarget

namespace IndependentScope
open FixedTarget

def OneOwner (g : Agent) (_c : Emission) : Prop := g = .a

theorem one_owner_nonvacuous : CND OneOwner ∧ Entire OneOwner .a ∧ ¬ Entire OneOwner .b := by
  refine ⟨?_, ?_, ?_⟩
  · intro ag bg c ha hb
    exact ha.trans hb.symm
  · intro c
    rfl
  · intro h
    have bad : Agent.b = Agent.a := h .x0
    cases bad

-- The countermodel is inhabited and CND is neither universal nor inconsistent.
theorem exact_ownership_controls :
    CND Own ∧ ¬ CND DuplicateOwn ∧
    (¬ Entire Own .a ∧ ¬ Entire Own .b) :=
  ⟨emitted_token_cnd, duplicate_ownership_rejected, neither_owns_entire_emission_process⟩

-- Concrete (4,4) is feasible jointly in the bounded family, but not a bounded command.
theorem union_not_sum_closure :
    add target target = (⟨4,4⟩ : Vec) ∧ ¬ inCapacity (add target target) := by
  constructor
  · rfl
  · simp [inCapacity, add, target]

-- This is why the parametric all-Nat construction matters for concentration.
theorem generic_concentration (a b : Vec) :
    ∃ c : Vec, add c zero = add a b := every_nat_vector_constructive (add a b)

-- Two possible controls under concord do not entail rectangular sovereignty.
theorem concord_does_not_yield_rectangular_control :
    (∀ q : Bool, AdmissibleControlsA sat concord q) ∧ ¬ ControlsA sat false :=
  ⟨concordant_all_targets, saturation_cannot_force_false⟩

theorem actual_redundancy_is_not_indispensability :
    sat true true = true ∧ sat true false = true ∧
    ¬ IndispensableB sat true true false true := by
  exact ⟨rfl, rfl, saturation_no_actual_indispensability⟩

-- Whole outcome attribution and ownership of all emission tokens are separate.
theorem whole_target_cnd_does_not_follow_from_emission_cnd :
    CND Own ∧ ¬ CNDAt WholeSufficient :=
  ⟨emitted_token_cnd, sufficient_as_entire_breaks_whole_target_cnd⟩

#print axioms one_owner_nonvacuous
#print axioms exact_ownership_controls
#print axioms union_not_sum_closure
#print axioms generic_concentration
#print axioms concord_does_not_yield_rectangular_control
#print axioms actual_redundancy_is_not_indispensability
#print axioms whole_target_cnd_does_not_follow_from_emission_cnd
end IndependentScope
import TaggedPER
import OpenDevelopments
import RigidityDiscriminator

namespace SigmaTagBoundary
open P01AC P01D
open P01AC.ExtensionalRepair (HasE)
open OpenTermStandardness (T Conv)
open TaggedPER
open ImportedOpenTermTransport (interp)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem zero_normal : OpenDevelopments.Normal T.zero := by
  intro u h; cases h; rfl

theorem probe_normal : OpenDevelopments.Normal (T.zero ⬝ T.k ⬝ (T.k ⬝ T.i)) := by
  intro u h
  cases h with
  | app hf hx =>
    cases hf with
    | app h0 hk =>
      cases h0; cases hk
      cases hx with
      | app hk hi => cases hk; cases hi; rfl

theorem ghost_not_tag : ¬ tag T.i := by
  intro h
  have projections : Conv (pair (first T.i) (second T.i)) (pair T.k (T.k ⬝ T.i)) :=
    OpenTermStandardness.pair_congr (.i _) (.i _)
  have eq : Conv T.zero (T.zero ⬝ T.k ⬝ (T.k ⬝ T.i)) :=
    (Conv.i T.zero).symm.trans ((Conv.app (h.trans projections) (.refl _)).trans
      (OpenTermStandardness.pair_application _ _ _))
  have impossible := OpenDevelopments.normal_unique zero_normal probe_normal eq
  cases impossible

def SigmaRaw : Ty := .sigma .raw .raw
def etaBody : Ty := .identity SigmaRaw (.var 0)
  (pairPoly (fstPoly (.var 0)) (sndPoly (.var 0)))
def Eta : Ty := .pi SigmaRaw etaBody

theorem ghost_member (ρ : REnv) (η : TaggedPER.Env) : F SigmaRaw ρ η T.i T.i :=
  ⟨.refl _,.refl _,Iff.rfl⟩

theorem eta_at_ghost_empty (ρ : REnv) (η : TaggedPER.Env) (p q : T) :
    ¬ F etaBody ρ (cons T.i η) p q := by
  intro h
  exact ghost_not_tag (h.1.2.2.mpr (tag_pair _ _))

theorem eta_empty (ρ : REnv) (η : TaggedPER.Env) (p q : T) : ¬ F Eta ρ η p q := by
  intro h
  exact eta_at_ghost_empty ρ η _ _ (h T.i T.i (ghost_member ρ η))

def emptyEnv : REnv := fun _ _ _ => False
theorem empty_admissible : admissible emptyEnv := fun _ =>
  ⟨False.elim,fun h _ => h,fun _ _ h => h⟩

theorem no_eta (p : Poly) : ¬ HasE [] p Eta := by
  intro h
  exact eta_empty _ _ _ _ (fundamental h emptyEnv zeroEnv zeroEnv empty_admissible ⟨rfl,rfl⟩)

theorem rigidity_exact (ρ : REnv) (η : TaggedPER.Env) :
    F SourceRigidity.Rigidity ρ η = FullPER.F SourceRigidity.Rigidity ρ η := rfl

theorem rigidity_valid (ρ : REnv) (η : TaggedPER.Env) :
    F SourceRigidity.Rigidity ρ η
      (interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 η)
      (interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 η) :=
  RigidityDiscriminator.rigidity_valid ρ η

/-- The explicit Rigidity hypothesis does not imply the universal dependent-pair eta type. -/
theorem no_rigidity_to_eta (p : Poly) :
    ¬ HasE [] p (arr SourceRigidity.Rigidity Eta) := by
  intro h
  have v := fundamental h emptyEnv zeroEnv zeroEnv empty_admissible ⟨rfl,rfl⟩
  rw [TaggedPER.F_arr] at v
  exact eta_empty _ _ _ _ (v _ _ (rigidity_valid emptyEnv zeroEnv))

/-- Direct open source form, with both the pair and the explicit Rigidity assumption. -/
theorem no_eta_under_rigidity (p : Poly) :
    ¬ HasE [SigmaRaw, SourceRigidity.Rigidity] p etaBody := by
  intro h
  let r := interp P01AC.ExtensionalRepair.ExactScalarFusion.c3 zeroEnv
  let η := cons T.i (cons r zeroEnv)
  have ee : E [SigmaRaw, SourceRigidity.Rigidity] emptyEnv η η :=
    ⟨⟨⟨rfl,rfl⟩,rigidity_valid emptyEnv zeroEnv⟩,ghost_member _ _⟩
  exact eta_at_ghost_empty _ _ _ _ (fundamental h emptyEnv η η empty_admissible ee)

/-- The original componentwise model validates eta simultaneously with Rigidity. -/
theorem full_eta_valid (ρ : FullPER.REnv) (η : FullPER.Env) :
    FullPER.F Eta ρ η (T.k ⬝ T.i) (T.k ⬝ T.i) := by
  intro z w zw
  exact ⟨⟨(OpenTermStandardness.fst_pair _ _).symm,
    (OpenTermStandardness.snd_pair _ _).symm⟩,.k _ _,.k _ _⟩

theorem no_rigidity_to_not_eta (p : Poly) :
    ¬ HasE [] p (arr SourceRigidity.Rigidity (arr Eta .bottom)) := by
  intro h
  have v := FullPER.fundamental h FullPER.Application.emptyEnv FullPER.zeroEnv FullPER.zeroEnv
    FullPER.Application.emptyEnv_admissible ⟨rfl,rfl⟩
  rw [FullPER.F_arr] at v
  have vn := v _ _ (RigidityDiscriminator.rigidity_valid _ _)
  rw [FullPER.F_arr] at vn
  exact vn _ _ (full_eta_valid _ _)

theorem relative_independence :
    (¬ ∃ p, HasE [] p (arr SourceRigidity.Rigidity Eta)) ∧
    (¬ ∃ p, HasE [] p (arr SourceRigidity.Rigidity (arr Eta .bottom))) :=
  ⟨fun ⟨p,h⟩ => no_rigidity_to_eta p h,
   fun ⟨p,h⟩ => no_rigidity_to_not_eta p h⟩

/-- The two projections cannot observe the tag distinction. -/
theorem matching_observations :
    Conv (first T.i) (first (pair (first T.i) (second T.i))) ∧
    Conv (second T.i) (second (pair (first T.i) (second T.i))) :=
  ⟨(OpenTermStandardness.fst_pair _ _).symm,
   (OpenTermStandardness.snd_pair _ _).symm⟩

theorem matching_observations_not_identity (ρ : REnv) (η : TaggedPER.Env) :
    ¬ F SigmaRaw ρ η T.i (pair (first T.i) (second T.i)) := by
  intro h
  exact ghost_not_tag (h.2.2.mpr (tag_pair _ _))

#print axioms full_eta_valid
#print axioms no_rigidity_to_not_eta
#print axioms relative_independence
#print axioms matching_observations_not_identity
#print axioms ghost_not_tag
#print axioms no_eta
#print axioms rigidity_exact
#print axioms rigidity_valid
#print axioms no_rigidity_to_eta
#print axioms no_eta_under_rigidity
end SigmaTagBoundary
import MixedControls
open Lean in
run_cmd do
  let env ← getEnv
  let targets := #[`CodedMixedTransformations.primrec_mixedCode,
    `CodedMixedTransformations.mixedCode_exact, `CodedMixedTransformations.tinstCode_exact,
    `CodedMixedTransformations.tsubstImagesCode_exact, `CodedMixedTransformations.primrec_twkCode,
    `CodedMixedTransformations.twkCode_exact, `CodedMixedTransformations.primrec_instantiateTypeCode,
    `CodedMixedTransformations.instantiateTypeCode_exact, `CodedMixedTransformations.primrec_finCode,
    `CodedMixedTransformations.finCode_exact, `CodedMixedTransformations.primrec_finSupportCode,
    `CodedMixedTransformations.finSupportCode_exact]
  let allowed := #[`propext, `Classical.choice, `Quot.sound]
  for target in targets do
    let (_, collected) := ((CollectAxioms.collect target).run env).run {}
    for ax in collected.axioms do
      unless allowed.contains ax do throwError "Unexpected axiom {ax} in {target}"
    logInfo m!"AUDIT {target}: {collected.axioms}"
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

/-! The exceptional monomial indexing and its global midpoint property. -/
namespace FullFunctionalIndexing

abbrev Exponent := ℕ × ℕ

def degree (p : Exponent) : ℕ := p.1 + p.2

def triangle : ℕ → ℕ
  | 0 => 0
  | n + 1 => triangle n + n + 1

@[simp] theorem triangle_zero : triangle 0 = 0 := rfl
@[simp] theorem triangle_succ (n : ℕ) : triangle (n+1) = triangle n + n + 1 := rfl

theorem twice_triangle (n : ℕ) : 2 * triangle n = n * (n+1) := by
  induction n with
  | zero => simp
  | succ n ih => rw [triangle_succ]; nlinarith

theorem triangle_formula (n : ℕ) : triangle n = n * (n+1) / 2 := by
  have h := twice_triangle n
  omega

theorem triangle_mono : Monotone triangle := by
  apply monotone_nat_of_le_succ
  intro n
  simp only [triangle_succ]
  omega

def seedIndex : Exponent → ℕ
  | (0, 0) => 1
  | (2, 1) => 2
  | (1, 2) => 3
  | (1, 1) => 4
  | (1, 0) => 5
  | (0, 1) => 6
  | (2, 0) => 7
  | (0, 2) => 8
  | (3, 0) => 9
  | (0, 3) => 10
  | _ => 0

/-- The one-based exceptional enumeration, followed by the ordinary degree shells. -/
def index (p : Exponent) : ℕ :=
  if degree p ≤ 3 then seedIndex p else triangle (degree p) + p.2 + 1

/-- The integer midpoint, used only when both coordinate sums are even. -/
def midpoint (p q : Exponent) : Exponent := ((p.1+q.1)/2, (p.2+q.2)/2)

def Compatible (p q : Exponent) : Prop :=
  (p.1 + q.1) % 2 = 0 ∧ (p.2 + q.2) % 2 = 0

theorem small_cases {p : Exponent} (h : degree p ≤ 3) :
    p = (0,0) ∨ p = (2,1) ∨ p = (1,2) ∨ p = (1,1) ∨
    p = (1,0) ∨ p = (0,1) ∨ p = (2,0) ∨ p = (0,2) ∨
    p = (3,0) ∨ p = (0,3) := by
  rcases p with ⟨a,b⟩
  simp only [degree, Prod.mk.injEq] at *
  omega

theorem index_small {p : Exponent} (h : degree p ≤ 3) :
    1 ≤ index p ∧ index p ≤ 10 := by
  rcases small_cases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    norm_num [index, degree, seedIndex]

theorem index_large {p : Exponent} (h : 4 ≤ degree p) :
    index p = triangle (degree p) + p.2 + 1 := by
  simp [index, show ¬degree p ≤ 3 by omega]

theorem index_pos (p : Exponent) : 0 < index p := by
  by_cases h : degree p ≤ 3
  · exact (index_small h).1
  · rw [index_large (by omega)]
    omega

theorem index_upper {p : Exponent} (h : 4 ≤ degree p) :
    index p ≤ triangle (degree p + 1) := by
  rw [index_large h, triangle_succ]
  have hcoord : p.2 ≤ degree p := by simp [degree]
  omega

theorem index_degree_lt {p q : Exponent}
    (hq : 4 ≤ degree q) (hpq : degree p < degree q) : index p < index q := by
  rw [index_large hq]
  by_cases hp : degree p ≤ 3
  · have hi := (index_small hp).2
    have ht := triangle_mono hq
    have ht4 : triangle 4 = 10 := rfl
    omega
  · have hu := index_upper (show 4 ≤ degree p by omega)
    have ht := triangle_mono (show degree p + 1 ≤ degree q by omega)
    omega

theorem midpoint_degree (p q : Exponent) (h : Compatible p q) :
    2 * degree (midpoint p q) = degree p + degree q := by
  rcases p with ⟨a,b⟩
  rcases q with ⟨c,d⟩
  simp only [Compatible, midpoint, degree] at *
  omega

theorem midpoint_precedes_small {p q : Exponent}
    (hp : degree p ≤ 3) (hq : degree q ≤ 3)
    (hne : p ≠ q) (h : Compatible p q) :
    index (midpoint p q) < max (index p) (index q) := by
  rcases small_cases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
  rcases small_cases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    norm_num [Compatible, midpoint, index, degree, seedIndex] at *

/-- Global midpoint precedence: every off-diagonal even moment is already defined. -/
theorem midpoint_precedes {p q : Exponent} (hne : p ≠ q) (h : Compatible p q) :
    index (midpoint p q) < max (index p) (index q) := by
  have hd := midpoint_degree p q h
  by_cases hp : degree p ≤ 3
  · by_cases hq : degree q ≤ 3
    · exact midpoint_precedes_small hp hq hne h
    · have hm : degree (midpoint p q) < degree q := by omega
      exact lt_of_lt_of_le (index_degree_lt (by omega) hm) (le_max_right _ _)
  · by_cases hq : degree q ≤ 3
    · have hm : degree (midpoint p q) < degree p := by omega
      exact lt_of_lt_of_le (index_degree_lt (by omega) hm) (le_max_left _ _)
    · by_cases he : degree p = degree q
      · have hm : degree (midpoint p q) = degree p := by omega
        have hc : p.2 ≠ q.2 := by
          intro hc
          apply hne
          apply Prod.ext
          · simp only [degree] at he
            omega
          · exact hc
        have hm2 : (midpoint p q).2 < max p.2 q.2 := by
          rcases h with ⟨ha,hb⟩
          simp only [midpoint]
          omega
        rw [index_large (by omega), index_large (by omega), index_large (by omega)]
        rw [hm, ← he]
        omega
      · rcases lt_or_gt_of_ne he with hlt | hgt
        · have hm : degree (midpoint p q) < degree q := by omega
          exact lt_of_lt_of_le (index_degree_lt (by omega) hm) (le_max_right _ _)
        · have hm : degree (midpoint p q) < degree p := by omega
          exact lt_of_lt_of_le (index_degree_lt (by omega) hm) (le_max_left _ _)

theorem index_injective : Function.Injective index := by
  intro p q he
  by_cases hp : degree p ≤ 3
  · by_cases hq : degree q ≤ 3
    · rcases small_cases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases small_cases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        norm_num [index, degree, seedIndex] at *
    · have hi := index_degree_lt (show 4 ≤ degree q by omega)
        (show degree p < degree q by omega)
      omega
  · by_cases hq : degree q ≤ 3
    · have hi := index_degree_lt (show 4 ≤ degree p by omega)
        (show degree q < degree p by omega)
      omega
    · have hd : degree p = degree q := by
        by_contra hne
        rcases lt_or_gt_of_ne hne with hl | hg
        · have hi := index_degree_lt (show 4 ≤ degree q by omega) hl
          omega
        · have hi := index_degree_lt (show 4 ≤ degree p by omega) hg
          omega
      rw [index_large (by omega), index_large (by omega), hd] at he
      apply Prod.ext
      · simp only [degree] at hd
        omega
      · omega

theorem index_successor (p : Exponent) : ∃ q, index q = index p + 1 := by
  by_cases hp : degree p ≤ 3
  · rcases small_cases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨(2,1), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(1,2), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(1,1), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(1,0), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(0,1), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(2,0), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(0,2), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(3,0), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(0,3), by norm_num [index, degree, seedIndex]⟩
    · exact ⟨(4,0), by norm_num [index, degree, seedIndex, triangle]⟩
  · rcases p with ⟨a,b⟩
    cases a with
    | zero =>
      refine ⟨(b+1,0), ?_⟩
      have hb : 4 ≤ b := by simpa [degree] using (show 4 ≤ degree (0,b) by omega)
      rw [index_large (by simp [degree]; omega), index_large (by simp [degree]; omega)]
      simp [degree, triangle_succ]
    | succ a =>
      refine ⟨(a,b+1), ?_⟩
      have hd : degree (a,b+1) = degree (a+1,b) := by simp [degree]; omega
      rw [index_large (by rw [hd]; omega), index_large (by omega), hd]
      simp
      omega

/-- Every positive integer is attained, with no finite degree bound. -/
theorem index_surjective (n : ℕ) : ∃ p, index p = n+1 := by
  induction n with
  | zero => exact ⟨(0,0), rfl⟩
  | succ n ih =>
    obtain ⟨p,hp⟩ := ih
    obtain ⟨q,hq⟩ := index_successor p
    exact ⟨q, by omega⟩

/-- A bijection from exponents to the positive natural numbers. -/
def positiveIndex (p : Exponent) : {n : ℕ // 0 < n} := ⟨index p, index_pos p⟩

theorem positiveIndex_bijective : Function.Bijective positiveIndex := by
  constructor
  · intro p q h
    exact index_injective (congrArg Subtype.val h)
  · intro ⟨n,hn⟩
    obtain ⟨p,hp⟩ := index_surjective (n-1)
    refine ⟨p, Subtype.ext ?_⟩
    change index p = n
    omega

@[simp] theorem index_seed_one : index (0,0) = 1 := rfl
@[simp] theorem index_seed_two : index (2,1) = 2 := rfl
@[simp] theorem index_seed_three : index (1,2) = 3 := rfl
@[simp] theorem index_seed_four : index (1,1) = 4 := rfl

theorem seed_cases {p : Exponent} (hp : index p ≤ 4) :
    p = (0,0) ∨ p = (2,1) ∨ p = (1,2) ∨ p = (1,1) := by
  have hs : degree p ≤ 3 := by
    by_contra h
    have hl := index_large (show 4 ≤ degree p by omega)
    have ht := triangle_mono (show 4 ≤ degree p by omega)
    have ht4 : triangle 4 = 10 := rfl
    omega
  rcases small_cases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    norm_num [index, degree, seedIndex] at *

/-- The first four exponent pairs have distinct parity classes. -/
theorem seed_parity_separated {p q : Exponent}
    (hp : index p ≤ 4) (hq : index q ≤ 4) (hne : p ≠ q) :
    ¬ Compatible p q := by
  rcases seed_cases hp with rfl | rfl | rfl | rfl <;>
  rcases seed_cases hq with rfl | rfl | rfl | rfl <;>
    norm_num [Compatible] at *

/-- The zero-based inverse of the one-based index. -/
noncomputable def exponentAt (n : ℕ) : Exponent := (index_surjective n).choose

@[simp] theorem index_exponentAt (n : ℕ) : index (exponentAt n) = n+1 :=
  (index_surjective n).choose_spec

@[simp] theorem exponentAt_index (p : Exponent) : exponentAt (index p - 1) = p := by
  apply index_injective
  rw [index_exponentAt]
  have h := index_pos p
  omega

theorem exponentAt_injective : Function.Injective exponentAt := by
  intro i j h
  have hi := congrArg index h
  simpa only [index_exponentAt, Nat.add_right_cancel_iff] using hi

@[simp] theorem exponentAt_zero : exponentAt 0 = (0,0) := by
  apply index_injective
  rw [index_exponentAt]
  rfl

@[simp] theorem exponentAt_one : exponentAt 1 = (2,1) := by
  apply index_injective
  rw [index_exponentAt]
  rfl

@[simp] theorem exponentAt_two : exponentAt 2 = (1,2) := by
  apply index_injective
  rw [index_exponentAt]
  rfl

@[simp] theorem exponentAt_three : exponentAt 3 = (1,1) := by
  apply index_injective
  rw [index_exponentAt]
  rfl

@[simp] theorem compatible_self (p : Exponent) : Compatible p p := by
  simp only [Compatible]
  omega

theorem compatible_symm {p q : Exponent} (h : Compatible p q) : Compatible q p := by
  simpa only [Compatible, Nat.add_comm] using h

@[simp] theorem midpoint_self (p : Exponent) : midpoint p p = p := by
  apply Prod.ext <;> simp [midpoint] <;> omega

theorem midpoint_comm (p q : Exponent) : midpoint p q = midpoint q p := by
  simp only [midpoint, Nat.add_comm]

/-- The form used to justify a newly appended Gram-matrix column. -/
theorem midpoint_precedes_of_index_lt {p q : Exponent}
    (hpq : index p < index q) (h : Compatible p q) :
    index (midpoint p q) < index q := by
  have hne : p ≠ q := by intro he; simp [he] at hpq
  simpa only [max_eq_right (Nat.le_of_lt hpq)] using midpoint_precedes hne h

/-- The form used to prove that an earlier Gram matrix stays unchanged. -/
theorem midpoint_index_le {p q : Exponent} (h : Compatible p q) :
    index (midpoint p q) ≤ max (index p) (index q) := by
  by_cases he : p = q
  · subst q
    simp
  · exact Nat.le_of_lt (midpoint_precedes he h)

#print axioms midpoint_precedes
#print axioms index_injective
#print axioms positiveIndex_bijective
#print axioms seed_parity_separated
#print axioms exponentAt_index
end FullFunctionalIndexing
import RawImages
import Mathlib.Data.Fintype.EquivFin

namespace FiniteRawReview
open FiniteRawObstruction FiniteRawObstruction.Source OrthemologyV2 OrthemologyV3
universe u

/-- Only values actually denoted by terms are subject to the K law. Unreachable
summary states need neither a K law nor a preimage under the summary map. -/
def reachableImage {A : Type u} (q : Term → A) (δ : A → A → A)
    (compositional : ∀ t₁ t, q (.app t₁ t) = δ (q t₁) (q t))
    (conversion : ∀ {t₁ t}, Conv t₁ t → q t₁ = q t) :
    ClosedRawImage { a : A // ∃ t, q t = a } where
  denote := fun t => ⟨q t, t, rfl⟩
  app := fun a b => ⟨δ a.val b.val, by
    obtain ⟨t₁, hs⟩ := a.property
    obtain ⟨t, ht⟩ := b.property
    exact ⟨.app t₁ t, by rw [compositional, hs, ht]⟩⟩
  denote_app := fun t₁ t => Subtype.ext (compositional t₁ t)
  conversion := fun h => Subtype.ext (conversion h)
  surjective := by
    intro a
    obtain ⟨t, ht⟩ := a.property
    exact ⟨t, Subtype.ext ht⟩

/-- An exact, conversion-respecting summary of every raw application is
constant whenever its summary carrier is finite. No whole-carrier surjectivity
is assumed. Finite bounded, restricted, or non-compositional summaries are
outside this theorem. -/
theorem finite_exact_summary_constant {A : Type u} [Finite A]
    (q : Term → A) (δ : A → A → A)
    (compositional : ∀ t₁ t, q (.app t₁ t) = δ (q t₁) (q t))
    (conversion : ∀ {t₁ t}, Conv t₁ t → q t₁ = q t) (t₁ t : Term) :
    q t₁ = q t := by
  letI : Finite { a : A // ∃ t, q t = a } :=
    Finite.of_injective Subtype.val Subtype.val_injective
  let D := reachableImage q δ compositional conversion
  have h := finite_closed_image_no_separation D t₁ t
  exact congrArg Subtype.val h

/-- Partial application does not evade the finite obstruction if every
K-first application and every resulting constant't₁ application is defined. -/
structure PartialKSlice (A : Type u) where
  app : A → A → Option A
  k : A
  encode : A → A
  k_apply : ∀ x, app k x = some (encode x)
  encoded_apply : ∀ x y, app (encode x) y = some x

theorem finite_partial_K_subsingleton {A : Type u} [Finite A]
    (M : PartialKSlice A) : Subsingleton A := by
  have hi : Function.Injective M.encode := by
    intro x y he
    have h := congrArg (fun z => M.app z M.k) he
    change M.app (M.encode x) M.k = M.app (M.encode y) M.k at h
    rw [M.encoded_apply, M.encoded_apply] at h
    exact Option.some.inj h
  obtain ⟨a, ha⟩ := Finite.surjective_of_injective hi M.k
  have hc (x : A) : M.encode x = a := by
    have h := M.k_apply x
    rw [← ha, M.encoded_apply] at h
    exact (Option.some.inj h).symm
  exact ⟨fun x y => hi ((hc x).trans (hc y).symm)⟩

/-- Whole-carrier surjectivity matters: a finite carrier may contain
unreachable junk while satisfying closed compositional conversion soundness. -/
def junkSummary : Term → Bool := fun _ => false
def junkTransition : Bool → Bool → Bool := fun a b => a || b

theorem junk_compositional (t₁ t : Term) :
    junkSummary (.app t₁ t) = junkTransition (junkSummary t₁) (junkSummary t) := rfl

theorem junk_conversion {t₁ t : Term} (_h : Conv t₁ t) :
    junkSummary t₁ = junkSummary t := rfl

theorem junk_not_surjective : ¬ Function.Surjective junkSummary := by
  intro h
  obtain ⟨t, ht⟩ := h true
  cases ht

theorem junk_whole_carrier_K_fails :
    ¬ (∀ x y, junkTransition (junkTransition (junkSummary .k) x) y = x) := by
  intro h
  have e := h false true
  cases e

/-- Compositionality alone is not enough: syntax shape is a nonconstant finite
summary with a total binary transition, but it does not respect conversion. -/
def shapeSummary : Term → Bool
  | .app _ _ => true
  | _ => false

def shapeTransition : Bool → Bool → Bool := fun _ _ => true

theorem shape_compositional (t₁ t : Term) :
    shapeSummary (.app t₁ t) = shapeTransition (shapeSummary t₁) (shapeSummary t) := rfl

theorem shape_nonconstant : shapeSummary .k ≠ shapeSummary (.app .k .k) := by decide

theorem shape_not_conversion_sound :
    ¬ (∀ {t₁ t}, Conv t₁ t → shapeSummary t₁ = shapeSummary t) := by
  intro h
  have e := h (Conv.step (Step.k .k .k))
  cases e

#print axioms finite_exact_summary_constant
#print axioms finite_partial_K_subsingleton
#print axioms junk_not_surjective
#print axioms junk_whole_carrier_K_fails
#print axioms shape_not_conversion_sound
end FiniteRawReview
import CountableIdentification
import Mathlib.MeasureTheory.Measure.Count
open MeasureTheory
-- This use MUST be rejected: uncountable counting measure is not s-finite.
example : Set.Countable {a : ℝ | 0 < (Measure.dirac a) {a}} := by
  apply Orthemology.Tranche2.countable_positive_exact_identification
    (Measure.count : Measure ℝ) (fun a : ℝ => Measure.dirac a) id measurable_id
    (fun a : ℝ => {a}) (by intro a; simp)
  intro a s hs
  have he : s = ∅ := Measure.count_eq_zero_iff.mp hs
  simp [he]
import ValidityControls
open ExactSyntaxValidity SourceFamilyComputability
example : valid 0 (node (leaf 0) (leaf 1)) = true := by
  rw [Controls.rejectBadTerminator]
  decide
import MatrixEndpointChecks
open P02.Codec P02.Codec.UniformComputability AtomicMembership MatrixIndependentAudit
example : Primrec (fun z : ℕ => decide (membershipMatrix z.unpair.1 z.unpair.2.unpair.1 z.unpair.2.unpair.2.unpair.1 z.unpair.2.unpair.2.unpair.2)) := membershipMatrix_nat_computable
import IndependentMixedControls
import ExtensionalSubstitutionControl
namespace HasEMixedReview
open OrthemologyV2 OrthemologyV3 P01D P01R P01AC
open P01F (cons)
open P01AC.ExtensionalRepair
open P01AC.ExtensionalRepair.Structural
open HasEDependentSubstitutionControls
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

theorem proofId_form : FormE [] proofId :=
  .identity (ClosedProofCanonicalisation.formed extensional_image)
    extensional_image extensional_image

def genuineCtx : Tel := [proofId]
theorem genuine_ctx : CtxE genuineCtx := .ext .nil proofId_form

def genuineImage : Ty := .identity (wk proofId) (.var 0) (.var 0)
theorem genuine_image_form : FormE genuineCtx genuineImage := by
  have hf := form_wk proofId_form CtxE.nil proofId_form
  exact .identity hf (.var hf .zero) (.var hf .zero)

-- The target telescope and replacement type genuinely require actual E evidence.
theorem target_not_original : ¬ Ctx genuineCtx := by
  intro hc
  cases hc with
  | ext _ hf =>
    cases hf with
    | identity _ hi _ => exact no_original_image _ hi

theorem dependent_e_only_transport : HasE genuineCtx (.atom .i)
    (tsubst (fun _ => genuineImage)
      (.identity (.all (endTy 1)) (.atom .i) (.atom .i))) :=
  has_closed_tsubst all_ext_input genuine_ctx (fun _ => genuine_image_form)

theorem transported_result_not_original (p : Poly) :
    ¬ Has genuineCtx p (tsubst (fun _ => genuineImage)
      (.identity (.all (endTy 1)) (.atom .i) (.atom .i))) := by
  intro hp
  exact target_not_original (P01AC.form_ctx (P01AC.has_form hp))

theorem image_genuinely_term_dependent :
    subst (cons (.atom .i) Poly.var) genuineImage ≠ genuineImage := by decide

theorem image_not_a_parameter (n : Nat) : genuineImage ≠ Ty.param n := by
  intro h
  cases h

-- The newer declaration now depends on the older E-only variable.
def dependentGenuineCtx : Tel := genuineImage :: genuineCtx
theorem dependent_genuine_ctx : CtxE dependentGenuineCtx :=
  .ext genuine_ctx genuine_image_form

def dependentGenuineImage : Ty := .identity (wk genuineImage) (.var 0) (.var 0)
theorem dependent_genuine_image_form : FormE dependentGenuineCtx dependentGenuineImage := by
  have hf := form_wk genuine_image_form genuine_ctx genuine_image_form
  exact .identity hf (.var hf .zero) (.var hf .zero)

theorem dependent_telescope_transport : HasE dependentGenuineCtx (.atom .i)
    (tsubst (fun _ => dependentGenuineImage)
      (.identity (.all (endTy 1)) (.atom .i) (.atom .i))) :=
  has_closed_tsubst all_ext_input dependent_genuine_ctx (fun _ => dependent_genuine_image_form)

theorem dependent_target_not_original : ¬ Ctx dependentGenuineCtx := by
  intro hc
  cases hc with
  | ext hc _ => exact target_not_original hc

theorem dependent_target_result_not_original (p : Poly) (A : Ty) :
    ¬ Has dependentGenuineCtx p A := by
  intro hp
  exact dependent_target_not_original (P01AC.form_ctx (P01AC.has_form hp))

#print axioms dependent_telescope_transport
#print axioms dependent_target_result_not_original
#print axioms dependent_e_only_transport
#print axioms target_not_original
#print axioms transported_result_not_original
end HasEMixedReview
