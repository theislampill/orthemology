import MembershipWitnesses
import MatrixSemanticControls

namespace MatrixIndependentAudit
open P02.Codec P02.Codec.UniformComputability AtomicMembership

theorem exact_four_input_predicate :
    Computable (fun p : ℕ × ℕ × ℕ × ℕ =>
      decide (AtomicMembership.membershipMatrix p.1 p.2.1 p.2.2.1 p.2.2.2)) :=
  membershipMatrix_computable

theorem exact_nat_coded_predicate : Computable (fun z : ℕ =>
    decide (AtomicMembership.membershipMatrix z.unpair.1 z.unpair.2.unpair.1
      z.unpair.2.unpair.2.unpair.1 z.unpair.2.unpair.2.unpair.2)) :=
  membershipMatrix_nat_computable

theorem four_input_pairing_roundtrip (e i k N : ℕ) :
    matrixInputOfNat (Nat.pair e (Nat.pair i (Nat.pair k N))) = (e,i,k,N) := by
  simp [matrixInputOfNat]

theorem exact_integer_boolean (e i k N : ℕ) :
    integerMatrix (e,i,k,N) = decide (AtomicMembership.membershipMatrix e i k N) := by
  simp [integerMatrix, membershipMatrix_integer_iff]

/-- Standard all-natural characteristic output, derived without a predicate oracle. -/
theorem characteristic_nat_to_nat : Computable (fun z : ℕ =>
    if AtomicMembership.membershipMatrix z.unpair.1 z.unpair.2.unpair.1
      z.unpair.2.unpair.2.unpair.1 z.unpair.2.unpair.2.unpair.2 then (1:ℕ) else 0) := by
  have hg : Primrec (fun b : Bool => if b then (1:ℕ) else 0) := by
    apply (Primrec.cond Primrec.id (Primrec.const 1) (Primrec.const 0)).of_eq
    intro b
    cases b <;> rfl
  apply (hg.to_comp.comp membershipMatrix_nat_computable).of_eq
  intro z
  by_cases h : AtomicMembership.membershipMatrix z.unpair.1 z.unpair.2.unpair.1
      z.unpair.2.unpair.2.unpair.1 z.unpair.2.unpair.2.unpair.2 <;> simp [h]

/-- The outer quantifiers remain in a logical equivalence; this theorem does
not claim a computable characteristic function for the infinite index set. -/
theorem exact_quantifier_order (e : ℕ) :
    e ∈ P02A2.Pi3IndexReduction.zeroDefectIndices ↔
      ∀ i, ∃ k, ∀ N, AtomicMembership.membershipMatrix e i k N :=
  effective_membership_normal_form.2 e

theorem exact_heavy_mass_bridge (e k N : ℕ) :
    AtomicMembership.rationalHeavyMass (P02A2.FiniteOutputTable.indexTable e) k N =
      (heavyCount e k N : ℚ≥0)/(2:ℚ≥0)^N := rationalHeavyMass_heavyCount e k N

end MatrixIndependentAudit
import LookupCode
import PolyExact
namespace IndependentAuxiliaryInterfaces
open Encodable AuxiliaryCertificates AuxiliaryCodeComputability OrthemologyV2 OrthemologyV3 P01D P01AC
-- Explicit root qualification guards the intended Mathlib class and tuple order.
theorem step_PR : _root_.Primrec (fun p : Nat × (Nat × Nat) => checkStepCode p.1 p.2.1 p.2.2) := primrec_checkStepCode
theorem red_PR : _root_.Primrec (fun p : Nat × (Nat × Nat) => checkRedCode p.1 p.2.1 p.2.2) := primrec_checkRedCode
theorem finite_PR : _root_.Primrec (fun p : Nat × (Nat × Nat) => checkFiniteCode p.1 p.2.1 p.2.2) := primrec_checkFiniteCode
theorem poly_PR : _root_.Primrec (fun p : Nat × (Nat × Nat) => checkPolyCode p.1 p.2.1 p.2.2) := primrec_checkPolyCode
theorem lookup_PR : _root_.Primrec (fun p : Nat × (Nat × (Nat × Nat)) => checkLookupCode p.1 p.2.1 p.2.2.1 p.2.2.2) := primrec_checkLookupCode
-- No malformed-code or decoder claim is substituted for canonical exactness.
theorem step_exact : ∀ (c : StepCert) (t u : Term), checkStepCode (encode c) (encode t) (encode u) = AuxiliaryCertificates.checkStep c t u := checkStepCode_exact
theorem red_exact : ∀ (c : RedCert) (t u : Term), checkRedCode (encode c) (encode t) (encode u) = AuxiliaryCertificates.checkRed c t u := checkRedCode_exact
theorem finite_exact : ∀ (c : FiniteCert) (t : Term) (A : TypeCode), checkFiniteCode (encode c) (encode t) (encode A) = AuxiliaryCertificates.checkFinite c t A := checkFiniteCode_exact
theorem poly_exact : ∀ (c : PolyCert) (p q : Poly), checkPolyCode (encode c) (encode p) (encode q) = AuxiliaryCertificates.checkPoly c p q := checkPolyCode_exact
theorem lookup_exact : ∀ (c : LookupCert) (Γ : Tel) (n : Nat) (A : Ty), checkLookupCode (encode c) (encode Γ) n (encode A) = AuxiliaryCertificates.checkLookup c Γ n A := checkLookupCode_exact
end IndependentAuxiliaryInterfaces
import OpaqueSearch
import RandomizedFinite

namespace CoveringKernel
open MeasureTheory
variable {α Ω : Type*} [Fintype α] [DecidableEq α] [MeasurableSpace Ω]

/-- Fixed maximal bad sets index worlds, independently of the coin outcome.
Each complete seed selects an ordinary deterministic policy on the same family. -/
theorem randomized_ae_cap_lower_bound {F : Finset (Finset α)} {O : Type*}
    (μ : Measure Ω)  (π : Ω → Policy F O)
    (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (q k N : ℕ)
    (hu : Uniform q F) (hop : Opaque k observe failedReply)
    (hcap : ∀ T : Finset α, T.card = k →
      ∀ᵐ ω ∂μ, SuccessWithin (π ω) observe T N) :
    coveringNumber α (Fintype.card α-q) k ≤ N := by
  let W := {T : Finset α // T.card = k}
  obtain ⟨ω, hω⟩ := RandomizedFinite.exists_coin_success_all μ
    (fun (T : W) ω => SuccessWithin (π ω) observe T.val N)
    (fun T => hcap T.val T.property)
  exact deterministic_cap_lower_bound (π ω) observe failedReply q k N hu hop
    (fun T hT => hω ⟨T, hT⟩)

/-- One fixed bad set defeats any smaller cap on a non-null set of seeds.
This conclusion does not select the bad set after drawing coins. -/
theorem randomized_below_cover_fixed_failure {F : Finset (Finset α)} {O : Type*}
    (μ : Measure Ω) [IsProbabilityMeasure μ] (π : Ω → Policy F O)
    (observe : Finset α → ℕ → Path F → O)
    (failedReply : ℕ → Path F → O) (q k N : ℕ)
    (hu : Uniform q F) (hop : Opaque k observe failedReply)
    (hsmall : N < coveringNumber α (Fintype.card α-q) k) :
    ∃ T : Finset α, T.card = k ∧
      ¬ (∀ᵐ ω ∂μ, SuccessWithin (π ω) observe T N) := by
  classical
  by_contra h
  push_neg at h
  have hl := randomized_ae_cap_lower_bound μ π observe failedReply q k N hu hop h
  omega

#print axioms randomized_ae_cap_lower_bound
#print axioms randomized_below_cover_fixed_failure
end CoveringKernel
import BlindGuessSharpness
open MeasureTheory Set Filter
open scoped Topology
namespace BlindAudit
open Orthemology.Tranche2 Orthemology.Tranche2.FiniteQuery

def success (a : ℝ) (e : ℕ → ℝ) : Set (ℝ × Oracle) :=
  {z | ∀ᶠ n in atTop,
    blindAsk (run blindAsk blindNext z.2 z.1 n).1 = false ∧
    BinaryGood a (e n) (1/2+(run blindAsk blindNext z.2 z.1 n).1*e n)}

theorem dirac_wrong_guess_zero (a guess : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (hne : guess ≠ a) (o : Oracle) (e : ℕ → ℝ)
    (he0 : ∀ n, 0 < e n) (he1 : ∀ n, e n ≤ 1/4)
    (he : Tendsto e atTop (𝓝 0)) :
    Measure.dirac (guess,o) (success a e) = 0 := by
  have h := blind_causal_success_mass a ha0 ha1 e he0 he1 he
    (Measure.dirac guess) (Measure.dirac (guess,o)) (Measure.map_dirac measurable_fst (guess,o))
  simpa [success, Measure.dirac_apply', hne] using h

theorem dirac_correct_guess_one (a : ℝ) (ha0 : 0 ≤ a) (ha1 : a ≤ 1)
    (o : Oracle) (e : ℕ → ℝ)
    (he0 : ∀ n, 0 < e n) (he1 : ∀ n, e n ≤ 1/4)
    (he : Tendsto e atTop (𝓝 0)) :
    Measure.dirac (a,o) (success a e) = 1 := by
  have h := blind_causal_success_mass a ha0 ha1 e he0 he1 he
    (Measure.dirac a) (Measure.dirac (a,o)) (Measure.map_dirac measurable_fst (a,o))
  simpa [success] using h

end BlindAudit
#print axioms BlindAudit.dirac_wrong_guess_zero
#print axioms BlindAudit.dirac_correct_guess_one
/- Actual unchanged-HasE conditional refutation of the original faithful-Raw
   identity. NoConfusion remains the explicit antecedent, not a new rule. -/
import SourceRawSeparator
import Initiality
import HasEStructuralBase

namespace OriginalRawSeparator.Conditional
open P01AC P01D OrthemologyV2 OrthemologyV3 P01R
open P01AC.ExtensionalRepair
open P01AC.Intensional.Plus (PolyConvPlus)
open P01AC.BooleanPrimitive (psub_closed)
open FullPER.Application (originalP originalQ)
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000

/-- The same literal conditional antecedent used by the finite-test templates. -/
def RawClash : Ty := .identity .raw (.atom .zero) (.atom .one)
def NoConfusion : Ty := arr RawClash .bottom

theorem clash_form {Γ : Tel} (hc : Ctx Γ) : Form Γ RawClash :=
  .identity (.raw hc) (.rawAtom (.raw hc)) (.rawAtom (.raw hc))
theorem noConfusion_form {Γ : Tel} (hc : Ctx Γ) : Form Γ NoConfusion :=
  P01AC.form_arr (clash_form hc) (.bottom hc)

theorem closed_raw {Γ : Tel} (hc : Ctx Γ) {p : Poly} (hp : Scoped 0 p) : Has Γ p .raw := by
  induction p with
  | var n => exact False.elim (Nat.not_lt_zero n hp)
  | atom t => exact .rawAtom (.raw hc)
  | app f a ihf iha => exact .rawApp (.raw hc) (ihf hp.1) (iha hp.2)

theorem originalP_closed : Scoped 0 originalP :=
  P01AC.has_scoped P01AC.UnaryIdentity.IntensionalBoundary.variableExpr.closed_has

theorem originalQ_closed : Scoped 0 originalQ :=
  P01AC.has_scoped P01AC.UnaryIdentity.IntensionalBoundary.redundantExpr.closed_has

-- The finite probe contains no term variables.
theorem probe_closed : Scoped 0 probeP := by
  simp [probeP, tailP, pairPoly, Scoped]

theorem context_subst (t : Poly) (σ : Nat → Poly) :
    psub σ (contextPoly t) = contextPoly (psub σ t) := by
  simp only [contextPoly, psub, psub_closed probe_closed]

theorem context_raw {Γ : Tel} (hc : Ctx Γ) {p : Poly} (hp : Has Γ p .raw) :
    Has Γ (contextPoly p) .raw := by
  have raw : Form Γ .raw := .raw hc
  exact .rawApp raw (.rawApp raw (.rawApp raw (.rawApp raw hp
    (closed_raw hc probe_closed)) (.rawAtom raw)) (.rawAtom raw)) (.rawAtom raw)

def RawIdentity : Ty := .identity .raw originalP originalQ

theorem rawIdentity_subst (σ : Nat → Poly) : subst σ RawIdentity = RawIdentity := by
  simp only [RawIdentity, subst, psub_closed originalP_closed, psub_closed originalQ_closed]

theorem rawIdentity_form {Γ : Tel} (hc : Ctx Γ) : Form Γ RawIdentity :=
  .identity (.raw hc) (closed_raw hc originalP_closed) (closed_raw hc originalQ_closed)

/-- Two old J applications; both conversion leaves use the literal finite separator. -/
def clashWitness (e : Poly) : Poly :=
  jPoly (jPoly (.atom .i) originalQ e) (.atom .one) (.atom .i)

theorem clash_of_original {Γ : Tel} (hc : Ctx Γ) {e : Poly}
    (he : HasE Γ e RawIdentity) : HasE Γ (clashWitness e) RawClash := by
  have raw : Form Γ .raw := .raw hc
  have hp : Has Γ originalP .raw := closed_raw hc originalP_closed
  have hq : Has Γ originalQ .raw := closed_raw hc originalQ_closed
  have hz : Has Γ (.atom .zero) .raw := .rawAtom raw
  have ho : Has Γ (.atom .one) .raw := .rawAtom raw
  have cr : Ctx (.raw :: Γ) := .ext hc raw
  let P : Ty := .identity .raw (.atom .zero) (contextPoly (.var 0))
  have hP : Form (.raw :: Γ) P := .identity (.raw cr) (.rawAtom (.raw cr))
    (context_raw cr (.var (.raw cr) .zero))
  have atP (p : Poly) : inst P p = .identity .raw (.atom .zero) (contextPoly p) := by
    simp only [P, inst, subst, context_subst, psub, P01F.cons]
  have start : HasE Γ (.atom .i) (inst P originalP) := by
    rw [atP]
    exact .identityIntro (form_inclusion (.identity raw hz (context_raw hc hp)))
      (has_inclusion hz) (has_inclusion (context_raw hc hp)) source_left.symm
  have moved := RigidityInitiality.transport_source hc raw hP hp hq he start
  rw [atP] at moved
  let Q : Ty := .identity .raw (.atom .zero) (.var 0)
  have hQ : Form (.raw :: Γ) Q := .identity (.raw cr) (.rawAtom (.raw cr))
    (.var (.raw cr) .zero)
  have finish : HasE Γ (.atom .i) (.identity .raw (contextPoly originalQ) (.atom .one)) :=
    .identityIntro (form_inclusion (.identity raw (context_raw hc hq) ho))
      (has_inclusion (context_raw hc hq)) (has_inclusion ho) source_right
  exact RigidityInitiality.transport_source hc raw hQ (context_raw hc hq) ho finish moved

def refutationBody : Poly := .app (.var 1) (clashWitness (.var 0))
def witness : Poly := abstract (abstract refutationBody)

/-- A closed, actual old-E proof of NoConfusion → (Id_Raw(P,Q) → Bottom). -/
theorem witness_has : HasE [] witness (arr NoConfusion (arr RawIdentity .bottom)) := by
  have c1 : Ctx [NoConfusion] := .ext .nil (noConfusion_form .nil)
  have p1 : Form [NoConfusion] RawIdentity := rawIdentity_form c1
  have c2 : Ctx [RawIdentity, NoConfusion] := .ext c1 p1
  have hp : HasE [RawIdentity, NoConfusion] (.var 0) RawIdentity := by
    have h := HasE.var (form_inclusion (P01AC.form_wk p1 c1 p1))
      (Lookup.zero (A := RawIdentity) (Γ := [NoConfusion]))
    simpa only [wk, rawIdentity_subst] using h
  have clash := clash_of_original c2 hp
  have hnc : HasE [RawIdentity, NoConfusion] (.var 1) NoConfusion :=
    .var (form_inclusion (noConfusion_form c2)) (.succ .zero)
  have hb : HasE [RawIdentity, NoConfusion] refutationBody .bottom :=
    .piElim (form_inclusion (noConfusion_form c2)) (form_inclusion (.bottom c2)) hnc clash
  have inner : HasE [NoConfusion] (abstract refutationBody) (arr RawIdentity .bottom) :=
    .piIntro (form_inclusion (P01AC.form_arr p1 (.bottom c1))) hb
      (scoped_abstract (P01AC.ExtensionalRepair.Structural.has_scoped hb))
  apply HasE.piIntro
    (form_inclusion (P01AC.form_arr (noConfusion_form .nil)
      (P01AC.form_arr (rawIdentity_form .nil) (.bottom .nil))))
    (show HasE [NoConfusion] (abstract refutationBody) (wk (arr RawIdentity .bottom)) from by
      simpa only [wk, subst_arr, rawIdentity_subst, subst] using inner)
    (scoped_abstract (P01AC.ExtensionalRepair.Structural.has_scoped inner))

theorem witness_closed : Scoped 0 witness :=
  P01AC.ExtensionalRepair.Structural.has_scoped witness_has

/-- The full literal formula, without local type abbreviations. -/
theorem literal_witness_has : HasE [] witness
    (arr (arr (.identity .raw (.atom .zero) (.atom .one)) .bottom)
      (arr (.identity .raw originalP originalQ) .bottom)) := witness_has

/-- Supplied old-E no-confusion evidence specializes the conditional proof. -/
theorem refute_with_noConfusion {nc : Poly} (hn : HasE [] nc NoConfusion) :
    HasE [] (.app witness nc) (arr RawIdentity .bottom) := by
  have h := HasE.piElim (P01AC.ExtensionalRepair.ClosedProofCanonicalisation.formed witness_has)
    (show FormE [] (inst (wk (arr RawIdentity .bottom)) nc) by
      simpa only [inst_wk] using form_inclusion
        (P01AC.form_arr (rawIdentity_form Ctx.nil) (.bottom .nil))) witness_has hn
  simpa only [inst_wk] using h

#print axioms clash_of_original
#print axioms witness_has
#print axioms refute_with_noConfusion
#print axioms literal_witness_has
#print axioms witness_closed
end OriginalRawSeparator.Conditional
import Enumeration

namespace GuardedTree.Witness
open Tree
variable {J E R : Type*} [DecidableEq J] [DecidableEq E]
  (G : Grammar J E R) [gd : ∀ r s, Decidable (G.guard r s)]

/-- Structural checking computes the original grammar validity proposition. -/
def validDecidable : (t : Tree G) → Decidable (Valid G t)
  | .node r child => by
    letI : ∀ i, Decidable (Valid G (child i)) := fun i => validDecidable (child i)
    exact inferInstanceAs (Decidable
      ((∀ i, Valid G (child i) ∧ judgement G (child i) = G.premise r i) ∧
        G.guard r (fun i => support G (child i))))

instance treeValidDecidable (t : Tree G) : Decidable (Valid G t) := validDecidable G t

/-- Standalone executable certificate verifier; recomputes all tree metadata. -/
def accept (q : J) (S : Finset E) (c : ℚ) (t : Tree G) : Bool :=
  decide (Valid G t ∧ q = q ∧ support G t = S ∧ cost G t = c)

theorem accept_iff (q : J) (S : Finset E) (c : ℚ) (t : Tree G) :
    accept G q S c t = true ↔
      Valid G t ∧ judgement G t = q ∧ support G t = S ∧ cost G t = c := by
  simp only [accept, decide_eq_true_eq]

/-- Deterministic first-match selection. Equal-cost ties use the rule-list order. -/
def search (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E) (c : ℚ) : Option (Tree G) :=
  (trees G rs h).find? (accept G q S c)

theorem search_sound (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E)
    (c : ℚ) (t : Tree G) (ht : search G rs h q S c = some t) :
    Bounded G h t ∧ Valid G t ∧ judgement G t = q ∧ support G t = S ∧ cost G t = c :=
  ⟨(mem_trees G rs h t).mp (List.mem_of_find?_eq_some ht),
    (accept_iff G q S c t).mp (List.find?_some ht)⟩

theorem search_complete (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E) (c : ℚ)
    (hex : ∃ t : Tree G, Bounded G h t ∧ Valid G t ∧
      judgement G t = q ∧ support G t = S ∧ cost G t = c) :
    ∃ t, search G rs h q S c = some t := by
  obtain ⟨t, hb, ht⟩ := hex
  have hi : (search G rs h q S c).isSome := List.find?_isSome.mpr
    ⟨t, (mem_trees G rs h t).mpr hb, (accept_iff G q S c t).mpr ht⟩
  cases he : search G rs h q S c with
  | none => simp [he] at hi
  | some t => exact ⟨t, rfl⟩

variable [Fintype R] [Fintype J]

/-- First compute the separate dynamic-table minimum, then exhaustively search
bounded finite trees at that exact cost. This is not efficient reconstruction. -/
def extractRound (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E) : Option (Tree G) :=
  (Executable.read (Executable.compileRounds G h) q S).bind (search G rs h q S)

theorem extract_sound (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E)
    (t : Tree G) (ht : extractRound G rs h q S = some t) :
    Bounded G h t ∧ Valid G t ∧ judgement G t = q ∧ support G t = S ∧
      Executable.read (Executable.compileRounds G h) q S = some (cost G t) := by
  unfold extractRound at ht
  cases hc : Executable.read (Executable.compileRounds G h) q S with
  | none => simp [hc] at ht
  | some c =>
    have hs : search G rs h q S c = some t := by simpa [hc] using ht
    obtain ⟨hb, hv, hq, hS, hp⟩ := search_sound G rs h q S c t hs
    exact ⟨hb, hv, hq, hS, by simp only [hp]⟩

theorem extract_complete (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E)
    (c : ℚ) (hc : Executable.read (Executable.compileRounds G h) q S = some c) :
    ∃ t, extractRound G rs h q S = some t ∧ cost G t = c := by
  have hr : Saturation.round G h q S = some c := by
    simpa only [Executable.compile_round_eq] using hc
  obtain ⟨t, ht⟩ := search_complete G rs h q S c ((Saturation.round_correct G h).1 q S c hr)
  exact ⟨t, by simp [extractRound, hc, ht], (search_sound G rs h q S c t ht).2.2.2.2⟩

/-- Exact correspondence, including unreachable keys; no existential tree is
chosen by the runtime implementation. -/
theorem extract_cost_eq (rs : RuleList R) (h : ℕ) (q : J) (S : Finset E) :
    (extractRound G rs h q S).map (cost G) =
      Executable.read (Executable.compileRounds G h) q S := by
  cases hc : Executable.read (Executable.compileRounds G h) q S with
  | none => simp [extractRound, hc]
  | some c =>
    obtain ⟨t, ht, hp⟩ := extract_complete G rs h q S c hc
    simp [ht, hp]

/-- Global reference extractor. Nonnegative prices are the correctness theorem's
hypothesis, not an implicit assumption of the bounded implementation. -/
def extract (rs : RuleList R) (q : J) (S : Finset E) : Option (Tree G) :=
  extractRound G rs (grammarBound G) q S

/-- Global output projection is exactly the existing compiled numeric table. -/
theorem extract_global_cost_eq (rs : RuleList R) (q : J) (S : Finset E) :
    (extract G rs q S).map (cost G) = Executable.read (Executable.compile G) q S :=
  extract_cost_eq G rs (grammarBound G) q S

theorem extract_global (rs : RuleList R) (hw : ∀ r, 0 ≤ G.price r)
    (q : J) (S : Finset E) (t : Tree G) (ht : extract G rs q S = some t) :
    Valid G t ∧ judgement G t = q ∧ support G t = S ∧
      (∀ u : Tree G, Valid G u → judgement G u = q → support G u = S →
        cost G t ≤ cost G u) := by
  obtain ⟨_, hv, hq, hs, hc⟩ := extract_sound G rs (grammarBound G) q S t ht
  refine ⟨hv, hq, hs, ?_⟩
  intro u hu huq hus
  obtain ⟨c, huC, hle⟩ := (Executable.compile_correct G hw).2 u hu
  change Executable.read (Executable.compileRounds G (grammarBound G)) _ _ = some c at huC
  rw [huq, hus, hc] at huC
  exact Option.some.inj huC ▸ hle

theorem extract_none_iff (rs : RuleList R) (hw : ∀ r, 0 ≤ G.price r)
    (q : J) (S : Finset E) : extract G rs q S = none ↔
      ¬ ∃ t : Tree G, Valid G t ∧ judgement G t = q ∧ support G t = S := by
  constructor
  · intro hn ⟨t, hv, hq, hs⟩
    obtain ⟨c, hc, _⟩ := (Executable.compile_correct G hw).2 t hv
    rw [hq, hs] at hc
    obtain ⟨u, hu, _⟩ := extract_complete G rs (grammarBound G) q S c hc
    change extract G rs q S = some u at hu
    rw [hn] at hu
    contradiction
  · intro hn
    cases ht : extract G rs q S with
    | none => rfl
    | some t =>
      obtain ⟨hv, hq, hs, _⟩ := extract_global G rs hw q S t ht
      exact False.elim (hn ⟨t, hv, hq, hs⟩)

#print axioms accept_iff
#print axioms extract_cost_eq
#print axioms extract_global_cost_eq
#print axioms extract_global
#print axioms extract_none_iff
end GuardedTree.Witness
import SerialCertImageRule
namespace CertificateCodeValidity
open Encodable SourceFamilyComputability CodedScope ExactSyntaxValidity AuxiliaryCodeComputability
open OrthemologyV2 P01D P01AC AuxiliaryCertificates JointCertificates TelescopeCodeValidity
set_option maxRecDepth 16384
set_option maxHeartbeats 1000000
attribute [local irreducible] Nat.pair

theorem SerialCert_bounds (c : Nat) (h : ∃ a : JointCertificates.SerialCert, encode a = c) :
    ∀ d ∈ localChildren serialCertDescription c, d.2 < c := by
  obtain ⟨a, rfl⟩ := h
  cases a; simp [localChildren, serialCertDescription, dependencies, fieldCode, List.range_succ]
  all_goals repeat' apply And.intro
  all_goals first
    | solve | apply field_lt_pack; simp
    | apply lt_of_le_of_lt (le_leaf _); apply field_lt_pack; simp

end CertificateCodeValidity
import TypedObservations

/- A separate cross-typing discriminator. The identical pair and selector
polynomials are typed once through Sigma and once through Church-encoded Pi. -/
namespace CrossTypedObserver
open OrthemologyV2 OrthemologyV3 P01D P01AC P01AC.ExtensionalRepair
open P01AC.EffectiveCompleteness (N inputNumeral inputNumeral_has app_has)
open P01AC.BooleanPrimitive (closed_has N_subst)
open P01AC.ExtensionalRepair.InternalGraph (pair_first)
set_option maxRecDepth 8192

def Selector (B : Ty) := arr B (arr B B)
def ChurchPair (B : Ty) := arr (Selector B) B
def Product (B : Ty) := Ty.sigma B (wk B)
def seed (a : Poly) := pairPoly a a
def step (b : Poly) := Poly.app (.atom .k) (pairPoly b b)
def run (n a b : Poly) := Poly.app (.app n (step b)) (seed a)
def observe (n a b : Poly) := fstPoly (run n a b)

theorem selector_form {Γ B} (hB : Form Γ B) : Form Γ (Selector B) :=
  form_arr hB (form_arr hB hB)
theorem churchPair_form {Γ B} (hB : Form Γ B) : Form Γ (ChurchPair B) :=
  form_arr (selector_form hB) hB

theorem product_form {Γ B} (hB : Form Γ B) : Form Γ (Product B) :=
  .sigma hB (form_wk hB (form_ctx hB) hB)

theorem constant_has {Γ A B b} (hA : Form Γ A) (hb : Has Γ b B) :
    Has Γ (.app (.atom .k) b) (arr A B) := by
  have hB := has_form hb
  have hAB := form_arr hA hB
  exact app_has (form_arr hB hAB) hAB (.k hB hA (form_arr hB hAB)) hb

theorem s_apply_has {Γ A B C f g}
    (hA : Form Γ A) (hB : Form Γ B) (hC : Form Γ C)
    (hf : Has Γ f (arr A (arr B C))) (hg : Has Γ g (arr A B)) :
    Has Γ (.app (.app (.atom .s) f) g) (arr A C) := by
  have hF := form_arr hA (form_arr hB hC)
  have hG := form_arr hA hB
  have hO := form_arr hA hC
  have hs := Has.s hA hB hC (form_arr hF (form_arr hG hO))
  exact app_has (form_arr hG hO) hO
    (app_has (form_arr hF (form_arr hG hO)) (form_arr hG hO) hs hf) hg

/-- The ACTUAL pairPoly SKI encoding has the Church-pair type as well. -/
theorem pair_church_has {Γ B a b} (ha : Has Γ a B) (hb : Has Γ b B) :
    Has Γ (pairPoly a b) (ChurchPair B) := by
  have hB := has_form ha
  have hE := selector_form hB
  have hBB := form_arr hB hB
  have hi : Has Γ (.atom .i) (arr (Selector B) (Selector B)) :=
    .i hE (form_arr hE hE)
  have inner := s_apply_has hE hB hBB hi (constant_has hE ha)
  exact s_apply_has hE hB hB inner (constant_has hE hb)

theorem pair_product_has {Γ B a b} (ha : Has Γ a B) (hb : Has Γ b B) :
    Has Γ (pairPoly a b) (Product B) := by
  apply Has.sigmaIntro (product_form (has_form ha))
  · simpa only [inst_wk] using has_form hb
  · exact ha
  · simpa only [inst_wk] using hb

theorem run_at {Γ C n a b} (hn : Has Γ n N)
    (hs : Has Γ (seed a) C) (hb : Has Γ (pairPoly b b) C) :
    Has Γ (run n a b) C := by
  have hC := has_form hs
  have hCC := form_arr hC hC
  have hi := TypedStructuredObserver.church_instance hC hn
  exact app_has hCC hC (app_has (form_arr hCC hCC) hCC hi (constant_has hC hb)) hs

/-- Sigma route: projection is literally application to K. -/
theorem observe_via_sigma {Γ B n a b}
    (hn : Has Γ n N) (ha : Has Γ a B) (hb : Has Γ b B) :
    Has Γ (observe n a b) B :=
  .sigmaFst (has_form ha) (product_form (has_form ha))
    (run_at hn (pair_product_has ha ha) (pair_product_has hb hb))

/-- Pi route: the same literal application to K, now typed as a selector. -/
theorem observe_via_church {Γ B n a b}
    (hn : Has Γ n N) (ha : Has Γ a B) (hb : Has Γ b B) :
    Has Γ (observe n a b) B := by
  have hB := has_form ha
  have hk : Has Γ (.atom .k) (Selector B) := .k hB hB (selector_form hB)
  exact app_has (churchPair_form hB) hB
    (run_at hn (pair_church_has ha ha) (pair_church_has hb hb)) hk

/-- The result judgement and polynomial coincide without conversion,
isomorphism transport, or a naturality assumption. -/
theorem same_endpoint_identity {Γ B n a b}
    (hn : Has Γ n N) (ha : Has Γ a B) (hb : Has Γ b B) :
    HasE Γ (.atom .i) (.identity B (observe n a b) (observe n a b)) := by
  have hs := has_inclusion (observe_via_sigma hn ha hb)
  have hc := has_inclusion (observe_via_church hn ha hb)
  exact .identityIntro (.identity (form_inclusion (has_form ha)) hs hc) hs hc (.refl _)

theorem zero_observation (a b : Poly) :
    P01DF.PolyConv (observe (inputNumeral 0) a b) a :=
  (P01DF.PolyConv.app (TypedStructuredObserver.numeral_zero_apply (step b) (seed a))
    (.refl _)).trans (pair_first a a)

theorem one_observation (a b : Poly) :
    P01DF.PolyConv (observe (inputNumeral 1) a b) b :=
  (P01DF.PolyConv.app (TypedStructuredObserver.numeral_one_apply (step b) (seed a))
    (.refl _)).trans
      ((P01DF.PolyConv.app (.k (pairPoly b b) (seed a)) (.refl _)).trans (pair_first b b))

theorem zero_source_identity {Γ B a b} (ha : Has Γ a B) (hb : Has Γ b B) :
    HasE Γ (.atom .i) (.identity B (observe (inputNumeral 0) a b) a) := by
  have hn := closed_has (inputNumeral_has 0) N_subst (form_ctx (has_form ha))
  have ho := has_inclusion (observe_via_sigma hn ha hb)
  have ha' := has_inclusion ha
  exact .identityIntro (.identity (form_inclusion (has_form ha)) ho ha') ho ha'
    (Intensional.Plus.polyConv_inclusion (zero_observation a b))

theorem one_source_identity {Γ B a b} (ha : Has Γ a B) (hb : Has Γ b B) :
    HasE Γ (.atom .i) (.identity B (observe (inputNumeral 1) a b) b) := by
  have hn := closed_has (inputNumeral_has 1) N_subst (form_ctx (has_form ha))
  have ho := has_inclusion (observe_via_church hn ha hb)
  have hb' := has_inclusion hb
  exact .identityIntro (.identity (form_inclusion (has_form hb)) ho hb') ho hb'
    (Intensional.Plus.polyConv_inclusion (one_observation a b))

universe u

def sigmaObservation {D : Type u}
    (n : ((D × D) → (D × D)) → (D × D) → (D × D)) (a b : D) : D :=
  (n (fun _ => (b,b)) (a,a)).1

def churchObservation {D : Type u}
    (n : (((D → D → D) → D) → ((D → D → D) → D)) →
      ((D → D → D) → D) → ((D → D → D) → D)) (a b : D) : D :=
  n (fun _ k => k b b) (fun k => k a a) (fun x _ => x)

/-- Conditional semantic consequence of the two source derivations.
`coherence` is equality of the values of ONE judgement, computed according to
Sigma's projection rule versus Pi's application/SKI rules. It is not assumed
for arbitrary maps, pairs of types, or Church carriers. -/
theorem no_shape_split {D : Type u}
    (ns : ((D × D) → (D × D)) → (D × D) → (D × D))
    (nc : (((D → D → D) → D) → ((D → D → D) → D)) →
      ((D → D → D) → D) → ((D → D → D) → D))
    (a b : D) (hne : a ≠ b)
    (coherence : sigmaObservation ns a b = churchObservation nc a b)
    (sigma_zero : ∀ step seed, ns step seed = seed)
    (church_one : ∀ step seed, nc step seed = step seed) : False := by
  apply hne
  simpa only [sigmaObservation, churchObservation, sigma_zero, church_one] using coherence

theorem no_reverse_shape_split {D : Type u}
    (ns : ((D × D) → (D × D)) → (D × D) → (D × D))
    (nc : (((D → D → D) → D) → ((D → D → D) → D)) →
      ((D → D → D) → D) → ((D → D → D) → D))
    (a b : D) (hne : a ≠ b)
    (coherence : sigmaObservation ns a b = churchObservation nc a b)
    (sigma_one : ∀ step seed, ns step seed = step seed)
    (church_zero : ∀ step seed, nc step seed = seed) : False := by
  apply hne.symm
  simpa only [sigmaObservation, churchObservation, sigma_one, church_zero] using coherence


/-- The two carrier syntaxes have distinct outer constructors. -/
theorem carriers_syntactically_distinct (B : Ty) : Product B ≠ ChurchPair B := by
  intro h
  cases h

def ProbeContext : Tel := [.param 0, .param 0, N]

theorem probe_context : Ctx ProbeContext := by
  have cn : Ctx [N] := .ext .nil (EffectiveCompleteness.N_form .nil)
  have cb : Ctx [.param 0,N] := .ext cn (.param cn)
  exact .ext cb (.param cb)

theorem probe_same_endpoint : HasE ProbeContext (.atom .i)
    (.identity (.param 0) (observe (.var 2) (.var 0) (.var 1))
      (observe (.var 2) (.var 0) (.var 1))) :=
  same_endpoint_identity
    (.var (EffectiveCompleteness.N_form probe_context) (.succ (.succ .zero)))
    (.var (.param probe_context) .zero) (.var (.param probe_context) (.succ .zero))

/-- Matching zero or matching one observations survive; the test does not
reject coherent fixed-count choices. -/
theorem matching_zero {D : Type u} (a b : D) :
    sigmaObservation (fun _ seed => seed) a b =
      churchObservation (fun _ seed => seed) a b := rfl

theorem matching_one {D : Type u} (a b : D) :
    sigmaObservation (fun step seed => step seed) a b =
      churchObservation (fun step seed => step seed) a b := rfl

theorem explicit_shape_split :
    Subsingleton Unit ∧
    sigmaObservation (fun step seed => step seed) false true = true ∧
    churchObservation (fun _ seed => seed) false true = false ∧
    sigmaObservation (fun step seed => step seed) false true ≠
      churchObservation (fun _ seed => seed) false true := by
  exact ⟨inferInstance, rfl, rfl, by decide⟩

#print axioms probe_same_endpoint
#print axioms explicit_shape_split

#print axioms pair_church_has
#print axioms observe_via_sigma
#print axioms observe_via_church
#print axioms same_endpoint_identity
#print axioms zero_source_identity
#print axioms one_source_identity
#print axioms no_shape_split
#print axioms no_reverse_shape_split
end CrossTypedObserver
