{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "status",
    "kind",
    "main_commit",
    "main_tree",
    "research_executed",
    "repository_modified",
    "obligation_ids",
    "source_files",
    "output_hashes"
  ],
  "properties": {
    "schema": {
      "const": "orthemology-research-handoff-receipt-v1"
    },
    "status": {
      "const": "SEALED_HANDOFF_ONLY"
    },
    "kind": {
      "enum": [
        "PRO_PACKET",
        "MASTER"
      ]
    },
    "main_commit": {
      "const": "03e2604dfcef278b01c60d19b05370fcec4194b6"
    },
    "main_tree": {
      "const": "3d06e80277ce39286c94307e0f14b215bc94ed83"
    },
    "research_executed": {
      "const": false
    },
    "repository_modified": {
      "const": false
    },
    "obligation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_files": {
      "type": "integer",
      "minimum": 0
    },
    "output_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
