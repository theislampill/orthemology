    `CodedMixedTransformations.primrec_tcRenChildren,
    `CodedMixedTransformations.primrec_tcRenStep,
    `CodedMixedTransformations.primrec_renameTypeCode,
    `CodedMixedTransformations.renameTypeCode_eq,
    `CodedMixedTransformations.fold_eq_renameTypeCode,
    `CodedMixedTransformations.renameTypeCode_exact,
    `CodedMixedTransformations.primrec_shiftTypeCode,
    `CodedMixedTransformations.shiftTypeCode_exact,
