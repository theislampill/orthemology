+query_vectors={'Theta':theta, 'D':audit}
+def adaptive_likelihood(pi, queries, outcomes):
+    q1,q2=queries; y1,y2=outcomes
+    if q1!='Theta' or q2!=('D' if y1==1 else 'Theta'):
+        return Q(0)
+    p1=dot(query_vectors[q1],pi)
+    p2=dot(query_vectors[q2],pi)  # A fresh independent episode at step two.
