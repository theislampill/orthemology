example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (SourceProof.i (TypeCode.var 0))) = none := by decide
-- elim272: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (TypeCode.var 0)) = none := by decide
-- app273: application; Python refuse
example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (SourceProof.i (TypeCode.var 1))) = none := by decide
-- elim274: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (TypeCode.var 1)) = none := by decide
-- app275: application; Python refuse
example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (SourceProof.i (TypeCode.all (TypeCode.arrow (TypeCode.var 0) (TypeCode.var 0))))) = none := by decide
-- elim276: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (TypeCode.all (TypeCode.arrow (TypeCode.var 0) (TypeCode.var 0)))) = none := by decide
-- app277: application; Python refuse
example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom))) = none := by decide
-- elim278: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) = none := by decide
-- app279: application; Python refuse
example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (SourceProof.i (TypeCode.all (TypeCode.var 1)))) = none := by decide
-- elim280: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.arrow (TypeCode.var 0) TypeCode.bottom)) (TypeCode.all (TypeCode.var 1))) = none := by decide
-- app281: application; Python refuse
example : sourceCheck 1 (SourceProof.app (SourceProof.i (TypeCode.all (TypeCode.var 1))) (SourceProof.i TypeCode.bottom)) = none := by decide
-- elim282: nonpoly; Python refuse
example : sourceCheck 1 (SourceProof.allE (SourceProof.i (TypeCode.all (TypeCode.var 1))) TypeCode.bottom) = none := by decide
-- app283: application; Python refuse
